## General
# Your npub, the owner of this relay; the owner always has full access.
# Required: Haven does not start without it.
OWNER_NPUB="npub1utx00neqgqln72j22kej3ux7803c2k986henvvha4thuwfkper4s7r50e8"
# Public host name of the relay without a scheme, e.g. relay.example.com. Haven builds the
# addresses on its web pages and the links to Blossom media from it. Required.
RELAY_URL="relay.utxo.one"
# Port Haven listens on inside the container. Default when unset: 3355. The compose files
# publish host port 3355 to it.
RELAY_PORT=3355
# Address Haven listens on: a specific IPv4 or IPv6 address, or "" for all interfaces.
# Default when unset: 0.0.0.0.
RELAY_BIND_ADDRESS="0.0.0.0"
# Database engine: badger or lmdb; lmdb works best with an NVMe drive, otherwise you might
# have stability issues. A missing line or any other value runs lmdb. Change it with
# ./haven db-switch, which moves the data.
DB_ENGINE="badger"
# Upper size of each lmdb database file in bytes, e.g. 10737418240 for 10 GB; 0 for the
# default of 256 GiB per file (the file is sparse, so only your data uses disk space).
LMDB_MAPSIZE=0
# Directory for Blossom media files. It must end with a slash: Haven appends each file's
# hash to it. The compose files mount ./blossom at blossom/.
BLOSSOM_PATH="blossom/"

## Private relay
# Name of the private relay, shown on its web page and in its relay information (NIP-11).
# Required.
PRIVATE_RELAY_NAME="utxo's private relay"
# npub shown as the private relay's contact in its relay information (NIP-11) and on its
# web page. Required.
PRIVATE_RELAY_NPUB="npub1utx00neqgqln72j22kej3ux7803c2k986henvvha4thuwfkper4s7r50e8"
# Description of the private relay, shown on its web page and in its relay information
# (NIP-11). Required.
PRIVATE_RELAY_DESCRIPTION="A safe place to store my drafts and ecash"
# URL of the private relay's icon in its relay information (NIP-11). The line must exist;
# the value may be empty.
PRIVATE_RELAY_ICON="https://image.nostr.build/b50979a0def2f99f9524dd6dfcbb7e4dd45df29c1c2f9b1bf39c15c2f4d1bdb3.png"

## Private relay rate limits
# Events per IP address: how many become allowed again after each interval. Default when
# unset: 50.
PRIVATE_RELAY_EVENT_IP_LIMITER_TOKENS_PER_INTERVAL=50
# How often, in minutes, the event allowance per IP address is topped up. Default when
# unset: 1.
PRIVATE_RELAY_EVENT_IP_LIMITER_INTERVAL=1
# Most events one IP address may send in a burst before it has to wait. Default when
# unset: 100.
PRIVATE_RELAY_EVENT_IP_LIMITER_MAX_TOKENS=100
# true accepts queries without any kind, author, id or tag; false rejects them. A query
# rule, not one of the rate limiters. Default when unset: true.
PRIVATE_RELAY_ALLOW_EMPTY_FILTERS=true
# false rejects queries with more than two tags and more than four kinds and tags in all;
# true accepts them. A query rule, not one of the rate limiters. Default when unset: true.
PRIVATE_RELAY_ALLOW_COMPLEX_FILTERS=true
# New connections per IP address: how many become allowed again after each interval.
# Default when unset: 3.
PRIVATE_RELAY_CONNECTION_RATE_LIMITER_TOKENS_PER_INTERVAL=3
# How often, in minutes, the connection allowance per IP address is topped up. Default
# when unset: 5.
PRIVATE_RELAY_CONNECTION_RATE_LIMITER_INTERVAL=5
# Most new connections one IP address may open in a burst before it has to wait. Default
# when unset: 9.
PRIVATE_RELAY_CONNECTION_RATE_LIMITER_MAX_TOKENS=9

## Chat relay
# Name of the chat relay, shown on its web page and in its relay information (NIP-11).
# Required.
CHAT_RELAY_NAME="utxo's chat relay"
# npub shown as the chat relay's contact in its relay information (NIP-11) and on its web
# page. Required.
CHAT_RELAY_NPUB="npub1utx00neqgqln72j22kej3ux7803c2k986henvvha4thuwfkper4s7r50e8"
# Description of the chat relay, shown on its web page and in its relay information
# (NIP-11). Required.
CHAT_RELAY_DESCRIPTION="a relay for private chats"
# URL of the chat relay's icon in its relay information (NIP-11). The line must exist; the
# value may be empty.
CHAT_RELAY_ICON="https://image.nostr.build/b50979a0def2f99f9524dd6dfcbb7e4dd45df29c1c2f9b1bf39c15c2f4d1bdb3.png"

## Chat relay rate limits
# Events per IP address: how many become allowed again after each interval. Default when
# unset: 50.
CHAT_RELAY_EVENT_IP_LIMITER_TOKENS_PER_INTERVAL=50
# How often, in minutes, the event allowance per IP address is topped up. Default when
# unset: 1.
CHAT_RELAY_EVENT_IP_LIMITER_INTERVAL=1
# Most events one IP address may send in a burst before it has to wait. Default when
# unset: 100.
CHAT_RELAY_EVENT_IP_LIMITER_MAX_TOKENS=100
# true accepts queries without any kind, author, id or tag; false rejects them. A query
# rule, not one of the rate limiters. Default when unset: false.
CHAT_RELAY_ALLOW_EMPTY_FILTERS=false
# false rejects queries with more than two tags and more than four kinds and tags in all;
# true accepts them. A query rule, not one of the rate limiters. Default when unset: false.
CHAT_RELAY_ALLOW_COMPLEX_FILTERS=false
# New connections per IP address: how many become allowed again after each interval.
# Default when unset: 3.
CHAT_RELAY_CONNECTION_RATE_LIMITER_TOKENS_PER_INTERVAL=3
# How often, in minutes, the connection allowance per IP address is topped up. Default
# when unset: 3.
CHAT_RELAY_CONNECTION_RATE_LIMITER_INTERVAL=3
# Most new connections one IP address may open in a burst before it has to wait. Default
# when unset: 9.
CHAT_RELAY_CONNECTION_RATE_LIMITER_MAX_TOKENS=9

## Outbox relay
# Name of the outbox relay, shown on its web page and in its relay information (NIP-11).
# Required.
OUTBOX_RELAY_NAME="utxo's outbox relay"
# npub shown as the outbox relay's contact in its relay information (NIP-11) and on its
# web page. Required.
OUTBOX_RELAY_NPUB="npub1utx00neqgqln72j22kej3ux7803c2k986henvvha4thuwfkper4s7r50e8"
# Description of the outbox relay, shown on its web page and in its relay information
# (NIP-11). Required.
OUTBOX_RELAY_DESCRIPTION="a relay and Blossom server for public messages and media"
# URL of the outbox relay's icon in its relay information (NIP-11). The line must exist;
# the value may be empty.
OUTBOX_RELAY_ICON="https://image.nostr.build/b50979a0def2f99f9524dd6dfcbb7e4dd45df29c1c2f9b1bf39c15c2f4d1bdb3.png"

## Outbox relay rate limits
# Events per IP address: how many become allowed again after each interval. Default when
# unset: 10.
OUTBOX_RELAY_EVENT_IP_LIMITER_TOKENS_PER_INTERVAL=10
# How often, in minutes, the event allowance per IP address is topped up. Default when
# unset: 60.
OUTBOX_RELAY_EVENT_IP_LIMITER_INTERVAL=60
# Most events one IP address may send in a burst before it has to wait. Default when
# unset: 100.
OUTBOX_RELAY_EVENT_IP_LIMITER_MAX_TOKENS=100
# true accepts queries without any kind, author, id or tag; false rejects them. A query
# rule, not one of the rate limiters. Default when unset: false.
OUTBOX_RELAY_ALLOW_EMPTY_FILTERS=false
# false rejects queries with more than two tags and more than four kinds and tags in all;
# true accepts them. A query rule, not one of the rate limiters. Default when unset: false.
OUTBOX_RELAY_ALLOW_COMPLEX_FILTERS=false
# New connections per IP address: how many become allowed again after each interval.
# Default when unset: 3.
OUTBOX_RELAY_CONNECTION_RATE_LIMITER_TOKENS_PER_INTERVAL=3
# How often, in minutes, the connection allowance per IP address is topped up. Default
# when unset: 1.
OUTBOX_RELAY_CONNECTION_RATE_LIMITER_INTERVAL=1
# Most new connections one IP address may open in a burst before it has to wait. Default
# when unset: 9.
OUTBOX_RELAY_CONNECTION_RATE_LIMITER_MAX_TOKENS=9

## Inbox relay
# Name of the inbox relay, shown on its web page and in its relay information (NIP-11).
# Required.
INBOX_RELAY_NAME="utxo's inbox relay"
# npub shown as the inbox relay's contact in its relay information (NIP-11) and on its web
# page. Required.
INBOX_RELAY_NPUB="npub1utx00neqgqln72j22kej3ux7803c2k986henvvha4thuwfkper4s7r50e8"
# Description of the inbox relay, shown on its web page and in its relay information
# (NIP-11). Required.
INBOX_RELAY_DESCRIPTION="send your interactions with my notes here"
# URL of the inbox relay's icon in its relay information (NIP-11). The line must exist; the
# value may be empty.
INBOX_RELAY_ICON="https://image.nostr.build/b50979a0def2f99f9524dd6dfcbb7e4dd45df29c1c2f9b1bf39c15c2f4d1bdb3.png"
# Read by Haven v1.2.2 (default when unset: 3600) but used nowhere else in its code, so
# changing it has no effect in this version.
INBOX_PULL_INTERVAL_SECONDS=600

## Inbox relay rate limits
# Events per IP address: how many become allowed again after each interval. Default when
# unset: 10.
INBOX_RELAY_EVENT_IP_LIMITER_TOKENS_PER_INTERVAL=10
# How often, in minutes, the event allowance per IP address is topped up. Default when
# unset: 1.
INBOX_RELAY_EVENT_IP_LIMITER_INTERVAL=1
# Most events one IP address may send in a burst before it has to wait. Default when
# unset: 20.
INBOX_RELAY_EVENT_IP_LIMITER_MAX_TOKENS=20
# true accepts queries without any kind, author, id or tag; false rejects them. A query
# rule, not one of the rate limiters. Default when unset: false.
INBOX_RELAY_ALLOW_EMPTY_FILTERS=false
# false rejects queries with more than two tags and more than four kinds and tags in all;
# true accepts them. A query rule, not one of the rate limiters. Default when unset: false.
INBOX_RELAY_ALLOW_COMPLEX_FILTERS=false
# New connections per IP address: how many become allowed again after each interval.
# Default when unset: 3.
INBOX_RELAY_CONNECTION_RATE_LIMITER_TOKENS_PER_INTERVAL=3
# How often, in minutes, the connection allowance per IP address is topped up. Default
# when unset: 1.
INBOX_RELAY_CONNECTION_RATE_LIMITER_INTERVAL=1
# Most new connections one IP address may open in a burst before it has to wait. Default
# when unset: 9.
INBOX_RELAY_CONNECTION_RATE_LIMITER_MAX_TOKENS=9


## Import
# Date (YYYY-MM-DD) from which ./haven import fetches your old notes. Required: Haven does
# not start without it.
IMPORT_START_DATE="2023-01-20"
# Seconds the import waits for each batch (ten days) of your own notes. Default when
# unset: 60.
IMPORT_OWNER_NOTES_FETCH_TIMEOUT_SECONDS=60
# Seconds the import waits for notes that tag you. Default when unset: 120.
IMPORT_TAGGED_NOTES_FETCH_TIMEOUT_SECONDS=120
# JSON list of relays used by the import, for the notes that tag you while the relay runs,
# and for the web-of-trust data. Required: the file must exist.
IMPORT_SEED_RELAYS_FILE="relays_import.json"

## Backup
# Periodic cloud backups: s3, or none (or leave blank) to disable them. Default when
# unset: none.
BACKUP_PROVIDER="none"
# Hours between two periodic cloud backups (only with BACKUP_PROVIDER="s3"). Default when
# unset: 24.
BACKUP_INTERVAL_HOURS=24

## S3 bucket for backups
# Access key ID for the bucket. Only read with BACKUP_PROVIDER="s3".
S3_ACCESS_KEY_ID="access"
# Secret key for the bucket. Only read with BACKUP_PROVIDER="s3".
S3_SECRET_KEY="secret"
# Endpoint host of the S3 service, e.g. s3.us-east-1.amazonaws.com. Only read
# with BACKUP_PROVIDER="s3".
S3_ENDPOINT="nyc3.digitaloceanspaces.com"
# Region of the bucket, e.g. us-east-1; GCP and Cloudflare R2 leave it blank. Only read
# with BACKUP_PROVIDER="s3".
S3_REGION="nyc3"
# Name of the bucket the backups go to. Only read with BACKUP_PROVIDER="s3".
S3_BUCKET_NAME="backups"

## Blastr
# JSON list of relays that every note sent to your outbox is also sent to; an entry
# without a scheme gets wss://. Required: the file must exist.
BLASTR_RELAYS_FILE="relays_blastr.json"
# Seconds to wait for each of those relays when broadcasting a note. Default when unset: 5.
BLASTR_TIMEOUT_SECONDS=5

## Web of trust
# Who may write to your inbox and chat relays: 0 anyone, 1 only you and whitelisted npubs,
# 2 also the people you follow, 3 also people they follow. Default when unset: 3.
WOT_DEPTH=3
# At depth 3, how many common followers someone needs to be trusted. Upstream's docs give
# 3 as the default; with the line missing Haven uses 0.
WOT_MINIMUM_FOLLOWERS=3
# Seconds Haven waits for web-of-trust data from other relays. Default when unset: 30.
WOT_FETCH_TIMEOUT_SECONDS=30
# How often the web of trust is rebuilt, as a duration such as 24h or 1h. Default when
# unset: 24h.
WOT_REFRESH_INTERVAL="24h"

## Access lists
# JSON list of npubs with the owner's rights: outbox, Blossom uploads, the private relay,
# no web-of-trust check. Leave blank for none; the owner is always whitelisted.
WHITELISTED_NPUBS_FILE="whitelisted_npubs.json"
# JSON list of npubs that cannot write to your chat and inbox relays and are skipped by the
# import. Leave blank for none.
BLACKLISTED_NPUBS_FILE="blacklisted_npubs.json"

## Logging
# How much Haven logs: DEBUG, INFO, WARN or ERROR; any other value, WARNING included, logs
# at INFO. Default when unset: INFO.
HAVEN_LOG_LEVEL="INFO"

## Container user
# The container runs as this uid:gid and must own the bind-mounted ./db and
# ./blossom directories. Leave these commented out and `./haven start` fills them
# in with your own `id -u` / `id -g`. Only set them by hand if you run
# `docker compose` directly, or if the data directories belong to another user.
#
# User id the container runs as; `./haven start` sets your own `id -u` when it is missing.
# DOCKER_UID=1000
# Group id the container runs as; `./haven start` sets your own `id -g` when it is missing.
# DOCKER_GID=1000
