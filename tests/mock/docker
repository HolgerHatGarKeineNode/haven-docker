#!/usr/bin/env bash
# Mock docker for the unit tests in tests/haven-engine.bats and the e2e
# rig: a healthy daemon, a relay container that is "up", a tor container
# that exited, a fixed image digest, and a logs stream that emits a
# counter line every 200 ms and spawns a marked child process so orphan
# checks can find it (marker sleep 21777).
#
# Scripted mode — active ONLY when MOCK_DOCKER_STATE_DIR is set (unset: the
# behaviour below the scripted block, unchanged). State lives in that dir:
#   calls.log   every call, one line, the raw argv ("compose -f f stop relay")
#   running     names of running containers, one per line (docker ps, compose ps)
#   exited      names listed as "Exited (0)" by `ps -a`; `stop` appends to it
#   run-count   number of `compose run` calls so far
#   started     touched by a held `run`, release: touch `release` to let it go
# Knobs (environment):
#   MOCK_STOP_FAILS=1   `compose stop` returns 0 but leaves `running` untouched
#   MOCK_STOP_SLEEP=<s> `compose stop` sleeps <s> seconds first (a slow stop, so
#                       a signal can land while it runs)
#   MOCK_START_FAILS=1  `compose start|up|restart` exit 1 and leave `running`
#                       untouched (a relay that does not come back)
#   MOCK_RUN_EXIT=<n>   exit status of every `compose run` (default 0)
#   MOCK_FAIL_AT=<n>    the n-th `compose run` (1-based) exits MOCK_RUN_EXIT if
#                       that is non-zero, else 1
#   MOCK_RUN_WRITES=1   a `run ... backup /app/backups/<f>` creates <f> on the
#                       host side of the `-v <host>:/app/backups` mount
#                       (content: $MOCK_RUN_PAYLOAD or "mock-backup"; with
#                       MOCK_RUN_PAYLOAD_FILE set, a copy of that file instead —
#                       for binary payloads such as a real zip). The container
#                       form `--entrypoint sh relay -c '... exec /app/haven
#                       backup "$1"' sh /app/backups/<f>` counts as well; a
#                       `umask NNN` in that -c script is applied to the write,
#                       so the file mode on the host follows the umask the
#                       caller really passed (the mock's own umask otherwise)
#   MOCK_RUN_HOLD=1     `run` touches `started`, then polls up to MOCK_HOLD_MAX
#                       seconds (default 10) for `release` before it continues;
#                       `docker stop|rm|kill <name>` touches `release` (the
#                       one-shot container ends, so its held `run` returns) and
#                       `docker stop|kill <name>` drops <name> from `running`
#   MOCK_HOLD_AT=<n>    with MOCK_RUN_HOLD=1: hold only the n-th `run` (1-based)
#   MOCK_PAYLOAD_AT=<n> with MOCK_RUN_WRITES=1: the n-th `run` writes a copy of
#   MOCK_PAYLOAD_AT_FILE instead of the usual payload (a second backup that
#                       differs from the first)
#   MOCK_DB_DIR=<dir>   a `run ... restore ...` creates engine files in the five
#                       database directories under <dir> (the host side of
#                       ./db): data.mdb + lock.mdb for lmdb, MANIFEST +
#                       000001.vlog + KEYREGISTRY for badger, the engine taken
#                       from `-e DB_ENGINE=<e>` (none given: lmdb, as upstream).
#                       Written before the exit status is applied, so a failing
#                       restore leaves a partial database like the real one
#   HAVEN_CONTAINER_NAME  name that start/up/restart mark as running
#                         (default haven-relay)
#   MOCK_LOG_COUNT=<n>  `compose logs` emits exactly n lines (MOCKLOG COUNTER=0 ..
#                       n-1) without pausing, then stays attached and silent until
#                       it is killed — a FROZEN stream, so an e2e check can wait once
#                       for the last line and then read a screen that cannot move
#                       (and the TUI's producer-death restart does not fire, the
#                       producer is alive). Works in both modes; unset or empty =
#                       the endless counter stream (every 200 ms) below.
# Without MOCK_LOG_COUNT `compose logs` keeps today's endless counter stream in
# scripted mode.

mock_log() { printf '%s\n' "$*" >> "$MOCK_DOCKER_STATE_DIR/calls.log"; }

mock_ps() { # mock_ps <all:0|1> <format>
  local all="$1" fmt="$2" n
  local d="$MOCK_DOCKER_STATE_DIR"
  while IFS= read -r n; do
    [[ -n "$n" ]] || continue
    if [[ "$fmt" == "{{.Names}}|{{.Status}}" ]]; then
      printf '%s|Up 2 hours (healthy)\n' "$n"
    else
      printf '%s\n' "$n"
    fi
  done < <(cat "$d/running" 2>/dev/null)
  if (( all )); then
    while IFS= read -r n; do
      [[ -n "$n" ]] || continue
      grep -qxF -- "$n" "$d/running" 2>/dev/null && continue
      if [[ "$fmt" == "{{.Names}}|{{.Status}}" ]]; then
        printf '%s|Exited (0) 4 minutes ago\n' "$n"
      else
        printf '%s\n' "$n"
      fi
    done < <(cat "$d/exited" 2>/dev/null)
  fi
}

mock_scripted() {
  local d="$MOCK_DOCKER_STATE_DIR" name="${HAVEN_CONTAINER_NAME:-haven-relay}"
  mkdir -p "$d"
  mock_log "$*"
  case "${1:-}" in
    info) exit 0 ;;
    inspect)
      printf 'sha256:abcdef1234567890abcdef1234567890abcdef1234567890abcdef1234567890\n'
      exit 0
      ;;
    ps)
      local all=0 fmt="{{.Names}}" a
      for a in "${@:2}"; do
        [[ "$a" == "-a" ]] && all=1
        [[ "$a" == "{{.Names}}|"* ]] && fmt="$a"
      done
      mock_ps "$all" "$fmt"
      exit 0
      ;;
    compose) ;;
    stop|rm|kill)
      : > "$d/release"
      if [[ "$1" != "rm" && -s "$d/running" ]]; then
        local last="${*: -1}"
        grep -vxF -- "$last" "$d/running" > "$d/running.tmp" || true
        mv -f "$d/running.tmp" "$d/running"
      fi
      exit 0
      ;;
    *) exit 0 ;;
  esac

  # compose: skip the global options in front of the subcommand
  local -a args=("${@:2}")
  while ((${#args[@]})); do
    case "${args[0]}" in
      -f|-p|--file|--project-name|--env-file|--profile) args=("${args[@]:2}") ;;
      -*) args=("${args[@]:1}") ;;
      *) break ;;
    esac
  done
  local sub="${args[0]:-}"
  args=("${args[@]:1}")

  case "$sub" in
    version) exit 0 ;;
    logs) return 0 ;;   # falls through to the counter stream below
    ps)
      printf 'NAME\tSTATUS\n'
      mock_ps 0 "{{.Names}}|{{.Status}}" | tr '|' '\t'
      exit 0
      ;;
    stop)
      [[ -z "${MOCK_STOP_SLEEP:-}" ]] || sleep "$MOCK_STOP_SLEEP"
      if [[ "${MOCK_STOP_FAILS:-0}" != "1" ]]; then
        if [[ -s "$d/running" ]]; then
          cat "$d/running" >> "$d/exited"
        fi
        : > "$d/running"
      fi
      exit 0
      ;;
    start|up|restart)
      [[ "${MOCK_START_FAILS:-0}" == "1" ]] && exit 1
      printf '%s\n' "$name" > "$d/running"
      exit 0
      ;;
    down)
      : > "$d/running"
      exit 0
      ;;
    run)
      local n=0
      [[ -f "$d/run-count" ]] && n="$(cat "$d/run-count")"
      n=$((n + 1))
      printf '%s' "$n" > "$d/run-count"
      if [[ "${MOCK_RUN_HOLD:-0}" == "1" && ( -z "${MOCK_HOLD_AT:-}" || "$n" == "${MOCK_HOLD_AT:-}" ) ]]; then
        : > "$d/started"
        local waited=0 max="${MOCK_HOLD_MAX:-10}"
        while [[ ! -e "$d/release" ]] && (( $(awk "BEGIN{print ($waited < $max)}") )); do
          sleep 0.05
          waited="$(awk "BEGIN{print $waited + 0.05}")"
        done
      fi
      if [[ "${MOCK_RUN_WRITES:-0}" == "1" ]]; then
        local i host="" target="" verb_seen=0 a um=""
        # shellcheck disable=SC2016  # a literal $1: the container's sh expands it
        local sh_backup='exec /app/haven backup "$1"'
        for ((i = 0; i < ${#args[@]}; i++)); do
          a="${args[$i]}"
          if [[ "$a" == "-v" ]]; then
            [[ "${args[$((i + 1))]:-}" == *":/app/backups" ]] && host="${args[$((i + 1))]%:/app/backups}"
          elif [[ "$a" == "backup" ]]; then
            verb_seen=1
          elif [[ "$a" == *"$sh_backup"* ]]; then
            verb_seen=1
            [[ "$a" =~ umask\ ([0-7]+) ]] && um="${BASH_REMATCH[1]}"
          elif (( verb_seen )) && [[ "$a" == /app/backups/* ]]; then
            target="$a"
          fi
        done
        if [[ -n "$host" && -n "$target" ]]; then
          (
            [[ -z "$um" ]] || umask "$um"
            if [[ -n "${MOCK_PAYLOAD_AT:-}" && "$n" == "${MOCK_PAYLOAD_AT:-}" ]]; then
              cp -- "$MOCK_PAYLOAD_AT_FILE" "$host/${target#/app/backups/}"
            elif [[ -n "${MOCK_RUN_PAYLOAD_FILE:-}" ]]; then
              cp -- "$MOCK_RUN_PAYLOAD_FILE" "$host/${target#/app/backups/}"
            else
              printf '%s' "${MOCK_RUN_PAYLOAD:-mock-backup}" > "$host/${target#/app/backups/}"
            fi
          )
        fi
      fi
      if [[ -n "${MOCK_DB_DIR:-}" ]]; then
        local j engine="lmdb" is_restore=0 dbn
        for ((j = 0; j < ${#args[@]}; j++)); do
          [[ "${args[$j]}" == "restore" ]] && is_restore=1
          if [[ "${args[$j]}" == "-e" && "${args[$((j + 1))]:-}" == DB_ENGINE=* ]]; then
            engine="${args[$((j + 1))]#DB_ENGINE=}"
          fi
        done
        if (( is_restore )); then
          for dbn in private chat outbox inbox blossom; do
            mkdir -p "$MOCK_DB_DIR/$dbn"
            if [[ "$engine" == "badger" ]]; then
              printf 'badger manifest %s %s\n' "$dbn" "$n" > "$MOCK_DB_DIR/$dbn/MANIFEST"
              printf 'badger vlog %s %s\n' "$dbn" "$n" > "$MOCK_DB_DIR/$dbn/000001.vlog"
              printf 'badger keys %s %s\n' "$dbn" "$n" > "$MOCK_DB_DIR/$dbn/KEYREGISTRY"
            else
              printf 'lmdb data %s %s\n' "$dbn" "$n" > "$MOCK_DB_DIR/$dbn/data.mdb"
              printf 'lmdb lock %s %s\n' "$dbn" "$n" > "$MOCK_DB_DIR/$dbn/lock.mdb"
            fi
          done
        fi
      fi
      local rc="${MOCK_RUN_EXIT:-0}"
      if [[ -n "${MOCK_FAIL_AT:-}" && "$n" == "$MOCK_FAIL_AT" ]]; then
        (( rc != 0 )) || rc=1
      fi
      exit "$rc"
      ;;
    *) exit 0 ;;
  esac
}

if [[ -n "${MOCK_DOCKER_STATE_DIR:-}" ]]; then
  mock_scripted "$@"
fi

case "${1:-}" in
  info)
    exit 0
    ;;
  ps)
    all=0
    fmt="{{.Names}}"
    for a in "${@:2}"; do
      [[ "$a" == "-a" ]] && all=1
      [[ "$a" == "{{.Names}}|"* ]] && fmt="$a"
    done
    if (( all )); then
      if [[ "$fmt" == "{{.Names}}|{{.Status}}" ]]; then
        printf 'haven-relay|Up 2 hours (healthy)\nhaven-tor|Exited (0) 4 minutes ago\n'
      else
        printf 'haven-relay\nhaven-tor\n'
      fi
    else
      if [[ "$fmt" == "{{.Names}}|{{.Status}}" ]]; then
        printf 'haven-relay|Up 2 hours (healthy)\n'
      else
        printf 'haven-relay\n'
      fi
    fi
    ;;
  inspect)
    printf 'sha256:abcdef1234567890abcdef1234567890abcdef1234567890abcdef1234567890\n'
    ;;
  compose)
    shift || true
    if [[ "${1:-}" == "version" ]]; then
      exit 0
    fi
    # logs path (arguments ignored): marker child + counter stream
    if [[ -n "${MOCK_LOG_COUNT:-}" ]] && ! [[ "$MOCK_LOG_COUNT" =~ ^[0-9]+$ ]]; then
      # before the marker child exists, so a refusal leaves no orphan behind
      printf 'mock docker: MOCK_LOG_COUNT must be a non-negative integer, got "%s"\n' "$MOCK_LOG_COUNT" >&2
      exit 2
    fi
    ( sleep 21777 ) &
    n=0
    if [[ -n "${MOCK_LOG_COUNT:-}" ]]; then
      while (( n < MOCK_LOG_COUNT )); do
        printf 'MOCKLOG COUNTER=%d\n' "$n"
        n=$((n + 1))
      done
      wait   # attached and silent: the marker child above keeps this process alive
    fi
    while :; do
      printf 'MOCKLOG COUNTER=%d\n' "$n"
      n=$((n + 1))
      sleep 0.2
    done
    ;;
  *)
    exit 0
    ;;
esac
