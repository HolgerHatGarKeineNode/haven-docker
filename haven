tui_update_layout() {
  local cols lines
  cols="$(tput cols 2>/dev/null || echo 80)"
  lines="$(tput lines 2>/dev/null || echo 24)"
  # a size that is no number (a tput killed by a signal prints nothing) keeps
  # the previous one, or the default before there is one: every printf '%d'
  # of the frame fails on an empty TUI_COLS
  [[ "$cols" =~ ^[0-9]+$ ]] || cols="${TUI_COLS:-0}"
  [[ "$lines" =~ ^[0-9]+$ ]] || lines="${TUI_LINES:-0}"
  [[ "$cols" =~ ^[1-9][0-9]*$ ]] || cols=80
  [[ "$lines" =~ ^[1-9][0-9]*$ ]] || lines=24
  TUI_COLS="$cols" TUI_LINES="$lines"

  if (( TUI_COLS < TUI_MIN_COLS || TUI_LINES < TUI_MIN_LINES )); then
    TUI_TOO_SMALL=1
  else
    TUI_TOO_SMALL=0
  fi

  LEFT_W=$((TUI_COLS * 38 / 100))
  if [[ "$LEFT_W" -lt 28 ]]; then
    LEFT_W=28
  fi
  if [[ "$LEFT_W" -gt $((TUI_COLS - 30)) ]]; then
    LEFT_W=$((TUI_COLS - 30))
  fi

  # Row 0: top border, Row 1: title bar, Row 2: separator
  # Rows 3..N-3: content, Row N-2: bottom border, Row N-1: status bar
  LEFT_X=2
  RIGHT_X=$((LEFT_W + 2))

  LEFT_CONTENT_W=$((LEFT_W - 3))
  RIGHT_CONTENT_W=$((TUI_COLS - LEFT_W - 4))
  if [[ "$LEFT_CONTENT_W" -lt 20 ]]; then
    LEFT_CONTENT_W=20
  fi
  if [[ "$RIGHT_CONTENT_W" -lt 20 ]]; then
    RIGHT_CONTENT_W=20
  fi

  LEFT_CONTENT_ROW=3
  RIGHT_CONTENT_ROW=3
  LEFT_CONTENT_HEIGHT=$((TUI_LINES - LEFT_CONTENT_ROW - 2))
  RIGHT_CONTENT_HEIGHT=$((TUI_LINES - RIGHT_CONTENT_ROW - 2))
  if [[ "$LEFT_CONTENT_HEIGHT" -lt 6 ]]; then
    LEFT_CONTENT_HEIGHT=6
  fi
  if [[ "$RIGHT_CONTENT_HEIGHT" -lt 6 ]]; then
    RIGHT_CONTENT_HEIGHT=6
  fi


  # Pre-compute horizontal line strings and border for frame drawing
  printf -v _HLINE_LEFT '%*s' "$((LEFT_W - 1))" ''
  _HLINE_LEFT="${_HLINE_LEFT// /$BOX_H}"
  printf -v _HLINE_RIGHT '%*s' "$((TUI_COLS - LEFT_W - 2))" ''
  _HLINE_RIGHT="${_HLINE_RIGHT// /$BOX_H}"
  printf -v _HLINE_SEP '%*s' "$LEFT_CONTENT_W" ''
  _HLINE_SEP="${_HLINE_SEP// /$BOX_H}"
  printf -v _BORDER_V '%b%s%b' "$TUI_FG_SEPARATOR" "$BOX_V" "$CLR_RESET"
}

tui_supports_bracketed_paste() {
  case "${TERM:-}" in
    xterm*|screen*|tmux*|rxvt*|st-*|st|alacritty*|kitty*|wezterm*|foot*|contour*|mlterm*|mintty*)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

tui_enable_bracketed_paste() {
  if [[ "$TUI_PASTE_ENABLED" != "1" ]] && tui_supports_bracketed_paste; then
    printf '\033[?2004h' >/dev/tty 2>/dev/null || true
    TUI_PASTE_ENABLED=1
  fi
}

tui_disable_bracketed_paste() {
  if [[ "$TUI_PASTE_ENABLED" == "1" ]]; then
    printf '\033[?2004l' >/dev/tty 2>/dev/null || true
    TUI_PASTE_ENABLED=0
  fi
}

tui_init() {
  export LC_CTYPE="${LC_CTYPE:-en_US.UTF-8}"
  TUI_ACTIVE=1
  TUI_STTY_ORIG="$(stty -g)"
  TUI_STTY_EXIT="$TUI_STTY_ORIG"
  stty -echo -icanon time 0 min 0
  tput smcup
  tput civis
  tui_enable_bracketed_paste
  tui_update_layout
  # the terminal modes once more after the cleanup: a Ctrl-C or SIGTERM lands
  # inside `read -rsn1` (tui_read_key), and the read builtin puts back the raw
  # modes it saved AFTER the INT/TERM trap's stty — the shell was left
  # -icanon -echo (measured in tmux, stty -g before/after). The EXIT trap runs
  # once the read has unwound.
  TUI_PID="$BASHPID"
  trap tui_on_exit EXIT
  trap tui_on_signal INT TERM
}

# tui_on_exit / tui_on_signal — the TUI's EXIT and INT/TERM actions; they act
# only in the TUI's own process. A subshell lists the parent's traps under
# `trap -p` without them being in force, and a writer guard that saved and put
# back that list armed them there: the subshell's exit then ran stty with the
# pre-TUI modes on the live terminal (echo on under the running TUI).
TUI_PID=""
tui_on_exit() {
  [[ "$BASHPID" == "$TUI_PID" ]] || return 0
  tui_cleanup
  tui_restore_tty
}

tui_on_signal() {
  [[ "$BASHPID" != "$TUI_PID" ]] || tui_cleanup
  exit 130
}

# tui_restore_tty — the terminal modes from before tui_init, by name (stdin may
# be a pipe); for the EXIT trap, after tui_cleanup.
TUI_STTY_EXIT=""
tui_restore_tty() {
  [[ -z "$TUI_STTY_EXIT" ]] || stty "$TUI_STTY_EXIT" </dev/tty 2>/dev/null || true
}

tui_cleanup() {
  # Idempotent: die() may run cleanup, then the EXIT trap runs it again.
  if [[ "${TUI_ACTIVE:-0}" != "1" ]]; then
    return 0
  fi
  stop_log_stream || true
  tui_disable_bracketed_paste || true
  # the terminal by name: inside a `done < <(…)` loop stdin is a pipe, stty on
  # it fails, and under errexit the rest of the cleanup (rmcup) never ran
  if [[ -n "$TUI_STTY_ORIG" ]]; then
    stty "$TUI_STTY_ORIG" </dev/tty 2>/dev/null || true
    TUI_STTY_ORIG=""
  fi
  tput cnorm 2>/dev/null || true
  tput rmcup 2>/dev/null || true
  TUI_ACTIVE=0
}

# Consume the payload of a bracketed-paste block after the opening
# ESC[200~ marker, up to the closing ESC[201~. The payload is dropped —
# P4 may turn it into real input.
tui_consume_bracketed_payload() {
  local ch=""
  local closer=""
  while IFS= read -rsn1 -t 1 ch; do
    [[ "$ch" == $'\x1b' ]] || continue
    IFS= read -rsn5 -t 0.05 closer || true
    [[ "$closer" == "[201~" ]] && return 0
  done
  return 0
}

tui_read_key() {
  _KEY=""
  # 150 ms poll: keys register within one tick (< 300 ms e2e-measured),
  # and the idle loop burns ~3x less CPU than the old 50 ms polling.
  if ! IFS= read -rsn1 -t 0.15 _KEY; then
    # a timeout that fired right after a byte arrived still hands it over
    [[ -n "$_KEY" ]] || return 1
  fi

  if [[ "$_KEY" == $'\x03' ]]; then
    _KEY="quit"
    return 0
  fi

  if [[ "$_KEY" == $'\x1b' ]]; then
    # Collect the bytes after ESC up to a finalizer (letter, '~', '$'), so
    # sequences of any length decode. Byte-wise reads with 10 ms timeouts:
    # a bare ESC press costs one timeout and still maps to esc, and the
    # collected bytes are never discarded on timeout.
    local seq=""
    local ch=""
    local i
    for i in 1 2 3 4 5; do
      IFS= read -rsn1 -t 0.01 ch || break
      seq+="$ch"
      # 'O' as the first byte after ESC is the SS3 introducer (F-keys,
      # arrow keys on some terminals), not a finalizer — read one more.
      if [[ "$i" == 1 && "$ch" == "O" ]]; then
        continue
      fi
      [[ "$ch" =~ [a-zA-Z~$] ]] && break
    done
    case "$seq" in
      "[A"|"OA") _KEY="up" ;;
      "[B"|"OB") _KEY="down" ;;
      "[C"|"OC") _KEY="right" ;;
      "[D"|"OD") _KEY="left" ;;
      "[H"|"OH"|"[7~"|"[1~") _KEY="home" ;;
      "[F"|"OF"|"[8~"|"[4~") _KEY="end" ;;
      "[5~") _KEY="pgup" ;;
      "[6~") _KEY="pgdn" ;;
      "[3~"|"[3$") _KEY="del" ;;
      "OP"|"[11~"|"[[A") _KEY="f1" ;;
      "OQ"|"[12~"|"[[B") _KEY="f2" ;;
      "[200~")
        # Bracketed paste — payload is discarded.
        tui_consume_bracketed_payload
        _KEY="paste"
        ;;
      "")
        # Nothing followed within the sequence timeout: a bare ESC press.
        _KEY="esc"
        ;;
      *)
        # Recognized as an escape sequence but not bound: swallow instead of
        # falling through to esc, which would navigate back a view.
        _KEY="unknown"
        ;;
    esac
    return 0
  fi

  if [[ -z "$_KEY" ]]; then
    _KEY="enter"
    return 0
  fi

  case "$_KEY" in
    $'\n'|$'\r') _KEY="enter" ;;
    q|Q) _KEY="quit" ;;
    $'\t') _KEY="tab" ;;
  esac
}

