# Bash version guard: the script needs bash >= 4.2 — `printf %(%s)T`
# (tui_update_docker_status) requires 4.2 and `exec {fd}<` (start_log_stream)
# requires 4.1. Help/usage stay reachable on older shells (macOS ships 3.2).
case "${1:-}" in
  help|-h|--help|"") : ;;
  *)
    if (( BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 2) )); then
      printf 'haven: bash 4.2 or newer is required, found %s.\n' "$BASH_VERSION" >&2
      printf 'haven: macOS ships bash 3.2 by default — install a newer bash (e.g. brew install bash).\n' >&2
      printf 'haven: run "%s help" for usage on any bash.\n' "$SCRIPT_NAME" >&2
      exit 1
    fi
    ;;
esac

