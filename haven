json_label_for() {
  local file="$1"
  local count=${#JSON_FILES[@]}
  for ((i=0; i<count; i++)); do
    if [[ "${JSON_FILES[$i]}" == "$file" ]]; then
      printf "%s" "${JSON_LABELS[$i]}"
      return
    fi
  done
  printf "%s" "$file"
}

