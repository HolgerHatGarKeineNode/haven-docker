tui_draw_frame() {
  local do_clear="${1:-0}"
  local row
  local bottom_row=$((TUI_LINES - 2))
  if [[ "$do_clear" == "1" ]]; then
    tui_clear
  fi

  # Row 0: top border ┌───┬───┐
  printf '\033[1;1H'
  printf "%b%s%s%s%s%s%b" "$TUI_FG_SEPARATOR" \
    "$BOX_TL" "$_HLINE_LEFT" "$BOX_TT" "$_HLINE_RIGHT" "$BOX_TR" "$CLR_RESET"

  # Row 1: colored title bar
  tui_draw_title_row

  # Row 2: sub-separator ├───┼───┤
  printf '\033[3;1H'
  printf "%b%s%s%s%s%s%b" "$TUI_FG_SEPARATOR" \
    "$BOX_LT" "$_HLINE_LEFT" "$BOX_CROSS" "$_HLINE_RIGHT" "$BOX_RT" "$CLR_RESET"

  # Content rows: left border, center divider, right border
  for ((row=3; row<bottom_row; row++)); do
    printf '\033[%d;1H%s\033[%d;%dH%s\033[%d;%dH%s' \
      "$((row+1))" "$_BORDER_V" \
      "$((row+1))" "$((LEFT_W+1))" "$_BORDER_V" \
      "$((row+1))" "$TUI_COLS" "$_BORDER_V"
  done

  # Bottom border └───┴───┘
  printf '\033[%d;1H' "$((bottom_row+1))"
  printf "%b%s%s%s%s%s%b" "$TUI_FG_SEPARATOR" \
    "$BOX_BL" "$_HLINE_LEFT" "$BOX_BT" "$_HLINE_RIGHT" "$BOX_BR" "$CLR_RESET"

  # Status bar
  tui_draw_status_bar
}

# The title row (terminal row 2), the only painter of it: the frame and both
# right-pane modes call it after setting TUI_LEFT_TITLE / TUI_RIGHT_TITLE.
# Columns (0-based): 0 border, 1 blank, 2..LEFT_W-1 left title (LEFT_W-2
# cells), LEFT_W divider (under ┬), LEFT_W+1 blank, LEFT_W+2..COLS-2 right
# title (COLS-LEFT_W-3 cells), COLS-1 border. Each title is truncated one cell
# short of its field, so a blank always separates it from the divider.
tui_draw_title_row() {
  local left_w=$((LEFT_W - 2))
  local right_w=$((TUI_COLS - LEFT_W - 3))
  local style="${TUI_BG_TITLEBAR}${TUI_BOLD}${TUI_FG_TITLE}"
  local left right
  # The left title is a path ("Haven / Access lists / Import relays"): when it
  # is too wide, leading segments give way to "…" before a word is cut, so the
  # view you are in stays readable.
  local path="$TUI_LEFT_TITLE" rest="$TUI_LEFT_TITLE"
  tui_str_width "$path"
  while (( _WIDTH > left_w - 1 )) && [[ "$rest" == *" / "* ]]; do
    rest="${rest#*" / "}"
    path="… / $rest"
    tui_str_width "$path"
  done
  tui_truncate "$path" $((left_w - 1))
  tui_pad_to "$_TRUNC" "$left_w"
  left="$_PADDED"
  tui_truncate "$TUI_RIGHT_TITLE" $((right_w - 1))
  tui_pad_to "$_TRUNC" "$right_w"
  right="$_PADDED"
  printf '\033[2;1H'
  printf "%s%b %s%b%s%b %s%b%s" \
    "$_BORDER_V" "$style" "$left" "$CLR_RESET" \
    "$_BORDER_V" "$style" "$right" "$CLR_RESET" \
    "$_BORDER_V"
}

# tui_footer_hints — _HINTS: the key hints of the bottom row, one "key|what"
# per line, for what the keys do right now: a dialog's own keys while one is
# open (TUI_FOOTER=message|confirm|prompt), else those of the current view and
# right-pane mode (Esc goes back only below the main view; / filters only the
# log pane; Tab names the pane it switches to).
TUI_FOOTER=""
_HINTS=""
_HINTS_DRAWN=""
tui_footer_hints() {
  case "$TUI_FOOTER" in
    message) _HINTS="Any key|Continue" ;;
    message-scroll) _HINTS=$'↑↓|Scroll\nOther key|Continue' ;;
    confirm) _HINTS=$'←→|Choose\n⏎|Confirm\nEsc|Cancel' ;;
    prompt) _HINTS=$'⏎|Confirm\nEsc|Cancel' ;;
    task) _HINTS="Ctrl-C|${TASK_CTRLC_HINT:-Stop}"$'\nOther keys|Wait' ;;
    *)
      local tab="Status" settings=0
      tui_view_has_details && settings=1
      if [[ "$TUI_RIGHT_MODE" == "status" ]]; then tab="Logs"; fi
      if (( settings )); then
        tab="Logs"
        [[ "$TUI_RIGHT_MODE" == "logs" ]] && tab="Details"
      fi
      _HINTS=$'↑↓|Move\n⏎|Open'
      if [[ "$TUI_VIEW" == env_list && -n "$SETTINGS_FILTER" ]]; then
        _HINTS+=$'\nEsc|Clear filter'
      elif [[ "$TUI_VIEW" != "main" ]]; then
        _HINTS+=$'\nEsc|Back'
      fi
      _HINTS+=$'\nTab|'"$tab"
      if [[ "$TUI_VIEW" == env_list ]] || { [[ "$TUI_RIGHT_MODE" == "logs" ]] && ! tui_view_has_details; }; then _HINTS+=$'\n/|Filter'; fi
      if [[ "$TUI_RIGHT_MODE" == "logs" ]] && (( LOG_SCROLL > 0 )); then _HINTS+=$'\nPgDn|Resume'; fi
      if [[ "$TUI_VIEW" == "main" ]]; then _HINTS+=$'\n?|Help\nq|Quit'; fi
      ;;
  esac
  return 0
}

tui_draw_status_bar() {
  local status_row=$((TUI_LINES - 1))
  tui_footer_hints
  _HINTS_DRAWN="$_HINTS|$TUI_COLS"
  # Fill entire row with statusbar background first
  tput cup "$status_row" 0
  printf "%b%-*s%b" "${TUI_BG_STATUSBAR}" "$TUI_COLS" "" "$CLR_RESET"
  # Overlay hints text: key in the shortcut style, what it does in the status
  # style. A hint that would not fit is left off with all after it (they are
  # in order of need), so the row never reaches the last column.
  tput cup "$status_row" 1
  local hint key what out="" used=1
  while IFS= read -r hint; do
    key="${hint%%|*}" what="${hint#*|}"
    tui_str_width " $key $what "
    (( used + _WIDTH < TUI_COLS )) || break
    used=$((used + _WIDTH))
    out+=" ${TUI_FG_SHORTCUT}${TUI_BOLD}${key}${CLR_RESET}${TUI_BG_STATUSBAR}${TUI_FG_STATUS} ${what} "
  done <<<"$_HINTS"
  printf "%b%b%b" "${TUI_BG_STATUSBAR}" "$out" "$CLR_RESET"
}

# tui_refresh_status_bar — redraw the bottom row only when its hints changed
# (view, right-pane mode, dialog, width); called after each pane render.
tui_refresh_status_bar() {
  tui_footer_hints
  [[ "$_HINTS|$TUI_COLS" == "$_HINTS_DRAWN" ]] || tui_draw_status_bar
}

# Display width of a string: printable-ASCII fast path, otherwise count
# codepoints with the common double-width blocks (CJK, Hangul, fullwidth
# forms, most emoji) as 2 columns. Combining marks count 1 — acceptable for
# menu labels and log lines.
tui_str_width() {
  local s="$1"
  local ascii_re='^[ -~]*$'
  if [[ "$s" =~ $ascii_re ]]; then
    _WIDTH=${#s}
    return 0
  fi
  local i cp w=0 n=${#s}
  for ((i=0; i<n; i++)); do
    printf -v cp '%d' "'${s:i:1}"
    if (( (cp>=0x1100 && cp<=0x115F) || (cp>=0x2E80 && cp<=0xA4CF) ||
          (cp>=0xAC00 && cp<=0xD7A3) || (cp>=0xF900 && cp<=0xFAFF) ||
          (cp>=0xFE30 && cp<=0xFE6F) || (cp>=0xFF00 && cp<=0xFF60) ||
          (cp>=0xFFE0 && cp<=0xFFE6) || (cp>=0x1F300 && cp<=0x1F64F) ||
          (cp>=0x1F900 && cp<=0x1F9FF) || (cp>=0x20000 && cp<=0x3FFFD) )); then
      w=$((w + 2))
    else
      w=$((w + 1))
    fi
  done
  _WIDTH=$w
}

# Truncate to a display width (not a codepoint count) so wide glyphs no
# longer push the frame borders out of alignment; the ellipsis is included.
tui_truncate() {
  local s="$1"
  local limit="$2"
  tui_str_width "$s"
  if (( _WIDTH <= limit )); then
    _TRUNC="$s"
    return 0
  fi
  local out="" w=0 i cw n=${#s}
  local budget=$((limit - 3))
  if (( budget < 0 )); then
    budget=0
  fi
  for ((i=0; i<n; i++)); do
    tui_str_width "${s:i:1}"
    cw=$_WIDTH
    if (( w + cw > budget )); then
      break
    fi
    out+="${s:i:1}"
    w=$((w + cw))
    if (( w >= budget )); then
      break
    fi
  done
  _TRUNC="${out}..."
}

# Pad to a display width (printf %-*s pads by codepoints and would leave
# CJK rows short, breaking column alignment against the frame).
tui_pad_to() {
  local s="$1"
  local width="$2"
  tui_str_width "$s"
  if (( _WIDTH > width )); then
    tui_truncate "$s" "$width"
    s="$_TRUNC"
    tui_str_width "$s"
  fi
  local pad=$((width - _WIDTH))
  _PADDED="$s"
  if (( pad > 0 )); then
    printf -v _SPACES '%*s' "$pad" ''
    _PADDED+="${_SPACES}"
  fi
}

tui_print_left() {
  local row="$1"
  shift
  local text="$*"
  tui_pad_to "$text" "$LEFT_CONTENT_W"
  tput cup "$row" "$LEFT_X"
  printf "%s" "$_PADDED"
}

tui_print_left_styled() {
  local row="$1"
  local style="$2"
  local text="$3"
  tui_pad_to "$text" "$LEFT_CONTENT_W"
  tput cup "$row" "$LEFT_X"
  printf "%b%s%b" "$style" "$_PADDED" "$CLR_RESET"
}

tui_print_right() {
  local row="$1"
  shift
  local text="$*"
  tput cup "$row" "$RIGHT_X"
  printf "%-*s" "$RIGHT_CONTENT_W" "$text"
}

tui_wait_key() {
  local _=""
  # each poll is a finished render pass for the test seam (the box is drawn);
  # false when the terminal was resized meanwhile (the caller lays out again)
  while ! IFS= read -rsn1 -t 0.1 _; do
    tui_sync_mark
    [[ "${TUI_NEED_RESIZE:-0}" -eq 1 ]] && return 1
  done
  return 0
}

# Prompt validators: called by tui_prompt with the raw input; rc != 0 plus
# VALIDATION_ERROR shows the error inline at the prompt, rc 0 accepts the
# input (PROMPT_RESULT carries the normalized value).

_validate_prompt_new_key() {
  VALIDATION_ERROR=""
  PROMPT_RESULT="$1"
  if [[ -z "$1" ]]; then
    VALIDATION_ERROR="Key is empty."
    return 1
  fi
  if [[ ! "$1" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
    VALIDATION_ERROR="Key must be A-Z, a-z, 0-9, _ and start with a letter or underscore."
    return 1
  fi
  if [[ -n "$(read_env_var "$1" 2>/dev/null || true)" ]]; then
    VALIDATION_ERROR="Key already exists in .env."
    return 1
  fi
  return 0
}

_validate_prompt_env_value() {
  VALIDATION_ERROR=""
  PROMPT_RESULT=""
  if [[ -z "$1" ]]; then
    VALIDATION_ERROR="Value is empty."
    return 1
  fi
  if ! validate_env_value "$PROMPT_ENV_KEY" "$1"; then
    return 1
  fi
  PROMPT_RESULT="$VALIDATION_VALUE"
  return 0
}

# --- prompt input -------------------------------------------------------------
# The text of an open prompt can be longer than its field: the field shows a
# window onto it that follows the cursor, with "…" in the first or last cell
# where text is hidden. The editing state is global so the key handling
# (tui_prompt_edit) and the window (tui_prompt_window) can be driven without a
# terminal; tui_prompt itself reads /dev/tty.
PROMPT_MAX=4096          # characters a prompt accepts (an npub is 63)
PI_TEXT=""               # the input
PI_CUR=0                 # cursor, in characters (0 .. length)
PI_VIEW=0                # first character shown in the field
_PI_ASCII=1              # 1: every character is one cell, _PI_P is not used
_PI_P=()                 # prefix sums of the cell widths: _PI_P[i] = cells of PI_TEXT[0:i]
_PI_SHOWN=""             # what the field shows between the markers
_PI_LMARK=0              # 1: "…" in the first cell (text hidden on the left)
_PI_RMARK=0              # 1: "…" in the last cell (text hidden on the right)
_PI_CURCOL=0             # cursor column, in cells from the start of the field

# tui_char_width <char> — _CW: cells of one character (the wide blocks of
# tui_str_width count 2).
tui_char_width() {
  local cp
  printf -v cp '%d' "'$1"
  if (( (cp>=0x1100 && cp<=0x115F) || (cp>=0x2E80 && cp<=0xA4CF) ||
        (cp>=0xAC00 && cp<=0xD7A3) || (cp>=0xF900 && cp<=0xFAFF) ||
        (cp>=0xFE30 && cp<=0xFE6F) || (cp>=0xFF00 && cp<=0xFF60) ||
        (cp>=0xFFE0 && cp<=0xFFE6) || (cp>=0x1F300 && cp<=0x1F64F) ||
        (cp>=0x1F900 && cp<=0x1F9FF) || (cp>=0x20000 && cp<=0x3FFFD) )); then
    _CW=2
  else
    _CW=1
  fi
}

# tui_prompt_widths — recompute the cell widths after PI_TEXT changed.
tui_prompt_widths() {
  local ascii_re='^[ -~]*$' i n=${#PI_TEXT} sum=0
  if [[ "$PI_TEXT" =~ $ascii_re ]]; then
    _PI_ASCII=1
    _PI_P=()
    return 0
  fi
  _PI_ASCII=0
  _PI_P=(0)
  for ((i = 0; i < n; i++)); do
    tui_char_width "${PI_TEXT:i:1}"
    sum=$((sum + _CW))
    _PI_P[i + 1]=$sum
  done
}

# _pi_cells <from> <to> — _N: cells of PI_TEXT[from:to]
_pi_cells() {
  if [[ "$_PI_ASCII" == "1" ]]; then
    _N=$(($2 - $1))
  else
    _N=$((_PI_P[$2] - _PI_P[$1]))
  fi
}

# _pi_fits <view> <field cells> — true when a window starting at <view> shows
# the cursor; _PI_TAIL=1 when it also shows the whole rest of the text.
_pi_fits() {
  local v="$1" f="$2" n=${#PI_TEXT} left=0 cw=1 end_cell=0
  (( v <= PI_CUR )) || return 1
  (( v > 0 )) && left=1
  (( PI_CUR == n )) && end_cell=1
  _pi_cells "$v" "$n"
  if (( left + _N + end_cell <= f )); then
    _PI_TAIL=1
    return 0
  fi
  _PI_TAIL=0
  if (( PI_CUR < n )); then
    _pi_cells "$PI_CUR" $((PI_CUR + 1))
    cw=$_N
  fi
  _pi_cells "$v" "$PI_CUR"
  (( left + _N + cw + 1 <= f ))
}

# tui_prompt_window <field cells> — move PI_VIEW so the cursor is inside the
# field, then fill _PI_SHOWN, _PI_LMARK, _PI_RMARK and _PI_CURCOL. The window
# moves only as far as the cursor needs; when the whole rest of the text fits
# it is pulled back, so no cell stays empty while text is hidden on the left.
tui_prompt_window() {
  local f="$1" n=${#PI_TEXT} e budget
  (( f < 4 )) && f=4
  (( PI_VIEW > PI_CUR )) && PI_VIEW=$PI_CUR
  (( PI_VIEW < 0 )) && PI_VIEW=0
  while ! _pi_fits "$PI_VIEW" "$f"; do
    PI_VIEW=$((PI_VIEW + 1))
  done
  while (( PI_VIEW > 0 )) && _pi_fits $((PI_VIEW - 1)) "$f" && [[ "$_PI_TAIL" == "1" ]]; do
    PI_VIEW=$((PI_VIEW - 1))
  done
  _pi_fits "$PI_VIEW" "$f" || true
  _PI_LMARK=0
  _PI_RMARK=0
  (( PI_VIEW > 0 )) && _PI_LMARK=1
  (( _PI_TAIL == 1 )) || _PI_RMARK=1
  budget=$((f - _PI_LMARK - _PI_RMARK))
  e=$PI_VIEW
  while (( e < n )); do
    _pi_cells "$PI_VIEW" $((e + 1))
    (( _N <= budget )) || break
    e=$((e + 1))
  done
  _PI_SHOWN="${PI_TEXT:PI_VIEW:e - PI_VIEW}"
  _pi_cells "$PI_VIEW" "$PI_CUR"
  _PI_CURCOL=$((_PI_LMARK + _N))
}

# tui_prompt_edit <action> [<text>] — one editing step on PI_TEXT/PI_CUR:
# left right home end backspace delete clear (Ctrl-U) word (Ctrl-W) insert.
tui_prompt_edit() {
  local before room
  case "$1" in
    left) (( PI_CUR > 0 )) && PI_CUR=$((PI_CUR - 1)) ;;
    right) (( PI_CUR < ${#PI_TEXT} )) && PI_CUR=$((PI_CUR + 1)) ;;
    home) PI_CUR=0 ;;
    end) PI_CUR=${#PI_TEXT} ;;
    backspace)
      if (( PI_CUR > 0 )); then
        PI_TEXT="${PI_TEXT:0:PI_CUR - 1}${PI_TEXT:PI_CUR}"
        PI_CUR=$((PI_CUR - 1))
      fi
      ;;
    delete)
      (( PI_CUR < ${#PI_TEXT} )) && PI_TEXT="${PI_TEXT:0:PI_CUR}${PI_TEXT:PI_CUR + 1}"
      ;;
    clear) PI_TEXT="" PI_CUR=0 ;;
    word)
      before="${PI_TEXT:0:PI_CUR}"
      if [[ "$before" =~ ^(.*)[[:space:]]+[^[:space:]]+$ ]]; then
        before="${BASH_REMATCH[1]}"
      else
        before=""
      fi
      PI_TEXT="$before${PI_TEXT:PI_CUR}"
      PI_CUR=${#before}
      ;;
    insert)
      room=$((PROMPT_MAX - ${#PI_TEXT}))
      (( room > 0 )) || return 0
      before="${2:0:room}"
      PI_TEXT="${PI_TEXT:0:PI_CUR}$before${PI_TEXT:PI_CUR}"
      PI_CUR=$((PI_CUR + ${#before}))
      ;;
  esac
  case "$1" in
    backspace|delete|clear|word|insert) tui_prompt_widths ;;
  esac
  return 0
}

# tui_prompt_read <timeout> — _PCH: one character from /dev/tty, read byte by
# byte (C locale) and put together from its UTF-8 bytes; "" for Enter. rc 1
# when nothing arrived. A read whose timeout fires right after it got a byte
# reports a timeout with the byte in hand: that byte counts, or a character
# arriving at that moment would lose its first byte.
tui_prompt_read() {
  local b="" rc=0 code need=0 i
  _PCH=""
  LC_ALL=C IFS= read -rsn1 -t "$1" b </dev/tty || rc=$?
  if [[ -z "$b" ]]; then
    (( rc == 0 )) && return 0   # the line delimiter: Enter
    return 1
  fi
  _PCH="$b"
  LC_ALL=C printf -v code '%d' "'$b"
  (( code < 0 )) && code=$((code + 256))
  if (( code >= 0xF0 && code <= 0xF7 )); then need=3
  elif (( code >= 0xE0 )) && (( code <= 0xEF )); then need=2
  elif (( code >= 0xC0 )) && (( code <= 0xDF )); then need=1
  fi
  for ((i = 0; i < need; i++)); do
    b=""
    LC_ALL=C IFS= read -rsn1 -t 0.05 b </dev/tty || true
    [[ -n "$b" ]] || break
    _PCH+="$b"
  done
  return 0
}

# tui_prompt_draw <row> <label> — the prompt row: label, then the field window
# (markers dim), padded to the pane; the terminal cursor ends on the input cursor.
tui_prompt_draw() {
  local row="$1" label="$2" label_w field_x f pad
  tui_str_width "$label"
  label_w=$_WIDTH
  field_x=$((LEFT_X + label_w + 1))
  f=$((LEFT_CONTENT_W - label_w - 1))
  (( f < 4 )) && f=4
  tui_prompt_window "$f"
  tput cup "$row" "$LEFT_X"
  printf "%b%s%b " "${TUI_FG_ACCENT}" "$label" "$CLR_RESET"
  (( _PI_LMARK )) && printf "%b…%b" "${TUI_DIM}${TUI_FG_MENU_DIM}" "$CLR_RESET"
  printf "%s" "$_PI_SHOWN"
  _pi_cells "$PI_VIEW" $((PI_VIEW + ${#_PI_SHOWN}))
  pad=$((f - _PI_LMARK - _PI_RMARK - _N))
  (( pad > 0 )) && printf "%*s" "$pad" ""
  (( _PI_RMARK )) && printf "%b…%b" "${TUI_DIM}${TUI_FG_MENU_DIM}" "$CLR_RESET"
  tput cup "$row" "$((field_x + _PI_CURCOL))"
}

tui_prompt() {
  local prompt="$1"
  local default="$2"
  local validator="${3:-}"
  local ch="" code=0 i

  # Refresh the geometry: prompts may open after the frame was last laid out.
  tui_update_layout
  local prompt_row=$((TUI_LINES - 3))
  local err_row=$((TUI_LINES - 2))
  PI_TEXT="" PI_CUR=0 PI_VIEW=0 PROMPT_ERR_ROWS=0
  tui_prompt_widths

  # Flush any pending input
  while IFS= read -rsn1 -t 0.01 _ </dev/tty; do :; done

  # All display output goes to /dev/tty so it reaches the terminal
  # even when this function runs inside $() subshell capture
  # The error row is the bottom border: it keeps its line until there is an
  # error to show. The bottom row names the prompt's keys while it is open.
  {
    tput cup "$prompt_row" "$LEFT_X"
    printf "%-*s" "$LEFT_CONTENT_W" ""
    TUI_FOOTER="prompt"
    tui_draw_status_bar
    tput cnorm
  } >/dev/tty

  # tui_prompt usually runs inside a $() subshell, which resets inherited
  # traps — re-arm SIGWINCH locally so a resize during input still redraws.
  trap 'TUI_NEED_RESIZE=1' SIGWINCH

  while true; do
    # Redraw prompt line and cursor at the current geometry.
    {
      if [[ "${TUI_NEED_RESIZE:-0}" -eq 1 ]]; then
        TUI_NEED_RESIZE=0
        tui_update_layout
        prompt_row=$((TUI_LINES - 3))
        err_row=$((TUI_LINES - 2))
        # the whole screen follows the new size, not only the prompt row:
        # frame, both panes, then the prompt on top (below)
        if [[ "$TUI_TOO_SMALL" != "1" ]]; then
          tui_draw_frame 1
          tui_render_right_panel
          TUI_NEED_MENU=1
          tui_render_left_menu
        fi
      fi
      tui_prompt_draw "$prompt_row" "$prompt"
    } >/dev/tty

    tui_prompt_read 0.1 || continue
    ch="$_PCH"

    # ESC: cancel, cursor keys, or bracketed paste. The bytes after ESC are
    # collected up to a finalizer, as in tui_read_key, so ESC[1~ and ESC[4~
    # (Home/End on some terminals) leave no "~" behind.
    if [[ "$ch" == $'\x1b' ]]; then
      local seq="" b=""
      for i in 1 2 3 4 5; do
        b=""
        IFS= read -rsn1 -t 0.01 b </dev/tty || [[ -n "$b" ]] || break
        seq+="$b"
        [[ "$i" == 1 && ( "$b" == "O" || "$b" == "[" ) ]] && continue
        [[ "$b" =~ [a-zA-Z~] ]] && break
      done
      case "$seq" in
        "[D"|"OD") tui_prompt_edit left ;;
        "[C"|"OC") tui_prompt_edit right ;;
        "[H"|"OH"|"[1~"|"[7~") tui_prompt_edit home ;;
        "[F"|"OF"|"[4~"|"[8~") tui_prompt_edit end ;;
        "[3~") tui_prompt_edit delete ;;
        "[200~")
          # Bracketed paste: ESC[200~ <payload> ESC[201~ — the payload is
          # inserted at the cursor, up to PROMPT_MAX characters in all; line
          # breaks and other control characters are dropped.
          local pch="" closer="" paste=""
          while tui_prompt_read 1; do
            pch="$_PCH"
            if [[ "$pch" == $'\x1b' ]]; then
              IFS= read -rsn5 -t 0.05 closer </dev/tty || true
              [[ "$closer" == "[201~" ]] && break
              continue
            fi
            [[ -n "$pch" ]] || continue
            printf -v code '%d' "'$pch"
            (( code >= 32 && code != 127 )) || continue
            paste+="$pch"
          done
          tui_prompt_edit insert "$paste"
          ;;
        "")
          # Bare ESC (nothing followed): cancel with the default.
          PI_TEXT="$default"
          break
          ;;
        *) : ;;   # another sequence: ignored, never inserted
      esac
      continue
    fi

    # Enter → confirm (validate inline when a validator is set)
    if [[ -z "$ch" || "$ch" == $'\n' || "$ch" == $'\r' ]]; then
      # an empty field means "no change": the default comes back as it is,
      # neither validated nor drawn
      if [[ -z "$PI_TEXT" ]]; then
        PI_TEXT="$default"
        break
      fi
      if [[ -n "$validator" ]]; then
        VALIDATION_ERROR=""
        PROMPT_RESULT=""
        if "$validator" "$PI_TEXT"; then
          [[ -n "$PROMPT_RESULT" ]] && PI_TEXT="$PROMPT_RESULT"
          break
        fi
        # the error wraps onto the rows just above the prompt (the menu's,
        # repainted when the prompt closes), never onto the frame
        {
          local -a err_lines=()
          local el er
          while IFS= read -r el; do err_lines+=("$el"); done < <(printf '✗ %s\n' "$VALIDATION_ERROR" | tui_wrap "$LEFT_CONTENT_W")
          (( ${#err_lines[@]} > 3 )) && err_lines=("${err_lines[@]:0:3}")
          for ((er = 1; er <= ${PROMPT_ERR_ROWS:-0}; er++)); do
            tput cup $((prompt_row - er)) "$LEFT_X"
            printf "%-*s" "$LEFT_CONTENT_W" ""
          done
          PROMPT_ERR_ROWS=${#err_lines[@]}
          for ((er = 0; er < PROMPT_ERR_ROWS; er++)); do
            tput cup $((prompt_row - PROMPT_ERR_ROWS + er)) "$LEFT_X"
            tui_pad_to "${err_lines[$er]}" "$LEFT_CONTENT_W"
            printf "%b%s%b" "${TUI_FG_LOG_ERROR}" "$_PADDED" "$CLR_RESET"
          done
        } >/dev/tty
        continue
      fi
      break
    fi

    case "$ch" in
      $'\x7f'|$'\x08') tui_prompt_edit backspace; continue ;;   # Backspace
      $'\x03') PI_TEXT="$default"; break ;;                      # Ctrl-C (no isig)
      $'\x01') tui_prompt_edit home; continue ;;                 # Ctrl-A
      $'\x05') tui_prompt_edit end; continue ;;                  # Ctrl-E
      $'\x15') tui_prompt_edit clear; continue ;;                # Ctrl-U
      $'\x17') tui_prompt_edit word; continue ;;                 # Ctrl-W
    esac

    # A printable character at the cursor (a UTF-8 character arrives whole)
    printf -v code '%d' "'$ch"
    if (( code < 32 )); then
      continue
    fi
    tui_prompt_edit insert "$ch"
  done

  # Cancelled or submitted: clear the label row — a finished prompt must not
  # stay painted until the next full redraw (the caller repaints the menu that
  # owns the row) — and give the error row, which is the bottom border, its
  # line back.
  {
    tput cup "$prompt_row" "$LEFT_X"
    printf "%-*s" "$LEFT_CONTENT_W" ""
    tput cup "$err_row" "$LEFT_X"
    printf "%b%s%b" "$TUI_FG_SEPARATOR" "$_HLINE_SEP" "$CLR_RESET"
    TUI_FOOTER=""
    tui_draw_status_bar
    tput civis
  } >/dev/tty
  printf "%s" "$PI_TEXT"
}

tui_confirm() {
  local prompt="$1"
  local default_answer="$2"
  local selection=0

  if [[ "$default_answer" == "n" || "$default_answer" == "N" ]]; then
    selection=1
  fi

  local yes_label="  Yes  "
  local no_label="  No  "

  # Fresh geometry — dialogs may open after the frame was last laid out.
  tui_update_layout

  TUI_FOOTER="confirm"
  tui_draw_frame 1
  tui_render_right_panel
  # The question wraps at word boundaries ("\n" in it starts a new line); the
  # buttons sit one blank row below its last line.
  local qline qrows=0
  while IFS= read -r qline; do
    tui_print_left_styled $((LEFT_CONTENT_ROW + qrows)) "${TUI_BOLD}${TUI_FG_ACCENT}" "$qline"
    qrows=$((qrows + 1))
  done < <(printf '%s\n' "${prompt//\\n/$'\n'}" | tui_wrap "$LEFT_CONTENT_W")
  local row=$((LEFT_CONTENT_ROW + qrows + 1))

  # May run inside a $() subshell with reset traps — re-arm SIGWINCH locally.
  trap 'TUI_NEED_RESIZE=1' SIGWINCH

  while true; do
    if [[ "${TUI_NEED_RESIZE:-0}" -eq 1 ]]; then
      TUI_NEED_RESIZE=0
      tui_update_layout
      row=$((LEFT_CONTENT_ROW + qrows + 1))
    fi
    tput cup "$row" "$LEFT_X"
    printf "%-*s" "$LEFT_CONTENT_W" ""
    tput cup "$row" "$LEFT_X"
    if [[ "$selection" -eq 0 ]]; then
      printf "%b%s%b  %b%s%b" \
        "${TUI_BOLD}${TUI_FG_SELECTED}${TUI_BG_CONFIRM_YES}" "$yes_label" "$CLR_RESET" \
        "${TUI_DIM}${TUI_FG_MENU_DIM}" "$no_label" "$CLR_RESET"
    else
      printf "%b%s%b  %b%s%b" \
        "${TUI_DIM}${TUI_FG_MENU_DIM}" "$yes_label" "$CLR_RESET" \
        "${TUI_BOLD}${TUI_FG_SELECTED}${TUI_BG_CONFIRM_NO}" "$no_label" "$CLR_RESET"
    fi

    tui_sync_mark
    tui_read_key || continue
    case "$_KEY" in
      left|up) selection=0 ;;
      right|down) selection=1 ;;
      enter)
        TUI_FOOTER=""
        if [[ "$selection" -eq 0 ]]; then
          return 0
        fi
        return 1
        ;;
      esc) TUI_FOOTER=""; return 1 ;;
    esac
  done
}

tui_message() {
  local title="$1"
  local text="$2"
  # callers write line breaks as "\n" inside double quotes, which bash keeps as
  # backslash + n: turn them into real ones, or they show up as text
  text="${text//\\n/$'\n'}"

  # Body text; a text taller than the pane scrolls with ↑↓ (the last row of
  # the page then says how many lines are hidden below), any other key
  # continues. A resize lays the box out again at the new size (fresh
  # geometry, the text wrapped anew), also while it waits for its key.
  local line top=0 i body_h=0 n=0 row redraw=1 paint=1
  local -a body=()
  while :; do
    if (( redraw )); then
      tui_update_layout
      body=()
      while IFS= read -r line; do body+=("$line"); done < <(printf "%s\n" "$text" | tui_wrap "$LEFT_CONTENT_W")
      n=${#body[@]}
      row=$((LEFT_CONTENT_ROW + 2))
      body_h=$((LEFT_CONTENT_ROW + LEFT_CONTENT_HEIGHT - row))
      TUI_FOOTER="message"
      (( n > body_h )) && TUI_FOOTER="message-scroll"
      (( top > n - body_h )) && top=$((n - body_h))
      (( top < 0 )) && top=0
      tui_draw_frame 1
      tui_render_right_panel
      tui_print_left_styled "$LEFT_CONTENT_ROW" "${TUI_BOLD}${TUI_FG_ACCENT}" "$title"
      tui_print_left_styled $((LEFT_CONTENT_ROW + 1)) "$TUI_FG_SEPARATOR" "$_HLINE_SEP"
      tui_draw_status_bar
      redraw=0 paint=1
    fi
    if (( paint )); then
      for ((i = 0; i < body_h; i++)); do
        line=""
        (( top + i < n )) && line="${body[$((top + i))]}"
        if (( n > body_h && i == body_h - 1 && top + body_h < n )); then
          tui_print_left_styled $((row + i)) "${TUI_DIM}${TUI_ITALIC}" "↓ $((n - top - body_h + 1)) more lines"
        else
          tui_print_left $((row + i)) "$line"
        fi
      done
      paint=0
    fi
    if (( n <= body_h )); then
      # any key continues (tui_wait_key: a resize meanwhile lays out again)
      tui_wait_key && break
      TUI_NEED_RESIZE=0
      redraw=1
      continue
    fi
    tui_sync_mark
    if ! tui_read_key; then
      if [[ "${TUI_NEED_RESIZE:-0}" -eq 1 ]]; then
        TUI_NEED_RESIZE=0
        redraw=1
      fi
      continue
    fi
    case "$_KEY" in
      down|j) (( top + body_h < n )) && top=$((top + 1)) ;;
      up|k) (( top > 0 )) && top=$((top - 1)) ;;
      pgdn) top=$((top + body_h - 1)); (( top > n - body_h )) && top=$((n - body_h)) ;;
      pgup) top=$((top - body_h + 1)); (( top < 0 )) && top=0 ;;
      unknown|paste) : ;;
      *) break ;;
    esac
    paint=1
  done
  TUI_FOOTER=""
}

# info, success, warn and die print the message with %s, never %b: messages
# carry file names, paths, arguments and tool output, where %b would turn a
# literal "\033", "\a" or "\n" into a control byte or an extra line (a backup
# named "-\033]52;c;<b64>\a.zip" set the terminal's clipboard through die).
# %b is kept for the script's own colour constants only.
info() {
  printf "%b%s\n" "${CLR_BLUE}INFO${CLR_RESET} " "$*"
}

success() {
  printf "%b%s\n" "${CLR_GREEN}OK${CLR_RESET} " "$*"
}

warn() {
  printf "%b%s\n" "${CLR_YELLOW}WARN${CLR_RESET} " "$*"
}

# The *_plain variants are the same as the above since info, success and warn
# print with %s; they stay for the call sites that pass text through
# printable_text (a raw control byte in it becomes "?").
info_plain() {
  printf "%b%s\n" "${CLR_BLUE}INFO${CLR_RESET} " "$*"
}

success_plain() {
  printf "%b%s\n" "${CLR_GREEN}OK${CLR_RESET} " "$*"
}

warn_plain() {
  printf "%b%s\n" "${CLR_YELLOW}WARN${CLR_RESET} " "$*"
}

# printable_text <string> — every byte outside printable ASCII becomes '?', so
# a crafted name cannot carry a raw escape sequence to the terminal.
printable_text() {
  printf '%s' "$1" | LC_ALL=C tr -c '[:print:]' '?'
}

die() {
  # Leave the alternate screen and restore the terminal BEFORE printing, so
  # the error stays visible on the normal screen — the EXIT trap's rmcup
  # would otherwise swallow the message with the alternate buffer.
  if [[ "${TUI_ACTIVE:-0}" == "1" ]]; then
    tui_cleanup
  fi
  printf "%b%s\n" "${CLR_RED}ERROR${CLR_RESET} " "$*" >&2
  exit 1
}

ensure_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "Missing dependency: $1"
}

detect_compose() {
  ensure_cmd docker
  if docker compose version >/dev/null 2>&1; then
    DOCKER_COMPOSE=(docker compose)
    return
  fi
  if command -v docker-compose >/dev/null 2>&1; then
    DOCKER_COMPOSE=(docker-compose)
    return
  fi
  die "Docker Compose not found. Install Docker Compose v2 or docker-compose."
}

ensure_docker() {
  if ! docker info >/dev/null 2>&1; then
    die "Docker daemon not reachable. Is Docker running?"
  fi
}

tui_require_docker() {
  if docker info >/dev/null 2>&1; then
    return 0
  fi
  if [[ "$TUI_ACTIVE" == "1" ]]; then
    tui_message "Docker" "Docker daemon not reachable. Start Docker and try again."
  else
    warn "Docker daemon not reachable. Start Docker and try again."
  fi
  return 1
}

has_tor_container() {
  docker ps -a --format '{{.Names}}' | grep -qx 'haven-tor'
}

relay_container_running() {
  docker ps --format '{{.Names}}' | grep -qxF -- "$RELAY_CONTAINER"
}

resolve_mode() {
  local action="$1"
  if [[ "$MODE" == "tor" ]]; then
    printf '%s' "tor"
    return
  fi
  if [[ "$MODE" == "plain" ]]; then
    printf '%s' "plain"
    return
  fi
  if [[ "$action" == "start" ]]; then
    printf '%s' "plain"
    return
  fi
  if has_tor_container; then
    printf '%s' "tor"
  else
    printf '%s' "plain"
  fi
}

compose_file_for() {
  local mode="$1"
  if [[ "$mode" == "tor" ]]; then
    printf '%s' "$COMPOSE_FILE_TOR"
  else
    printf '%s' "$COMPOSE_FILE_PLAIN"
  fi
}

require_compose_file() {
  [[ -f "$1" ]] || die "Compose file not found: $1"
}

dc() {
  local compose_file="$1"
  shift
  "${DOCKER_COMPOSE[@]}" -f "$compose_file" "$@"
}

# read_env_var <key> — the raw value (inline comment and trailing blanks cut)
# of the LAST line that sets <key> in .env: Compose reads a key that is in the
# file more than once with the value of its last line, so every reader in this
# script goes through here and sees that value. The key is compared literally
# (from awk's environment, no pattern). 1 when no line sets it.
read_env_var() {
  local key="$1"
  local env_file="$ROOT_DIR/.env"
  [[ -f "$env_file" ]] || return 1
  # shellcheck disable=SC2016  # an awk program: $0 belongs to awk, not to the shell
  HAVEN_K="$key" awk '
    function strip_inline(v,    i,c,quote,out) {
      quote=""
      out=""
      for (i=1; i<=length(v); i++) {
        c=substr(v,i,1)
        if (c=="\"" || c=="\047") {
          if (quote==c) quote=""
          else if (quote=="") quote=c
        }
        if (c=="#" && quote=="") break
        out=out c
      }
      sub(/[ \t]+$/, "", out)
      return out
    }
    BEGIN { key = ENVIRON["HAVEN_K"]; klen = length(key) }
    {
      line = $0
      if (substr(line, 1, klen + 1) != key "=") {
        if (!sub(/^[ \t]*export[ \t]+/, "", line) || substr(line, 1, klen + 1) != key "=") next
      }
      last = strip_inline(substr(line, klen + 2))
      found = 1
    }
    END { if (!found) exit 1; print last }
  ' "$env_file"
}

# Timestamped backup before every config write, keeping the 10 most
# recent (restore: cp <file>.bak.<timestamp> <file>, see README).
backup_config_file() {
  local file="$1"
  [[ -f "$file" ]] || return 0
  local ts
  printf -v ts '%(%Y%m%d%H%M%S)T' -1
  cp -p "$file" "$file.bak.$ts" 2>/dev/null || return 0
  local -a backups=()
  local b
  while IFS= read -r b; do
    [[ -n "$b" ]] && backups+=("$b")
  done < <(ls -1 "$file".bak.* 2>/dev/null | sort)
  if (( ${#backups[@]} > 10 )); then
    for ((i=0; i < ${#backups[@]} - 10; i++)); do
      rm -f "${backups[$i]}"
    done
  fi
}

# replace_file_from <file> <command> [args...] — <file> becomes the output of
# the command. .env holds secrets, and the old `awk > .env.tmp; mv` turned a
# 0600 .env into 0644 under umask 022 (measured on 99d840c). So: the temporary
# file sits next to <file> (same directory, the mv is a rename on the same
# filesystem); mktemp creates it owner-only, it is narrowed to the original's
# owner bits after the redirection opened it and before the first byte is
# written, and it takes the original's owner and mode only once the content is
# complete — at no moment is it more permissive than <file>. Silent (it also
# runs inside the db-switch rollback, where a message may hit a dead terminal):
# returns 1 with REPLACE_ERR set and <file> untouched when any step fails,
# including an owner that cannot be kept.
REPLACE_ERR=""
REPLACE_TMP=""
replace_file_from() {
  local file="$1" tmp mode owner cur
  shift
  REPLACE_ERR=""
  mode="$(path_mode "$file")"
  owner="$(stat -L -c '%u:%g' "$file" 2>/dev/null || stat -L -f '%u:%g' "$file" 2>/dev/null || true)"
  if [[ ! "$mode" =~ ^[0-7]{3,4}$ || ! "$owner" =~ ^[0-9]+:[0-9]+$ ]]; then
    REPLACE_ERR="cannot read the mode or owner of ${file#"$ROOT_DIR/"}; it was not changed"
    return 1
  fi
  if ! tmp="$(umask 077 && mktemp "$file.tmp.XXXXXX" 2>/dev/null)"; then
    REPLACE_ERR="cannot create a temporary file next to ${file#"$ROOT_DIR/"}; it was not changed"
    return 1
  fi
  REPLACE_TMP="$tmp"   # for writer_guard's EXIT path; gone after the mv or an rm below
  # shellcheck disable=SC2094  # chmod narrows the file the redirection already opened; nothing reads it
  if ! { chmod "$(printf '%o' $(( 8#$mode & 8#600 )))" "$tmp" 2>/dev/null && "$@"; } > "$tmp"; then
    rm -f -- "$tmp" 2>/dev/null
    REPLACE_ERR="cannot write the new content of ${file#"$ROOT_DIR/"}; it was not changed"
    return 1
  fi
  cur="$(stat -c '%u:%g' "$tmp" 2>/dev/null || stat -f '%u:%g' "$tmp" 2>/dev/null || true)"
  if [[ "$cur" != "$owner" ]] && ! chown "$owner" "$tmp" 2>/dev/null; then
    rm -f -- "$tmp" 2>/dev/null
    REPLACE_ERR="${file#"$ROOT_DIR/"} belongs to $owner, which this user cannot keep on a rewritten file; it was not changed"
    return 1
  fi
  if ! chmod "$mode" "$tmp" 2>/dev/null || ! mv -f -- "$tmp" "$file" 2>/dev/null; then
    rm -f -- "$tmp" 2>/dev/null
    REPLACE_ERR="cannot replace ${file#"$ROOT_DIR/"}; it was not changed"
    return 1
  fi
  return 0
}

# env_value_has_control <text> — true when <text> holds a control character
# (C0 incl. CR, LF, ESC and TAB, DEL, or C1): no .env value may carry one. A
# line break in a value is a new .env line — a pasted "a\nOWNER_NPUB=…" used to
# add a line Compose reads — and ESC reaches the terminal of whoever shows it.
env_value_has_control() {
  [[ "$1" == *[[:cntrl:]]* ]]
}

# env_key_stats <file> <key> — _ENV_LINES (records in <file>), _ENV_KEY_LINES
# (lines that set <key>) and _ENV_LAST (the raw text after "<key>=" on the last
# of them, the line Compose uses), compared literally: the key is no pattern.
env_key_stats() {
  local out
  # shellcheck disable=SC2016  # an awk program: $0 belongs to awk, not to the shell
  out="$(HAVEN_K="$2" awk '
    BEGIN { key = ENVIRON["HAVEN_K"]; klen = length(key) }
    {
      t = $0
      if (substr(t, 1, klen + 1) != key "=") { if (!sub(/^[ \t]*export[ \t]+/, "", t) || substr(t, 1, klen + 1) != key "=") next }
      n++; last = substr(t, klen + 2)
    }
    END { printf "%d\t%d\t%s", NR, n, last }
  ' "$1" 2>/dev/null)" || return 1
  IFS=$'\t' read -r _ENV_LINES _ENV_KEY_LINES _ENV_LAST <<<"$out" || true
}

# env_write_check <file> <snapshot> <want lines> <want key lines> <key> [<value>]
# — after a write: <file> must have <want lines> records and <want key lines>
# lines for <key> (and, with <value>, <value> on the last of them, byte for
# byte); otherwise <snapshot> (the file before the write) is put back and the
# check fails with REPLACE_ERR set. A value that slipped a line break past the
# checks, or a writer that went wrong, never stays in .env.
env_write_check() {
  local file="$1" snap="$2" want="$3" want_k="$4" key="$5"
  if env_key_stats "$file" "$key" && [[ "$_ENV_LINES" == "$want" && "$_ENV_KEY_LINES" == "$want_k" ]] \
    && { (( $# < 6 )) || [[ "$_ENV_LAST" == "$6" ]]; }; then
    return 0
  fi
  if cat -- "$snap" > "$file" 2>/dev/null; then
    REPLACE_ERR="${file#"$ROOT_DIR/"} came out different from what was written for $key ($want lines expected, ${_ENV_LINES:-?} found, ${_ENV_KEY_LINES:-?} for $key); the file before the write was put back"
  else
    REPLACE_ERR="${file#"$ROOT_DIR/"} came out different from what was written for $key, and the file before the write could not be put back: restore it from ${file##*/}.bak.<time>"
  fi
  return 1
}

# writer_guard_on / writer_guard_off — around a rewrite of .env (set_env_var,
# remove_env_var): INT, TERM and HUP that arrive meanwhile are held until the
# write has finished or failed on its own paths — every one of which removes
# the snapshot (.env.pre.*) and the temporary file (.env.tmp.*) — and are then
# raised again against the trap that was there before (or the default). An
# exit meanwhile (errexit) removes both first and then runs the previous EXIT
# trap. Measured on 4c29cf3: 10 of 60 SIGTERMs left a .env.pre.* behind, a full
# copy of .env.
WG_SAVED_EXIT=""
WG_SAVED_INT=""
WG_SAVED_TERM=""
WG_SAVED_HUP=""
WG_SIG=""
WG_SNAP=""
writer_guard_on() {
  local exit_action=""
  WG_SAVED_EXIT="$(trap -p EXIT)"
  WG_SAVED_INT="$(trap -p INT)"
  WG_SAVED_TERM="$(trap -p TERM)"
  WG_SAVED_HUP="$(trap -p HUP)"
  WG_SIG="" WG_SNAP="" REPLACE_TMP=""
  trap_action_of "$WG_SAVED_EXIT"
  exit_action="$_TRAP_ACTION"
  # shellcheck disable=SC2064  # the previous EXIT action is meant to be expanded now
  trap "writer_guard_clean; $exit_action" EXIT
  trap 'WG_SIG=INT' INT
  trap 'WG_SIG=TERM' TERM
  trap 'WG_SIG=HUP' HUP
}

# trap_action_of <`trap -p` line of one signal> — _TRAP_ACTION: its action
# (the line is shell-quoted for reuse: `trap -- '<action>' <SIG>`); empty
# when there is no trap
trap_action_of() {
  _TRAP_ACTION=""
  [[ -n "$1" ]] || return 0
  eval "set -- $1"
  _TRAP_ACTION="$3"
}

writer_guard_clean() {
  [[ -z "$WG_SNAP" ]] || rm -f -- "$WG_SNAP" 2>/dev/null || true
  [[ -z "$REPLACE_TMP" ]] || rm -f -- "$REPLACE_TMP" 2>/dev/null || true
  WG_SNAP="" REPLACE_TMP=""
}

writer_guard_off() {
  local sig saved
  writer_guard_clean
  # each signal goes straight from the guard's handler to the trap saved for
  # it, never through the default action: a TERM between a `trap -` and the
  # restore killed the process there (db-switch step 5: no rollback). Only a
  # signal without a saved trap goes back to the default.
  for sig in EXIT INT TERM HUP; do
    case "$sig" in
      EXIT) saved="$WG_SAVED_EXIT" ;;
      INT) saved="$WG_SAVED_INT" ;;
      TERM) saved="$WG_SAVED_TERM" ;;
      *) saved="$WG_SAVED_HUP" ;;
    esac
    if [[ -n "$saved" ]]; then
      eval "$saved"
    else
      trap - "$sig"
    fi
  done
  # read only now: a signal held until here is in WG_SIG, a later one already
  # met the trap put back above
  sig="$WG_SIG"
  WG_SAVED_EXIT="" WG_SAVED_INT="" WG_SAVED_TERM="" WG_SAVED_HUP="" WG_SIG=""
  [[ -z "$sig" ]] || kill -s "$sig" "$BASHPID" 2>/dev/null || true
}

# set_env_var <key> <value> — <key>=<value> into .env, the value byte for byte
# (awk reads key and value from its environment, which processes no escapes: a
# typed "\n" stays a backslash and an n). A key that is in .env more than once
# gets the new value on its LAST line, the one Compose uses; the earlier ones
# stay as they are. A value with a control character is refused, and after the
# write the file must have the same lines as before (one more for a new key),
# or it is put back (env_write_check). Signals wait for the end of the write
# (writer_guard_on).
set_env_var() {
  local rc=0
  writer_guard_on
  set_env_var_write "$@" || rc=$?
  writer_guard_off
  return "$rc"
}

set_env_var_write() {
  local key="$1"
  local value="$2"
  local env_file="$ROOT_DIR/.env"
  local snap lines keys rc=0

  if [[ ! "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
    warn_plain "Not written: $(printable_text "$key") is not a valid key name."
    return 1
  fi
  if env_value_has_control "$value"; then
    warn "Not written: the value for $key contains a control character (a line break, tab or escape)."
    return 1
  fi

  if [[ ! -f "$env_file" ]]; then
    touch "$env_file"
  else
    backup_config_file "$env_file"
  fi
  if ! env_key_stats "$env_file" "$key"; then
    warn "cannot read ${env_file#"$ROOT_DIR/"}; it was not changed"
    return 1
  fi
  lines="$_ENV_LINES" keys="$_ENV_KEY_LINES"
  if ! snap="$(umask 077 && mktemp "$env_file.pre.XXXXXX" 2>/dev/null)" || ! { WG_SNAP="$snap"; cat -- "$env_file" > "$snap"; }; then
    [[ -z "${snap:-}" ]] || rm -f -- "$snap"
    warn "cannot create a temporary file next to ${env_file#"$ROOT_DIR/"}; it was not changed"
    return 1
  fi

  # shellcheck disable=SC2016  # an awk program: $0 belongs to awk, not to the shell
  if ! replace_file_from "$env_file" env HAVEN_K="$key" HAVEN_V="$value" awk '
    function match_kind(line,    t) {
      if (substr(line, 1, klen + 1) == key "=") return 1
      t = line
      if (sub(/^[ \t]*export[ \t]+/, "", t) && substr(t, 1, klen + 1) == key "=") return 2
      return 0
    }
    BEGIN { key = ENVIRON["HAVEN_K"]; value = ENVIRON["HAVEN_V"]; klen = length(key) }
    NR == FNR { if (match_kind($0)) last = FNR; next }
    FNR == last {
      if (match_kind($0) == 2) print "export " key "=" value
      else print key "=" value
      next
    }
    { print }
    END { if (!last) print key "=" value }
  ' "$env_file" "$env_file"; then
    rm -f -- "$snap"
    warn "$REPLACE_ERR"
    return 1
  fi
  if (( keys == 0 )); then
    env_write_check "$env_file" "$snap" $((lines + 1)) 1 "$key" "$value" || rc=1
  else
    env_write_check "$env_file" "$snap" "$lines" "$keys" "$key" "$value" || rc=1
  fi
  rm -f -- "$snap"
  if (( rc )); then
    warn "$REPLACE_ERR"
    return 1
  fi
}

# run_capture <command...> — RUN_OUTPUT (stdout and stderr) and RUN_STATUS of
# the command, run in a subshell. errexit is off in there (a command
# substitution under `set +e`): a function run this way has to return its
# failures itself. TUI_ACTIVE=0 in the subshell: a die in a captured action
# ends only the subshell and leaves the running TUI's terminal alone (no
# tui_cleanup: no stty reset, no rmcup, bracketed paste stays on); the caller
# shows the output, the error included. The parent's EXIT/INT/TERM/HUP traps
# are cleared first: `trap -p` in a subshell lists them although they are not
# in force, and a writer guard (set_env_var) that put that list back armed the
# TUI's EXIT action in here — the subshell's exit reset the live terminal. An
# ignored signal stays ignored: that disposition is inherited for real.
run_capture_child() {
  local sig
  TUI_ACTIVE=0
  for sig in EXIT INT TERM HUP; do
    [[ "$(trap -p "$sig")" == "trap -- '' "* ]] || trap - "$sig"
  done
  "$@"
}

run_capture() {
  RUN_OUTPUT=""
  RUN_STATUS=0
  set +e
  RUN_OUTPUT="$(run_capture_child "$@" 2>&1)"
  RUN_STATUS=$?
  set -e
}

is_quoted() {
  local raw="$1"
  [[ ${#raw} -ge 2 ]] || return 1
  local first="${raw:0:1}"
  local last="${raw: -1}"
  [[ ( "$first" == "\"" && "$last" == "\"" ) || ( "$first" == "'" && "$last" == "'" ) ]]
}

strip_quotes() {
  local raw="$1"
  if is_quoted "$raw"; then
    printf "%s" "${raw:1:${#raw}-2}"
  else
    printf "%s" "$raw"
  fi
}

wrap_like_raw() {
  local raw="$1"
  local value="$2"
  if is_quoted "$raw"; then
    local quote="${raw:0:1}"
    printf "%s%s%s" "$quote" "$value" "$quote"
  else
    printf "%s" "$value"
  fi
}

value_has_unquoted_spaces() {
  local raw="$1"
  if is_quoted "$raw"; then
    return 1
  fi
  [[ "$raw" =~ [[:space:]] ]]
}

is_int() {
  [[ "$1" =~ ^[0-9]+$ ]]
}

is_port() {
  local value="$1"
  is_int "$value" || return 1
  [[ "$value" -ge 1 && "$value" -le 65535 ]]
}

is_bool() {
  local value="${1,,}"
  [[ "$value" == "true" || "$value" == "false" ]]
}

is_mixed_case() {
  [[ "$1" =~ [a-z] ]] && [[ "$1" =~ [A-Z] ]]
}

is_npub() {
  local value="${1,,}"
  [[ "$value" =~ ^npub1[023456789acdefghjklmnpqrstuvwxyz]+$ ]]
}

is_relay_address() {
  local value="$1"
  [[ -n "$value" ]] || return 1
  [[ "$value" =~ [[:space:]] ]] && return 1
  [[ "$value" =~ ^([a-zA-Z][a-zA-Z0-9+.-]*://)?(\\[[0-9a-fA-F:]+\\]|[A-Za-z0-9.-]+)(:[0-9]{1,5})?(/.*)?$ ]]
}

is_http_url() {
  local value="$1"
  [[ "$value" =~ ^https?://.+$ ]]
}

is_date() {
  [[ "$1" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]
}

# is_duration <value> — true for what upstream's getEnvDuration accepts and
# time.NewTicker can run: Go's time.ParseDuration syntax in whole hours,
# minutes and seconds ("24h", "90m", "1h30m"), greater than zero. Go has no
# day unit: "1d" makes ParseDuration fail and Haven panic at start (v1.2.2
# config.go getEnvDuration; pkg/wot PeriodicRefresh -> time.NewTicker).
is_duration() {
  [[ "$1" =~ ^([0-9]+[hms])+$ ]] || return 1
  [[ "$1" =~ [1-9] ]]
}

# is_log_level <value> — the levels upstream's getLogLevelFromConfig knows
# (v1.2.2 main.go: DEBUG, INFO, WARN, ERROR; anything else logs at INFO). The
# editor upper-cases what is typed: upstream compares case-sensitively.
is_log_level() {
  case "${1^^}" in
    DEBUG|INFO|WARN|ERROR) return 0 ;;
    *) return 1 ;;
  esac
}

is_backup_provider() {
  case "${1,,}" in
    ""|none|s3) return 0 ;;
    *) return 1 ;;
  esac
}

is_ipv4() {
  local value="$1"
  [[ "$value" =~ ^([0-9]{1,3}\\.){3}[0-9]{1,3}$ ]] || return 1
  local o1 o2 o3 o4
  IFS=. read -r o1 o2 o3 o4 <<<"$value"
  for octet in "$o1" "$o2" "$o3" "$o4"; do
    [[ "$octet" -ge 0 && "$octet" -le 255 ]] || return 1
  done
}

is_ipv6() {
  local value="$1"
  [[ "$value" =~ : ]] || return 1
  [[ "$value" =~ ^[0-9a-fA-F:]+$ ]]
}

ensure_json_file_value() {
  local raw="$1"
  local allow_empty="$2"
  local value="$3"

  if [[ -z "$value" ]]; then
    [[ "$allow_empty" == "1" ]] && return 0
    VALIDATION_ERROR="Value cannot be empty."
    return 1
  fi

  if [[ "$value" != *.json ]]; then
    VALIDATION_ERROR="File must end with .json"
    return 1
  fi

  local path="$ROOT_DIR/$value"
  if [[ -f "$path" ]]; then
    return 0
  fi

  if [[ -t 0 && -t 1 ]]; then
    if ask_yes_no "File $value not found. Create empty file now? [y/N] " "n"; then
      printf "[]\n" > "$path"
      success "Created $value"
      return 0
    fi
  fi

  VALIDATION_ERROR="File not found: $value"
  return 1
}

# env_value_quotes_ok <raw> — false for a value that starts with a quote but is
# not one quoted string to its end. Compose 5.x reads a quoted value, double or
# single, up to the first quote of its kind that follows an even number of
# backslashes (\" and \' are escaped quotes, \\ is a pair); it refuses the
# whole file when the closing quote is missing ('My relay\' is unterminated)
# and drops what follows it ("a"b reads as a). Measured with `docker compose
# config` on 45 values, tests/haven-security.bats ("D2").
env_value_quotes_ok() {
  local v="$1" q inner
  case "${v:0:1}" in
    \"|\') q="${v:0:1}" ;;
    *) return 0 ;;
  esac
  (( ${#v} >= 2 )) && [[ "${v: -1}" == "$q" ]] || return 1
  inner="${v:1:${#v}-2}"
  # escape pairs first (\\, then \" or \'), then no bare quote of the kind may
  # be left and no backslash that would escape the closing quote
  inner="${inner//\\\\/}"
  inner="${inner//"\\$q"/}"
  [[ "$inner" != *"$q"* && "$inner" != *\\ ]]
}

validate_env_value() {
  local key="$1"
  local raw="$2"
  local value=""
  local provider=""

  VALIDATION_ERROR=""
  VALIDATION_VALUE="$raw"

  if [[ -n "$raw" ]]; then
    value="$(strip_quotes "$raw")"
  fi

  # every key: a value is one .env line, and its quotes are Compose's
  if env_value_has_control "$raw"; then
    VALIDATION_ERROR="No line breaks, tabs or other control characters in a value."
    return 1
  fi
  if ! env_value_quotes_ok "$raw"; then
    VALIDATION_ERROR="A value that starts with a quote must end with the same quote and hold no other one of its kind, unless escaped: write \\\" inside double quotes, \\' inside single quotes; a single backslash right before the closing quote escapes it."
    return 1
  fi

  if value_has_unquoted_spaces "$raw"; then
    VALIDATION_ERROR="Values with spaces must be quoted."
    return 1
  fi

  case "$key" in
    *_NPUB)
      if [[ -z "$value" ]]; then
        VALIDATION_ERROR="NPUB cannot be empty."
        return 1
      fi
      if is_mixed_case "$value"; then
        VALIDATION_ERROR="NPUB must be all lowercase or all uppercase."
        return 1
      fi
      if ! is_npub "$value"; then
        VALIDATION_ERROR="Invalid npub format."
        return 1
      fi
      VALIDATION_VALUE="$(wrap_like_raw "$raw" "${value,,}")"
      ;;
    RELAY_URL)
      if ! is_relay_address "$value"; then
        VALIDATION_ERROR="Invalid relay host or URL."
        return 1
      fi
      ;;
    RELAY_PORT)
      if ! is_port "$value"; then
        VALIDATION_ERROR="Port must be 1-65535."
        return 1
      fi
      VALIDATION_VALUE="$value"
      ;;
    RELAY_BIND_ADDRESS)
      if [[ -z "$value" ]]; then
        VALIDATION_VALUE="$raw"
        return 0
      fi
      if ! is_ipv4 "$value" && ! is_ipv6 "$value"; then
        VALIDATION_ERROR="Bind address must be IPv4, IPv6, or empty."
        return 1
      fi
      ;;
    DB_ENGINE)
      case "${value,,}" in
        badger|lmdb) VALIDATION_VALUE="$(wrap_like_raw "$raw" "${value,,}")" ;;
        *) VALIDATION_ERROR="DB_ENGINE must be badger or lmdb."; return 1 ;;
      esac
      # Measured (plan P1): a flip alone serves 0 events without any warning and
      # the relay keeps writing to a new, empty database next to the old one.
      # The data moves only with db-switch, so the editor refuses the flip.
      if ! engine_change_allowed "${value,,}"; then
        VALIDATION_ERROR="$ENGINE_CHANGE_ERR"
        return 1
      fi
      ;;
    LMDB_MAPSIZE)
      if ! is_int "$value"; then
        VALIDATION_ERROR="LMDB_MAPSIZE must be a number >= 0."
        return 1
      fi
      VALIDATION_VALUE="$value"
      ;;
    BLOSSOM_PATH)
      if [[ -z "$value" ]]; then
        VALIDATION_ERROR="BLOSSOM_PATH cannot be empty."
        return 1
      fi
      ;;
    *_ICON)
      if [[ -n "$value" ]] && ! is_http_url "$value"; then
        VALIDATION_ERROR="Icon must be a http(s) URL or empty."
        return 1
      fi
      ;;
    *_ALLOW_EMPTY_FILTERS|*_ALLOW_COMPLEX_FILTERS)
      if ! is_bool "$value"; then
        VALIDATION_ERROR="Value must be true or false."
        return 1
      fi
      VALIDATION_VALUE="${value,,}"
      ;;
    WOT_REFRESH_INTERVAL)
      if [[ "$value" =~ ^[0-9]+d$ ]]; then
        VALIDATION_ERROR="Haven has no day unit: use hours (${value%d}d = $(( 10#${value%d} * 24 ))h). Units: h, m, s."
        return 1
      fi
      if ! is_duration "$value"; then
        VALIDATION_ERROR="A duration above zero in h, m and s, e.g. 24h, 90m or 1h30m."
        return 1
      fi
      ;;
    BACKUP_INTERVAL_HOURS)
      if ! is_int "$value"; then
        VALIDATION_ERROR="BACKUP_INTERVAL_HOURS must be a number >= 0."
        return 1
      fi
      VALIDATION_VALUE="$value"
      ;;
    *_TOKENS_PER_INTERVAL|*_INTERVAL|*_MAX_TOKENS|*_INTERVAL_SECONDS|*_TIMEOUT_SECONDS|*_DEPTH|*_MINIMUM_FOLLOWERS)
      if ! is_int "$value"; then
        VALIDATION_ERROR="Value must be a number >= 0."
        return 1
      fi
      VALIDATION_VALUE="$value"
      ;;
    IMPORT_START_DATE)
      if ! is_date "$value"; then
        VALIDATION_ERROR="Date must be YYYY-MM-DD."
        return 1
      fi
      ;;
    IMPORT_SEED_RELAYS_FILE)
      ensure_json_file_value "$raw" 0 "$value" || return 1
      ;;
    BLASTR_RELAYS_FILE)
      ensure_json_file_value "$raw" 0 "$value" || return 1
      ;;
    WHITELISTED_NPUBS_FILE|BLACKLISTED_NPUBS_FILE)
      ensure_json_file_value "$raw" 1 "$value" || return 1
      ;;
    BACKUP_PROVIDER)
      if ! is_backup_provider "$value"; then
        VALIDATION_ERROR="BACKUP_PROVIDER must be s3, none, or empty."
        return 1
      fi
      VALIDATION_VALUE="$(wrap_like_raw "$raw" "${value,,}")"
      ;;
    S3_ACCESS_KEY_ID|S3_SECRET_KEY|S3_ENDPOINT|S3_REGION|S3_BUCKET_NAME)
      provider="$(read_env_var BACKUP_PROVIDER 2>/dev/null || true)"
      provider="$(strip_quotes "$provider")"
      provider="${provider,,}"
      if [[ "$provider" == "s3" && -z "$value" ]]; then
        VALIDATION_ERROR="$key is required when BACKUP_PROVIDER=s3."
        return 1
      fi
      if [[ "$key" == "S3_ENDPOINT" && -n "$value" ]]; then
        if ! is_relay_address "$value"; then
          VALIDATION_ERROR="S3_ENDPOINT must be a host or URL."
          return 1
        fi
      fi
      if [[ "$key" == "S3_BUCKET_NAME" && -n "$value" ]]; then
        if [[ ! "$value" =~ ^[a-z0-9.-]{3,63}$ ]]; then
          VALIDATION_ERROR="S3_BUCKET_NAME must be 3-63 chars (lowercase, numbers, dot, dash)."
          return 1
        fi
      fi
      ;;
    HAVEN_LOG_LEVEL)
      if [[ "${value^^}" == WARNING ]]; then
        VALIDATION_ERROR="Haven reads WARN, not WARNING (WARNING logs at INFO). Type WARN."
        return 1
      fi
      if ! is_log_level "$value"; then
        VALIDATION_ERROR="HAVEN_LOG_LEVEL must be DEBUG, INFO, WARN or ERROR."
        return 1
      fi
      VALIDATION_VALUE="$(wrap_like_raw "$raw" "${value^^}")"
      ;;
    *)
      ;;
  esac

  return 0
}

# env_rule_text <key> — _RULE: what validate_env_value checks for <key>, in
# words, for the settings editor's details pane; empty when it checks nothing
# beyond the quoting every value needs. Keep in step with validate_env_value.
env_rule_text() {
  case "$1" in
    *_NPUB) _RULE="An npub (npub1…), all lower or all upper case." ;;
    RELAY_URL) _RULE="A host name or URL without spaces." ;;
    RELAY_PORT) _RULE="A port number, 1 to 65535." ;;
    RELAY_BIND_ADDRESS) _RULE="An IPv4 or IPv6 address, or empty." ;;
    DB_ENGINE) _RULE="badger or lmdb, and only the engine of the data in db/ (to move the data: ./$SCRIPT_NAME db-switch)." ;;
    LMDB_MAPSIZE) _RULE="A whole number, 0 or more." ;;
    BLOSSOM_PATH) _RULE="Not empty." ;;
    *_ICON) _RULE="An http:// or https:// URL, or empty." ;;
    *_ALLOW_EMPTY_FILTERS|*_ALLOW_COMPLEX_FILTERS) _RULE="true or false." ;;
    WOT_REFRESH_INTERVAL) _RULE="A duration above zero in hours, minutes and seconds (h, m, s), e.g. 24h, 90m or 1h30m. No days: 1d is 24h." ;;
    BACKUP_INTERVAL_HOURS) _RULE="A whole number, 0 or more." ;;
    *_TOKENS_PER_INTERVAL|*_INTERVAL|*_MAX_TOKENS|*_INTERVAL_SECONDS|*_TIMEOUT_SECONDS|*_DEPTH|*_MINIMUM_FOLLOWERS)
      _RULE="A whole number, 0 or more." ;;
    IMPORT_START_DATE) _RULE="A date as YYYY-MM-DD." ;;
    IMPORT_SEED_RELAYS_FILE|BLASTR_RELAYS_FILE) _RULE="A .json file name; the file must exist." ;;
    WHITELISTED_NPUBS_FILE|BLACKLISTED_NPUBS_FILE) _RULE="A .json file name that exists, or empty." ;;
    BACKUP_PROVIDER) _RULE="s3, none or empty." ;;
    S3_ACCESS_KEY_ID|S3_SECRET_KEY|S3_REGION) _RULE="Not empty when BACKUP_PROVIDER is s3." ;;
    S3_ENDPOINT) _RULE="A host or URL; not empty when BACKUP_PROVIDER is s3." ;;
    S3_BUCKET_NAME) _RULE="3 to 63 characters: lower-case letters, digits, dot, dash; not empty when BACKUP_PROVIDER is s3." ;;
    HAVEN_LOG_LEVEL) _RULE="DEBUG, INFO, WARN or ERROR." ;;
    *) _RULE="" ;;
  esac
}

# env_stored_value_note <key> <raw value> — _STORED_NOTE: for a value already
# in .env that upstream does not read the way it looks, what Haven does with
# it (the details pane shows it under Current); empty otherwise. Only for the
# two settings whose rule changed with upstream v1.2.2 (log level, duration).
env_stored_value_note() {
  local v
  _STORED_NOTE=""
  v="$(strip_quotes "$2")"
  [[ -n "$v" ]] || return 0
  case "$1" in
    HAVEN_LOG_LEVEL)
      case "$v" in
        DEBUG|INFO|WARN|ERROR) ;;
        WARNING) _STORED_NOTE="Haven does not know WARNING and logs at INFO; WARN is its warnings level." ;;
        *) _STORED_NOTE="Haven does not know $v and logs at INFO; it reads DEBUG, INFO, WARN or ERROR in capitals." ;;
      esac
      ;;
    WOT_REFRESH_INTERVAL)
      # Go's syntax in full (decimals, ms/us/ns): only what ParseDuration
      # refuses, or a zero NewTicker refuses, stops Haven
      if [[ ! "$v" =~ ^(([0-9]+(\.[0-9]*)?|\.[0-9]+)(ns|us|ms|s|m|h))+$ ]]; then
        _STORED_NOTE="Haven cannot read $v as a duration and stops at start; use h, m or s, e.g. 24h."
      elif [[ ! "$v" =~ [1-9] ]]; then
        _STORED_NOTE="Haven stops at start with an interval of zero."
      fi
      ;;
  esac
}

# env_dollar_note <raw value> — _DOLLAR_NOTE: one sentence when the value holds
# a $ outside single quotes, empty otherwise. Compose expands $NAME and ${NAME}
# in an unquoted or double-quoted .env value (measured: a relay name holding
# ${S3_SECRET_KEY:-d} became the secret, published as relay metadata; ${X:?e}
# makes Compose refuse the file) and keeps a single-quoted one literal. A
# warning only: legitimate values contain $.
env_dollar_note() {
  _DOLLAR_NOTE=""
  [[ "$1" == *'$'* && "${1:0:1}" != "'" ]] || return 0
  _DOLLAR_NOTE="Docker Compose expands \$NAME and \${NAME} in this value (unquoted or in double quotes); put the value in single quotes to keep it literal."
}

ask_yes_no() {
  local prompt="$1"
  local default_answer="$2"
  local reply=""

  if [[ "$TUI_ACTIVE" == "1" && -t 1 ]]; then
    if tui_confirm "$prompt" "$default_answer"; then
      return 0
    fi
    return 1
  fi

  while true; do
    read -r -p "$prompt" reply
    if [[ -z "$reply" ]]; then
      reply="$default_answer"
    fi
    case "$reply" in
      y|Y|yes|YES) return 0 ;;
      n|N|no|NO) return 1 ;;
      *) printf "Please answer y or n.\n" ;;
    esac
  done
}

ensure_example_jsons() {
  local example
  for example in "$ROOT_DIR"/*.example.json; do
    [[ -e "$example" ]] || continue
    local target="${example/.example.json/.json}"
    if [[ ! -f "$target" ]]; then
      local example_name
      local target_name
      example_name="$(basename "$example")"
      target_name="$(basename "$target")"
      # A previous bare `docker compose up` creates missing bind-mount sources as
      # root-owned directories. Copying into one would silently nest the example.
      if [[ -d "$target" ]]; then
        die "$target_name is a directory (created by Docker because the file was missing). Remove it and start again: sudo rm -rf $target"
      fi
      if [[ -t 0 && -t 1 ]]; then
        if ask_yes_no "Missing $target_name. Copy from $example_name now? [Y/n] " "y"; then
          cp "$example" "$target"
          success "Created $target_name"
        else
          warn "Skipped $target_name. You can copy it later."
        fi
      else
        warn "Missing $target_name. Run: cp $example_name $target_name"
      fi
    fi
  done
}

detect_json_tool() {
  if command -v jq >/dev/null 2>&1; then
    JSON_TOOL="jq"
    return 0
  fi
  if command -v python3 >/dev/null 2>&1; then
    JSON_TOOL="python"
    return 0
  fi
  warn "Missing dependency: jq or python3 (needed for JSON editor)."
  return 1
}

ensure_env_file() {
  local env_file="$ROOT_DIR/.env"
  if [[ -f "$env_file" ]]; then
    return 0
  fi

  if [[ -t 0 && -t 1 ]]; then
    if ask_yes_no ".env not found. Create empty .env now? [Y/n] " "y"; then
      touch "$env_file"
      success "Created .env"
      return 0
    fi
    warn ".env missing."
    return 1
  fi

  warn ".env missing. Create one before editing."
  return 1
}

list_env_keys() {
  local env_file="$ROOT_DIR/.env"
  [[ -f "$env_file" ]] || return 0
  awk '
    /^[ \t]*#/ {next}
    /^[ \t]*$/ {next}
    /^[ \t]*export[ \t]+[A-Za-z_][A-Za-z0-9_]*=/ {
      line=$0
      sub(/^[ \t]*export[ \t]+/, "", line)
      split(line, a, "=")
      key=a[1]
      if (!(key in seen)) { print key; seen[key]=1 }
      next
    }
    /^[A-Za-z_][A-Za-z0-9_]*=/ {
      split($0, a, "=")
      key=a[1]
      if (!(key in seen)) { print key; seen[key]=1 }
    }
  ' "$env_file"
}

# remove_env_var <key> — every line that sets <key> leaves .env, checked like
# set_env_var's write and with the same signal guard.
remove_env_var() {
  local rc=0
  writer_guard_on
  remove_env_var_write "$@" || rc=$?
  writer_guard_off
  return "$rc"
}

remove_env_var_write() {
  local key="$1"
  local env_file="$ROOT_DIR/.env"
  local snap lines keys rc=0
  [[ -f "$env_file" ]] || return 1
  backup_config_file "$env_file"
  if ! env_key_stats "$env_file" "$key"; then
    warn "cannot read ${env_file#"$ROOT_DIR/"}; it was not changed"
    return 1
  fi
  lines="$_ENV_LINES" keys="$_ENV_KEY_LINES"
  if ! snap="$(umask 077 && mktemp "$env_file.pre.XXXXXX" 2>/dev/null)" || ! { WG_SNAP="$snap"; cat -- "$env_file" > "$snap"; }; then
    [[ -z "${snap:-}" ]] || rm -f -- "$snap"
    warn "cannot create a temporary file next to ${env_file#"$ROOT_DIR/"}; it was not changed"
    return 1
  fi
  # every line of the key goes (the key is compared literally, from awk's
  # environment: no escape processing, no pattern)
  # shellcheck disable=SC2016  # an awk program: $0 belongs to awk, not to the shell
  if ! replace_file_from "$env_file" env HAVEN_K="$key" awk '
    BEGIN { key = ENVIRON["HAVEN_K"]; klen = length(key) }
    {
      t = $0
      if (substr(t, 1, klen + 1) == key "=") next
      if (sub(/^[ \t]*export[ \t]+/, "", t) && substr(t, 1, klen + 1) == key "=") next
      print
    }
  ' "$env_file"; then
    rm -f -- "$snap"
    warn "$REPLACE_ERR"
    return 1
  fi
  env_write_check "$env_file" "$snap" $((lines - keys)) 0 "$key" || rc=1
  rm -f -- "$snap"
  if (( rc )); then
    warn "$REPLACE_ERR"
    return 1
  fi
}

list_missing_env_vars() {
  local env_file="$ROOT_DIR/.env"
  local example_file="$ROOT_DIR/.env.example"
  [[ -f "$env_file" && -f "$example_file" ]] || return 0
  awk '
    function extract_key(line,    tmp, ep, kp) {
      tmp = line
      sub(/^[ \t]*/, "", tmp)
      sub(/^export[ \t]+/, "", tmp)
      ep = index(tmp, "=")
      if (ep == 0) return ""
      kp = substr(tmp, 1, ep - 1)
      if (kp ~ /^[A-Za-z_][A-Za-z0-9_]*$/) return kp
      return ""
    }
    NR == FNR {
      key = extract_key($0)
      if (key != "") existing[key] = 1
      next
    }
    {
      key = extract_key($0)
      if (key != "" && !(key in existing)) print key
    }
  ' "$env_file" "$example_file"
}

env_keys_from_file() {
  # Reads the given file, or stdin when called without one.
  awk '
    {
      line = $0
      sub(/^[ \t]*/, "", line)
      sub(/^export[ \t]+/, "", line)
      ep = index(line, "=")
      if (ep == 0) next
      key = substr(line, 1, ep - 1)
      if (key ~ /^[A-Za-z_][A-Za-z0-9_]*$/) print key
    }
  ' "$@" | LC_ALL=C sort -u
}

# Our .env.example is a hand-maintained copy of upstream's plus the Docker-only
# variables, and it drifted once without anyone noticing (#11): Haven falls back
# to a built-in default for an undefined variable, so nothing fails — the setting
# is just invisible, in the docs and in the env editor, which lists what is in
# .env. The image carries upstream's own file, so diff against that: no network,
# and pinned to the exact version that was built.
report_upstream_env_drift() {
  local compose_file="$1"
  local upstream_keys our_keys env_keys undocumented unset_here

  [[ -f "$ROOT_DIR/.env" ]] || return 0

  upstream_keys="$(dc "$compose_file" run --rm --no-deps -T --entrypoint cat \
    relay /app/.env.example.upstream 2>/dev/null | env_keys_from_file || true)"
  # Images built before this file was added do not carry it, and a diagnostic
  # must never fail a start: no file, no check.
  [[ -n "$upstream_keys" ]] || return 0

  our_keys="$(env_keys_from_file "$ROOT_DIR/.env.example" 2>/dev/null || true)"
  env_keys="$(env_keys_from_file "$ROOT_DIR/.env")"

  undocumented="$(LC_ALL=C comm -23 <(printf '%s\n' "$upstream_keys") \
    <(printf '%s\n' "$our_keys") | paste -sd ' ' -)"
  unset_here="$(LC_ALL=C comm -12 <(printf '%s\n' "$upstream_keys") \
    <(printf '%s\n' "$our_keys") \
    | LC_ALL=C comm -23 - <(printf '%s\n' "$env_keys") | paste -sd ' ' -)"

  if [[ -n "$unset_here" ]]; then
    warn "Not set in your .env: $unset_here — Haven uses its built-in defaults. Add them with: ./haven env-upgrade"
  fi
  if [[ -n "$undocumented" ]]; then
    warn "The packaged Haven supports variables this repo does not document: $undocumented"
    warn "Set them in .env by hand, and please report the gap: https://github.com/HolgerHatGarKeineNode/haven-docker/issues"
  fi
  return 0
}

UPGRADE_ENV_NOTE=""
upgrade_env_file() {
  local env_file="$ROOT_DIR/.env"
  local example_file="$ROOT_DIR/.env.example"

  [[ -f "$example_file" ]] || return 1

  if [[ ! -f "$env_file" ]]; then
    cp "$example_file" "$env_file"
    return 0
  fi

  # A missing DB_ENGINE line means lmdb to the relay (upstream), while the
  # example suggests badger: with data of one engine in db/ the added line
  # names that engine, or the start gate would refuse the relay afterwards.
  local engine=""
  UPGRADE_ENV_NOTE=""
  if [[ -z "$(env_key_lines DB_ENGINE)" ]] && grep -qE '^[[:blank:]]*(export[[:blank:]]+)?DB_ENGINE=' "$example_file"; then
    db_disk_engine
    case "$DISK_ENGINE" in
      badger|lmdb)
        engine="$DISK_ENGINE"
        UPGRADE_ENV_NOTE="DB_ENGINE added as $engine: db/ holds $engine data ($DISK_DATA)."
        ;;
    esac
  fi

  backup_config_file "$env_file"

  # shellcheck disable=SC2016  # an awk program: $0 belongs to awk, not to the shell
  if ! replace_file_from "$env_file" env UPG_ENGINE="$engine" awk '
    function extract_key(line,    tmp, ep, kp) {
      tmp = line
      sub(/^[ \t]*/, "", tmp)
      sub(/^export[ \t]+/, "", tmp)
      ep = index(tmp, "=")
      if (ep == 0) return ""
      kp = substr(tmp, 1, ep - 1)
      if (kp ~ /^[A-Za-z_][A-Za-z0-9_]*$/) return kp
      return ""
    }

    NR == FNR {
      key = extract_key($0)
      if (key != "") existing[key] = 1
      env_lines[++env_count] = $0
      next
    }

    {
      key = extract_key($0)
      if (key != "") {
        if (key in existing) {
          last_anchor = key
          has_gap = 0
        } else {
          n_missing++
          insert_after[n_missing] = last_anchor
          line = $0
          if (key == "DB_ENGINE" && ENVIRON["UPG_ENGINE"] != "") {
            # the value (double-quoted or bare) becomes the engine on disk;
            # the comment after it stays
            ep = index(line, "=")
            rest = substr(line, ep + 1)
            if (match(rest, /^"[^"]*"/) || match(rest, /^[^ \t#]*/)) rest = substr(rest, RLENGTH + 1)
            line = substr(line, 1, ep) "\"" ENVIRON["UPG_ENGINE"] "\"" rest
          }
          if (has_gap) {
            insert_block[n_missing] = "\n" line "\n"
          } else {
            insert_block[n_missing] = line "\n"
          }
          has_gap = 0
        }
      } else {
        has_gap = 1
      }
    }

    END {
      for (j = 1; j <= n_missing; j++) {
        if (insert_after[j] == "") {
          printf "%s", insert_block[j]
        }
      }
      for (i = 1; i <= env_count; i++) {
        print env_lines[i]
        key = extract_key(env_lines[i])
        if (key != "") {
          for (j = 1; j <= n_missing; j++) {
            if (insert_after[j] == key) {
              printf "%s", insert_block[j]
            }
          }
        }
      }
    }
  ' "$env_file" "$example_file"; then
    warn "$REPLACE_ERR"
    return 1
  fi
}

ensure_json_array_file() {
  local file="$1"
  local path="$ROOT_DIR/$file"
  local example="$ROOT_DIR/${file/.json/.example.json}"

  if [[ -f "$path" ]]; then
    return 0
  fi

  if [[ -f "$example" ]]; then
    if ask_yes_no "Create $file from $(basename "$example")? [Y/n] " "y"; then
      cp "$example" "$path"
      success "Created $file"
      return 0
    fi
  fi

  if ask_yes_no "$file is missing. Create empty list now? [Y/n] " "y"; then
    printf "[]\n" > "$path"
    success "Created $file"
  else
    warn "JSON file missing: $file"
    return 1
  fi
}

json_list_items() {
  local path="$1"
  if [[ "$JSON_TOOL" == "jq" ]]; then
    jq -e 'type=="array"' "$path" >/dev/null 2>&1 || die "Invalid JSON array in $(basename "$path")"
    jq -r '.[]' "$path"
  else
    python3 - "$path" <<'PY'
import json,sys
path=sys.argv[1]
with open(path,"r",encoding="utf-8") as f:
    data=json.load(f)
if not isinstance(data,list):
    raise SystemExit(1)
for item in data:
    print(item)
PY
  fi
}

json_write_tmp() {
  local path="$1"
  local tmp="$path.tmp"
  backup_config_file "$path"
  cat > "$tmp"
  mv "$tmp" "$path"
}

json_add_item() {
  local path="$1"
  local item="$2"
  if [[ "$JSON_TOOL" == "jq" ]]; then
    jq --arg item "$item" '. + [$item]' "$path" | json_write_tmp "$path"
  else
    python3 - "$path" "$item" <<'PY'
import json,sys,os
path=sys.argv[1]
item=sys.argv[2]
with open(path,"r",encoding="utf-8") as f:
    data=json.load(f)
if not isinstance(data,list):
    raise SystemExit(1)
data.append(item)
with open(path+".tmp","w",encoding="utf-8") as f:
    json.dump(data,f,ensure_ascii=True,indent=2)
    f.write("\n")
os.replace(path+".tmp",path)
PY
  fi
}

json_remove_index() {
  local path="$1"
  local index="$2"
  if [[ "$JSON_TOOL" == "jq" ]]; then
    jq --argjson idx "$index" 'del(.[$idx])' "$path" | json_write_tmp "$path"
  else
    python3 - "$path" "$index" <<'PY'
import json,sys,os
path=sys.argv[1]
index=int(sys.argv[2])
with open(path,"r",encoding="utf-8") as f:
    data=json.load(f)
if not isinstance(data,list):
    raise SystemExit(1)
if index < 0 or index >= len(data):
    raise SystemExit(2)
data.pop(index)
with open(path+".tmp","w",encoding="utf-8") as f:
    json.dump(data,f,ensure_ascii=True,indent=2)
    f.write("\n")
os.replace(path+".tmp",path)
PY
  fi
}

json_clear() {
  local path="$1"
  if [[ "$JSON_TOOL" == "jq" ]]; then
    printf "[]\n" | json_write_tmp "$path"
  else
    printf "[]\n" > "$path"
  fi
}

json_item_kind() {
  local file="$1"
  case "$file" in
    relays_import.json|relays_blastr.json) printf "relay" ;;
    blacklisted_npubs.json|whitelisted_npubs.json) printf "npub" ;;
    *) printf "string" ;;
  esac
}

json_item_is_valid() {
  local file="$1"
  local item="$2"
  local kind
  kind="$(json_item_kind "$file")"

  case "$kind" in
    relay)
      is_relay_address "$item"
      ;;
    npub)
      if is_mixed_case "$item"; then
        return 1
      fi
      is_npub "$item"
      ;;
    *)
      [[ -n "$item" ]]
      ;;
  esac
}

validate_json_item() {
  local file="$1"
  local item="$2"
  local kind
  kind="$(json_item_kind "$file")"

  VALIDATION_VALUE="$item"
  if [[ -z "$item" ]]; then
    VALIDATION_ERROR="Item cannot be empty."
    return 1
  fi

  case "$kind" in
    relay)
      if ! is_relay_address "$item"; then
        VALIDATION_ERROR="Relay must be a host or URL."
        return 1
      fi
      ;;
    npub)
      if is_mixed_case "$item"; then
        VALIDATION_ERROR="NPUB must be all lowercase or all uppercase."
        return 1
      fi
      if ! is_npub "$item"; then
        VALIDATION_ERROR="Invalid npub format."
        return 1
      fi
      VALIDATION_VALUE="${item,,}"
      ;;
    *)
      ;;
  esac

  return 0
}

list_services() {
  local compose_file="$1"
  dc "$compose_file" config --services 2>/dev/null || true
}

show_onion_host() {
  local host_file="$ROOT_DIR/tor/data/haven/hostname"
  if [[ -f "$host_file" ]]; then
    printf "Onion Host: %s\n" "$(cat "$host_file")"
  else
    warn "Onion host file not found. Tor may still be initializing."
  fi
}

path_owner_uid() {
  # -L follows symlinks: Docker bind-mounts the target, so the target's owner is
  # what matters. GNU coreutils first, BSD/macOS second; empty means "unknown".
  stat -L -c %u "$1" 2>/dev/null || stat -L -f %u "$1" 2>/dev/null || printf ''
}

env_value_or_empty() {
  local raw=""
  if ! raw="$(read_env_var "$1")"; then
    printf ''
    return 0
  fi
  local value
  value="$(strip_quotes "$raw")"
  # Trim surrounding whitespace — `KEY= 1000` is valid .env, but the raw value
  # would break both the comparison and the chown hint we print.
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  printf '%s' "$value"
}

# docker-compose.yml runs the container as ${DOCKER_UID:-1000}:${DOCKER_GID:-1000}.
# On hosts where the login user is not uid 1000 that default cannot write into the
# bind-mounted ./db, so pin both to the host user unless the operator set them.
ensure_docker_uid() {
  local env_file="$ROOT_DIR/.env"
  local host_uid host_gid changed=0
  [[ -f "$env_file" ]] || return 0
  host_uid="$(id -u)"
  host_gid="$(id -g)"

  if [[ -z "$(env_value_or_empty DOCKER_UID)" ]]; then
    set_env_var DOCKER_UID "$host_uid"
    changed=1
  fi
  if [[ -z "$(env_value_or_empty DOCKER_GID)" ]]; then
    set_env_var DOCKER_GID "$host_gid"
    changed=1
  fi

  if [[ "$changed" == "1" ]]; then
    info "Set DOCKER_UID/DOCKER_GID in .env to ${host_uid}:${host_gid} (host user)."
  fi
  return 0
}

# Compose silently creates missing bind-mount sources as root-owned. Create them
# ourselves beforehand and refuse to start when the container user could not write.
ensure_data_dirs() {
  local container_uid container_gid dir path owner check_owner=1
  container_uid="$(env_value_or_empty DOCKER_UID)"
  container_gid="$(env_value_or_empty DOCKER_GID)"
  # Mirror compose's own ${DOCKER_UID:-1000} fallback for the unset case.
  [[ -n "$container_uid" ]] || container_uid="1000"
  [[ -n "$container_gid" ]] || container_gid="1000"
  # Compose also accepts a user *name*; we cannot resolve that to a host uid, so
  # create the directories but say out loud that the check was skipped.
  if ! is_int "$container_uid" || ! is_int "$container_gid"; then
    warn "DOCKER_UID/DOCKER_GID are not numeric (${container_uid}:${container_gid}) — skipping the ownership check for db/ and blossom/."
    check_owner=0
  fi

  # backups/ is not part of the start path: only backup and restore need it, and
  # they check it themselves (backup_dir_check), strictly.
  for dir in db blossom; do
    path="$ROOT_DIR/$dir"
    if [[ -L "$path" && ! -e "$path" ]]; then
      die "$dir is a broken symlink. Point $path at an existing directory or remove it."
    fi
    if [[ -e "$path" && ! -d "$path" ]]; then
      die "$dir exists but is not a directory. Remove $path and start again."
    fi
    if [[ ! -d "$path" ]]; then
      mkdir -p "$path" || die "Cannot create $path"
      success "Created $dir/"
    fi

    [[ "$check_owner" == "1" ]] || continue
    owner="$(path_owner_uid "$path")"
    # 10# forces base 10: bash arithmetic would read a leading zero as octal,
    # while Docker and chown read the same string as decimal.
    if is_int "$owner" && [[ $((10#$owner)) -ne $((10#$container_uid)) ]]; then
      die "$dir/ is owned by uid $owner but the container runs as uid $container_uid — Haven cannot write to it. Fix with: sudo chown -R ${container_uid}:${container_gid} $path"
    fi

    # Ownership and mode bits are independent, so an earlier `chmod -R 777`
    # workaround survives the chown fix silently: the container starts, and every
    # account on the host can rewrite the relay database. Warn, never abort —
    # the relay works, it is only exposed.
    if [[ -n "$(find -H "$path" -perm -o+w -print 2>/dev/null | head -n 1 || true)" ]]; then
      warn "$dir/ is world-writable — every account on this host can modify the relay database. Reset with: chmod -R u=rwX,go= $path"
    fi
  done
}

# HAVEN_IMPORT_FLAG makes entrypoint.sh run `haven import` *instead of* the relay.
# The import exits when it is done and `restart: unless-stopped` starts the
# container right back into it, so the flag left on means an import loop and no
# relay. `./haven import` runs the same import once, without the flag.
warn_import_flag() {
  local flag
  flag="$(env_value_or_empty HAVEN_IMPORT_FLAG)"
  [[ "${flag,,}" == "true" ]] || return 0
  warn "HAVEN_IMPORT_FLAG=true — this container runs the note import instead of the relay, and restarts into it again every time it finishes."
  warn "Set it to false and use './haven import' for a one-shot import."
}

# The relay cannot serve without these; a start on an (almost) empty .env
# used to sail through silently — the only thing that ended up in .env was
# DOCKER_UID/DOCKER_GID from ensure_docker_uid, and the container ran with
# no owner and no relay identity at all.
warn_missing_critical_env() {
  local env_file="$ROOT_DIR/.env"
  [[ -f "$env_file" ]] || return 0
  local -a missing=()
  local key v
  for key in OWNER_NPUB RELAY_URL RELAY_PORT PRIVATE_RELAY_NPUB CHAT_RELAY_NPUB OUTBOX_RELAY_NPUB INBOX_RELAY_NPUB; do
    v="$(read_env_var "$key" 2>/dev/null || true)"
    v="$(strip_quotes "$v")"
    [[ -z "$v" ]] && missing+=("$key")
  done
  if (( ${#missing[@]} > 0 )); then
    # join explicitly: the script's global IFS starts with a newline
    local joined
    printf -v joined '%s ' "${missing[@]}"
    warn "Your .env is missing critical variables: ${joined% }"
    warn "The relay cannot run like this. Run './haven env-upgrade', fill in at least OWNER_NPUB and RELAY_URL, then start again."
  fi
}

prepare_start() {
  warn_missing_critical_env
  ensure_docker_uid
  ensure_data_dirs
  ensure_example_jsons
  warn_import_flag
}

# Every one-shot run of the upstream binary (import, backup, restore) needs the
# relay down: badger and lmdb both take an exclusive lock on db/. Stop it only
# when it runs, and verify that it is gone. Sets ONESHOT_RELAY_WAS_RUNNING (1/0)
# for relay_restart_after_oneshot; returns 1 with a hint when the stop did not
# take.
# Runs inside the signal guard: every message is `|| true` (a closed pipe or a
# hung-up terminal must not end the script with the relay stopped), and compose
# is called directly, not through dc — a redirection on a shell function applies
# to the shell itself, so a trap firing during it would inherit /dev/null.
ONESHOT_RELAY_WAS_RUNNING=0
relay_stop_for_oneshot() {
  local compose_file="$1" what="$2"
  ONESHOT_RELAY_WAS_RUNNING=0
  relay_container_running || return 0
  ONESHOT_RELAY_WAS_RUNNING=1
  info "Stopping the relay — the database allows a single writer." || true
  "${DOCKER_COMPOSE[@]}" -f "$compose_file" stop relay >/dev/null 2>&1 || true

  # Verify rather than assume. If the stop did not take, the one-shot opens db/
  # against a live relay and dies in badger with a lock panic that reads like
  # a bug in the import (issue #12) — abort with the actual cause instead.
  if relay_container_running; then
    warn "The relay container is still running; the $what cannot open db/ while it holds the lock." || true
    warn "Stop it manually ('./haven stop' or 'docker stop $RELAY_CONTAINER') and run the $what again." || true
    return 1
  fi
  return 0
}

# relay_start_again <compose_file> — the start alone, without a message of its
# own: compose start, compose up -d as the fallback (its output stays visible,
# it names the reason), then the container check. Compose is called directly
# for the same reason as in relay_stop_for_oneshot.
# With ONESHOT_RELAY_RECREATE=1 (db-switch) it is `compose up -d relay` instead:
# `compose start` restarts the existing container with the environment it was
# created with, so after a DB_ENGINE change the relay opened the old engine's
# files in the new directories and served 0 events (measured, P3 real Docker).
# up -d recreates the container from the current .env when it differs.
ONESHOT_RELAY_RECREATE=0
relay_start_again() {
  local compose_file="$1"
  if [[ "$ONESHOT_RELAY_RECREATE" == "1" ]]; then
    "${DOCKER_COMPOSE[@]}" -f "$compose_file" up -d relay >/dev/null 2>&1 || return 1
  else
    "${DOCKER_COMPOSE[@]}" -f "$compose_file" start relay >/dev/null 2>&1 \
      || "${DOCKER_COMPOSE[@]}" -f "$compose_file" up -d || return 1
  fi
  relay_container_running
}

# Returns 1 with a warning when the relay does not come back, so a caller never
# reports success while the relay is down.
relay_restart_after_oneshot() {
  local compose_file="$1" was_running="$2"
  [[ "$was_running" == "1" ]] || return 0
  info "Starting the relay again..." || true
  if ! relay_start_again "$compose_file"; then
    warn "The relay did not start again; it is NOT running. Check './$SCRIPT_NAME logs relay', then start it with './$SCRIPT_NAME start'." || true
    return 1
  fi
  return 0
}

# Last line of a one-shot verb whose relay did not come back: the warning has
# to be the final word, after any result line of the one-shot itself.
relay_down_final_warning() {
  warn "The relay is NOT running. Start it with './$SCRIPT_NAME start'."
}

# --- one-shot signal guard ---------------------------------------------------
# Between relay_stop_for_oneshot and the relay restart, INT/TERM/HUP must not
# leave the relay stopped. oneshot_run starts compose in the background and
# waits for it, so a trapped signal is handled at once instead of after the
# one-shot has finished. The handler stops the one-shot container first (a
# relay started next to it would hit the database lock), then restarts the
# relay if it was running, prints the relay state and re-raises the signal.
# Output never decides whether the relay comes back: SIGPIPE is ignored inside
# the window, every message there is `|| true` (a write into a closed pipe or a
# hung-up terminal fails, and the trap action runs with errexit active), and the
# handler does all of its work before it prints the first line.
ONESHOT_PID=""
ONESHOT_GUARD_FILE=""
ONESHOT_GUARD_WHAT=""
ONESHOT_GUARD_PARTIAL=""
ONESHOT_SAVED_TRAPS=""
# Optional hooks of a caller that changes more than the relay state (db-switch):
# ROLLBACK runs after the one-shot is stopped and before the relay restart and
# must not print (0 = the relay may start); REPORT runs last, best effort, with
# the "one-shot still running" flag as its argument.
ONESHOT_GUARD_ROLLBACK=""
ONESHOT_GUARD_REPORT=""

# Armed BEFORE relay_stop_for_oneshot, so the stop window is covered too; the
# handler reads ONESHOT_RELAY_WAS_RUNNING, which the stop sets first.
oneshot_guard_on() { # <compose_file> <what>
  ONESHOT_GUARD_FILE="$1"
  ONESHOT_GUARD_WHAT="$2"
  ONESHOT_RELAY_WAS_RUNNING=0
  ONESHOT_GUARD_PARTIAL=""
  ONESHOT_GUARD_ROLLBACK=""
  ONESHOT_GUARD_REPORT=""
  ONESHOT_RELAY_RECREATE=0
  ONESHOT_PID=""
  # The TUI's own INT/TERM trap is put back by oneshot_guard_off.
  ONESHOT_SAVED_TRAPS="$(trap -p INT TERM HUP PIPE)"
  trap 'oneshot_on_signal INT' INT
  trap 'oneshot_on_signal TERM' TERM
  trap 'oneshot_on_signal HUP' HUP
  trap '' PIPE
}

oneshot_guard_off() {
  trap - INT TERM HUP PIPE
  if [[ -n "$ONESHOT_SAVED_TRAPS" ]]; then
    eval "$ONESHOT_SAVED_TRAPS"
  fi
  ONESHOT_PID=""
  ONESHOT_GUARD_ROLLBACK=""
  ONESHOT_GUARD_REPORT=""
  ONESHOT_RELAY_RECREATE=0
}

# oneshot_run <compose args...> — compose in the background, waited for. Returns
# its exit status. Stdin is passed on explicitly: an asynchronous command would
# otherwise read /dev/null (the import is interactive output, not input, but
# compose decides on a TTY from stdin).
oneshot_run() {
  local rc=0
  "${DOCKER_COMPOSE[@]}" "$@" <&0 &
  ONESHOT_PID=$!
  while :; do
    rc=0
    wait "$ONESHOT_PID" || rc=$?
    # wait also returns > 128 when a trapped signal interrupts it; the handler
    # never returns, so a live pid here only means a spurious wakeup.
    kill -0 "$ONESHOT_PID" 2>/dev/null || break
  done
  ONESHOT_PID=""
  return "$rc"
}

oneshot_on_signal() {
  local sig="$1" i blocked=0 relay_rc=0 rollback_rc=0
  trap '' INT TERM HUP
  # --- the work: nothing below prints until the relay state is settled ---
  if [[ -n "$ONESHOT_PID" ]] && kill -0 "$ONESHOT_PID" 2>/dev/null; then
    docker stop -t 10 "$ONESHOT_CONTAINER" >/dev/null 2>&1 || true
    kill -TERM "$ONESHOT_PID" 2>/dev/null || true
    for ((i = 0; i < 150; i++)); do
      kill -0 "$ONESHOT_PID" 2>/dev/null || break
      sleep 0.1
    done
    if kill -0 "$ONESHOT_PID" 2>/dev/null; then
      kill -KILL "$ONESHOT_PID" 2>/dev/null || true
    fi
    wait "$ONESHOT_PID" 2>/dev/null || true
  fi
  ONESHOT_PID=""
  # A compose client that died on its own (HUP from a closed terminal) leaves
  # the container running: stop it whenever docker lists it, whatever became of
  # the client.
  if docker ps --format '{{.Names}}' 2>/dev/null | grep -qxF -- "$ONESHOT_CONTAINER"; then
    docker stop -t 10 "$ONESHOT_CONTAINER" >/dev/null 2>&1 || true
  fi

  if docker ps --format '{{.Names}}' 2>/dev/null | grep -qxF -- "$ONESHOT_CONTAINER"; then
    blocked=1
  elif [[ -n "$ONESHOT_GUARD_ROLLBACK" ]] && ! "$ONESHOT_GUARD_ROLLBACK"; then
    # the caller's own undo (db-switch) did not finish: start nothing
    rollback_rc=1
  elif [[ "$ONESHOT_RELAY_WAS_RUNNING" == "1" ]]; then
    relay_start_again "$ONESHOT_GUARD_FILE" || relay_rc=1
  fi
  # compose run --rm cannot remove the container when compose itself was
  # killed; a stopped leftover would block the next one-shot and ./haven start.
  docker rm "$ONESHOT_CONTAINER" >/dev/null 2>&1 || true

  # --- the report: best effort, a failed write changes nothing above ---
  printf '\n' >&2 || true
  warn "Received SIG$sig during the $ONESHOT_GUARD_WHAT — the one-shot container is stopped before the relay is started again." || true
  if [[ "$blocked" == "1" ]]; then
    warn "The one-shot container $ONESHOT_CONTAINER is still running; the relay is NOT started next to it (database lock)." || true
    warn "Stop it with 'docker stop $ONESHOT_CONTAINER', then start the relay with './$SCRIPT_NAME start'." || true
  elif [[ "$relay_rc" -ne 0 ]]; then
    warn "The relay did not start again; it is NOT running. Check './$SCRIPT_NAME logs relay', then start it with './$SCRIPT_NAME start'." || true
  fi
  if [[ -n "$ONESHOT_GUARD_PARTIAL" && ( -e "$ONESHOT_GUARD_PARTIAL" || -L "$ONESHOT_GUARD_PARTIAL" ) ]]; then
    warn_plain "The incomplete file $ONESHOT_GUARD_PARTIAL is not a usable backup; delete it." || true
  fi
  if relay_container_running; then
    info "The relay is running." || true
  elif [[ "$rollback_rc" -eq 0 ]]; then
    warn "The relay is NOT running. Start it with './$SCRIPT_NAME start'." || true
  else
    warn "The relay is NOT running." || true
  fi
  if [[ -n "$ONESHOT_GUARD_REPORT" ]]; then
    "$ONESHOT_GUARD_REPORT" "$blocked" || true
  fi

  # Back to the disposition from before the guard (default, or the TUI's own
  # trap) and re-raise, so the caller sees the signal.
  oneshot_guard_off
  kill -s "$sig" "$$"
  # Not reached when the signal is fatal; a TUI trap put back above exits.
  exit $((128 + $(kill -l "$sig")))
}

# Every start path (CLI start/restart, the TUI menu, the restart after an .env
# edit) passes start_services or restart_services, and both ask start_blocked
# first: the relay must not run next to a one-shot container, nor on a database
# that an engine switch left half moved, nor with DB_ENGINE naming the other
# engine than the data in db/.
start_blocked() {
  oneshot_blocks_start && return 0
  switch_marker_blocks "the relay does not start" && return 0
  engine_mismatch_blocks
}

# engine_mismatch_blocks — 0 (with the reason and both ways out) when a
# readable directory in db/ holds only the engine .env does NOT run (unset or
# unknown counts as lmdb, as upstream) and no directory holds the one it runs:
# the relay would serve an empty database and write a new one next to the data
# (measured, plan P1). Judged per directory, like engine_change_allowed, so an
# unreadable directory or one of neither engine next to the data does not open
# the gate. Directories holding both engines (or disagreeing) only warn, once
# per run — that layout is functional and may hold events received since. An
# empty db/ never blocks; a db/ of which nothing can be judged warns.
START_MIXED_WARNED=0
MIXED_START_WARNING="db/ holds files of both engines"
engine_mismatch_blocks() {
  local state eff other shown r
  db_disk_engine
  state="$(env_engine_state)"
  eff="lmdb"
  [[ "$state" != "badger" ]] || eff="badger"
  other="badger"
  [[ "$eff" != "badger" ]] || other="lmdb"
  case "$state" in
    unset) shown="DB_ENGINE is not set" ;;
    other) shown="DB_ENGINE='$(printable_text "$(env_value_or_empty DB_ENGINE)")'" ;;
    *) shown="DB_ENGINE=$state" ;;
  esac
  r=" $DISK_REPORT "
  if [[ "$r" == *"=$other "* && "$r" != *"=$eff "* && "$r" != *"=mixed "* ]]; then
    warn_plain "db/ holds $other data, but .env runs the relay on $eff ($shown). Started like this, the relay would serve an empty database and write a new $eff database next to your data, so it is not started."
    [[ -z "$DISK_BAD" ]] || warn_plain "Not readable or of neither engine: $DISK_BAD."
    warn "Either move the data to $eff with './$SCRIPT_NAME db-switch $eff', or set DB_ENGINE=$other in .env ('./$SCRIPT_NAME env'); then start again."
    return 0
  fi
  if [[ "$START_MIXED_WARNED" != "1" ]]; then
    case "$DISK_ENGINE" in
      mixed)
        START_MIXED_WARNED=1
        warn "$MIXED_START_WARNING ($DISK_BAD); the relay serves only its $eff side. For one clean database: './$SCRIPT_NAME db-switch $eff --from <badger|lmdb>'."
        ;;
      split)
        START_MIXED_WARNED=1
        warn "The directories in db/ disagree about the engine ($DISK_REPORT); the relay serves only its $eff directories. For one clean database: './$SCRIPT_NAME db-switch $eff --from <badger|lmdb>'."
        ;;
      unknown)
        if engine_unjudgeable_note; then
          START_MIXED_WARNED=1
          warn "$ENGINE_UNKNOWN_NOTE"
        fi
        ;;
    esac
  fi
  return 1
}

# engine_unjudgeable_note — after db_disk_engine: 0 with ENGINE_UNKNOWN_NOTE
# (one line) when no directory in db/ shows an engine but some cannot be read
# or hold files of neither engine; then DB_ENGINE cannot be checked against
# the data. Both gates (start and the env editor) say so instead of nothing.
ENGINE_UNKNOWN_NOTE=""
engine_unjudgeable_note() {
  local r=" $DISK_REPORT "
  ENGINE_UNKNOWN_NOTE=""
  [[ -n "$DISK_BAD" ]] || return 1
  [[ "$r" != *"=badger "* && "$r" != *"=lmdb "* && "$r" != *"=mixed "* ]] || return 1
  ENGINE_UNKNOWN_NOTE="Cannot tell which engine db/ holds ($DISK_BAD: unreadable or files of neither engine); DB_ENGINE is not checked against the data."
  return 0
}

# switch_marker_blocks <what> — 0 (with the reason) while db/.switch-in-progress
# exists: db/ and DB_ENGINE may not belong together until the rollback has run.
switch_marker_blocks() {
  if [[ -e "$DB_SWITCH_MARKER" || -L "$DB_SWITCH_MARKER" ]]; then
    warn "An engine switch did not finish (db/.switch-in-progress exists): db/ and DB_ENGINE may not match, so $1."
    warn "Run './$SCRIPT_NAME db-switch --rollback' to put the previous engine and its data back, then try again."
    return 0
  fi
  return 1
}

oneshot_blocks_start() {
  if docker ps -a --format '{{.Names}}' 2>/dev/null | grep -qxF -- "$ONESHOT_CONTAINER"; then
    warn "A one-shot container (backup, restore or import) exists: $ONESHOT_CONTAINER — the relay cannot share db/ with it."
    warn "If it still runs, wait for it ('docker logs -f $ONESHOT_CONTAINER'); if it is stopped, remove it with 'docker rm $ONESHOT_CONTAINER'. Then start again."
    return 0
  fi
  return 1
}

# The note import is a separate one-shot run of the same binary, not something
# the relay does while serving. Run it with `compose run`, which ignores the
# service's restart policy — the flag-based path cannot, which is why leaving the
# flag on loops. The relay has to be down for it: badger and lmdb both take an
# exclusive lock on db/, so two writers cannot share it.
run_import_once() {
  local mode="$1"
  local compose_file status=0 was_running=0 relay_rc=0

  compose_file="$(compose_file_for "$mode")"
  require_compose_file "$compose_file"

  if switch_marker_blocks "the import does not run"; then return 1; fi
  ensure_docker_uid
  ensure_data_dirs
  ensure_example_jsons
  warn_import_flag
  # The import runs under the fixed one-shot name, so the signal guard can stop
  # it and ./haven start can see it.
  oneshot_leftover_check || return 1

  oneshot_guard_on "$compose_file" "import"
  if ! relay_stop_for_oneshot "$compose_file" "import"; then
    oneshot_guard_off
    return 1
  fi
  was_running="$ONESHOT_RELAY_WAS_RUNNING"

  info "Importing notes ($mode). This runs once and exits; it can take a while." || true
  oneshot_run -f "$compose_file" run --rm --no-deps --name "$ONESHOT_CONTAINER" \
    -e HAVEN_IMPORT_FLAG=true relay || status=$?

  relay_restart_after_oneshot "$compose_file" "$was_running" || relay_rc=1
  oneshot_guard_off

  if [[ "$status" -ne 0 ]]; then
    warn "Import exited with status $status."
    [[ "$relay_rc" -eq 0 ]] || relay_down_final_warning
    return "$status"
  fi
  if [[ "$relay_rc" -ne 0 ]]; then
    info "Import finished."
    relay_down_final_warning
    return 1
  fi
  success "Import finished."
  return 0
}

# ---------------------------------------------------------------------------
# backup / restore
#
# Both run the upstream binary one-shot with the backups/ directory mounted:
#   compose run --rm --no-deps --name <relay>-oneshot -v backups:/app/backups
#     --entrypoint /app/haven relay backup|restore /app/backups/<file>
# --entrypoint bypasses entrypoint.sh, so no compose or image change is needed.
# Measured on v1.2.2-6 (plan P1): the exit code of `backup` is not a success
# signal (exit 0 with a truncated zip on a full disk), and a damaged zip can
# leave a partially restored database. Every zip is therefore verified before
# it is called a backup and before it is restored.
# ---------------------------------------------------------------------------

# backup_normalize_name <arg> — sets BACKUP_NAME to the plain file name inside
# backups/, or warns and returns 1. A leading "backups/" (tab completion) is
# accepted.
BACKUP_NAME=""
backup_normalize_name() {
  local name="$1"
  BACKUP_NAME=""
  name="${name#./}"
  name="${name#backups/}"
  if [[ -z "$name" ]]; then
    warn "No file name given."
    return 1
  fi
  if [[ "$name" == /* ]]; then
    warn_plain "Absolute paths are not allowed: $(printable_text "$1") — backups always live in backups/; give a file name only."
    return 1
  fi
  if [[ "$name" == */* || "$name" == *..* ]]; then
    warn_plain "Not a plain file name: $(printable_text "$1") — backups always live in backups/; '/' and '..' are not allowed."
    return 1
  fi
  if [[ "$name" != ?*.zip ]]; then
    warn_plain "Backup file names must end in .zip: $(printable_text "$1")"
    return 1
  fi
  if [[ ! "$name" =~ ^[A-Za-z0-9][A-Za-z0-9._+-]*$ ]]; then
    warn_plain "Backup file names may contain only letters, digits and . _ + - : $(printable_text "$1")"
    return 1
  fi
  BACKUP_NAME="$name"
}

list_backups() {
  local f found=0
  for f in "$BACKUP_DIR"/*.zip; do
    [[ -f "$f" ]] || continue
    if [[ "$found" == "0" ]]; then
      info_plain "Backups in $BACKUP_DIR:"
      found=1
    fi
    printf '  %s\n' "$(printable_text "${f##*/}")"
  done
  if [[ "$found" == "0" ]]; then
    info_plain "No backups found in $BACKUP_DIR (create one with './$SCRIPT_NAME backup')."
  fi
}

# A one-shot container left over from an aborted run would be a second writer
# on db/ (lmdb allows several), and compose would refuse the fixed name anyway.
oneshot_leftover_check() {
  if docker ps -a --format '{{.Names}}' 2>/dev/null | grep -qxF -- "$ONESHOT_CONTAINER"; then
    warn "A one-shot container from an earlier run still exists: $ONESHOT_CONTAINER"
    warn "Check it with 'docker logs $ONESHOT_CONTAINER', remove it with 'docker rm -f $ONESHOT_CONTAINER', then try again."
    return 1
  fi
  return 0
}

# path_mode <path> — permission bits in octal ("700"), following symlinks;
# empty when unknown. GNU coreutils first, BSD/macOS second.
path_mode() {
  stat -L -c %a "$1" 2>/dev/null || stat -L -f %Lp "$1" 2>/dev/null || printf ''
}

# backup_dir_check <create:0|1>
# backups/ holds full copies of the database, and the one-shot container writes
# into it by name. Another account that can write there could plant a symlink
# that the write follows (into db/, say), so backup and restore REFUSE unless
# backups/ belongs to the uid the container runs as and is writable by nobody
# else. A missing backups/ is created with mode 700 when create=1; with
# create=0 (restore) it is left to the caller to report the missing file.
# Only backup and restore call this; the start path never looks at backups/.
backup_dir_check() {
  local create="$1" uid gid owner mode
  uid="$(env_value_or_empty DOCKER_UID)"
  gid="$(env_value_or_empty DOCKER_GID)"
  [[ -n "$uid" ]] || uid="1000"
  [[ -n "$gid" ]] || gid="1000"
  if ! is_int "$uid"; then
    warn_plain "DOCKER_UID is not numeric ($(printable_text "$uid")); backup and restore cannot check who owns backups/ and do not run. Set a numeric DOCKER_UID in .env."
    return 1
  fi
  if [[ -L "$BACKUP_DIR" && ! -e "$BACKUP_DIR" ]]; then
    warn_plain "backups is a broken symlink. Point $BACKUP_DIR at an existing directory or remove it."
    return 1
  fi
  if [[ -e "$BACKUP_DIR" && ! -d "$BACKUP_DIR" ]]; then
    warn_plain "backups exists but is not a directory. Remove $BACKUP_DIR and try again."
    return 1
  fi
  if [[ ! -d "$BACKUP_DIR" ]]; then
    [[ "$create" == "1" ]] || return 0
    if ! mkdir -m 700 -- "$BACKUP_DIR"; then
      warn_plain "Cannot create $BACKUP_DIR"
      return 1
    fi
    success "Created backups/ (mode 700)."
  fi

  owner="$(path_owner_uid "$BACKUP_DIR")"
  # 10# forces base 10, as in ensure_data_dirs.
  if ! is_int "$owner" || [[ $((10#$owner)) -ne $((10#$uid)) ]]; then
    warn_plain "backups/ is owned by uid ${owner:-unknown}, but the container runs as uid $uid; backup and restore only use a backups/ owned by that uid. Fix with: sudo chown ${uid}:${gid} $BACKUP_DIR && chmod 700 $BACKUP_DIR"
    return 1
  fi
  mode="$(path_mode "$BACKUP_DIR")"
  if [[ ! "$mode" =~ ^[0-7]{3,4}$ ]]; then
    warn_plain "Cannot read the permissions of $BACKUP_DIR; backup and restore do not run without checking them."
    return 1
  fi
  if (( (8#$mode & 8#022) != 0 )); then
    warn_plain "backups/ is writable by other accounts (mode $mode): another user could redirect the backup into db/ or swap the file a restore reads. Fix with: chmod go-w $BACKUP_DIR (700 is best)."
    return 1
  fi
  if (( (8#$mode & 8#300) != 8#300 )); then
    warn_plain "backups/ is not writable for uid $uid, the user the container runs as. Fix with: chmod u+rwx $BACKUP_DIR"
    return 1
  fi
  return 0
}

# backup_file_owned <path> — regular file (not a symlink) owned by the uid the
# container runs as. Warns and returns 1 otherwise.
backup_file_owned() {
  local f="$1" uid owner
  uid="$(env_value_or_empty DOCKER_UID)"
  [[ -n "$uid" ]] || uid="1000"
  if [[ -L "$f" ]]; then
    warn_plain "${f##*/} is a symbolic link, not a file in backups/; it is not used. Check where it points ('ls -l $f') and remove it."
    return 1
  fi
  if [[ ! -f "$f" ]]; then
    warn_plain "${f##*/} is not a regular file; it is not used."
    return 1
  fi
  owner="$(stat -c %u -- "$f" 2>/dev/null || stat -f %u -- "$f" 2>/dev/null || printf '')"
  if ! is_int "$uid" || ! is_int "$owner" || [[ $((10#$owner)) -ne $((10#$uid)) ]]; then
    warn_plain "${f##*/} is owned by uid ${owner:-unknown}, not by uid $uid, the user the container runs as; it is not used. If you trust it: chown $uid $f"
    return 1
  fi
  return 0
}

# A random suffix for the .partial file, so its name cannot be guessed ahead of
# the run.
random_suffix() {
  local r
  r="$(od -An -N8 -tx1 /dev/urandom 2>/dev/null | tr -d ' \n' || true)"
  [[ "$r" =~ ^[0-9a-f]{16}$ ]] || r="$(printf '%04x%04x%04x%04x' "$RANDOM" "$RANDOM" "$RANDOM" "$$")"
  printf '%s' "$r"
}

# oneshot_fail <relay_rc> — the "relay is not running" warning goes last.
oneshot_fail() {
  [[ "$1" -eq 0 ]] || relay_down_final_warning
  return 0
}

# Free space in backups/ against the allocated size of db/ (du counts allocated
# blocks, so a sparse lmdb file counts with what it really holds). A failed
# measurement only warns: the verification after the backup still catches a
# truncated zip.
backup_space_check() {
  local need free
  need="$(du -skH "$ROOT_DIR/db" 2>/dev/null | awk 'NR==1 {print $1}' || true)"
  free="$(df -Pk "$BACKUP_DIR" 2>/dev/null | awk 'NR==2 {print $4}' || true)"
  if ! is_int "$need" || ! is_int "$free"; then
    warn "Could not measure the free space in backups/; continuing (the backup is verified afterwards)."
    return 0
  fi
  if (( free < need )); then
    warn "Not enough free space in backups/: ${free} KiB free, db/ holds ${need} KiB."
    return 1
  fi
  return 0
}

# Fails closed: a db/ the host user cannot read or search, or a find that
# fails, counts as holding data — "empty" would skip the confirmation.
db_has_data() {
  local db="$ROOT_DIR/db" out=""
  [[ -e "$db" || -L "$db" ]] || return 1
  [[ -d "$db" && -r "$db" && -x "$db" ]] || return 0
  out="$(find -H "$db" -mindepth 1 ! -name .gitignore -print -quit 2>/dev/null)" || return 0
  [[ -n "$out" ]]
}

# little-endian hex ("0500") to decimal
zip_le_hex() {
  local h="$1" out=""
  while [[ -n "$h" ]]; do
    out="${h:0:2}$out"
    h="${h:2}"
  done
  printf '%d' "$((16#$out))"
}

# The end-of-central-directory record must close the file: busybox unzip -t
# (the image's unzip) accepts a zip cut by one byte (measured on v1.2.2-6),
# Info-ZIP does not. Upstream writes no zip comment, so the record is the last
# 22 bytes and its offset + size land exactly on the file size.
zip_tail_intact() {
  local f="$1" size hex cd_size cd_off
  size="$(stat -L -c %s "$f" 2>/dev/null || stat -L -f %z "$f" 2>/dev/null || true)"
  is_int "$size" || return 1
  (( size >= 22 )) || return 1
  hex="$(tail -c 22 "$f" | od -An -v -tx1 | tr -d ' \n')"
  [[ ${#hex} -eq 44 && "${hex:0:8}" == "504b0506" ]] || return 1
  [[ "${hex:40:4}" == "0000" ]] || return 1
  cd_size="$(zip_le_hex "${hex:24:8}")"
  cd_off="$(zip_le_hex "${hex:32:8}")"
  # ZIP64 (> 4 GiB or > 65535 entries) moves the real values elsewhere; leave
  # that case to unzip -t.
  if [[ "${hex:24:8}" == "ffffffff" || "${hex:32:8}" == "ffffffff" ]]; then
    return 0
  fi
  (( cd_off + cd_size + 22 == size ))
}

# verify_backup_zip <compose_file> <path inside backups/>
# 0 = intact and exactly the five expected entries; 1 = damaged (warned);
# 2 = could not be verified (warned). Sets BACKUP_VERIFIED_BY.
BACKUP_VERIFIED_BY=""
verify_backup_zip() {
  local compose_file="$1" f="$2" listing="" rc=0 entries
  BACKUP_VERIFIED_BY=""
  if [[ ! -s "$f" ]]; then
    warn "${f##*/} is missing or empty."
    return 1
  fi
  if ! zip_tail_intact "$f"; then
    warn "${f##*/} is damaged: the end of the archive is missing or invalid (truncated file?)."
    return 1
  fi
  if command -v "$HOST_UNZIP" >/dev/null 2>&1; then
    BACKUP_VERIFIED_BY="host unzip"
    if ! "$HOST_UNZIP" -t "$f" >/dev/null 2>&1; then
      warn "${f##*/} is damaged: the archive integrity test (unzip -t) failed."
      return 1
    fi
    listing="$("$HOST_UNZIP" -l "$f" 2>/dev/null)" || rc=$?
    if [[ "$rc" -ne 0 ]]; then
      warn "${f##*/} is damaged: unzip cannot list it."
      return 1
    fi
  else
    # No unzip on the host: use the image's own (busybox) unzip one-shot.
    # 99 = no unzip in the image, 98 = integrity test failed; anything else
    # non-zero is docker/compose failing to run the check.
    BACKUP_VERIFIED_BY="the image's unzip"
    # shellcheck disable=SC2016  # $1 expands inside the container's sh, not here
    listing="$(dc "$compose_file" run --rm --no-deps -T --name "$ONESHOT_CONTAINER" \
      -v "$BACKUP_DIR:/app/backups" --entrypoint sh relay \
      -c 'command -v unzip >/dev/null 2>&1 || exit 99; unzip -t "$1" >/dev/null 2>&1 || exit 98; unzip -l "$1"' \
      sh "/app/backups/${f##*/}" 2>/dev/null)" || rc=$?
    if [[ "$rc" -eq 98 ]]; then
      warn "${f##*/} is damaged: the archive integrity test (unzip -t in the image) failed."
      return 1
    fi
    if [[ "$rc" -ne 0 ]]; then
      warn "${f##*/} could not be verified: there is no unzip on this host, and the check with the image's unzip did not run (status $rc)."
      warn "Install unzip on the host (e.g. 'apt install unzip') and try again."
      return 2
    fi
  fi
  entries="$(printf '%s\n' "$listing" | awk 'NF == 4 && $1 ~ /^[0-9]+$/ {print $4}' | LC_ALL=C sort)"
  if [[ "$entries" != "$BACKUP_ENTRIES" ]]; then
    warn_plain "${f##*/} is not a complete Haven backup: expected the entries ${BACKUP_ENTRIES//$'\n'/ }, found: $(printable_text "${entries//$'\n'/ }")"
    return 1
  fi
  return 0
}

human_size() {
  awk -v b="$1" 'BEGIN {
    split("bytes KiB MiB GiB TiB", u, " ")
    i = 1
    while (b >= 1024 && i < 5) { b /= 1024; i++ }
    if (i == 1) printf "%d %s", b, u[i]; else printf "%.1f %s", b, u[i]
  }'
}

# backup_oneshot_to <compose_file> <partial> [compose run options...] — the
# backup one-shot itself, writing <partial> inside backups/. The relay must be
# down and the signal guard armed. Extra options (db-switch: -e DB_ENGINE=...)
# go in front of the service name. Returns the one-shot's exit status.
backup_oneshot_to() {
  local compose_file="$1" partial="$2"
  shift 2
  # umask 077 inside the container: the zip is a full copy of the database
  # (badger keeps db/<relay>/ at 0700), so it is created 0600 for whatever uid
  # the container runs as. --entrypoint sh keeps entrypoint.sh out, as before.
  # shellcheck disable=SC2016  # $1 expands inside the container's sh, not here
  oneshot_run -f "$compose_file" run --rm --no-deps -T --name "$ONESHOT_CONTAINER" \
    -v "$BACKUP_DIR:/app/backups" "$@" --entrypoint sh relay \
    -c 'umask 077; exec /app/haven backup "$1"' sh "/app/backups/${partial##*/}"
}

# backup_finish <compose_file> <status> <partial> <target> — everything after
# the backup one-shot: the file must exist, belong to the container user, be a
# verified zip; then it is renamed to <target>. Warns and returns 1 otherwise
# (a kept .partial is named). Prints nothing on success.
backup_finish() {
  local compose_file="$1" status="$2" partial="$3" target="$4" vrc=0
  local name="${target##*/}"
  if [[ "$status" -ne 0 ]]; then
    warn "The backup exited with status $status; no backup was written."
    if [[ -e "$partial" && ! -L "$partial" ]]; then
      warn_plain "The incomplete file is kept for inspection: $partial — it is not a usable backup; delete it when done."
    fi
    return 1
  fi
  if [[ ! -e "$partial" && ! -L "$partial" ]]; then
    warn "The backup reported success but wrote no file; no backup was written."
    return 1
  fi
  # Something other than the container put this path there (a symlink planted
  # during the run, a foreign file): it is neither verified nor renamed.
  if ! backup_file_owned "$partial"; then
    warn "No backup was written."
    return 1
  fi
  if [[ ! -s "$partial" ]]; then
    warn "The backup reported success but wrote an empty file; no backup was written."
    return 1
  fi

  verify_backup_zip "$compose_file" "$partial" || vrc=$?
  if [[ "$vrc" -ne 0 ]]; then
    warn_plain "No backup was written. The unverified file is kept for inspection: $partial — it is not a usable backup; delete it when done."
    return 1
  fi

  if [[ -e "$target" || -L "$target" ]]; then
    warn_plain "backups/$name appeared while the backup ran; the verified file stays as $partial."
    return 1
  fi
  mv -n -- "$partial" "$target"
  if [[ -e "$partial" || -L "$target" || ! -f "$target" ]]; then
    warn_plain "Could not rename $partial to $name; the verified file stays as $partial."
    return 1
  fi
  return 0
}

# restore_oneshot <compose_file> <name in backups/> [compose run options...] —
# the restore one-shot itself; same preconditions as backup_oneshot_to.
restore_oneshot() {
  local compose_file="$1" name="$2"
  shift 2
  oneshot_run -f "$compose_file" run --rm --no-deps -T --name "$ONESHOT_CONTAINER" \
    -v "$BACKUP_DIR:/app/backups" "$@" --entrypoint /app/haven \
    relay restore "/app/backups/$name"
}

# backup_relay_db <mode> [file]
backup_relay_db() {
  local mode="$1" requested="$2"
  local compose_file name target partial status=0 was_running size relay_rc=0

  compose_file="$(compose_file_for "$mode")"
  require_compose_file "$compose_file"

  # --- preflight: nothing is stopped before all of this has passed ---
  if [[ -n "$requested" ]]; then
    backup_normalize_name "$requested" || return 1
    name="$BACKUP_NAME"
  else
    name="haven-backup-$(date +%Y%m%d-%H%M%S).zip"
  fi
  target="$BACKUP_DIR/$name"
  partial="$target.partial-$(random_suffix)"
  if switch_marker_blocks "the backup does not run"; then return 1; fi

  ensure_docker_uid
  ensure_data_dirs
  ensure_example_jsons
  backup_dir_check 1 || return 1
  if [[ -e "$target" || -L "$target" ]]; then
    warn "backups/$name already exists; a backup never overwrites a file. Choose another name."
    return 1
  fi
  if [[ -e "$partial" || -L "$partial" ]]; then
    warn_plain "$partial already exists; try again."
    return 1
  fi
  oneshot_leftover_check || return 1
  backup_space_check || return 1

  # --- run ---
  oneshot_guard_on "$compose_file" "backup"
  ONESHOT_GUARD_PARTIAL="$partial"
  if ! relay_stop_for_oneshot "$compose_file" "backup"; then
    oneshot_guard_off
    return 1
  fi
  was_running="$ONESHOT_RELAY_WAS_RUNNING"

  info "Writing backups/$name ($mode)..." || true
  backup_oneshot_to "$compose_file" "$partial" || status=$?

  # The relay comes back before the verification: it does not need db/ quiet.
  relay_restart_after_oneshot "$compose_file" "$was_running" || relay_rc=1
  oneshot_guard_off

  if ! backup_finish "$compose_file" "$status" "$partial" "$target"; then
    oneshot_fail "$relay_rc"
    return 1
  fi

  size="$(stat -L -c %s "$target" 2>/dev/null || stat -L -f %z "$target" 2>/dev/null || printf '?')"
  success_plain "Backup written: $target ($(human_size "$size"), five entries verified with $BACKUP_VERIFIED_BY)."
  info "It does not contain the media files in blossom/, your .env or the JSON lists (relays_import.json, relays_blastr.json, blacklisted_npubs.json, whitelisted_npubs.json) — copy those separately."
  if [[ "$relay_rc" -ne 0 ]]; then
    relay_down_final_warning
    return 1
  fi
  return 0
}

# restore_relay_db <mode> <file>
restore_relay_db() {
  local mode="$1" requested="$2"
  local compose_file name file status=0 was_running vrc=0 relay_rc=0

  compose_file="$(compose_file_for "$mode")"
  require_compose_file "$compose_file"

  # --- preflight: nothing is stopped before all of this has passed ---
  if [[ -z "$requested" ]]; then
    warn "Usage: ./$SCRIPT_NAME restore <file>  (a file in backups/)"
    list_backups
    return 1
  fi
  backup_normalize_name "$requested" || return 1
  name="$BACKUP_NAME"
  file="$BACKUP_DIR/$name"
  if switch_marker_blocks "the restore does not run"; then return 1; fi

  ensure_docker_uid
  ensure_data_dirs
  ensure_example_jsons
  backup_dir_check 0 || return 1
  if [[ ! -e "$file" && ! -L "$file" ]]; then
    warn "backups/$name not found."
    list_backups
    return 1
  fi
  # Upstream imports a backup without any signature check: only a regular file
  # of the container user is read, never a symlink to somewhere else.
  backup_file_owned "$file" || { warn "Nothing was restored; the relay was not touched."; return 1; }
  oneshot_leftover_check || return 1

  verify_backup_zip "$compose_file" "$file" || vrc=$?
  if [[ "$vrc" -ne 0 ]]; then
    warn "Nothing was restored; the relay was not touched."
    return 1
  fi
  info "backups/$name verified with $BACKUP_VERIFIED_BY: intact, five entries."

  if db_has_data; then
    # the duplicate sentences are measured (the list rows of
    # tests/real-docker/p2, p3 and p6): notes are never doubled; on lmdb every
    # restore into a database that already lists a file adds one more
    # identical /list entry, on badger none
    info "db/ already holds data (or cannot be read to check). A restore adds the events from backups/$name that are missing and deletes nothing; events that exist only in the database stay. Notes that are already there are skipped; on lmdb, a media index entry that is already there is listed once more (one more identical /list entry per restore)."
    if [[ "$ASSUME_YES" == "1" ]]; then
      :
    elif [[ -t 0 ]]; then
      if ! ask_yes_no "Restore into the existing database? [y/N] " "n"; then
        info "Restore cancelled; nothing was changed."
        return 1
      fi
    else
      warn "No terminal to ask for confirmation. Run again with --yes to restore into the existing database."
      return 1
    fi
  fi

  # --- run ---
  oneshot_guard_on "$compose_file" "restore"
  if ! relay_stop_for_oneshot "$compose_file" "restore"; then
    oneshot_guard_off
    return 1
  fi
  was_running="$ONESHOT_RELAY_WAS_RUNNING"

  info "Restoring from backups/$name ($mode)..." || true
  restore_oneshot "$compose_file" "$name" || status=$?

  relay_restart_after_oneshot "$compose_file" "$was_running" || relay_rc=1
  oneshot_guard_off

  if [[ "$status" -ne 0 ]]; then
    warn "The restore exited with status $status. The database may now be partially restored."
    warn "Running the same restore again is safe: it adds what is missing and deletes nothing (on lmdb, a media index entry that is already there is listed once more)."
    oneshot_fail "$relay_rc"
    return 1
  fi
  if [[ "$relay_rc" -ne 0 ]]; then
    info "Restore finished: the events from backups/$name that were missing are now in the database."
    relay_down_final_warning
    return 1
  fi
  success "Restore finished: the events from backups/$name that were missing are now in the database; nothing was deleted, and notes that were already there were skipped. On lmdb, a media index entry that was already there is now listed once more."
  info "Media files are not part of a backup: list entries whose file is missing from blossom/ answer 404 until the files are copied back."
  return 0
}

# ---------------------------------------------------------------------------
# db-switch
#
# Moves the relay database to the other engine the way upstream supports it:
# backup, switch DB_ENGINE, restore — with every fact taken from disk, not from
# .env or an exit code. Measured on v1.2.2-6 (plan P1): flipping DB_ENGINE alone
# serves 0 events and leaves the other engine's files next to the old ones; both
# engines use the same five directories; per-entry CRCs of a backup are equal
# across engines for the same data.
#
#   1 preflight  read-only checks, then one confirmation (or --yes)
#   2 stop       the relay, when it runs, verified gone
#   3 backup     backups/haven-pre-switch-<engine>-<ts>.zip, verified
#   4 move       marker db/.switch-in-progress, then the five directories into
#                db/.pre-switch-<old engine>-<ts>/ (renames inside db/)
#   5 config     DB_ENGINE in .env (set_env_var, with its config backup)
#   6 restore    restore, then a second backup of the new database whose
#                per-entry CRCs must equal the first
#   7 start      marker removed, relay started when it ran before
#
# Any failure or signal once step 4 has begun rolls back: what the restore made
# goes to db/.failed-<ts>/, the old directories come back, DB_ENGINE is put back
# verbatim, the marker goes only when the old layout is complete. Nothing in
# db/ is ever deleted; the old directories stay for the user to remove.
# Progress lines for a caller: "::step <n>/<total> <name>", "::result <ok|
# rolled-back|failed>".
# ---------------------------------------------------------------------------

DBS_STEPS=7
DBS_ACTIVE=0             # 1 while db/ may hold a half-moved layout (marker written)
DBS_KIND=""              # switch | undo
DBS_SOURCE=""            # switch: the old engine; undo: the engine set aside
DBS_TARGET=""            # switch: the new engine; undo: the engine brought back
DBS_TS=""
DBS_BACKUP=""            # switch: the pre-switch zip in backups/
DBS_BACKUP2=""           # switch: the zip of the new database
DBS_STASH=""             # directory in db/ whose contents come back on rollback
DBS_ASIDE=""             # directory in db/ that takes what is set aside on rollback
DBS_DIRS=""              # database directories of the layout to come back
DBS_ENV_SET=0            # 1: the DB_ENGINE line DBS_ENV_LINE belongs in .env
DBS_ENV_LINE=""          # 0: no DB_ENGINE line belongs in .env
DBS_ENV_FIX=""           # switch: .env's DB_ENGINE state (badger|lmdb|unset|other)
                         # when it contradicted the data; the rollback then sets
                         # the data's engine (DBS_ENV_LINE), not the old value
DBS_RELAY_WAS_RUNNING=0
DBS_STEP=""
DBS_ERR=""
# Inside a mixed stash: the DB_ENGINE line from before the switch, so that
# --rollback after a completed switch puts the mixed layout back as it was.
DBS_ENV_NOTE=".switch-env"
# Inside every stash: "dirs=<names>", the directories the switch moved into it.
# An undo brings back exactly these and refuses when one is gone (or the note).
DBS_DIRS_NOTE=".switch-dirs"
DBS_ROLLED=0            # signal path: 1 rolled back, 2 rollback did not finish
DBS_UNTOUCHED=0         # 1: dbs_restore_layout refused before it moved anything
DISK_ENGINE=""
DISK_REPORT=""
DISK_DATA=""
DISK_BAD=""

dbs_progress() { printf '::step %s/%s %s\n' "$1" "$2" "$3" || true; }
dbs_result() { printf '::result %s\n' "$1" || true; }
dbs_word_in() { [[ " $2 " == *" $1 "* ]]; }
dbs_ts() { date +%Y%m%d-%H%M%S; }

# db_dir_engine <dir> — what a database directory holds, judged by its files:
# badger (MANIFEST, KEYREGISTRY, *.vlog, *.sst), lmdb (data.mdb, lock.mdb),
# mixed (both), empty, missing, other (files of neither engine, or not a
# directory) or unreadable.
db_dir_engine() {
  local d="$1" any="" b="" l=""
  if [[ ! -e "$d" && ! -L "$d" ]]; then printf 'missing'; return 0; fi
  if [[ ! -d "$d" ]]; then printf 'other'; return 0; fi
  any="$(find -H "$d" -mindepth 1 -maxdepth 1 -print -quit 2>/dev/null)" || { printf 'unreadable'; return 0; }
  if [[ -z "$any" ]]; then printf 'empty'; return 0; fi
  b="$(find -H "$d" -mindepth 1 -maxdepth 1 \( -name MANIFEST -o -name KEYREGISTRY -o -name '*.vlog' -o -name '*.sst' \) -print -quit 2>/dev/null)" || { printf 'unreadable'; return 0; }
  l="$(find -H "$d" -mindepth 1 -maxdepth 1 \( -name data.mdb -o -name lock.mdb \) -print -quit 2>/dev/null)" || { printf 'unreadable'; return 0; }
  if [[ -n "$b" && -n "$l" ]]; then
    printf 'mixed'
  elif [[ -n "$b" ]]; then
    printf 'badger'
  elif [[ -n "$l" ]]; then
    printf 'lmdb'
  else
    printf 'other'
  fi
}

# db_disk_engine [base] — the engine of the five directories under base (db/):
# sets DISK_ENGINE to badger, lmdb, none (no data), mixed (a directory holds
# both; DISK_BAD names them), split (directories disagree) or unknown (DISK_BAD
# names the unreadable ones or those holding neither), DISK_DATA to the
# directories with data and DISK_REPORT to "name=engine ...".
db_disk_engine() {
  local base="${1:-$ROOT_DIR/db}" n e seen="" mixed="" bad="" data="" report=""
  for n in "${DB_ENGINE_DIRS[@]}"; do
    e="$(db_dir_engine "$base/$n")"
    report+="$n=$e "
    case "$e" in
      badger|lmdb)
        data+="$n "
        if [[ -z "$seen" ]]; then
          seen="$e"
        elif [[ "$seen" != "$e" ]]; then
          seen="split"
        fi
        ;;
      mixed) mixed+="$n " ;;
      other|unreadable) bad+="$n " ;;
    esac
  done
  DISK_REPORT="${report% }"
  DISK_DATA="${data% }"
  DISK_BAD=""
  if [[ -n "$mixed" ]]; then
    DISK_ENGINE="mixed"
    DISK_BAD="${mixed% }"
  elif [[ -n "$bad" ]]; then
    DISK_ENGINE="unknown"
    DISK_BAD="${bad% }"
  elif [[ "$seen" == "split" ]]; then
    DISK_ENGINE="split"
  elif [[ -z "$seen" ]]; then
    DISK_ENGINE="none"
  else
    DISK_ENGINE="$seen"
  fi
}

# engine_change_allowed <engine> — 0 when DB_ENGINE may become <engine> without
# moving data: no directory in db/ holds files of the other engine (db/ empty,
# or <engine> only; unreadable directories and files of neither engine do not
# count). Otherwise 1 with ENGINE_CHANGE_ERR naming the db-switch that moves
# the data. Used by the env editor (validate_env_value).
ENGINE_CHANGE_ERR=""
ENGINE_CHANGE_WARN=""    # one line when nothing in db/ can be judged (allowed)
engine_change_allowed() {
  local want="$1" other=badger
  [[ "$want" == badger ]] && other=lmdb
  ENGINE_CHANGE_ERR=""
  ENGINE_CHANGE_WARN=""
  db_disk_engine
  if engine_unjudgeable_note; then ENGINE_CHANGE_WARN="$ENGINE_UNKNOWN_NOTE"; fi
  if [[ " $DISK_REPORT " == *"=mixed "* ]] \
    || [[ " $DISK_REPORT " == *"=$other "* && " $DISK_REPORT " == *"=$want "* ]]; then
    ENGINE_CHANGE_ERR="db/ holds both engines: use ./$SCRIPT_NAME db-switch $want --from <engine>"
    return 1
  fi
  if [[ " $DISK_REPORT " == *"=$other "* ]]; then
    ENGINE_CHANGE_ERR="db/ holds $other data: use ./$SCRIPT_NAME db-switch $want"
    return 1
  fi
  return 0
}

# tui_engine_unknown_note <key> — before the env editor writes DB_ENGINE: one
# line when the value cannot be checked against db/ (nothing there can be
# judged); the write goes ahead.
tui_engine_unknown_note() {
  [[ "$1" == "DB_ENGINE" ]] || return 0
  engine_change_allowed lmdb || true
  [[ -z "$ENGINE_CHANGE_WARN" ]] || tui_message "DB_ENGINE" "$ENGINE_CHANGE_WARN"
}

# env_key_lines <key> — the .env lines that set <key>, matched as read_env_var does
env_key_lines() {
  local env_file="$ROOT_DIR/.env"
  [[ -f "$env_file" ]] || return 0
  # shellcheck disable=SC2016  # an awk program: $0 belongs to awk, not to the shell
  HAVEN_K="$1" awk '
    BEGIN { key = ENVIRON["HAVEN_K"]; klen = length(key) }
    {
      t = $0
      if (substr(t, 1, klen + 1) == key "=" || (sub(/^[ \t]*export[ \t]+/, "", t) && substr(t, 1, klen + 1) == key "=")) print
    }
  ' "$env_file"
}

# env_engine_state — "unset", "badger", "lmdb" or "other" for DB_ENGINE in .env.
# Upstream runs lmdb for anything but "badger" (read in code, plan P0).
env_engine_state() {
  local v
  if [[ -z "$(env_key_lines DB_ENGINE)" ]]; then
    printf 'unset'
    return 0
  fi
  v="$(env_value_or_empty DB_ENGINE)"
  case "$v" in
    badger|lmdb) printf '%s' "$v" ;;
    *) printf 'other' ;;
  esac
}

# Test seam: with HAVEN_TEST_SWITCH_HOOK set to an executable, db-switch runs it
# with a point name (after-backup, after-move, after-config, before-restore,
# after-restore); a non-zero exit fails that step. Unset: nothing runs.
dbs_hook() {
  [[ -n "${HAVEN_TEST_SWITCH_HOOK:-}" ]] || return 0
  "$HAVEN_TEST_SWITCH_HOOK" "$1" </dev/null >/dev/null 2>&1 || { DBS_ERR="the test hook failed at $1"; return 1; }
}

# The marker: key=value lines, written to a fresh temporary file and renamed.
dbs_write_marker() {
  local content tmp
  printf -v content 'kind=%s\nsource=%s\ntarget=%s\nstarted=%s\nbackup=%s\nstash=%s\naside=%s\ndirs=%s\nrelay_was_running=%s\nenv_set=%s\nenv_line=%s\nenv_fix=%s\nstep=%s\n' \
    "$DBS_KIND" "$DBS_SOURCE" "$DBS_TARGET" "$DBS_TS" "$DBS_BACKUP" "$DBS_STASH" "$DBS_ASIDE" \
    "$DBS_DIRS" "$DBS_RELAY_WAS_RUNNING" "$DBS_ENV_SET" "$DBS_ENV_LINE" "$DBS_ENV_FIX" "$DBS_STEP"
  tmp="$(mktemp "$DB_SWITCH_MARKER.XXXXXX" 2>/dev/null)" || return 1
  if ! printf '%s' "$content" > "$tmp" 2>/dev/null || ! mv -f -- "$tmp" "$DB_SWITCH_MARKER" 2>/dev/null; then
    rm -f -- "$tmp" 2>/dev/null
    return 1
  fi
  [[ -f "$DB_SWITCH_MARKER" && ! -L "$DB_SWITCH_MARKER" ]]
}

# dbs_load_marker — reads db/.switch-in-progress into the DBS_* variables and
# checks every field: the names it holds decide which directories are renamed,
# so anything unexpected is refused (DBS_ERR says what).
dbs_load_marker() {
  local l k v
  DBS_KIND="" DBS_SOURCE="" DBS_TARGET="" DBS_TS="" DBS_BACKUP="" DBS_STASH="" DBS_ASIDE=""
  DBS_DIRS="" DBS_RELAY_WAS_RUNNING="" DBS_ENV_SET="" DBS_ENV_LINE="" DBS_ENV_FIX="" DBS_STEP="" DBS_ERR=""
  if [[ -L "$DB_SWITCH_MARKER" || ! -f "$DB_SWITCH_MARKER" || ! -r "$DB_SWITCH_MARKER" ]]; then
    DBS_ERR="it is not a readable regular file"
    return 1
  fi
  while IFS= read -r l || [[ -n "$l" ]]; do
    k="${l%%=*}"
    v="${l#*=}"
    case "$k" in
      kind) DBS_KIND="$v" ;;
      source) DBS_SOURCE="$v" ;;
      target) DBS_TARGET="$v" ;;
      started) DBS_TS="$v" ;;
      backup) DBS_BACKUP="$v" ;;
      stash) DBS_STASH="$v" ;;
      aside) DBS_ASIDE="$v" ;;
      dirs) DBS_DIRS="$v" ;;
      relay_was_running) DBS_RELAY_WAS_RUNNING="$v" ;;
      env_set) DBS_ENV_SET="$v" ;;
      env_line) DBS_ENV_LINE="$v" ;;
      env_fix) DBS_ENV_FIX="$v" ;;
      step) DBS_STEP="$v" ;;
    esac
  done < "$DB_SWITCH_MARKER"
  local n
  if [[ "$DBS_KIND" != "switch" && "$DBS_KIND" != "undo" ]]; then
    DBS_ERR="unknown kind"
  elif [[ ! "$DBS_STASH" =~ ^\.pre-switch-(badger|lmdb|mixed)-[0-9]{8}-[0-9]{6}$ ]]; then
    DBS_ERR="invalid stash directory name"
  elif [[ ! "$DBS_SOURCE" =~ ^(badger|lmdb)$ || ! "$DBS_TARGET" =~ ^(badger|lmdb)$ ]] \
    || [[ "$DBS_SOURCE" == "$DBS_TARGET" && "$DBS_STASH" != .pre-switch-mixed-* ]]; then
    # the same engine on both sides only for a mixed layout (--from = target)
    DBS_ERR="invalid engines"
  elif [[ ! "$DBS_ENV_FIX" =~ ^(badger|lmdb|unset|other)?$ ]]; then
    DBS_ERR="invalid env_fix"
  elif [[ -n "$DBS_ASIDE" && ! "$DBS_ASIDE" =~ ^\.(failed|post-switch-(badger|lmdb))-[0-9]{8}-[0-9]{6}(-[0-9]+)?$ ]]; then
    DBS_ERR="invalid set-aside directory name"
  elif [[ ! "$DBS_RELAY_WAS_RUNNING" =~ ^[01]$ || ! "$DBS_ENV_SET" =~ ^[01]$ ]]; then
    DBS_ERR="invalid flags"
  elif [[ "$DBS_ENV_SET" == "1" && ! "$DBS_ENV_LINE" =~ ^[[:blank:]]*(export[[:blank:]]+)?DB_ENGINE= ]]; then
    DBS_ERR="invalid DB_ENGINE line"
  elif [[ ! "$DBS_STEP" =~ ^(move|moved|config|restored|verified|start|undo)$ ]]; then
    DBS_ERR="unknown step"
  fi
  if [[ -z "$DBS_ERR" ]]; then
    local -a words=()
    IFS=' ' read -r -a words <<< "$DBS_DIRS"
    for n in "${words[@]}"; do
      dbs_word_in "$n" "$DB_ENGINE_DIRS_TEXT" || DBS_ERR="unknown directory name in dirs"
    done
  fi
  [[ -z "$DBS_ERR" ]]
}

# dbs_unique <name> — <name> when db/<name> is free, else <name>-2, -3, ...
dbs_unique() {
  local c="$1" i=2
  while [[ -e "$ROOT_DIR/db/$c" || -L "$ROOT_DIR/db/$c" ]]; do
    c="$1-$i"
    i=$((i + 1))
  done
  printf '%s' "$c"
}

# dbs_own_dir <path> — 0 when <path> is a real directory (not a symlink) owned
# by the user running this script or by DOCKER_UID. A stash or set-aside
# directory that is anything else was not made by db-switch: moving through it
# would carry data into or out of a directory outside db/.
dbs_own_dir() {
  local p="$1" owner uid
  [[ -d "$p" && ! -L "$p" ]] || return 1
  owner="$(stat -c %u -- "$p" 2>/dev/null || stat -f %u -- "$p" 2>/dev/null)" || return 1
  [[ "$owner" == "$(id -u)" ]] && return 0
  uid="$(env_value_or_empty DOCKER_UID)"
  [[ -n "$uid" ]] || uid="1000"
  is_int "$uid" && [[ "$owner" == "$((10#$uid))" ]]
}

# dbs_dir_usable <name below db/> — dbs_own_dir for the stash or set-aside
# directory when it exists (a missing one is fine); DBS_ERR says why not.
dbs_dir_usable() {
  local p="$ROOT_DIR/db/$1"
  [[ -e "$p" || -L "$p" ]] || return 0
  dbs_own_dir "$p" && return 0
  DBS_ERR="db/$1 is not a directory db-switch made (a symlink, not a directory, or owned by another user); nothing is moved through it"
  return 1
}

# GNU mv -T treats the target as the final name, never as a directory to move
# into; -n never replaces it. Elsewhere (BSD) the existence check below remains.
DBS_MV_FLAGS=()
if mv --version 2>/dev/null | grep -q GNU; then DBS_MV_FLAGS=(-T -n); fi

# dbs_move <from> <to> — a plain rename; never onto an existing path and never
# into a directory that appeared there meanwhile.
dbs_move() {
  if [[ -e "$2" || -L "$2" ]]; then
    DBS_ERR="${2#"$ROOT_DIR/"} already exists"
    return 1
  fi
  mv ${DBS_MV_FLAGS[@]+"${DBS_MV_FLAGS[@]}"} -- "$1" "$2" 2>/dev/null
  if [[ -e "$1" || -L "$1" ]] || [[ ! -e "$2" && ! -L "$2" ]]; then
    DBS_ERR="could not move ${1#"$ROOT_DIR/"} to ${2#"$ROOT_DIR/"}"
    return 1
  fi
  return 0
}

# dbs_set_aside <name> — db/<name> into the set-aside directory, created (and
# recorded in the marker) on first use.
dbs_set_aside() {
  local db="$ROOT_DIR/db"
  if [[ -z "$DBS_ASIDE" ]]; then
    DBS_ASIDE="$(dbs_unique ".failed-$(dbs_ts)")"
    if ! dbs_write_marker; then
      DBS_ERR="cannot update db/.switch-in-progress"
      return 1
    fi
  fi
  if [[ -e "$db/$DBS_ASIDE" || -L "$db/$DBS_ASIDE" ]]; then
    dbs_dir_usable "$DBS_ASIDE" || return 1
  elif ! mkdir -m 700 -- "$db/$DBS_ASIDE" 2>/dev/null || ! dbs_own_dir "$db/$DBS_ASIDE"; then
    DBS_ERR="cannot create db/$DBS_ASIDE"
    return 1
  fi
  dbs_move "$db/$1" "$db/$DBS_ASIDE/$1"
}

# dbs_env_put — the DB_ENGINE line of .env back to DBS_ENV_LINE (or removed
# when DBS_ENV_SET=0), verbatim; nothing is written when it already matches.
dbs_env_put() {
  local env_file="$ROOT_DIR/.env" cur
  cur="$(env_key_lines DB_ENGINE)"
  if [[ "$DBS_ENV_SET" == "1" ]]; then
    [[ "$cur" != "$DBS_ENV_LINE" ]] || return 0
  else
    [[ -n "$cur" ]] || return 0
  fi
  if [[ ! -f "$env_file" || ! -w "$env_file" ]]; then
    DBS_ERR=".env is not writable; DB_ENGINE could not be set back"
    return 1
  fi
  backup_config_file "$env_file"
  # shellcheck disable=SC2016  # an awk program: $0 belongs to awk, not to the shell
  replace_file_from "$env_file" env DBS_LINE="$DBS_ENV_LINE" DBS_SET="$DBS_ENV_SET" awk '
      $0 ~ /^[ \t]*export[ \t]+DB_ENGINE=/ || $0 ~ /^DB_ENGINE=/ {
        if (ENVIRON["DBS_SET"] == "1" && !done) { print ENVIRON["DBS_LINE"]; done = 1 }
        next
      }
      { print }
      END { if (ENVIRON["DBS_SET"] == "1" && !done) print ENVIRON["DBS_LINE"] }
    ' "$env_file" || true
  cur="$(env_key_lines DB_ENGINE)"
  if [[ "$DBS_ENV_SET" == "1" && "$cur" != "$DBS_ENV_LINE" ]] || [[ "$DBS_ENV_SET" != "1" && -n "$cur" ]]; then
    DBS_ERR="DB_ENGINE in .env could not be set back"
    return 1
  fi
  return 0
}

# dbs_restore_layout — the rollback itself, silent (DBS_ERR on failure): every
# directory recorded in DBS_DIRS that sits in the stash comes back, whatever is
# in its place goes to the set-aside directory first; a database directory that
# did not exist before is set aside as well. Then DB_ENGINE, then a check that
# the old layout is complete — only then the marker goes. Safe to repeat.
dbs_restore_layout() {
  local db="$ROOT_DIR/db" n stash rest
  DBS_ERR=""
  stash="$db/$DBS_STASH"
  # checked here, at the point of use, in every entry point (failed step,
  # signal, --rollback with a marker, undo): the names in the marker are
  # validated, but what sits under them may have been swapped since
  DBS_UNTOUCHED=1
  dbs_dir_usable "$DBS_STASH" || return 1
  if [[ -n "$DBS_ASIDE" ]]; then dbs_dir_usable "$DBS_ASIDE" || return 1; fi
  DBS_UNTOUCHED=0
  for n in "${DB_ENGINE_DIRS[@]}"; do
    if dbs_word_in "$n" "$DBS_DIRS"; then
      [[ -e "$stash/$n" || -L "$stash/$n" ]] || continue
      dbs_dir_usable "$DBS_STASH" || return 1
      if [[ -e "$db/$n" || -L "$db/$n" ]]; then
        dbs_set_aside "$n" || return 1
      fi
      dbs_move "$stash/$n" "$db/$n" || return 1
    elif [[ -e "$db/$n" || -L "$db/$n" ]]; then
      dbs_set_aside "$n" || return 1
    fi
  done
  dbs_env_put || return 1
  for n in "${DB_ENGINE_DIRS[@]}"; do
    if dbs_word_in "$n" "$DBS_DIRS"; then
      if [[ ! -d "$db/$n" ]] || [[ -e "$stash/$n" || -L "$stash/$n" ]]; then
        DBS_ERR="db/$n is not back in place"
        return 1
      fi
    elif [[ -e "$db/$n" || -L "$db/$n" ]]; then
      DBS_ERR="db/$n is still there"
      return 1
    fi
  done
  # rmdir removes the stash only when it is empty; its notes (.switch-env,
  # .switch-dirs) are this script's own and go with it
  if dbs_own_dir "$stash"; then
    rest="$(find "$stash" -mindepth 1 -maxdepth 1 ! -name "$DBS_ENV_NOTE" ! -name "$DBS_DIRS_NOTE" -print -quit 2>/dev/null)" || rest="?"
    if [[ -z "$rest" ]]; then
      rm -f -- "${stash:?}/$DBS_ENV_NOTE" "${stash:?}/$DBS_DIRS_NOTE" 2>/dev/null
    fi
    rmdir -- "$stash" 2>/dev/null || true
  fi
  rm -f -- "$DB_SWITCH_MARKER" 2>/dev/null
  if [[ -e "$DB_SWITCH_MARKER" || -L "$DB_SWITCH_MARKER" ]]; then
    DBS_ERR="cannot remove db/.switch-in-progress"
    return 1
  fi
  DBS_ACTIVE=0
  return 0
}

# The engine a rollback brings back ("mixed" for a mixed layout).
dbs_back_engine() {
  if [[ "$DBS_STASH" == .pre-switch-mixed-* ]]; then
    printf 'mixed'
  elif [[ "$DBS_KIND" == "undo" ]]; then
    printf '%s' "$DBS_TARGET"
  else
    printf '%s' "$DBS_SOURCE"
  fi
}

# What a rollback did to DB_ENGINE, for the messages.
dbs_env_back_text() {
  local was
  case "$DBS_ENV_FIX" in
    "") printf 'DB_ENGINE is as before'; return 0 ;;
    unset) was="no DB_ENGINE (lmdb)" ;;
    other) was="an unknown DB_ENGINE (lmdb)" ;;
    *) was="DB_ENGINE=$DBS_ENV_FIX" ;;
  esac
  printf 'DB_ENGINE is set to %s, the engine of that data (.env had %s, which did not match it)' "$DBS_SOURCE" "$was"
}

dbs_manual_steps() {
  local env_hint
  if [[ "$DBS_ENV_SET" == "1" ]]; then
    env_hint="set the DB_ENGINE line in .env back to: $(printable_text "$DBS_ENV_LINE")"
  else
    env_hint="remove the DB_ENGINE line from .env"
  fi
  warn_plain "The automatic rollback did not finish: $(printable_text "$DBS_ERR")." || true
  warn "db/.switch-in-progress stays, so './$SCRIPT_NAME start' refuses until the old layout is back. To finish by hand:" || true
  info_plain "  1. For each of $DB_ENGINE_DIRS_TEXT that is in db/$DBS_STASH/: move db/<name> (if there) into db/${DBS_ASIDE:-.failed-manual}/, then: mv db/$DBS_STASH/<name> db/<name>" || true
  info_plain "  2. $env_hint" || true
  info_plain "  3. Remove db/.switch-in-progress, then run './$SCRIPT_NAME start'." || true
  info "Or remove the cause and run './$SCRIPT_NAME db-switch --rollback' again; it continues where it stopped." || true
}

# Signal hooks (see oneshot_on_signal).
dbs_signal_rollback() {
  [[ "$DBS_ACTIVE" == "1" ]] || return 0
  if dbs_restore_layout; then
    DBS_ROLLED=1
    return 0
  fi
  DBS_ROLLED=2
  return 1
}

dbs_signal_report() {
  local blocked="$1" back
  back="$(dbs_back_engine)"
  if [[ "$blocked" == "1" && "$DBS_ACTIVE" == "1" ]]; then
    warn "Interrupted in step '$DBS_STEP' and NOT rolled back: the one-shot container still runs and may write to db/." || true
    warn "Once it has stopped, run './$SCRIPT_NAME db-switch --rollback'." || true
    dbs_result failed
  elif [[ "$DBS_ROLLED" == "1" ]]; then
    info "Rolled back: the $back directories are in db/ again and $(dbs_env_back_text)." || true
    [[ -z "$DBS_ASIDE" ]] || info_plain "What the interrupted run produced is kept in db/$DBS_ASIDE/." || true
    [[ "$DBS_KIND" != "switch" || ! -f "$BACKUP_DIR/$DBS_BACKUP" ]] || info_plain "The verified backup made before the switch stays: backups/$DBS_BACKUP" || true
    dbs_result rolled-back
  elif [[ "$DBS_ROLLED" == "2" ]]; then
    dbs_manual_steps
    dbs_result failed
  elif [[ "$DBS_STEP" == "done" ]]; then
    info "The switch had completed before the signal: db/ holds $DBS_TARGET data and DB_ENGINE=$DBS_TARGET; the old directories are in db/$DBS_STASH/." || true
    # ok only when the relay is as the user had it: a relay that ran before and
    # is down now is a failure, whatever the data looks like
    if [[ "$DBS_RELAY_WAS_RUNNING" == "1" ]] && ! relay_container_running; then
      warn "The relay ran before the switch and is NOT running now. Check './$SCRIPT_NAME logs relay', then start it with './$SCRIPT_NAME start' — or go back with './$SCRIPT_NAME db-switch --rollback'." || true
      dbs_result failed
    else
      dbs_result ok
    fi
  else
    info "Nothing was changed: db/ and DB_ENGINE are as before." || true
    [[ "$DBS_KIND" != "switch" || -z "$DBS_BACKUP" || ! -f "$BACKUP_DIR/$DBS_BACKUP" ]] || info_plain "The verified backup made before the switch stays: backups/$DBS_BACKUP" || true
    dbs_result failed
  fi
}

# dbs_fail <compose_file> <reason> — a step failed: roll back when step 4 has
# begun, start the relay on the old engine when it ran before, say which state
# the installation is in. Always returns 1.
dbs_fail() {
  local compose_file="$1" why="$2" rolled=0 relay_rc=0 back
  # the rollback runs to its end; a signal now would only cut it short
  trap '' INT TERM HUP
  if [[ "$DBS_ACTIVE" == "1" ]]; then
    if dbs_restore_layout; then rolled=1; else rolled=2; fi
  fi
  if [[ "$rolled" != "2" && "$DBS_RELAY_WAS_RUNNING" == "1" ]] && ! relay_container_running; then
    relay_start_again "$compose_file" || relay_rc=1
  fi
  oneshot_guard_off
  back="$(dbs_back_engine)"
  # no rollback ran although the directories had already moved (step 7 could
  # not put the marker back): the new database is in place, not the old one
  local late=0
  if [[ "$rolled" == "0" ]] && ! dbs_word_in "$DBS_STEP" "stop backup move"; then
    late=1
    back="$DBS_TARGET"
  fi

  warn_plain "The engine switch failed: $why" || true
  case "$rolled" in
    0)
      if [[ "$late" == "1" ]]; then
        warn "Not rolled back: db/ holds the new $DBS_TARGET database and DB_ENGINE=$DBS_TARGET; the old directories are in db/$DBS_STASH/. To go back: './$SCRIPT_NAME db-switch --rollback'." || true
      else
        info "Nothing was changed: db/ and DB_ENGINE are as before." || true
      fi
      ;;
    1)
      info "Rolled back: the $back directories are in db/ again and $(dbs_env_back_text)." || true
      [[ -z "$DBS_ASIDE" ]] || info_plain "What the failed run produced is kept in db/$DBS_ASIDE/ (remove it when you no longer need it)." || true
      ;;
    2) dbs_manual_steps ;;
  esac
  if [[ "$DBS_KIND" == "switch" && -n "$DBS_BACKUP" && -f "$BACKUP_DIR/$DBS_BACKUP" ]]; then
    info_plain "The verified backup made before the switch stays: backups/$DBS_BACKUP" || true
  fi
  if [[ "$rolled" == "2" ]]; then
    warn "The relay was not started." || true
  elif relay_container_running; then
    info "The relay is running ($back)." || true
  elif [[ "$relay_rc" -ne 0 ]]; then
    warn "The relay did not start again; it is NOT running. Check './$SCRIPT_NAME logs relay', then start it with './$SCRIPT_NAME start'." || true
  else
    info "The relay was not running before and was not started." || true
  fi
  if [[ "$rolled" == "1" ]]; then dbs_result rolled-back; else dbs_result failed; fi
  return 1
}

# zip_entry_crcs <compose_file> <zip in backups/> — "name crc" per entry,
# sorted. The host unzip reads them when there is one; without it the image's
# own (busybox) unzip does, one-shot as in verify_backup_zip: its -v listing has
# the columns of Info-ZIP's (CRC-32 in field 7, name in field 8; measured on
# v1.2.2-7). A listing that cannot be read gives no lines, never a made-up one.
zip_entry_crcs() {
  local compose_file="$1" f="$2" listing=""
  if command -v "$HOST_UNZIP" >/dev/null 2>&1; then
    listing="$("$HOST_UNZIP" -v "$f" 2>/dev/null)" || listing=""
  else
    # shellcheck disable=SC2016  # $1 expands inside the container's sh, not here
    listing="$(dc "$compose_file" run --rm --no-deps -T --name "$ONESHOT_CONTAINER" \
      -v "$BACKUP_DIR:/app/backups" --entrypoint sh relay \
      -c 'command -v unzip >/dev/null 2>&1 || exit 99; unzip -v "$1"' \
      sh "/app/backups/${f##*/}" 2>/dev/null)" || listing=""
  fi
  printf '%s\n' "$listing" | awk 'NF >= 8 && $7 ~ /^[0-9a-f]{8}$/ {print $8, $7}' | LC_ALL=C sort
}

# dbs_compare_crcs <compose_file> <zip> <zip> — 0 only when both backups list
# the same five entries with the same CRC32. Sets DBS_CRCS_BY.
DBS_CRCS_BY=""
dbs_compare_crcs() {
  local compose_file="$1" a b
  DBS_CRCS_BY="the image's unzip"
  if command -v "$HOST_UNZIP" >/dev/null 2>&1; then
    DBS_CRCS_BY="host unzip"
  fi
  a="$(zip_entry_crcs "$compose_file" "$2")" || a=""
  b="$(zip_entry_crcs "$compose_file" "$3")" || b=""
  if [[ "$(printf '%s\n' "$a" | awk 'NF {n++} END {print n + 0}')" -ne 5 ]]; then
    DBS_ERR="cannot read the entry CRCs of ${2##*/} with $DBS_CRCS_BY"
    return 1
  fi
  if [[ "$a" != "$b" ]]; then
    DBS_ERR="the backup of the new database differs from the backup of the old one (per-entry CRC32, read with $DBS_CRCS_BY) — old: ${a//$'\n'/, } — new: ${b//$'\n'/, }"
    return 1
  fi
  return 0
}

# dbs_common_checks — read-only checks shared by the switch and the undo; warns
# and returns 1 on the first that fails.
dbs_common_checks() {
  local db="$ROOT_DIR/db" uid gid lines out=""
  if [[ -e "$DB_SWITCH_MARKER" || -L "$DB_SWITCH_MARKER" ]]; then
    warn "An engine switch did not finish (db/.switch-in-progress exists). Run './$SCRIPT_NAME db-switch --rollback' first."
    return 1
  fi
  if [[ ! -f "$ROOT_DIR/.env" ]]; then
    warn ".env not found; the relay configuration is needed to know who owns db/ and which engine it runs."
    return 1
  fi
  lines="$(env_key_lines DB_ENGINE | awk 'END {print NR}')"
  if (( lines > 1 )); then
    warn ".env sets DB_ENGINE $lines times; keep one line, then run db-switch again."
    return 1
  fi
  if [[ -L "$db" && ! -e "$db" ]]; then
    warn_plain "db is a broken symlink: $db"
    return 1
  fi
  if [[ ! -d "$db" || ! -r "$db" || ! -x "$db" || ! -w "$db" ]]; then
    warn_plain "$db must be a directory this user can read and write; db-switch renames directories inside it."
    return 1
  fi
  uid="$(env_value_or_empty DOCKER_UID)"
  gid="$(env_value_or_empty DOCKER_GID)"
  [[ -n "$uid" ]] || uid="1000"
  [[ -n "$gid" ]] || gid="1000"
  if ! is_int "$uid"; then
    warn_plain "DOCKER_UID is not numeric ($(printable_text "$uid")); db-switch cannot check who owns db/ and does not run. Set a numeric DOCKER_UID in .env."
    return 1
  fi
  if ! out="$(find -H "$db" -mindepth 1 ! -user "$((10#$uid))" -print -quit 2>/dev/null)"; then
    warn_plain "Cannot read everything inside $db; db-switch does not run without checking it. Fix the permissions (sudo chown -R ${uid}:${gid} $db)."
    return 1
  fi
  if [[ -n "$out" ]]; then
    warn_plain "$(printable_text "${out#"$ROOT_DIR/"}") is not owned by uid $uid, the user the container runs as; the restored database could not be written next to it. Fix with: sudo chown -R ${uid}:${gid} $db"
    return 1
  fi
  oneshot_leftover_check || return 1
  return 0
}

# dbs_same_fs <dir names...> — every given db/<name> lives on the filesystem of
# db/ itself, so the moves are renames and never a copy.
dbs_same_fs() {
  local db="$ROOT_DIR/db" n dev_db dev
  dev_db="$(stat -L -c %d "$db" 2>/dev/null || stat -L -f %d "$db" 2>/dev/null || true)"
  for n in "$@"; do
    [[ -e "$db/$n" || -L "$db/$n" ]] || continue
    dev="$(stat -c %d "$db/$n" 2>/dev/null || stat -f %d "$db/$n" 2>/dev/null || true)"
    if [[ -z "$dev_db" || "$dev" != "$dev_db" ]]; then
      warn_plain "db/$n is on another filesystem than db/ (a mount point?); db-switch only renames inside db/ and does not copy. Move it by hand first."
      return 1
    fi
  done
  return 0
}

# Free space for two backups (before and after) and a second database.
dbs_space_check() {
  local db="$ROOT_DIR/db" bdir="$BACKUP_DIR" need free_b free_d dev_b dev_d n
  local -a paths=()
  [[ -d "$bdir" ]] || bdir="$ROOT_DIR"
  for n in "${DB_ENGINE_DIRS[@]}"; do
    [[ -e "$db/$n" ]] && paths+=("$db/$n")
  done
  need="$(du -skH "${paths[@]}" 2>/dev/null | awk '{s += $1} END {print s + 0}' || true)"
  free_b="$(df -Pk "$bdir" 2>/dev/null | awk 'NR==2 {print $4}' || true)"
  free_d="$(df -Pk "$db" 2>/dev/null | awk 'NR==2 {print $4}' || true)"
  dev_b="$(stat -L -c %d "$bdir" 2>/dev/null || stat -L -f %d "$bdir" 2>/dev/null || true)"
  dev_d="$(stat -L -c %d "$db" 2>/dev/null || stat -L -f %d "$db" 2>/dev/null || true)"
  if ! is_int "$need" || ! is_int "$free_b" || ! is_int "$free_d" || [[ -z "$dev_b" || -z "$dev_d" ]]; then
    warn "Could not measure the free space; continuing (every step is verified, a failure rolls back)."
    return 0
  fi
  if [[ "$dev_b" == "$dev_d" ]]; then
    if (( free_d < 3 * need )); then
      warn "Not enough free space: the switch needs about $((3 * need)) KiB (two backups and a second database of ${need} KiB), ${free_d} KiB are free."
      return 1
    fi
  elif (( free_b < 2 * need || free_d < need )); then
    warn "Not enough free space: backups/ needs about $((2 * need)) KiB (${free_b} KiB free), db/ about ${need} KiB (${free_d} KiB free)."
    return 1
  fi
  return 0
}

# dbs_confirm <question> — tty: ask; otherwise --yes is required.
dbs_confirm() {
  if [[ "$ASSUME_YES" == "1" ]]; then
    return 0
  fi
  if [[ -t 0 ]]; then
    ask_yes_no "$1 [y/N] " "n" && return 0
    info "Cancelled; nothing was changed."
    return 1
  fi
  warn "No terminal to ask for confirmation. Run again with --yes to go ahead."
  return 1
}

# dbs_env_disk_check <disk engine> <verb> — refuses when .env names the other
# engine explicitly: which one is current cannot be decided then. Unset or
# unknown values leave the decision to the disk (said out loud).
dbs_env_disk_check() {
  local disk="$1" state raw
  state="$(env_engine_state)"
  case "$state" in
    unset)
      info "DB_ENGINE is not set in .env (the relay would run lmdb); db/ holds $disk data — the disk decides." ;;
    other)
      raw="$(env_value_or_empty DB_ENGINE)"
      info_plain "DB_ENGINE in .env is '$(printable_text "$raw")', which is not an engine (the relay would run lmdb); db/ holds $disk data — the disk decides." ;;
    "$disk") : ;;
    *)
      warn ".env says DB_ENGINE=$state, but db/ holds $disk data ($DISK_DATA). Which engine is current cannot be decided safely, so nothing was changed."
      warn "If the relay should serve the $disk data, set DB_ENGINE=$disk in .env ('./$SCRIPT_NAME env'), then run './$SCRIPT_NAME $2' again."
      return 1
      ;;
  esac
  return 0
}

# dbs_not_one_engine <target> <engine .env runs> — the refusal for db/ that is
# not one clean engine (after db_disk_engine): the situation in plain words and
# the commands to choose from. Mixed directories are what a DB_ENGINE flip
# without a migration leaves behind (measured, plan P1: 5 of 5 directories).
dbs_not_one_engine() {
  local target="$1" eff="$2" old="badger"
  [[ "$eff" != "badger" ]] || old="lmdb"
  case "$DISK_ENGINE" in
    mixed)
      warn "Both engines have files in db/ ($DISK_BAD); nothing was changed."
      info "This happens when DB_ENGINE was changed without a migration: the relay does not move the data, it starts a new, empty database next to it. Since then the relay has been writing to $eff (the engine in .env); the $old files hold what was there before."
      info "Which side to keep is your decision. Choose one of:"
      info_plain "  ./$SCRIPT_NAME db-switch $target --from $(printf '%-6s' "$old")  carries over the events of the $old side (the data from before the change)"
      info_plain "  ./$SCRIPT_NAME db-switch $target --from $(printf '%-6s' "$eff")  carries over the events of the $eff side (what the relay received since)"
      info "Either way all files of both engines are kept in db/.pre-switch-mixed-<time>/, and events only on the other side are not merged."
      ;;
    split)
      warn "The directories in db/ disagree about the engine ($DISK_REPORT). Which engine holds your data cannot be decided for you, so nothing was changed."
      info "If you know which side to keep: './$SCRIPT_NAME db-switch $target --from badger' or './$SCRIPT_NAME db-switch $target --from lmdb'."
      ;;
    *)
      warn "Cannot tell the engine of: $DISK_BAD (unreadable, or files of neither engine). Nothing was changed."
      info "If you know which side to keep: './$SCRIPT_NAME db-switch $target --from badger' or './$SCRIPT_NAME db-switch $target --from lmdb'."
      ;;
  esac
}

# db_switch <engine> [from] — from (--from) picks the side of directories that
# hold both engines (or disagree) whose events are carried over.
db_switch() {
  local target="$1" from="${2:-}" mode compose_file source ts n relay_now db="$ROOT_DIR/db" state eff other rc=0 mixed=0

  # --- 1 preflight: nothing is stopped or written before all of this passed ---
  dbs_progress 1 "$DBS_STEPS" preflight
  if [[ "$target" != "badger" && "$target" != "lmdb" ]]; then
    warn_plain "Unknown engine '$(printable_text "$target")'. Use './$SCRIPT_NAME db-switch badger' or './$SCRIPT_NAME db-switch lmdb' (lower case), or '--rollback'."
    dbs_result failed
    return 1
  fi
  if ! docker info >/dev/null 2>&1; then
    warn "Docker daemon not reachable. Is Docker running?"
    dbs_result failed
    return 1
  fi
  mode="$(resolve_mode "db-switch")"
  compose_file="$(compose_file_for "$mode")"
  require_compose_file "$compose_file"
  if ! dbs_common_checks; then
    dbs_result failed
    return 1
  fi

  db_disk_engine
  state="$(env_engine_state)"
  eff="lmdb"
  [[ "$state" != "badger" ]] || eff="badger"
  case "$DISK_ENGINE" in
    mixed|split|unknown)
      if [[ -z "$from" ]]; then
        dbs_not_one_engine "$target" "$eff"
        dbs_result failed
        return 1
      fi
      mixed=1
      source="$from"
      info_plain "db/ is not one clean engine ($DISK_REPORT); --from $from: the $from side is carried over."
      ;;
    none)
      info "db/ holds no data, so there is nothing to move: only .env needs changing. Set DB_ENGINE=$target ('./$SCRIPT_NAME env') and start the relay."
      dbs_result failed
      return 1
      ;;
    *)
      if [[ -n "$from" && "$from" != "$DISK_ENGINE" ]]; then
        warn "--from $from does not match db/: it holds $DISK_ENGINE data only ($DISK_DATA), there is no $from side to carry over. Nothing was changed."
        info "To move the $DISK_ENGINE data: './$SCRIPT_NAME db-switch $target' (the disk decides, no --from needed)."
        dbs_result failed
        return 1
      fi
      source="$DISK_ENGINE"
      info "Found $source data in db/ ($DISK_DATA)."
      case "$state" in
        "$source") : ;;
        unset)
          info "DB_ENGINE is not set in .env (the relay would run lmdb); db/ holds $source data — the disk decides." ;;
        other)
          info_plain "DB_ENGINE in .env is '$(printable_text "$(env_value_or_empty DB_ENGINE)")', which is not an engine (the relay would run lmdb); db/ holds $source data — the disk decides." ;;
        *)
          info ".env says DB_ENGINE=$state, the data on disk is $source — the disk decides: the switch starts from the $source data." ;;
      esac
      if [[ "$source" == "$target" ]]; then
        warn "db/ already holds $target data; there is nothing to switch."
        [[ "$state" == "$target" ]] || info "Set DB_ENGINE=$target in .env so the relay opens it ('./$SCRIPT_NAME env')."
        dbs_result failed
        return 1
      fi
      ;;
  esac
  other="badger"
  [[ "$source" != "badger" ]] || other="lmdb"
  dbs_same_fs "${DB_ENGINE_DIRS[@]}" || { dbs_result failed; return 1; }
  backup_dir_check 0 || { dbs_result failed; return 1; }

  ts="$(dbs_ts)"
  DBS_KIND="switch"
  DBS_SOURCE="$source"
  DBS_TARGET="$target"
  DBS_TS="$ts"
  DBS_BACKUP="haven-pre-switch-$target-$ts.zip"
  DBS_BACKUP2="haven-post-switch-$target-$ts.zip"
  if [[ "$mixed" == "1" ]]; then
    DBS_STASH=".pre-switch-mixed-$ts"
  else
    DBS_STASH=".pre-switch-$source-$ts"
  fi
  DBS_ASIDE=""
  DBS_DIRS=""
  for n in "${DB_ENGINE_DIRS[@]}"; do
    [[ -e "$db/$n" || -L "$db/$n" ]] && DBS_DIRS+="$n "
  done
  DBS_DIRS="${DBS_DIRS% }"
  DBS_ENV_FIX=""
  if [[ -n "$(env_key_lines DB_ENGINE)" ]]; then
    DBS_ENV_SET=1
    DBS_ENV_LINE="$(env_key_lines DB_ENGINE)"
  else
    DBS_ENV_SET=0
    DBS_ENV_LINE=""
  fi
  # .env names another engine than the data (R3): a rollback must not put the
  # contradiction back — the relay would serve an empty database. It sets the
  # engine of the data instead (with the line's export prefix and quoting).
  if [[ "$mixed" == "0" && "$eff" != "$source" ]]; then
    DBS_ENV_FIX="$state"
    DBS_ENV_SET=1
    n=""
    [[ "$(env_key_lines DB_ENGINE | tail -n 1)" =~ ^[[:blank:]]*export[[:blank:]] ]] && n="export "
    DBS_ENV_LINE="${n}DB_ENGINE=$(wrap_like_raw "$(read_env_var DB_ENGINE 2>/dev/null || true)" "$source")"
  fi
  for n in "$BACKUP_DIR/$DBS_BACKUP" "$BACKUP_DIR/$DBS_BACKUP2" "$db/$DBS_STASH"; do
    if [[ -e "$n" || -L "$n" ]]; then
      warn_plain "$n already exists; try again in a second."
      dbs_result failed
      return 1
    fi
  done
  dbs_space_check || { dbs_result failed; return 1; }

  relay_now="the relay is not running and stays stopped"
  relay_container_running && relay_now="the relay is offline for the duration and is started again afterwards"
  if [[ "$mixed" == "1" ]]; then
    info "Make a clean $target database from the $source side of db/:"
    info "  - $relay_now"
    info "  - first a verified backup, read with DB_ENGINE=$source: backups/$DBS_BACKUP"
    info "  - the events of the $source side are carried over into the new $target database."
    info "  - events that exist only on the $other side stay in db/$DBS_STASH/ and are NOT merged."
    info "  - all files of both engines are kept in db/$DBS_STASH/ (this script never deletes them)"
  else
    info "Switch the relay database from $source to $target:"
    info "  - $relay_now"
    info "  - first a verified backup: backups/$DBS_BACKUP"
    info "  - the old directories are kept in db/$DBS_STASH/ (this script never deletes them)"
    if [[ -n "$DBS_ENV_FIX" ]]; then
      info "  - should the switch fail or be rolled back, DB_ENGINE becomes $source, the engine of the data (not the $eff from .env)"
    fi
  fi
  if [[ "$mixed" == "1" ]]; then
    dbs_confirm "Make a clean $target database from the $source side now?" || { dbs_result failed; return 1; }
  elif ! dbs_confirm "Switch from $source to $target now?"; then
    dbs_result failed
    return 1
  fi
  # bind-mount sources compose would otherwise create root-owned (may stop here)
  ensure_example_jsons
  ensure_data_dirs

  DBS_ACTIVE=0
  DBS_ROLLED=0
  DBS_RELAY_WAS_RUNNING=0
  DBS_STEP="stop"
  oneshot_guard_on "$compose_file" "engine switch"
  ONESHOT_GUARD_ROLLBACK="dbs_signal_rollback"
  ONESHOT_GUARD_REPORT="dbs_signal_report"
  ONESHOT_RELAY_RECREATE=1
  dbs_run "$compose_file" || rc=$?
  return "$rc"
}

# dbs_run <compose_file> — steps 2 to 7, inside the signal guard. Messages here
# are best effort (|| true); every step checks its own result.
dbs_run() {
  local compose_file="$1" db="$ROOT_DIR/db" partial status n vrc

  # --- 2 stop ---
  dbs_progress 2 "$DBS_STEPS" stop
  if ! relay_stop_for_oneshot "$compose_file" "engine switch"; then
    DBS_RELAY_WAS_RUNNING="$ONESHOT_RELAY_WAS_RUNNING"
    dbs_fail "$compose_file" "the relay did not stop."
    return 1
  fi
  DBS_RELAY_WAS_RUNNING="$ONESHOT_RELAY_WAS_RUNNING"

  # --- 3 backup (DB_ENGINE given explicitly: .env may name no engine) ---
  dbs_progress 3 "$DBS_STEPS" backup
  DBS_STEP="backup"
  backup_dir_check 1 || { dbs_fail "$compose_file" "backups/ is not usable."; return 1; }
  partial="$BACKUP_DIR/$DBS_BACKUP.partial-$(random_suffix)"
  ONESHOT_GUARD_PARTIAL="$partial"
  info "Backing up the $DBS_SOURCE database to backups/$DBS_BACKUP..." || true
  status=0
  backup_oneshot_to "$compose_file" "$partial" -e "DB_ENGINE=$DBS_SOURCE" || status=$?
  ONESHOT_GUARD_PARTIAL=""
  if ! backup_finish "$compose_file" "$status" "$partial" "$BACKUP_DIR/$DBS_BACKUP"; then
    dbs_fail "$compose_file" "the backup before the switch did not succeed."
    return 1
  fi
  success_plain "Backup verified: backups/$DBS_BACKUP" || true
  dbs_hook after-backup || { dbs_fail "$compose_file" "$DBS_ERR."; return 1; }

  # --- 4 move ---
  dbs_progress 4 "$DBS_STEPS" move
  DBS_STEP="move"
  if ! dbs_write_marker; then
    rm -f -- "$DB_SWITCH_MARKER" 2>/dev/null
    dbs_fail "$compose_file" "cannot write db/.switch-in-progress."
    return 1
  fi
  DBS_ACTIVE=1
  if ! mkdir -m 700 -- "$db/$DBS_STASH" 2>/dev/null; then
    # nothing has moved yet, and whatever holds the name now is not this run's:
    # no rollback through it — the marker goes and the run ends here
    DBS_ERR="cannot create db/$DBS_STASH"
    rm -f -- "$DB_SWITCH_MARKER" 2>/dev/null
    if [[ -e "$DB_SWITCH_MARKER" || -L "$DB_SWITCH_MARKER" ]]; then
      DBS_ERR+=", and db/.switch-in-progress could not be removed (nothing was moved: remove it by hand)"
    fi
    DBS_ACTIVE=0
    dbs_fail "$compose_file" "$DBS_ERR."
    return 1
  fi
  if [[ "$DBS_STASH" == .pre-switch-mixed-* ]] \
    && ! printf 'env_set=%s\nenv_line=%s\n' "$DBS_ENV_SET" "$DBS_ENV_LINE" > "$db/$DBS_STASH/$DBS_ENV_NOTE" 2>/dev/null; then
    dbs_fail "$compose_file" "cannot write db/$DBS_STASH/$DBS_ENV_NOTE."
    return 1
  fi
  if ! printf 'dirs=%s\n' "$DBS_DIRS" > "$db/$DBS_STASH/$DBS_DIRS_NOTE" 2>/dev/null; then
    dbs_fail "$compose_file" "cannot write db/$DBS_STASH/$DBS_DIRS_NOTE."
    return 1
  fi
  for n in "${DB_ENGINE_DIRS[@]}"; do
    dbs_word_in "$n" "$DBS_DIRS" || continue
    dbs_dir_usable "$DBS_STASH" || { dbs_fail "$compose_file" "$DBS_ERR."; return 1; }
    dbs_move "$db/$n" "$db/$DBS_STASH/$n" || { dbs_fail "$compose_file" "$DBS_ERR."; return 1; }
  done
  DBS_STEP="moved"
  dbs_write_marker || { dbs_fail "$compose_file" "cannot update db/.switch-in-progress."; return 1; }
  if [[ "$DBS_STASH" == .pre-switch-mixed-* ]]; then
    info_plain "Moved the directories (files of both engines) to db/$DBS_STASH/." || true
  else
    info_plain "Moved the $DBS_SOURCE directories to db/$DBS_STASH/." || true
  fi
  dbs_hook after-move || { dbs_fail "$compose_file" "$DBS_ERR."; return 1; }

  # --- 5 config ---
  dbs_progress 5 "$DBS_STEPS" config
  dbs_set_engine "$DBS_TARGET" || { dbs_fail "$compose_file" "$DBS_ERR."; return 1; }
  DBS_STEP="config"
  dbs_write_marker || { dbs_fail "$compose_file" "cannot update db/.switch-in-progress."; return 1; }
  info "Set DB_ENGINE=$DBS_TARGET in .env." || true
  dbs_hook after-config || { dbs_fail "$compose_file" "$DBS_ERR."; return 1; }

  # --- 6 restore, then a second backup whose entries must equal the first ---
  dbs_progress 6 "$DBS_STEPS" restore
  vrc=0
  if ! backup_file_owned "$BACKUP_DIR/$DBS_BACKUP"; then
    dbs_fail "$compose_file" "backups/$DBS_BACKUP cannot be used for the restore."
    return 1
  fi
  verify_backup_zip "$compose_file" "$BACKUP_DIR/$DBS_BACKUP" || vrc=$?
  if [[ "$vrc" -ne 0 ]]; then
    dbs_fail "$compose_file" "backups/$DBS_BACKUP no longer verifies."
    return 1
  fi
  dbs_hook before-restore || { dbs_fail "$compose_file" "$DBS_ERR."; return 1; }
  info "Restoring into a new $DBS_TARGET database..." || true
  status=0
  restore_oneshot "$compose_file" "$DBS_BACKUP" -e "DB_ENGINE=$DBS_TARGET" || status=$?
  if [[ "$status" -ne 0 ]]; then
    dbs_fail "$compose_file" "the restore exited with status $status."
    return 1
  fi
  DBS_STEP="restored"
  dbs_write_marker || { dbs_fail "$compose_file" "cannot update db/.switch-in-progress."; return 1; }
  dbs_hook after-restore || { dbs_fail "$compose_file" "$DBS_ERR."; return 1; }
  db_disk_engine
  if [[ "$DISK_ENGINE" != "$DBS_TARGET" ]]; then
    dbs_fail "$compose_file" "after the restore db/ does not hold $DBS_TARGET data ($DISK_REPORT)."
    return 1
  fi
  partial="$BACKUP_DIR/$DBS_BACKUP2.partial-$(random_suffix)"
  ONESHOT_GUARD_PARTIAL="$partial"
  info "Backing up the new $DBS_TARGET database to compare it..." || true
  status=0
  backup_oneshot_to "$compose_file" "$partial" -e "DB_ENGINE=$DBS_TARGET" || status=$?
  ONESHOT_GUARD_PARTIAL=""
  if ! backup_finish "$compose_file" "$status" "$partial" "$BACKUP_DIR/$DBS_BACKUP2"; then
    dbs_fail "$compose_file" "the backup of the new database did not succeed."
    return 1
  fi
  if ! dbs_compare_crcs "$compose_file" "$BACKUP_DIR/$DBS_BACKUP" "$BACKUP_DIR/$DBS_BACKUP2"; then
    dbs_fail "$compose_file" "$DBS_ERR."
    return 1
  fi
  DBS_STEP="verified"
  dbs_write_marker || { dbs_fail "$compose_file" "cannot update db/.switch-in-progress."; return 1; }
  success "The new $DBS_TARGET database holds the same entries as the old one (per-entry CRC32 of both backups, read with $DBS_CRCS_BY)." || true

  # --- 7 start ---
  dbs_progress 7 "$DBS_STEPS" start
  rm -f -- "$DB_SWITCH_MARKER" 2>/dev/null
  if [[ -e "$DB_SWITCH_MARKER" || -L "$DB_SWITCH_MARKER" ]]; then
    dbs_fail "$compose_file" "cannot remove db/.switch-in-progress."
    return 1
  fi
  DBS_ACTIVE=0
  DBS_STEP="done"
  if [[ "$DBS_RELAY_WAS_RUNNING" == "1" ]]; then
    info "Starting the relay on $DBS_TARGET..." || true
    if ! relay_start_again "$compose_file"; then
      # the marker comes back first, so an interrupted rollback can be resumed
      DBS_STEP="start"
      if dbs_write_marker; then
        DBS_ACTIVE=1
        dbs_fail "$compose_file" "the relay did not start on $DBS_TARGET."
      else
        dbs_fail "$compose_file" "the relay did not start on $DBS_TARGET, and db/.switch-in-progress could not be written to roll back; db/ holds the new $DBS_TARGET database, the old directories are in db/$DBS_STASH/."
      fi
      return 1
    fi
  fi
  oneshot_guard_off

  if [[ "$DBS_STASH" == .pre-switch-mixed-* ]]; then
    success "The relay database is a clean $DBS_TARGET database with the events of the $DBS_SOURCE side."
    info_plain "Backup of the $DBS_SOURCE side: backups/$DBS_BACKUP"
    info_plain "Backup of the new $DBS_TARGET database: backups/$DBS_BACKUP2"
    info_plain "The mixed directories (files of both engines) are kept in db/$DBS_STASH/ — events only on the other side are there and were not merged; this script never deletes them."
    info "To go back to the mixed layout: './$SCRIPT_NAME db-switch --rollback' (events received after the switch stay in the $DBS_TARGET directories and are not carried back)."
  else
    success "Switched the relay database from $DBS_SOURCE to $DBS_TARGET."
    info_plain "Backup of the old $DBS_SOURCE database: backups/$DBS_BACKUP"
    info_plain "Backup of the new $DBS_TARGET database: backups/$DBS_BACKUP2"
    info_plain "The old $DBS_SOURCE directories are kept in db/$DBS_STASH/ — this script never deletes them; removing them is your own step once you are sure the relay serves everything."
    info "To go back: './$SCRIPT_NAME db-switch --rollback' (events received after the switch stay in the $DBS_TARGET directories and are not carried back)."
  fi
  if [[ "$DBS_RELAY_WAS_RUNNING" == "1" ]]; then
    info "The relay is running on $DBS_TARGET."
  else
    info "The relay was not running before and was not started."
  fi
  dbs_result ok
  return 0
}

# dbs_set_engine <engine> — step 5: DB_ENGINE through set_env_var (and its
# config backup), keeping the quoting of the old value; read back afterwards.
dbs_set_engine() {
  local env_file="$ROOT_DIR/.env" raw
  if [[ ! -f "$env_file" || ! -w "$env_file" ]]; then
    DBS_ERR=".env is not writable, so DB_ENGINE cannot be set to $1"
    return 1
  fi
  raw="$(read_env_var DB_ENGINE 2>/dev/null || true)"
  set_env_var DB_ENGINE "$(wrap_like_raw "$raw" "$1")"
  if [[ "$(env_value_or_empty DB_ENGINE)" != "$1" || "$(env_key_lines DB_ENGINE | awk 'END {print NR}')" -ne 1 ]]; then
    DBS_ERR="DB_ENGINE in .env could not be set to $1"
    return 1
  fi
  return 0
}

# db_switch_rollback — with a marker: finish the rollback it records; without:
# undo the last completed switch (db/.pre-switch-*).
db_switch_rollback() {
  local mode compose_file relay_rc=0 back

  dbs_progress 1 4 preflight
  if ! docker info >/dev/null 2>&1; then
    warn "Docker daemon not reachable. Is Docker running?"
    dbs_result failed
    return 1
  fi
  mode="$(resolve_mode "db-switch")"
  compose_file="$(compose_file_for "$mode")"
  require_compose_file "$compose_file"
  if [[ ! -e "$DB_SWITCH_MARKER" && ! -L "$DB_SWITCH_MARKER" ]]; then
    dbs_undo_last "$compose_file"
    return $?
  fi

  if ! dbs_load_marker; then
    warn_plain "db/.switch-in-progress is not a marker this script can use ($DBS_ERR); nothing was changed."
    info "Look at it ('cat db/.switch-in-progress') and at db/.pre-switch-*/; put the directories back by hand, then remove the marker."
    dbs_result failed
    return 1
  fi
  oneshot_leftover_check || { dbs_result failed; return 1; }
  back="$(dbs_back_engine)"
  info_plain "Unfinished engine switch found ($DBS_KIND $DBS_SOURCE -> $DBS_TARGET, step '$DBS_STEP'); putting the $back directories back."

  DBS_ROLLED=0
  oneshot_guard_on "$compose_file" "engine switch rollback"
  ONESHOT_GUARD_ROLLBACK="dbs_signal_rollback"
  ONESHOT_GUARD_REPORT="dbs_signal_report"
  ONESHOT_RELAY_RECREATE=1
  dbs_progress 2 4 stop
  if ! relay_stop_for_oneshot "$compose_file" "rollback"; then
    oneshot_guard_off
    dbs_result failed
    return 1
  fi
  [[ "$ONESHOT_RELAY_WAS_RUNNING" != "1" ]] || DBS_RELAY_WAS_RUNNING=1
  ONESHOT_RELAY_WAS_RUNNING="$DBS_RELAY_WAS_RUNNING"
  DBS_ACTIVE=1
  dbs_progress 3 4 rollback
  trap '' INT TERM HUP
  if ! dbs_restore_layout; then
    oneshot_guard_off
    dbs_manual_steps
    warn "The relay was not started." || true
    dbs_result failed
    return 1
  fi
  dbs_progress 4 4 start
  if [[ "$DBS_RELAY_WAS_RUNNING" == "1" ]]; then
    relay_start_again "$compose_file" || relay_rc=1
  fi
  oneshot_guard_off
  dbs_rolled_back_report "$relay_rc"
  return "$relay_rc"
}

dbs_rolled_back_report() {
  local back
  back="$(dbs_back_engine)"
  success "Rolled back: the $back directories are in db/ again and $(dbs_env_back_text)."
  if [[ -n "$DBS_ASIDE" ]]; then
    if [[ "$DBS_KIND" == "undo" ]]; then
      info_plain "The $DBS_SOURCE directories are kept in db/$DBS_ASIDE/ — events received since the switch are there and were NOT merged back."
    else
      info_plain "What the unfinished switch produced is kept in db/$DBS_ASIDE/ (remove it when you no longer need it)."
    fi
  fi
  if [[ "$1" -ne 0 ]]; then
    warn "The relay did not start again; it is NOT running. Check './$SCRIPT_NAME logs relay', then start it with './$SCRIPT_NAME start'."
  elif relay_container_running; then
    info "The relay is running ($back)."
  else
    info "The relay was not running and was not started."
  fi
  dbs_result rolled-back
}

# dbs_stash_complete <stash name> — 0 when db/<stash>/.switch-dirs exists and
# every directory it names is in the stash; sets DBS_NOTE_DIRS to those names.
# Otherwise 1 with DBS_ERR naming what is missing. db-switch writes the note
# into every stash; no released version wrote a stash without it.
DBS_NOTE_DIRS=""
dbs_stash_complete() {
  local s="$ROOT_DIR/db/$1" l dirs="" seen=0 n gone="" names=""
  local -a words=()
  DBS_NOTE_DIRS=""
  if [[ -f "$s/$DBS_DIRS_NOTE" && ! -L "$s/$DBS_DIRS_NOTE" && -r "$s/$DBS_DIRS_NOTE" ]]; then
    while IFS= read -r l || [[ -n "$l" ]]; do
      if [[ "$l" == dirs=* ]]; then dirs="${l#dirs=}"; seen=1; fi
    done < "$s/$DBS_DIRS_NOTE"
  fi
  if [[ "$seen" != "1" ]]; then
    DBS_ERR="db/$1/$DBS_DIRS_NOTE is missing or unreadable, so which directories the switch put there is unknown"
    return 1
  fi
  IFS=' ' read -r -a words <<< "$dirs"
  if [[ "${#words[@]}" -eq 0 ]]; then
    DBS_ERR="db/$1/$DBS_DIRS_NOTE names no directory"
    return 1
  fi
  for n in "${words[@]}"; do
    if ! dbs_word_in "$n" "$DB_ENGINE_DIRS_TEXT"; then
      DBS_ERR="db/$1/$DBS_DIRS_NOTE names an unknown directory"
      return 1
    fi
    [[ -e "$s/$n" || -L "$s/$n" ]] || gone+="$n "
    names+="$n "
  done
  if [[ -n "$gone" ]]; then
    DBS_ERR="db/$1/ is incomplete: the switch put ${dirs} there, and ${gone% } is missing (removed by hand?)"
    return 1
  fi
  DBS_NOTE_DIRS="${names% }"
  return 0
}

# dbs_undo_last <compose_file> — no marker: put back the directories of the
# last completed switch (the newest db/.pre-switch-<engine>-<ts>/), the current
# ones go to db/.post-switch-<engine>-<ts>/.
dbs_undo_last() {
  local compose_file="$1" db="$ROOT_DIR/db" d name best="" best_ts="" e_old e_cur ts n raw prefix relay_rc=0
  local note_set="" note_line="" l
  for d in "$db"/.pre-switch-*; do
    [[ -d "$d" && ! -L "$d" ]] || continue
    name="${d##*/}"
    [[ "$name" =~ ^\.pre-switch-(badger|lmdb|mixed)-([0-9]{8}-[0-9]{6})$ ]] || continue
    if [[ -z "$best" || "${BASH_REMATCH[2]}" > "$best_ts" ]]; then
      best="$name"
      best_ts="${BASH_REMATCH[2]}"
      e_old="${BASH_REMATCH[1]}"
    fi
  done
  if [[ -z "$best" ]]; then
    info "Nothing to roll back: no unfinished switch (db/.switch-in-progress) and no earlier switch (db/.pre-switch-*)."
    dbs_result ok
    return 0
  fi
  for d in "$db"/.post-switch-*; do
    name="${d##*/}"
    if [[ -d "$d" && "$name" =~ ^\.post-switch-(badger|lmdb)-([0-9]{8}-[0-9]{6})(-[0-9]+)?$ && ! "${BASH_REMATCH[2]}" < "$best_ts" ]]; then
      info_plain "Nothing to roll back: the last switch was already rolled back (db/$name/ is not older than db/$best/)."
      dbs_result ok
      return 0
    fi
  done

  if ! dbs_common_checks; then
    dbs_result failed
    return 1
  fi
  # what the switch put into the stash (its .switch-dirs note) must all still
  # be there: an undo sets every current directory aside, so a stash thinned by
  # hand would leave the relay with less than before — or with nothing
  if ! dbs_stash_complete "$best"; then
    warn_plain "$DBS_ERR; nothing was changed."
    info "The current directories stay in use. To go back anyway, put the directories back by hand: move db/<name> aside, mv db/$best/<name> db/<name>, and set DB_ENGINE to the engine of that data."
    dbs_result failed
    return 1
  fi
  if [[ "$e_old" == "mixed" ]]; then
    # a mixed stash is put back as it is; its DB_ENGINE line comes from the
    # note the switch left in it — without that note, refuse rather than guess
    if [[ -f "$db/$best/$DBS_ENV_NOTE" && ! -L "$db/$best/$DBS_ENV_NOTE" ]]; then
      while IFS= read -r l || [[ -n "$l" ]]; do
        case "$l" in
          env_set=*) note_set="${l#env_set=}" ;;
          env_line=*) note_line="${l#env_line=}" ;;
        esac
      done < "$db/$best/$DBS_ENV_NOTE"
    fi
    if [[ ! "$note_set" =~ ^[01]$ ]] || [[ "$note_set" == "1" && ! "$note_line" =~ ^[[:blank:]]*(export[[:blank:]]+)?DB_ENGINE= ]]; then
      warn_plain "db/$best/$DBS_ENV_NOTE is missing or unreadable, so the DB_ENGINE that belongs to the mixed layout is unknown; nothing was changed."
      info "Put the directories back by hand: move db/<name> aside, mv db/$best/<name> db/<name>, and set DB_ENGINE as it was before the switch."
      dbs_result failed
      return 1
    fi
  else
    db_disk_engine "$db/$best"
    if [[ "$DISK_ENGINE" != "$e_old" ]]; then
      warn_plain "db/$best/ does not hold clean $e_old data ($DISK_REPORT); nothing was changed."
      dbs_result failed
      return 1
    fi
  fi
  DBS_DIRS="$DBS_NOTE_DIRS"
  db_disk_engine
  case "$DISK_ENGINE" in
    none)
      if [[ "$e_old" == "mixed" ]]; then
        e_cur="lmdb"
        [[ "$(env_engine_state)" != "badger" ]] || e_cur="badger"
      else
        e_cur="$( [[ "$e_old" == badger ]] && echo lmdb || echo badger )"
      fi
      ;;
    badger|lmdb)
      e_cur="$DISK_ENGINE"
      if [[ "$e_cur" == "$e_old" ]]; then
        warn_plain "db/ already holds $e_old data, like db/$best/; there is no switch to undo. Nothing was changed."
        dbs_result failed
        return 1
      fi
      dbs_env_disk_check "$e_cur" "db-switch --rollback" || { dbs_result failed; return 1; }
      ;;
    *)
      warn "The current directories in db/ are not one clean engine ($DISK_REPORT); nothing was changed."
      dbs_result failed
      return 1
      ;;
  esac
  dbs_same_fs "${DB_ENGINE_DIRS[@]}" || { dbs_result failed; return 1; }

  ts="$(dbs_ts)"
  DBS_KIND="undo"
  DBS_SOURCE="$e_cur"
  DBS_TARGET="$e_old"
  DBS_TS="$ts"
  DBS_BACKUP=""
  DBS_STASH="$best"
  DBS_ASIDE="$(dbs_unique ".post-switch-$e_cur-$ts")"
  DBS_ENV_FIX=""
  if [[ "$e_old" == "mixed" ]]; then
    # the marker wants an engine here; the label comes from the stash name
    DBS_TARGET="$e_cur"
    DBS_ENV_SET="$note_set"
    DBS_ENV_LINE="$note_line"
  else
    raw="$(read_env_var DB_ENGINE 2>/dev/null || true)"
    prefix=""
    [[ "$(env_key_lines DB_ENGINE | tail -n 1)" =~ ^[[:blank:]]*export[[:blank:]] ]] && prefix="export "
    DBS_ENV_SET=1
    DBS_ENV_LINE="${prefix}DB_ENGINE=$(wrap_like_raw "$raw" "$e_old")"
  fi
  DBS_STEP="undo"
  DBS_RELAY_WAS_RUNNING=0
  relay_container_running && DBS_RELAY_WAS_RUNNING=1

  info "Undo the last engine switch (db/$best/):"
  info "  - the current $e_cur directories go to db/$DBS_ASIDE/; events received since the switch stay there and are NOT merged back"
  if [[ "$e_old" == "mixed" ]]; then
    if [[ "$DBS_ENV_SET" == "1" ]]; then
      info_plain "  - the mixed directories from db/$best/ come back as they were, and the DB_ENGINE line from before the switch: $(printable_text "$DBS_ENV_LINE")"
    else
      info "  - the mixed directories from db/$best/ come back as they were; DB_ENGINE was not set before the switch and is removed (the relay runs lmdb)"
    fi
  else
    info "  - the $e_old directories from db/$best/ come back, DB_ENGINE becomes $e_old"
  fi
  if [[ "$DBS_RELAY_WAS_RUNNING" == "1" ]]; then
    info "  - the relay is offline meanwhile and is started again afterwards"
  fi
  if ! dbs_confirm "Undo the switch now?"; then
    dbs_result failed
    return 1
  fi

  DBS_ROLLED=0
  oneshot_guard_on "$compose_file" "engine switch rollback"
  ONESHOT_GUARD_ROLLBACK="dbs_signal_rollback"
  ONESHOT_GUARD_REPORT="dbs_signal_report"
  ONESHOT_RELAY_RECREATE=1
  dbs_progress 2 4 stop
  if ! relay_stop_for_oneshot "$compose_file" "rollback"; then
    oneshot_guard_off
    dbs_result failed
    return 1
  fi
  if ! dbs_write_marker; then
    rm -f -- "$DB_SWITCH_MARKER" 2>/dev/null
    relay_restart_after_oneshot "$compose_file" "$DBS_RELAY_WAS_RUNNING" || true
    oneshot_guard_off
    warn "Cannot write db/.switch-in-progress; nothing was changed."
    dbs_result failed
    return 1
  fi
  DBS_ACTIVE=1
  dbs_progress 3 4 rollback
  trap '' INT TERM HUP
  if ! dbs_restore_layout; then
    if [[ "$DBS_UNTOUCHED" == "1" ]]; then
      # refused before the first move: the current layout is intact, so the
      # marker goes and the relay comes back as it was
      rm -f -- "$DB_SWITCH_MARKER" 2>/dev/null
      if [[ ! -e "$DB_SWITCH_MARKER" && ! -L "$DB_SWITCH_MARKER" ]]; then
        DBS_ACTIVE=0
        relay_restart_after_oneshot "$compose_file" "$DBS_RELAY_WAS_RUNNING" || true
        oneshot_guard_off
        warn_plain "The undo did not run: $(printable_text "$DBS_ERR")." || true
        info "Nothing was changed: db/ and DB_ENGINE are as before." || true
        dbs_result failed
        return 1
      fi
    fi
    oneshot_guard_off
    dbs_manual_steps
    warn "The relay was not started." || true
    dbs_result failed
    return 1
  fi
  dbs_progress 4 4 start
  if [[ "$DBS_RELAY_WAS_RUNNING" == "1" ]]; then
    relay_start_again "$compose_file" || relay_rc=1
  fi
  oneshot_guard_off
  dbs_rolled_back_report "$relay_rc"
  return "$relay_rc"
}

start_services() {
  local mode="$1"
  local compose_file
  local args=(up -d)

  compose_file="$(compose_file_for "$mode")"
  require_compose_file "$compose_file"

  # return, not die: in the TUI the caller shows the warnings in its own box
  if start_blocked; then return 1; fi

  # START_PREPARED=1 (dynamic scope): the caller already ran prepare_start
  # before stopping the relay (restart_after_env_change).
  if [[ "${START_PREPARED:-0}" != "1" ]]; then
    prepare_start
  fi

  if [[ "$BUILD_IMAGES" == "1" ]]; then
    args+=(--build)
  fi

  info "Starting services ($mode)..."
  # the failure is returned, not left to errexit: run_capture (the TUI's
  # Start, Restart and the restart after a saved setting) runs this with
  # errexit off, and a failed `up` used to end in the status of the lines below
  local rc=0
  dc "$compose_file" "${args[@]}" || rc=$?
  if (( rc != 0 )); then
    warn "docker compose up failed (exit $rc); the relay was not started."
    return "$rc"
  fi
  dc "$compose_file" ps || true

  # After the start, so the image is guaranteed to be pulled.
  report_upstream_env_drift "$compose_file"

  if [[ "$mode" == "tor" ]]; then
    show_onion_host
  fi
  return 0
}

stop_services() {
  local mode="$1"
  local compose_file
  compose_file="$(compose_file_for "$mode")"
  require_compose_file "$compose_file"

  info "Stopping services ($mode)..."
  if ! dc "$compose_file" down --remove-orphans; then
    warn "Nothing to stop or compose down failed."
  fi
}

restart_services() {
  local mode="$1"
  # before the stop: a refused start must not leave the relay stopped
  if start_blocked; then return 1; fi
  stop_services "$mode"
  # start_services returns its own failure (errexit is off in run_capture)
  start_services "$mode" || return $?
}

show_status() {
  local mode="$1"
  local compose_file
  compose_file="$(compose_file_for "$mode")"
  require_compose_file "$compose_file"

  info "Status ($mode):"
  dc "$compose_file" ps

  if [[ "$mode" == "tor" ]]; then
    show_onion_host
  fi
}

stream_logs() {
  local mode="$1"
  local compose_file="$2"
  local service="$3"
  local args=(logs --tail "$TAIL_COUNT")

  if [[ "$FOLLOW_LOGS" == "1" ]]; then
    args+=(-f)
  fi

  if [[ -n "$service" && "$service" != "all" ]]; then
    args+=("$service")
  fi

  info "Streaming logs ($mode). Press Ctrl+C to return."
  dc "$compose_file" "${args[@]}"
}

# log_sanitize_line <line> — _SANITIZED: a log line as the pane shows it. CR
# and the common CSI colour codes go first in pure bash (the pane colours a
# line by its level word, not by the producer's codes); whatever control is
# left — an OSC 52 that would set the clipboard, an OSC 2 that would set the
# window title, any other escape string or C0/C1 byte — goes through
# strip_terminal_controls. Only CSI was removed until P6.
log_sanitize_line() {
  _SANITIZED="$1"
  _SANITIZED="${_SANITIZED//$'\r'/}"
  _SANITIZED="${_SANITIZED//$'\t'/  }"
  while [[ "$_SANITIZED" == *$'\x1b\x5b'* ]]; do
    local _before="${_SANITIZED%%$'\x1b\x5b'*}"
    local _after="${_SANITIZED#*$'\x1b\x5b'}"
    while [[ "${_after:0:1}" == [0-9\;] ]]; do
      _after="${_after:1}"
    done
    [[ "${_after:0:1}" == [a-zA-Z] ]] && _after="${_after:1}"
    _SANITIZED="${_before}${_after}"
  done
  strip_terminal_controls "$_SANITIZED"
  _SANITIZED="$_STRIPPED"
}

# strip_terminal_controls <line> — _STRIPPED: <line> with every escape sequence
# removed (CSI, the OSC/DCS/SOS/PM/APC strings up to BEL or ESC \, two-byte
# ESC sequences) and every C0 control, DEL and C1 control (U+0080..U+009F, and
# a stray byte that is no UTF-8, such as an 8-bit CSI 0x9B) dropped; a tab
# becomes two blanks. For the output of a child the TUI draws: nothing in it
# may reach the terminal as a control (an OSC 52 sets the clipboard). A line
# of printable characters only takes the fast path.
strip_terminal_controls() {
  local s="${1//$'\t'/  }"
  if [[ "$s" =~ ^[[:print:]]*$ ]]; then
    _STRIPPED="$s"
    return 0
  fi
  # byte by byte in the C locale; UTF-8 sequences are decoded to tell a C1
  # character (C2 80..C2 9F) from a printable one
  # shellcheck disable=SC2016  # an awk program: $0 belongs to awk, not to the shell
  _STRIPPED="$(printf '%s\n' "$s" | LC_ALL=C awk '
    BEGIN { for (i = 1; i < 256; i++) ord[sprintf("%c", i)] = i }
    function b(j) { return (j <= n) ? ord[substr(line, j, 1)] + 0 : -1 }
    {
      line = $0; n = length(line); out = ""; i = 1
      while (i <= n) {
        c = b(i)
        if (c == 27) {
          d = b(i + 1)
          if (d == 91) {                                   # CSI: params, intermediates, final
            i += 2
            while (i <= n && b(i) >= 32 && b(i) <= 63) i++
            if (i <= n && b(i) >= 64 && b(i) <= 126) i++
          } else if (d == 93 || d == 80 || d == 88 || d == 94 || d == 95) {   # a string
            i += 2
            while (i <= n) {
              e = b(i)
              if (e == 7) { i++; break }
              if (e == 27) { i += (b(i + 1) == 92) ? 2 : 1; break }
              i++
            }
          } else if (d >= 32 && d <= 47) {                 # intermediates, then the final
            i += 2
            while (i <= n && b(i) >= 32 && b(i) <= 47) i++
            if (i <= n) i++
          } else if (d >= 48 && d <= 126) {
            i += 2
          } else {
            i++
          }
          continue
        }
        if (c < 32 || c == 127) { i++; continue }
        if (c < 128) { out = out substr(line, i, 1); i++; continue }
        k = (c >= 194 && c <= 223) ? 1 : (c >= 224 && c <= 239) ? 2 : (c >= 240 && c <= 244) ? 3 : 0
        ok = (k > 0)
        for (j = 1; ok && j <= k; j++) { e = b(i + j); if (e < 128 || e > 191) ok = 0 }
        if (!ok) { i++; continue }                         # no UTF-8: a stray byte
        if (c == 194 && b(i + 1) <= 159) { i += 2; continue }   # C1 control
        out = out substr(line, i, k + 1); i += k + 1
      }
      printf "%s", out
    }')"
}

log_append() {
  local line="$1"
  LOG_LINES+=("$line")
  if (( ${#LOG_LINES[@]} > LOG_BUFFER_MAX )); then
    LOG_LINES=("${LOG_LINES[@]: -$LOG_BUFFER_MAX}")
  fi
}

# Window onto the (possibly filtered) log buffer for the current render.
# Sets _VIEW_LINES (array), _VIEW_IS_LIVE (1 when following the tail),
# _VIEW_MATCHES (number of lines matching the filter). Scrolling with
# LOG_SCROLL > 0 pins the window LOG_SCROLL lines above the live end.
tui_log_view_lines() {
  local count=${#LOG_LINES[@]}
  if [[ -n "$LOG_FILTER" ]]; then
    local -a filtered=()
    local line
    local low_filter="${LOG_FILTER,,}"
    for line in "${LOG_LINES[@]}"; do
      [[ "${line,,}" == *"$low_filter"* ]] && filtered+=("$line")
    done
    _VIEW_LINES=("${filtered[@]+"${filtered[@]}"}")
  else
    _VIEW_LINES=("${LOG_LINES[@]}")
  fi
  _VIEW_MATCHES=${#_VIEW_LINES[@]}

  local height="$1"
  local total=${#_VIEW_LINES[@]}
  if (( LOG_SCROLL <= 0 || total <= height )); then
    _VIEW_START=$((total > height ? total - height : 0))
    _VIEW_IS_LIVE=1
  else
    _VIEW_START=$((total - height - LOG_SCROLL))
    (( _VIEW_START < 0 )) && _VIEW_START=0
    _VIEW_IS_LIVE=0
  fi
}

stop_log_stream() {
  if [[ -n "$LOG_PID" ]]; then
    # Kill the whole process group when the producer runs as its own leader
    # (setsid): docker compose spawns children that a bare kill would leave
    # behind. Fall back to the pid itself when setsid was unavailable.
    if [[ "${LOG_PID_SETSID:-0}" == "1" ]]; then
      kill -- "-$LOG_PID" >/dev/null 2>&1 || true
    fi
    kill "$LOG_PID" >/dev/null 2>&1 || true
    wait "$LOG_PID" >/dev/null 2>&1 || true
  fi
  LOG_PID=""
  LOG_PID_SETSID=0
  if [[ -n "${LOG_FD:-}" ]]; then
    exec {LOG_FD}<&- || true
  fi
  LOG_FD=""
  if [[ -n "$LOG_FIFO" ]]; then
    rm -f "$LOG_FIFO"
  fi
  LOG_FIFO=""
  if [[ -n "${LOG_FIFO_DIR:-}" ]]; then
    rmdir "$LOG_FIFO_DIR" 2>/dev/null || true
  fi
  LOG_FIFO_DIR=""
}

start_log_stream() {
  stop_log_stream
  LOG_LINES=()

  if ! docker info >/dev/null 2>&1; then
    return
  fi

  local mode
  local compose_file
  local args=(logs --tail "$TAIL_COUNT")
  mode="$(resolve_mode "logs")"
  compose_file="$(compose_file_for "$mode")"

  if [[ ! -f "$compose_file" ]]; then
    log_append "Compose file not found: $(basename "$compose_file")"
    return
  fi

  if [[ "$FOLLOW_LOGS" == "1" ]]; then
    args+=(-f)
  fi
  if [[ -n "$LOG_SERVICE" && "$LOG_SERVICE" != "all" ]]; then
    args+=("$LOG_SERVICE")
  fi

  # Private directory via mktemp -d: mktemp -u + mkfifo is a TOCTOU race in
  # a shared /tmp — someone registering the name in between wins the fifo.
  LOG_FIFO_DIR="$(mktemp -d "${TMPDIR:-/tmp}/haven-log.XXXXXX")"
  LOG_FIFO="$LOG_FIFO_DIR/log.fifo"
  mkfifo "$LOG_FIFO"
  set +e
  LOG_PID_SETSID=0
  if command -v setsid >/dev/null 2>&1; then
    # setsid execs a binary — spell out the compose command instead of the
    # dc() helper function, which is invisible outside the shell.
    setsid "${DOCKER_COMPOSE[@]}" -f "$compose_file" "${args[@]}" >"$LOG_FIFO" 2>&1 &
    LOG_PID_SETSID=1
  else
    dc "$compose_file" "${args[@]}" >"$LOG_FIFO" 2>&1 &
  fi
  LOG_PID=$!
  set -e
  exec {LOG_FD}<"$LOG_FIFO"
}

refresh_log_snapshot() {
  LOG_LINES=()
  if ! docker info >/dev/null 2>&1; then
    return
  fi
  local mode
  local compose_file
  local args=(logs --tail "$TAIL_COUNT")
  mode="$(resolve_mode "logs")"
  compose_file="$(compose_file_for "$mode")"
  if [[ ! -f "$compose_file" ]]; then
    log_append "Compose file not found: $(basename "$compose_file")"
    return
  fi
  if [[ -n "$LOG_SERVICE" && "$LOG_SERVICE" != "all" ]]; then
    args+=("$LOG_SERVICE")
  fi

  run_capture dc "$compose_file" "${args[@]}"
  if [[ "$RUN_STATUS" -ne 0 ]]; then
    log_append "Logs unavailable."
    return
  fi

  local line
  while IFS= read -r line; do
    log_sanitize_line "$line"
    log_append "$_SANITIZED"
  done <<<"$RUN_OUTPUT"
}

drain_log_stream() {
  if [[ -z "${LOG_FD:-}" ]]; then
    return
  fi
  local updated=0
  local line
  while IFS= read -r -t 0.01 line <&$LOG_FD; do
    log_sanitize_line "$line"
    log_append "$_SANITIZED"
    updated=1
  done
  if [[ "$updated" -eq 1 && "$TUI_RIGHT_MODE" != details ]]; then
    TUI_NEED_RIGHT=1
  fi
}

tui_refresh_logs_view() {
  if [[ "$FOLLOW_LOGS" == "1" ]]; then
    start_log_stream
  else
    refresh_log_snapshot
  fi
  if [[ "$TUI_ACTIVE" == "1" ]]; then
    TUI_NEED_RIGHT=1
  fi
}

tui_ensure_log_stream() {
  if [[ -n "$LOG_PID" ]] && ! kill -0 "$LOG_PID" >/dev/null 2>&1; then
    stop_log_stream
    TUI_NEED_RIGHT=1
  fi

  if [[ "$FOLLOW_LOGS" != "1" || "$TUI_DOCKER_OK" -ne 1 ]]; then
    return
  fi

  if [[ -z "$LOG_PID" ]]; then
    local now
    printf -v now '%(%s)T' -1
    if [[ -z "$TUI_LAST_LOG_RESTART" || $((now - TUI_LAST_LOG_RESTART)) -ge 1 ]]; then
      start_log_stream
      TUI_LAST_LOG_RESTART="$now"
      TUI_NEED_RIGHT=1
    fi
    return
  fi

  if ! kill -0 "$LOG_PID" >/dev/null 2>&1; then
    local now
    printf -v now '%(%s)T' -1
    if [[ -z "$TUI_LAST_LOG_RESTART" || $((now - TUI_LAST_LOG_RESTART)) -ge 1 ]]; then
      stop_log_stream
      start_log_stream
      TUI_LAST_LOG_RESTART="$now"
      TUI_NEED_RIGHT=1
    fi
  fi
}

tui_render_right_panel() {
  # Mode switch: logs (default), the status view, the details of the selected
  # setting (settings editor) or the output of a running data task. Tab
  # toggles (and with it the Tab and / hints of the bottom row).
  tui_refresh_status_bar
  case "$TUI_RIGHT_MODE" in
    status) tui_render_right_status ;;
    details) tui_render_right_details ;;
    task) tui_render_right_task ;;
    *) tui_render_right_logs ;;
  esac
}

# tui_wrap <cells> — stdin wrapped to <cells> per line: at spaces; a word wider
# than that (a path, a file name) breaks after its last "/", "-", "_" or "."
# that fits, and only where there is none in the middle of a run of letters.
# No line starts with a space; empty lines stay. Used for the dialogs, result
# boxes and details, where fold -s cut "lmdb" into "lm" and "db".
tui_wrap() {
  awk -v w="$1" '
    function brk(s, room,    i, c) {   # length of the longest prefix of s ending in a break char, <= room
      for (i = (room < length(s) ? room : length(s)); i > 1; i--) {
        c = substr(s, i, 1)
        if (c == "/" || c == "-" || c == "_" || c == ".") return i
      }
      return 0
    }
    {
      n = split($0, words, / +/); line = ""
      for (j = 1; j <= n; j++) {
        word = words[j]
        if (word == "") continue
        cand = (line == "" ? word : line " " word)
        if (length(cand) <= w) { line = cand; continue }
        if (line != "" && length(word) <= w) { print line; line = word; continue }
        if (line != "") {
          p = brk(word, w - length(line) - 1)
          if (p >= 4) { print line " " substr(word, 1, p); word = substr(word, p + 1) }
          else print line
          line = ""
        }
        while (length(word) > w) {
          p = brk(word, w); if (p == 0) p = w
          print substr(word, 1, p); word = substr(word, p + 1)
        }
        line = word
      }
      print line
    }'
}

# tui_wrap_key <key> <cells> — the key name on as many lines as it needs,
# broken after an underscore where possible, never cut.
tui_wrap_key() {
  local rest="$1" w="$2" line="" part
  while [[ -n "$rest" ]]; do
    if [[ "$rest" == *_* ]]; then part="${rest%%_*}_"; else part="$rest"; fi
    rest="${rest:${#part}}"
    if (( ${#line} + ${#part} <= w )); then
      line+="$part"
      continue
    fi
    [[ -n "$line" ]] && printf '%s\n' "$line"
    line=""
    while (( ${#part} > w )); do
      printf '%s\n' "${part:0:w}"
      part="${part:w}"
    done
    line="$part"
  done
  [[ -n "$line" ]] && printf '%s\n' "$line"
  return 0
}

# tui_setting_details — DETAIL_LINES: what the details pane shows for the
# selected entry of the settings list (or the key of the setting view), wrapped
# to the pane: the full key name, its description, then three labelled fields
# in a column — Current (the value now, masked like the list for credentials,
# and in bold: it is what the user came for), Allowed (the rule the editor
# checks) and Example (the value of .env.example). DETAIL_BOLD: how many
# leading lines are the key; DETAIL_STYLE: the style of a line, by index.
DETAIL_LINES=()
DETAIL_BOLD=0
DETAIL_STYLE=()
DETAIL_LABEL_W=9
# detail_field <label> <text> [style] — one labelled field: the label in its
# column, the text wrapped beside it, continuation lines indented under it.
detail_field() {
  local label="$1" text="$2" style="${3:-}" line first=1 pad
  printf -v pad '%*s' "$DETAIL_LABEL_W" ''
  while IFS= read -r line; do
    if (( first )); then
      DETAIL_LINES+=("$(printf '%-*s%s' "$DETAIL_LABEL_W" "$label" "$line")")
    else
      DETAIL_LINES+=("$pad$line")
    fi
    [[ -z "$style" ]] || DETAIL_STYLE[${#DETAIL_LINES[@]} - 1]="$style"
    first=0
  done < <(printf '%s\n' "$text" | tui_wrap $((RIGHT_CONTENT_W - DETAIL_LABEL_W)))
}

tui_setting_details() {
  local id="" key="" w="$RIGHT_CONTENT_W" v line
  DETAIL_LINES=()
  DETAIL_BOLD=0
  DETAIL_STYLE=()
  if [[ "$TUI_VIEW" == "env_item" ]]; then
    key="$CURRENT_ENV_KEY"
  elif (( ${#MENU_IDS[@]} > 0 && TUI_SEL < ${#MENU_IDS[@]} )); then
    id="${MENU_IDS[$TUI_SEL]}"
    [[ "$id" == key:* ]] && key="${id#key:}"
  fi
  if [[ -z "$key" ]]; then
    case "$id" in
      add) v="Adds a line to .env: you type the key, then its value. Saving restarts a running relay." ;;
      back) v="Back to the main menu." ;;
      group:*) v="Esc clears the filter; / starts a new one." ;;
      *) v="" ;;
    esac
    while IFS= read -r line; do DETAIL_LINES+=("$line"); done < <(printf '%s\n' "$v" | tui_wrap "$w")
    return 0
  fi
  env_example_load
  while IFS= read -r line; do DETAIL_LINES+=("$line"); done < <(tui_wrap_key "$key" "$w")
  DETAIL_BOLD=${#DETAIL_LINES[@]}
  DETAIL_LINES+=("")
  if [[ -n "${EX_DESC[$key]:-}" ]]; then
    v="${EX_DESC[$key]}"
  elif [[ -n "${EX_SEC[$key]+x}" ]]; then
    v="No description in .env.example."
  else
    v="Not in .env.example: Haven does not document this setting."
  fi
  while IFS= read -r line; do DETAIL_LINES+=("$line"); done < <(printf '%s\n' "$v" | tui_wrap "$w")
  DETAIL_LINES+=("")
  env_effective_value "$key"
  v="$_EFFECTIVE"
  env_stored_value_note "$key" "$v"
  settings_shown_value "$key" "$v"
  v="$_SHOWN"
  if [[ -z "$v" ]]; then
    v="(empty)"
  elif (( _SHOWN_MASKED )); then
    v+=" (hidden; Enter, then Reveal value shows it)"
  fi
  detail_field "Current" "$v" "$TUI_BOLD"
  [[ -z "$_STORED_NOTE" ]] || detail_field "" "$_STORED_NOTE" "$TUI_FG_LOG_WARN"
  env_dollar_note "$_EFFECTIVE"
  [[ -z "$_DOLLAR_NOTE" ]] || detail_field "" "$_DOLLAR_NOTE" "$TUI_FG_LOG_WARN"
  if (( _EFFECTIVE_LINES > 1 )); then
    detail_field "" "$key is in .env $_EFFECTIVE_LINES times; Compose uses the last line, shown here, and Edit changes that line only." "$TUI_FG_LOG_WARN"
  fi
  env_rule_text "$key"
  [[ -z "$_RULE" ]] || detail_field "Allowed" "$_RULE"
  if [[ -n "${EX_SEC[$key]+x}" ]]; then
    settings_shown_value "$key" "${EX_EXAMPLE[$key]}"
    v="$_SHOWN"
    [[ -n "$v" ]] || v="(empty)"
    [[ "${EX_COMMENTED[$key]:-0}" == "1" ]] && v+=" (commented out in .env.example)"
    detail_field "Example" "$v"
  fi
}

tui_render_right_details() {
  TUI_RIGHT_TITLE="Details"
  tui_draw_title_row
  # the right pane is drawn before the left one: the list it describes may
  # not be built (or its selection clamped) yet
  if [[ "$TUI_NEED_MENU" -eq 1 ]]; then
    tui_build_menu
    TUI_NEED_MENU=0
  fi
  tui_clamp_sel
  if [[ "$TUI_VIEW" == restore_list || "$TUI_VIEW" == switch ]]; then
    tui_flow_details
  else
    tui_setting_details
  fi
  local row line style n=${#DETAIL_LINES[@]}
  for ((row = 0; row < RIGHT_CONTENT_HEIGHT; row++)); do
    line="" style=""
    if (( row < n )); then
      line="${DETAIL_LINES[$row]}"
      style="${DETAIL_STYLE[$row]:-}"
      (( row < DETAIL_BOLD )) && style="${TUI_BOLD}${TUI_FG_ACCENT}"
    fi
    if (( row == RIGHT_CONTENT_HEIGHT - 1 && n > RIGHT_CONTENT_HEIGHT )); then
      line="… (more in a taller terminal)"
      style="${TUI_DIM}${TUI_ITALIC}"
    fi
    tui_truncate "$line" "$RIGHT_CONTENT_W"
    tui_pad_to "$_TRUNC" "$RIGHT_CONTENT_W"
    printf '\033[%d;%dH%b%s%b' "$((RIGHT_CONTENT_ROW + row + 1))" "$((RIGHT_X + 1))" "$style" "$_PADDED" "$CLR_RESET"
  done
}

tui_render_right_status() {
  # plain like the log title; the log stream's spinner belongs to the log view
  TUI_RIGHT_TITLE="Status"
  tui_draw_title_row

  # Docker queries are throttled and cached (like tui_update_docker_status):
  # du over db/ and blossom/ can take a moment on large installs, and the
  # render path must never block on the daemon.
  local now
  printf -v now '%(%s)T' -1
  if [[ -z "$TUI_STATUS_TS" || $((now - TUI_STATUS_TS)) -ge 5 ]]; then
    tui_collect_status
    TUI_STATUS_TS="$now"
  fi

  # "label|value|style" per field: the label in its own column, the value
  # wrapped beside it (continuation rows indented), the style for the value
  local -a rows=() styles=()
  local entry label value style vw=$((RIGHT_CONTENT_W - 13)) first part
  (( vw < 8 )) && vw=8
  for entry in "${TUI_STATUS_CACHE[@]+"${TUI_STATUS_CACHE[@]}"}"; do
    label="${entry%%|*}" value="${entry#*|}" style=""
    if [[ "$value" == *"|"* ]]; then style="${value##*|}"; value="${value%|*}"; fi
    first=1
    while IFS= read -r part; do
      if (( first )); then
        rows+=("$(printf '%-12s %s' "$label" "$part")")
      else
        rows+=("$(printf '%-12s %s' "" "$part")")
      fi
      styles+=("$style")
      first=0
    done < <(printf '%s\n' "$value" | tui_wrap "$vw")
  done
  local row line st
  for ((row=0; row<RIGHT_CONTENT_HEIGHT; row++)); do
    line="" st=""
    if (( row < ${#rows[@]} )); then
      line="${rows[$row]}"
      st="${styles[$row]}"
    fi
    tui_truncate "$line" "$RIGHT_CONTENT_W"
    tui_pad_to "$_TRUNC" "$RIGHT_CONTENT_W"
    printf '\033[%d;%dH' "$((RIGHT_CONTENT_ROW + row + 1))" "$((RIGHT_X + 1))"
    case "$st" in
      warn) printf "%b%s%b" "$TUI_FG_LOG_WARN" "$_PADDED" "$CLR_RESET" ;;
      *) printf "%s" "$_PADDED" ;;
    esac
  done
}

# tui_collect_status — TUI_STATUS_CACHE: the status view's fields, one
# "label|value[|style]" each, in this order: relay state with uptime, mode,
# relay URL (and the onion host on Tor), the engine on disk with the size of
# db/, media (blossom/), the newest backup, image tag and digest, then one line
# per container. Every state is a word; called throttled (every 5 s at most).
tui_collect_status() {
  local name status relay="" mode url onion="" state dsize engine envs tag digest="" f
  local -a containers=()
  TUI_STATUS_CACHE=()
  if docker info >/dev/null 2>&1; then
    while IFS='|' read -r name status; do
      [[ -n "$name" ]] || continue
      if [[ "$status" == Up* ]]; then
        state="${status#Up }"
        state="running, up ${state%% (*}"
      else
        state="stopped"
      fi
      containers+=("$name: $state")
      if [[ "$name" == "$RELAY_CONTAINER" ]]; then
        if [[ "$status" == Up* ]]; then relay="● Running, ${state#running, }"; else relay="○ Stopped"; fi
      fi
    done < <(docker ps -a --format '{{.Names}}|{{.Status}}' 2>/dev/null | grep -E "^haven-|^${RELAY_CONTAINER}[|]" || true)
    [[ -n "$relay" ]] || relay="○ Not created yet (never started)"
    digest="$(docker inspect --format '{{.Image}}' "$RELAY_CONTAINER" 2>/dev/null || true)"
  else
    relay="○ Unknown: Docker is offline"
  fi
  TUI_STATUS_CACHE+=("Relay|$relay")

  mode="$(resolve_mode "status" 2>/dev/null || printf plain)"
  if [[ "$mode" == "tor" ]]; then
    TUI_STATUS_CACHE+=("Mode|Tor")
    [[ -r "$ROOT_DIR/tor/data/haven/hostname" ]] && onion="$(head -n 1 "$ROOT_DIR/tor/data/haven/hostname" 2>/dev/null)"
  else
    TUI_STATUS_CACHE+=("Mode|Docker")
  fi
  url="$(env_value_or_empty RELAY_URL)"
  if [[ -n "$url" ]]; then url="wss://${url#wss://}"; else url="not set (RELAY_URL in .env)"; fi
  [[ -z "$onion" ]] || url+="; onion: $(printable_text "$onion")"
  TUI_STATUS_CACHE+=("URL|$(printable_text "$url")")

  dsize="$(du -sh "$ROOT_DIR/db" 2>/dev/null | awk '{print $1}')"
  [[ -n "$dsize" ]] || dsize="unknown"
  db_disk_engine
  envs="$(env_engine_state)"
  case "$DISK_ENGINE" in
    badger|lmdb)
      engine="$DISK_ENGINE"
      if [[ "$envs" != "$DISK_ENGINE" && ( "$envs" == badger || "$envs" == lmdb ) ]]; then
        engine="$DISK_ENGINE on disk, but .env names $envs"
      fi
      ;;
    mixed) engine="files of both engines in db/ ($DISK_BAD)" ;;
    split) engine="the directories in db/ disagree ($DISK_REPORT)" ;;
    unknown) engine="cannot tell: $DISK_BAD unreadable or of neither engine" ;;
    *) engine="no data yet (.env: $envs)" ;;
  esac
  TUI_STATUS_CACHE+=("Database|$engine, db/ $dsize")

  if [[ -d "$ROOT_DIR/blossom" ]]; then
    dsize="$(du -sh "$ROOT_DIR/blossom" 2>/dev/null | awk '{print $1}')"
    TUI_STATUS_CACHE+=("Media|blossom/ ${dsize:-unknown}")
  else
    TUI_STATUS_CACHE+=("Media|blossom/ does not exist")
  fi

  tui_flow_backups_list
  if [[ -n "$FLOW_LIST_ERR" ]]; then
    TUI_STATUS_CACHE+=("Last backup|backups/ cannot be read|warn")
  elif (( ${#FLOW_FILES[@]} )); then
    f="${FLOW_FILES[0]}"
    tui_flow_age "${FLOW_FILE_TIME[$f]}"
    TUI_STATUS_CACHE+=("Last backup|$_AGE, $f")
  else
    TUI_STATUS_CACHE+=("Last backup|never|warn")
  fi

  tag="-"
  if [[ -f "$ROOT_DIR/docker-compose.yml" ]]; then
    tag="$(grep -m1 'image:.*haven-docker' "$ROOT_DIR/docker-compose.yml" | sed -E 's/.*haven-docker:([^[:space:]]+).*/\1/')"
    [[ -n "$tag" ]] || tag="-"
  fi
  if [[ "$digest" == sha256:* ]]; then
    TUI_STATUS_CACHE+=("Image|$tag, ${digest:0:19}")
  else
    TUI_STATUS_CACHE+=("Image|$tag, no running image")
  fi

  if (( ${#containers[@]} )); then
    for f in "${containers[@]}"; do TUI_STATUS_CACHE+=("Container|$f"); done
  elif docker info >/dev/null 2>&1; then
    TUI_STATUS_CACHE+=("Container|none")
  else
    TUI_STATUS_CACHE+=("Container|unknown: Docker is offline")
  fi
}

tui_render_right_logs() {
  # Update right title bar with spinner
  local spinner=""
  if [[ "$FOLLOW_LOGS" == "1" && -n "$LOG_PID" ]]; then
    local frame_idx=$((_SPINNER_TICK % ${#SPINNER_FRAMES[@]}))
    spinner=" ${SPINNER_FRAMES[$frame_idx]}"
  fi
  TUI_RIGHT_TITLE="Logs: ${LOG_SERVICE:-all}${spinner} │ Tail: ${TAIL_COUNT}"
  if [[ -n "$LOG_FILTER" ]]; then
    TUI_RIGHT_TITLE="Logs: ${LOG_SERVICE:-all}${spinner} │ Filter: $LOG_FILTER"
  fi
  if (( LOG_SCROLL > 0 )); then
    TUI_RIGHT_TITLE="${TUI_RIGHT_TITLE} │ Paused"   # the bottom row names PgDn
  fi
  tui_draw_title_row

  # With a filter the hit count takes the first content row: the window of
  # lines is one row shorter and its row 1 shows the window's first line.
  local hit_rows=0
  [[ -n "$LOG_FILTER" ]] && hit_rows=1
  local body_h=$((RIGHT_CONTENT_HEIGHT - hit_rows))
  tui_log_view_lines "$body_h"
  local -a view_lines=("${_VIEW_LINES[@]+"${_VIEW_LINES[@]}"}")
  local total=${#view_lines[@]}
  local start=$_VIEW_START
  local count=$((total - start > body_h ? body_h : total - start))
  local end=$((start + count))

  # Filter hit count goes on the first content row so it stays visible
  local hitline=""
  if [[ -n "$LOG_FILTER" ]]; then
    case "$_VIEW_MATCHES" in
      0) hitline="No matching lines" ;;
      1) hitline="1 matching line" ;;
      *) hitline="${_VIEW_MATCHES} matching lines" ;;
    esac
  fi

  local row idx line line_color
  for ((row=0; row<RIGHT_CONTENT_HEIGHT; row++)); do
    idx=$((start + row - hit_rows))
    line=""
    line_color=""
    if [[ -n "$hitline" && "$row" -eq 0 ]]; then
      line="$hitline"
      line_color="${TUI_DIM}${TUI_ITALIC}"
      hitline=""
    elif [[ "$idx" -lt "$end" ]]; then
      line="${view_lines[$idx]}"
      # Colorize based on content
      if [[ "$line" == *[Ee][Rr][Rr][Oo][Rr]* || "$line" == *ERRO* || "$line" == *panic* ]]; then
        line_color="$TUI_FG_LOG_ERROR"
      elif [[ "$line" == *[Ww][Aa][Rr][Nn]* || "$line" == *WARN* ]]; then
        line_color="$TUI_FG_LOG_WARN"
      else
        line_color="$TUI_FG_LOG_INFO"
      fi
    elif [[ "$total" -eq 0 && "$row" -eq 0 ]]; then
      line="Waiting for logs..."
      [[ "$TUI_DOCKER_OK" == "1" ]] || line="Docker is offline: no logs."
      line_color="${TUI_DIM}${TUI_ITALIC}"
    fi
    tui_truncate "$line" "$RIGHT_CONTENT_W"
    printf '\033[%d;%dH' "$((RIGHT_CONTENT_ROW + row + 1))" "$((RIGHT_X + 1))"
    if [[ -n "$line_color" ]]; then
      tui_pad_to "$_TRUNC" "$RIGHT_CONTENT_W"
      printf "%b%s%b" "$line_color" "$_PADDED" "$CLR_RESET"
    else
      tui_pad_to "$_TRUNC" "$RIGHT_CONTENT_W"
      printf "%s" "$_PADDED"
    fi
  done
}

prompt_tail_count() {
  local input=""
  read -r -p "Tail lines (current: $TAIL_COUNT): " input
  if [[ -n "$input" ]]; then
    if [[ "$input" =~ ^[0-9]+$ ]]; then
      TAIL_COUNT="$input"
    else
      warn "Invalid number. Keeping $TAIL_COUNT."
    fi
  fi
}

pause() {
  if [[ "$TUI_ACTIVE" == "1" && -t 1 ]]; then
    tui_message "Continue" "Press any key to continue."
  else
    read -r -p "Press Enter to continue..." _
  fi
}

print_header() {
  printf "%b\n" "${CLR_BLUE}Haven Control${CLR_RESET}"
  printf "%b%s%b\n\n" "$CLR_DIM" "$ROOT_DIR" "$CLR_RESET"
}

