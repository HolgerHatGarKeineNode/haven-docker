tui_update_docker_status() {
  local now
  printf -v now '%(%s)T' -1
  if [[ -z "$TUI_LAST_DOCKER_CHECK" || $((now - TUI_LAST_DOCKER_CHECK)) -ge 5 ]]; then
    local prev="$TUI_DOCKER_OK"
    local next=0
    if docker info >/dev/null 2>&1; then
      next=1
    else
      next=0
    fi
    if [[ "$next" -ne "$prev" ]]; then
      TUI_NEED_LEFT=1
      TUI_NEED_MENU=1
    fi
    TUI_DOCKER_OK="$next"
    TUI_LAST_DOCKER_CHECK="$now"
  fi
}

tui_set_view() {
  TUI_VIEW="$1"
  TUI_SEL=0
  TUI_OFFSET=0
  TUI_NEED_MENU=1
  TUI_NEED_LEFT=1
  TUI_NEED_RIGHT=1
}

# The selection marker is the only glyph in front of a menu label: the
# selected row gets "▸ ", every other row two blanks, so labels share a column.
tui_menu_icon() {
  if [[ "${1:-}" == "selected" ]]; then
    _ICON="$ICO_SELECTED"
  else
    _ICON="  "
  fi
}

# tui_state_engine — the engine word of the main view's state line: the engine
# of the data in db/ when there is exactly one; "mixed" when directories hold
# both or disagree; otherwise what DB_ENGINE in .env makes the relay run
# (upstream runs lmdb for anything but "badger", unset included).
tui_state_engine() {
  db_disk_engine
  case "$DISK_ENGINE" in
    badger|lmdb) _ENGINE_WORD="$DISK_ENGINE" ;;
    mixed|split) _ENGINE_WORD="mixed" ;;
    *)
      if [[ "$(env_engine_state)" == "badger" ]]; then
        _ENGINE_WORD="badger"
      else
        _ENGINE_WORD="lmdb"
      fi
      ;;
  esac
}

# tui_state_line — MENU_STATE for the main view: relay state, mode, engine,
# each a word ("● Running  Tor  badger"). When the line is wider than the left
# pane, whole fields are dropped from the right; a word is never cut.
tui_state_line() {
  local -a fields=()
  if [[ "$TUI_DOCKER_OK" -ne 1 ]]; then
    fields+=("○ Docker offline")
  else
    if relay_container_running 2>/dev/null; then
      fields+=("● Running")
    else
      fields+=("○ Stopped")
    fi
    if [[ "$(resolve_mode "status" 2>/dev/null)" == "tor" ]]; then
      fields+=("Tor")
    else
      fields+=("Plain")
    fi
  fi
  tui_state_engine
  fields+=("$_ENGINE_WORD")

  local n=${#fields[@]} i line
  while (( n > 1 )); do
    line="${fields[0]}"
    for ((i = 1; i < n; i++)); do
      line+="  ${fields[$i]}"
    done
    tui_str_width "$line"
    (( _WIDTH <= LEFT_CONTENT_W )) && break
    n=$((n - 1))
  done
  if (( n == 1 )); then
    line="${fields[0]}"
  fi
  MENU_STATE="$line"
}

# tui_menu_selectable <index> — true for an entry the selection may rest on
# (group names are drawn but never selected).
tui_menu_selectable() {
  local idx="$1"
  (( idx >= 0 && idx < ${#MENU_IDS[@]} )) || return 1
  [[ "${MENU_IDS[$idx]}" != group:* ]]
}

# tui_sel_step <from> <step> — move the selection from <from> in direction
# <step> (+1/-1) to the next selectable entry; false (selection unchanged)
# when there is none.
tui_sel_step() {
  local i=$(($1 + $2))
  local count=${#MENU_IDS[@]}
  while (( i >= 0 && i < count )); do
    if tui_menu_selectable "$i"; then
      TUI_SEL="$i"
      TUI_NEED_LEFT=1
      return 0
    fi
    i=$((i + $2))
  done
  return 1
}

# Display-only masking for values of sensitive keys in the env list.
# Not a security feature — the .env itself stays plaintext; this only keeps
# shoulder-surfers and screenshots from carrying the secret away.
mask_env_value() {
  local v="${1:-}"
  if (( ${#v} > 8 )); then
    _MASKED="…${v: -4}"
  elif [[ -n "$v" ]]; then
    _MASKED="…"
  else
    _MASKED=""
  fi
}

env_key_is_sensitive() {
  case "$1" in
    *SECRET*|*PASSWORD*|*TOKEN*|*KEY*) return 0 ;;
    *) return 1 ;;
  esac
}

tui_build_menu() {
  MENU_IDS=()
  MENU_LABELS=()
  MENU_KEYS=()
  MENU_TITLE=""
  MENU_SUBTITLE=""
  MENU_STATE=""

  case "$TUI_VIEW" in
    main)
      TUI_LEFT_TITLE="Haven"
      tui_state_line
      MENU_IDS=(group:relay start_plain start_tor stop restart
        group:data backup restore db_switch import
        group:configure env json env_upgrade onion
        help about quit)
      MENU_LABELS=("Relay" "Start" "Start with Tor" "Stop" "Restart"
        "Data" "Back up now" "Restore a backup" "Switch database engine" "Import notes"
        "Configure" "Settings (.env)" "Access lists (JSON)" "Update settings from template" "Onion address"
        "Help" "About" "Quit")
      MENU_KEYS=("" s t x r
        "" b e d i
        "" c l u o
        "?" a q)
      ;;
    logs)
      TUI_LEFT_TITLE="Haven / Logs"
      MENU_TITLE="Logs Settings"
      MENU_SUBTITLE="Service: ${LOG_SERVICE:-all} │ Tail: ${TAIL_COUNT} │ Follow: $([[ "$FOLLOW_LOGS" == "1" ]] && echo on || echo off)"
      MENU_IDS=(service tail follow back)
      MENU_LABELS=("Select service" "Tail lines" "Toggle follow" "Back")
      ;;
    logs_service)
      TUI_LEFT_TITLE="Haven / Logs / Service"
      MENU_TITLE="Log Services"
      MENU_SUBTITLE="Choose which service to stream."
      MENU_IDS=(all)
      MENU_LABELS=("All services")
      local svc
      while IFS= read -r svc; do
        [[ -n "$svc" ]] || continue
        MENU_IDS+=("$svc")
        MENU_LABELS+=("$svc")
      done < <(list_services "$(compose_file_for "$(resolve_mode "logs")")")
      if [[ "${#MENU_IDS[@]}" -eq 1 ]]; then
        MENU_IDS+=(relay tor)
        MENU_LABELS+=("relay" "tor")
      fi
      MENU_IDS+=(back)
      MENU_LABELS+=("Back")
      ;;
    env_list)
      TUI_LEFT_TITLE="Haven / Settings"
      MENU_TITLE="Settings (.env)"
      MENU_SUBTITLE="Select a variable"
      MENU_IDS=(add)
      MENU_LABELS=("Add variable")
      local key
      local value
      while IFS= read -r key; do
        [[ -n "$key" ]] || continue
        value=""
        value="$(read_env_var "$key" 2>/dev/null || true)"
        if env_key_is_sensitive "$key"; then
          mask_env_value "$value"
          value="$_MASKED"
        fi
        MENU_IDS+=("key:$key")
        MENU_LABELS+=("$key = $value")
      done < <(list_env_keys)
      MENU_IDS+=(back)
      MENU_LABELS+=("Back")
      ;;
    env_item)
      TUI_LEFT_TITLE="Haven / Settings / $CURRENT_ENV_KEY"
      MENU_TITLE=".env: $CURRENT_ENV_KEY"
      MENU_SUBTITLE="Edit or remove this variable."
      MENU_IDS=(edit reveal remove back)
      MENU_LABELS=("Edit value" "Reveal value" "Remove variable" "Back")
      ;;
    json_files)
      TUI_LEFT_TITLE="Haven / Access lists"
      MENU_TITLE="Access lists (JSON)"
      MENU_SUBTITLE="Select a list"
      local count=${#JSON_FILES[@]}
      local file label
      for ((i=0; i<count; i++)); do
        file="${JSON_FILES[$i]}"
        label="${JSON_LABELS[$i]}"
        MENU_IDS+=("$file")
        MENU_LABELS+=("$label ($file)")
      done
      MENU_IDS+=(back)
      MENU_LABELS+=("Back")
      ;;
    json_items)
      TUI_LEFT_TITLE="Haven / Access lists / $(json_label_for "$CURRENT_JSON_FILE")"
      MENU_TITLE="JSON: $CURRENT_JSON_FILE"
      MENU_SUBTITLE="Edit list items"
      MENU_IDS=(add clear)
      MENU_LABELS=("Add item" "Clear list")
      local path="$ROOT_DIR/$CURRENT_JSON_FILE"
      local output=""
      if ! output="$(json_list_items "$path" 2>/dev/null)"; then
        MENU_IDS=(back)
        MENU_LABELS=("Invalid JSON (back)")
      else
        local idx=0
        local item
        while IFS= read -r item; do
          MENU_IDS+=("item:$idx")
          if json_item_is_valid "$CURRENT_JSON_FILE" "$item"; then
            MENU_LABELS+=("$item")
          else
            MENU_LABELS+=("$item (invalid)")
          fi
          idx=$((idx + 1))
        done <<<"$output"
        MENU_IDS+=(back)
        MENU_LABELS+=("Back")
      fi
      ;;
  esac
}

tui_render_left_menu() {
  local row="$LEFT_CONTENT_ROW"
  local visible_rows="$LEFT_CONTENT_HEIGHT"

  # Only rebuild menu data when needed (not on simple navigation)
  if [[ "$TUI_NEED_MENU" -eq 1 ]]; then
    tui_build_menu
    TUI_NEED_MENU=0
  fi

  # Row 1 names the current view (the path); it changes with the view.
  tui_draw_title_row

  # State line (main view): bold, the state is a word
  if [[ -n "$MENU_STATE" ]]; then
    tui_truncate "$MENU_STATE" "$LEFT_CONTENT_W"
    tui_print_left_styled "$row" "$TUI_BOLD" "$_TRUNC"
    row=$((row + 1))
    visible_rows=$((visible_rows - 1))
  fi

  # Bold accent title
  if [[ -n "$MENU_TITLE" ]]; then
    tui_truncate "$MENU_TITLE" "$LEFT_CONTENT_W"
    tui_print_left_styled "$row" "${TUI_BOLD}${TUI_FG_ACCENT}" "$_TRUNC"
    row=$((row + 1))
    visible_rows=$((visible_rows - 1))
  fi

  # Dim subtitle
  if [[ -n "$MENU_SUBTITLE" ]]; then
    tui_truncate "$MENU_SUBTITLE" "$LEFT_CONTENT_W"
    tui_print_left_styled "$row" "${TUI_DIM}${TUI_FG_SUBTITLE}" "$_TRUNC"
    row=$((row + 1))
    visible_rows=$((visible_rows - 1))
  fi

  # Thin separator under a titled view (the main view's groups need the row)
  if [[ -n "$MENU_TITLE" ]]; then
    tui_print_left_styled "$row" "$TUI_FG_SEPARATOR" "$_HLINE_SEP"
    row=$((row + 1))
    visible_rows=$((visible_rows - 1))
  fi

  local count=${#MENU_LABELS[@]}
  if [[ "$count" -le 0 ]]; then
    tui_print_left_styled "$row" "$TUI_DIM" "(empty)"
    return
  fi

  if [[ "$TUI_SEL" -lt 0 ]]; then
    TUI_SEL=0
  fi
  if [[ "$TUI_SEL" -ge "$count" ]]; then
    TUI_SEL=$((count - 1))
  fi
  # The selection never rests on a group name: forward first, else backward.
  if ! tui_menu_selectable "$TUI_SEL"; then
    tui_sel_step "$TUI_SEL" 1 || tui_sel_step "$TUI_SEL" -1 || true
  fi

  if [[ "$TUI_SEL" -lt "$TUI_OFFSET" ]]; then
    TUI_OFFSET="$TUI_SEL"
    # scrolling up onto the first entry of a group shows the group name too
    if (( TUI_OFFSET > 0 )) && [[ "${MENU_IDS[$((TUI_OFFSET - 1))]}" == group:* ]]; then
      TUI_OFFSET=$((TUI_OFFSET - 1))
    fi
  fi
  if [[ "$TUI_SEL" -ge $((TUI_OFFSET + visible_rows)) ]]; then
    TUI_OFFSET=$((TUI_SEL - visible_rows + 1))
  fi

  local i idx label menu_id key key_w label_w
  for ((i=0; i<visible_rows; i++)); do
    idx=$((TUI_OFFSET + i))
    label=""
    menu_id=""
    key=""
    if [[ "$idx" -lt "$count" ]]; then
      label="${MENU_LABELS[$idx]}"
      menu_id="${MENU_IDS[$idx]}"
      key="${MENU_KEYS[$idx]:-}"
    fi
    key_w=0
    [[ -n "$key" ]] && key_w=2
    label_w=$((LEFT_CONTENT_W - 2 - key_w))
    tui_truncate "$label" "$label_w"

    printf '\033[%d;%dH' "$((row + i + 1))" "$((LEFT_X + 1))"
    if [[ -z "$label" ]]; then
      printf "%-*s" "$LEFT_CONTENT_W" ""
    elif [[ "$menu_id" == group:* ]]; then
      # group name: dim, in the marker column, never selected
      tui_pad_to "$_TRUNC" "$LEFT_CONTENT_W"
      printf "%b%s%b" "$TUI_FG_MENU_DIM" "$_PADDED" "$CLR_RESET"
    elif [[ "$idx" -eq "$TUI_SEL" ]]; then
      tui_menu_icon selected
      if [[ -n "$key" ]]; then
        tui_pad_to "${_ICON}${key} ${_TRUNC}" "$LEFT_CONTENT_W"
      else
        tui_pad_to "${_ICON}${_TRUNC}" "$LEFT_CONTENT_W"
      fi
      printf "%b%s%b" \
        "${TUI_BOLD}${TUI_FG_SELECTED}${TUI_BG_SELECTED}" \
        "$_PADDED" "$CLR_RESET"
    else
      local style="$TUI_FG_MENU"
      if [[ "$menu_id" == "back" || "$menu_id" == "quit" ]]; then
        style="$TUI_FG_MENU_DIM"
      fi
      tui_menu_icon
      tui_pad_to "$_TRUNC" "$label_w"
      if [[ -n "$key" ]]; then
        printf "%s%b%s%b%b %s%b" "$_ICON" \
          "$TUI_SHORTCUT_KEY" "$key" "$CLR_RESET" \
          "$style" "$_PADDED" "$CLR_RESET"
      else
        printf "%s%b%s%b" "$_ICON" "$style" "$_PADDED" "$CLR_RESET"
      fi
    fi
  done
}

tui_handle_back() {
  case "$TUI_VIEW" in
    main) return 1 ;;
    logs) tui_set_view "main" ;;
    logs_service) tui_set_view "logs" ;;
    env_list) tui_set_view "main" ;;
    env_item) tui_set_view "env_list" ;;
    json_files) tui_set_view "main" ;;
    json_items) tui_set_view "json_files" ;;
    *) tui_set_view "main" ;;
  esac
  return 0
}

tui_run_action() {
  local title="$1"
  shift
  if [[ "$TUI_ACTIVE" == "1" && "$FOLLOW_LOGS" == "1" ]]; then
    stop_log_stream
  fi
  run_capture "$@"
  if [[ "$RUN_STATUS" -ne 0 ]]; then
    local text="Failed (exit $RUN_STATUS)."
    if [[ -n "$RUN_OUTPUT" ]]; then
      text="$text\n\n$RUN_OUTPUT"
    fi
    tui_message "$title" "$text"
  elif [[ "$RUN_OUTPUT" == *"$MIXED_START_WARNING"* ]]; then
    # a start that went ahead on mixed directories: its warning would scroll by
    # unseen in the captured output
    tui_message "$title" "$(printf '%s\n' "$RUN_OUTPUT" | grep -F -- "$MIXED_START_WARNING")"
  fi
  if [[ "$TUI_ACTIVE" == "1" ]]; then
    TUI_NEED_FRAME=1
    TUI_NEED_MENU=1
    TUI_NEED_LEFT=1
    TUI_NEED_RIGHT=1
    tui_refresh_logs_view
  fi
}

# About screen: the distributed version (image tag from the compose file)
# plus the running relay image digest, best effort without the daemon.
tui_about() {
  local version="-"
  local compose_file="$ROOT_DIR/docker-compose.yml"
  if [[ -f "$compose_file" ]]; then
    version="$(grep -m1 'image:.*haven-docker' "$compose_file" | sed -E 's/.*haven-docker:([^[:space:]]+).*/\1/')"
    [[ -n "$version" ]] || version="-"
  fi
  local digest="-"
  if docker info >/dev/null 2>&1; then
    digest="$(docker inspect --format '{{.Image}}' "$RELAY_CONTAINER" 2>/dev/null || true)"
    if [[ "$digest" == sha256:* ]]; then
      digest="${digest:0:22}…"
    else
      digest="-"
    fi
  fi
  tui_message "About" "haven-docker CLI version: $version
Relay image digest: $digest
Upstream: Haven, a High Availability Vault for Events on Nostr.
Backups: every .env/JSON edit writes a timestamped .bak.<ts> next to the file (10 most recent are kept)."
}

tui_handle_enter() {
  local id="${MENU_IDS[$TUI_SEL]}"

  case "$TUI_VIEW" in
    main)
      case "$id" in
        start_plain)
          tui_require_docker || return
          if tui_confirm "Start services (Docker)?" "y"; then
            tui_run_action "Start" start_services "plain"
          fi
          ;;
        start_tor)
          tui_require_docker || return
          if tui_confirm "Start services (Tor)?" "y"; then
            tui_run_action "Start" start_services "tor"
          fi
          ;;
        stop)
          tui_require_docker || return
          local mode_stop
          mode_stop="$(resolve_mode "stop")"
          if tui_confirm "Stop services ($mode_stop)?" "y"; then
            tui_run_action "Stop" stop_services "$mode_stop"
          fi
          ;;
        restart)
          tui_require_docker || return
          local mode_restart
          mode_restart="$(resolve_mode "restart")"
          if tui_confirm "Restart services ($mode_restart)?" "y"; then
            tui_run_action "Restart" restart_services "$mode_restart"
          fi
          ;;
        logs)
          tui_set_view "logs"
          ;;
        status)
          tui_require_docker || return
          local mode_status
          local compose_file
          mode_status="$(resolve_mode "status")"
          compose_file="$(compose_file_for "$mode_status")"
          run_capture dc "$compose_file" ps
          tui_message "Status" "$RUN_OUTPUT"
          ;;
        env)
          if ! ensure_env_file; then
            tui_message ".env" ".env missing."
            return
          fi
          tui_set_view "env_list"
          ;;
        json)
          if ! detect_json_tool; then
            tui_message "JSON Editor" "jq or python3 is required for JSON editing."
            return
          fi
          tui_set_view "json_files"
          ;;
        onion)
          local onion_text=""
          local onion_host_file="$ROOT_DIR/tor/data/haven/hostname"
          local onion_torrc="$ROOT_DIR/tor/torrc"
          if [[ -f "$onion_host_file" ]]; then
            onion_text="$(cat "$onion_host_file")"
          else
            onion_text="Hostname not found. Tor may still be initializing."
          fi
          if [[ -f "$onion_torrc" ]]; then
            onion_text="$onion_text

torrc:
$(cat "$onion_torrc")"
          fi
          tui_message "Onion Host" "$onion_text"
          ;;
        import)
          tui_require_docker || return
          if tui_confirm "Import notes now? The relay stops for it." "y"; then
            # The import streams for minutes; suspend the TUI so it is visible.
            tui_cleanup
            printf "\n"
            run_import_once "$(resolve_mode "import")" || true
            printf "\nPress Enter to return to the TUI... "
            read -r _ || true
            tui_init
            TUI_NEED_FRAME=1
            TUI_NEED_MENU=1
            TUI_NEED_LEFT=1
            TUI_NEED_RIGHT=1
          fi
          ;;
        backup)
          tui_message "Back up now" "To back up the database, run ./$SCRIPT_NAME backup in a terminal."
          ;;
        restore)
          tui_message "Restore a backup" "To restore a backup, run ./$SCRIPT_NAME restore <file> in a terminal."
          ;;
        db_switch)
          tui_message "Switch database engine" "To move the data to the other engine, run ./$SCRIPT_NAME db-switch <badger|lmdb> in a terminal."
          ;;
        env_upgrade)
          if [[ ! -f "$ROOT_DIR/.env.example" ]]; then
            tui_message "Upgrade .env" ".env.example not found."
            return
          fi
          if [[ ! -f "$ROOT_DIR/.env" ]]; then
            if tui_confirm "No .env found. Create from .env.example?" "y"; then
              cp "$ROOT_DIR/.env.example" "$ROOT_DIR/.env"
              tui_message "Upgrade .env" ".env created from .env.example.\n\nPlease edit your .env and then\nrestart services."
            fi
            return
          fi
          local upgrade_missing=""
          upgrade_missing="$(list_missing_env_vars)"
          local upgrade_count=0
          if [[ -n "$upgrade_missing" ]]; then
            upgrade_count="$(printf "%s\n" "$upgrade_missing" | wc -l)"
            upgrade_count="${upgrade_count// /}"
          fi
          if [[ "$upgrade_count" -eq 0 ]]; then
            tui_message "Upgrade .env" "No missing variables found.\nYour .env is up to date."
            return
          fi
          local upgrade_preview=""
          upgrade_preview="$(printf "%s\n" "$upgrade_missing" | head -n 10)"
          if [[ "$upgrade_count" -gt 10 ]]; then
            upgrade_preview="$upgrade_preview\n... and $((upgrade_count - 10)) more"
          fi
          tui_message "Missing Variables" "$upgrade_count variable(s) found:\n\n$upgrade_preview"
          if tui_confirm "Add to .env?" "y"; then
            upgrade_env_file
            local upgrade_note=""
            [[ -z "$UPGRADE_ENV_NOTE" ]] || upgrade_note="\n\n$UPGRADE_ENV_NOTE"
            tui_message "Upgrade .env" "$upgrade_count variable(s) added.\n\nPlease review and edit your\n.env file, then restart\nservices.$upgrade_note"
          fi
          ;;
        help)
          show_help_screen
          ;;
        about)
          tui_about
          ;;
        quit)
          return 1
          ;;
      esac
      ;;
    logs)
      case "$id" in
        service)
          tui_set_view "logs_service"
          ;;
        tail)
          local new_tail
          new_tail="$(tui_prompt "Tail lines: " "$TAIL_COUNT")"
          if [[ "$new_tail" =~ ^[0-9]+$ ]]; then
            TAIL_COUNT="$new_tail"
            if [[ "$FOLLOW_LOGS" == "1" ]]; then
              start_log_stream
            else
              refresh_log_snapshot
            fi
            TUI_NEED_RIGHT=1
          else
            tui_message "Logs" "Tail must be a number."
          fi
          ;;
        follow)
          if [[ "$FOLLOW_LOGS" == "1" ]]; then
            FOLLOW_LOGS=0
            stop_log_stream
            refresh_log_snapshot
          else
            FOLLOW_LOGS=1
            start_log_stream
          fi
          TUI_NEED_RIGHT=1
          ;;
        back)
          tui_set_view "main"
          ;;
      esac
      ;;
    logs_service)
      if [[ "$id" == "back" ]]; then
        tui_set_view "logs"
      else
        LOG_SERVICE="$id"
        if [[ "$FOLLOW_LOGS" == "1" ]]; then
          start_log_stream
        else
          refresh_log_snapshot
        fi
        TUI_NEED_RIGHT=1
        tui_set_view "logs"
      fi
      ;;
    env_list)
      case "$id" in
        add)
          local new_key
          local new_value
          new_key="$(tui_prompt "New key: " "" _validate_prompt_new_key)"
          if [[ -z "$new_key" ]]; then
            return
          fi
          PROMPT_ENV_KEY="$new_key"
          new_value="$(tui_prompt "New value: " "" _validate_prompt_env_value)"
          if [[ -z "$new_value" ]]; then
            return
          fi
          tui_engine_unknown_note "$new_key"
          set_env_var "$new_key" "$new_value"
          restart_after_env_change
          ;;
        back)
          tui_set_view "main"
          ;;
        *)
          if [[ "$id" == key:* ]]; then
            CURRENT_ENV_KEY="${id#key:}"
            tui_set_view "env_item"
          fi
          ;;
      esac
      ;;
    env_item)
      case "$id" in
        edit)
          local current=""
          local new_value=""
          current="$(read_env_var "$CURRENT_ENV_KEY" 2>/dev/null || true)"
          PROMPT_ENV_KEY="$CURRENT_ENV_KEY"
          new_value="$(tui_prompt "New value (blank to keep): " "$current" _validate_prompt_env_value)"
          if [[ -z "$new_value" ]]; then
            return
          fi
          tui_engine_unknown_note "$CURRENT_ENV_KEY"
          set_env_var "$CURRENT_ENV_KEY" "$new_value"
          restart_after_env_change
          ;;
        reveal)
          # Explicit reveal: the list view only ever shows masked values.
          local shown=""
          shown="$(read_env_var "$CURRENT_ENV_KEY" 2>/dev/null || true)"
          if [[ -z "$shown" ]]; then
            shown="(empty)"
          fi
          tui_message "$CURRENT_ENV_KEY" "$shown"
          ;;
        remove)
          # without the line the relay runs lmdb (upstream's default): the same
          # flip as an edit, refused the same way
          if [[ "$CURRENT_ENV_KEY" == "DB_ENGINE" ]] && ! engine_change_allowed lmdb; then
            tui_message "$CURRENT_ENV_KEY" "Not removed: without DB_ENGINE the relay runs lmdb. $ENGINE_CHANGE_ERR"
            return
          fi
          if tui_confirm "Remove $CURRENT_ENV_KEY?" "n"; then
            tui_engine_unknown_note "$CURRENT_ENV_KEY"
            remove_env_var "$CURRENT_ENV_KEY"
            restart_after_env_change
          fi
          ;;
        back)
          tui_set_view "env_list"
          ;;
      esac
      ;;
    json_files)
      if [[ "$id" == "back" ]]; then
        tui_set_view "main"
      else
        CURRENT_JSON_FILE="$id"
        if ! ensure_json_array_file "$CURRENT_JSON_FILE"; then
          tui_message "JSON Editor" "File missing or invalid."
          return
        fi
        tui_set_view "json_items"
      fi
      ;;
    json_items)
      case "$id" in
        add)
          local new_item
          new_item="$(tui_prompt "Add item: " "")"
          if [[ -z "$new_item" ]]; then
            tui_message "JSON Editor" "Item is empty."
            return
          fi
          if ! validate_json_item "$CURRENT_JSON_FILE" "$new_item"; then
            tui_message "JSON Editor" "$VALIDATION_ERROR"
            return
          fi
          local item_to_add="$VALIDATION_VALUE"
          local path="$ROOT_DIR/$CURRENT_JSON_FILE"
          run_capture json_list_items "$path"
          local duplicate=0
          local existing
          while IFS= read -r existing; do
            if [[ "$existing" == "$item_to_add" ]]; then
              duplicate=1
              break
            fi
          done <<<"$RUN_OUTPUT"
          if [[ "$duplicate" == "1" ]]; then
            tui_message "JSON Editor" "Item already exists."
            return
          fi
          json_add_item "$path" "$item_to_add"
          ;;
        clear)
          if tui_confirm "Clear entire list?" "n"; then
            json_clear "$ROOT_DIR/$CURRENT_JSON_FILE"
          fi
          ;;
        back)
          tui_set_view "json_files"
          ;;
        item:*)
          local index="${id#item:}"
          local path="$ROOT_DIR/$CURRENT_JSON_FILE"
          local output=""
          output="$(json_list_items "$path" 2>/dev/null || true)"
          local current_item=""
          current_item="$(printf "%s" "$output" | sed -n "$((index + 1))p")"
          if [[ -n "$current_item" ]]; then
            if tui_confirm "Remove item?\n\n$current_item" "n"; then
              json_remove_index "$path" "$index"
            fi
          fi
          ;;
      esac
      ;;
  esac
  TUI_NEED_MENU=1
  TUI_NEED_LEFT=1
  TUI_NEED_RIGHT=1
  return 0
}

tui_handle_key() {
  local key="$1"
  local count=${#MENU_IDS[@]}

  # Main view: an entry's shortcut letter runs exactly what Enter runs on it.
  if [[ "$TUI_VIEW" == "main" && ${#key} -eq 1 ]]; then
    local k
    for ((k = 0; k < count; k++)); do
      if [[ -n "${MENU_KEYS[$k]:-}" && "${MENU_KEYS[$k]}" == "$key" ]]; then
        TUI_SEL="$k"
        TUI_NEED_LEFT=1
        tui_handle_enter || return 1
        TUI_NEED_LEFT=1
        return 0
      fi
    done
  fi

  # Navigation skips group names (tui_menu_selectable).
  case "$key" in
    up|k)
      tui_sel_step "$TUI_SEL" -1 || true
      ;;
    down|j)
      tui_sel_step "$TUI_SEL" 1 || true
      ;;
    home|g)
      tui_sel_step -1 1 || true
      TUI_NEED_LEFT=1
      ;;
    end|G)
      tui_sel_step "$count" -1 || true
      TUI_NEED_LEFT=1
      ;;
    pgup|pgdn)
      # Since P5 the page keys belong to the log panel's scrollback (the
      # plan's P5 DoD assigns them there); menus page via g/G, Home/End,
      # j/k and the digit shortcuts.
      if [[ "$TUI_RIGHT_MODE" == "logs" ]]; then
        local page=$((RIGHT_CONTENT_HEIGHT > 1 ? RIGHT_CONTENT_HEIGHT - 1 : 1))
        if [[ "$key" == "pgup" ]]; then
          # Clamp against what the panel shows: with a filter, the matching
          # lines in the window under the hit-count row (one row shorter).
          local height=$RIGHT_CONTENT_HEIGHT
          local total=${#LOG_LINES[@]}
          if [[ -n "$LOG_FILTER" ]]; then
            height=$((RIGHT_CONTENT_HEIGHT - 1))
            tui_log_view_lines "$height"
            total=$_VIEW_MATCHES
          fi
          local max_scroll=$((total > height ? total - height : 0))
          LOG_SCROLL=$((LOG_SCROLL + page))
          (( LOG_SCROLL > max_scroll )) && LOG_SCROLL=$max_scroll
        else
          LOG_SCROLL=$((LOG_SCROLL - page))
          (( LOG_SCROLL < 0 )) && LOG_SCROLL=0
        fi
        TUI_NEED_RIGHT=1
      fi
      ;;
    /)
      # Live substring filter for the log panel. No default on purpose:
      # an empty Enter must clear the filter instead of re-applying it.
      if [[ "$TUI_RIGHT_MODE" == "logs" ]]; then
        local new_filter
        new_filter="$(tui_prompt "Filter (empty clears): " "")"
        LOG_FILTER="$new_filter"
        LOG_SCROLL=0
        TUI_NEED_RIGHT=1
        # the prompt cleared its rows, which belong to the menu
        TUI_NEED_LEFT=1
      fi
      ;;
    tab)
      if [[ "$TUI_RIGHT_MODE" == "logs" ]]; then
        TUI_RIGHT_MODE="status"
      else
        TUI_RIGHT_MODE="logs"
      fi
      TUI_NEED_RIGHT=1
      ;;
    [1-9])
      # the nth selectable entry (group names do not count)
      local n=0 d
      for ((d = 0; d < count; d++)); do
        tui_menu_selectable "$d" || continue
        n=$((n + 1))
        if (( n == key )); then
          TUI_SEL="$d"
          TUI_NEED_LEFT=1
          break
        fi
      done
      ;;
    enter)
      tui_handle_enter || return 1
      # a prompt the entry opened cleared its rows, which belong to the menu
      TUI_NEED_LEFT=1
      ;;
    left|esc)
      tui_handle_back || return 1
      ;;
    quit)
      if [[ "$TUI_VIEW" == "main" ]]; then
        return 1
      fi
      tui_handle_back
      ;;
    del|f1|f2|unknown|paste)
      # Recognized escape sequences not bound to a menu action; they must
      # never fall through to esc/back.
      ;;
  esac
  return 0
}

# Test seam (see HAVEN_TUI_SYNC_FILE at the top): publish "a render pass has
# completed" as an incrementing number. Written via a temp file and rename so a
# reader never sees a half-written value.
tui_sync_mark() {
  [[ -n "${HAVEN_TUI_SYNC_FILE:-}" ]] || return 0
  TUI_SYNC_COUNT=$((TUI_SYNC_COUNT + 1))
  { printf '%s\n' "$TUI_SYNC_COUNT" > "$HAVEN_TUI_SYNC_FILE.tmp" \
      && mv -f "$HAVEN_TUI_SYNC_FILE.tmp" "$HAVEN_TUI_SYNC_FILE"; } 2>/dev/null || true
}

tui_loop() {
  local start_view="$1"
  local running=1
  local rendered=0

  # Size check BEFORE tui_init touches stty/the alternate screen, so a
  # too-small terminal leaves the shell state untouched.
  tui_update_layout
  if [[ "$TUI_TOO_SMALL" == "1" ]]; then
    printf 'Terminal too small: %s needs at least %d columns x %d lines (current: %d x %d).\n' \
      "$SCRIPT_NAME" "$TUI_MIN_COLS" "$TUI_MIN_LINES" "$TUI_COLS" "$TUI_LINES" >&2
    exit 1
  fi

  tui_init
  trap 'TUI_NEED_RESIZE=1' SIGWINCH

  if [[ -n "$start_view" ]]; then
    TUI_VIEW="$start_view"
  else
    TUI_VIEW="main"
  fi
  TUI_SEL=0
  TUI_OFFSET=0
  TUI_NEED_FRAME=1
  TUI_NEED_LEFT=1
  TUI_NEED_RIGHT=1

  if [[ -z "$LOG_SERVICE" ]]; then
    LOG_SERVICE="relay"
  fi
  TUI_RIGHT_TITLE="Logs: ${LOG_SERVICE:-all}"
  _SPINNER_TICK=0

  tui_update_docker_status
  if [[ "$FOLLOW_LOGS" == "1" ]]; then
    start_log_stream
  else
    refresh_log_snapshot
  fi

  while [[ "$running" -eq 1 ]]; do
    if [[ "$TUI_NEED_RESIZE" -eq 1 ]]; then
      TUI_NEED_RESIZE=0
      tui_update_layout
      if [[ "$TUI_TOO_SMALL" == "1" ]]; then
        # Below the renderable minimum: show a message instead of a garbled
        # frame; normal operation resumes once the terminal grows again.
        tui_clear
        printf '\033[1;1H%s' "${CLR_RESET}"
        printf 'Terminal too small: need at least %d cols x %d lines (current: %d x %d). Enlarge to continue.' \
          "$TUI_MIN_COLS" "$TUI_MIN_LINES" "$TUI_COLS" "$TUI_LINES"
        TUI_NEED_FRAME=0
        TUI_NEED_MENU=0
        TUI_NEED_LEFT=0
        TUI_NEED_RIGHT=0
        rendered=1
      else
        TUI_NEED_FRAME=1
        TUI_NEED_MENU=1
        TUI_NEED_LEFT=1
        TUI_NEED_RIGHT=1
      fi
    fi

    _SPINNER_TICK=$((_SPINNER_TICK + 1))
    if (( _SPINNER_TICK % 4 == 0 && FOLLOW_LOGS == 1 )); then
      # With the 150 ms poll this fires every ~600 ms; draining pulls all
      # buffered lines per tick, so follow-logs stay visibly flowing.
      TUI_NEED_RIGHT=1
    fi

    tui_update_docker_status
    tui_ensure_log_stream
    drain_log_stream

    if [[ "$TUI_NEED_FRAME" -eq 1 ]]; then
      tui_draw_frame 1
      TUI_NEED_FRAME=0
      TUI_NEED_LEFT=1
      TUI_NEED_RIGHT=1
      rendered=1
    fi

    if [[ "$TUI_NEED_RIGHT" -eq 1 ]]; then
      tui_render_right_panel
      TUI_NEED_RIGHT=0
      rendered=1
    fi

    if [[ "$TUI_NEED_LEFT" -eq 1 ]]; then
      tui_render_left_menu
      TUI_NEED_LEFT=0
      rendered=1
    fi

    if [[ "$rendered" -eq 1 ]]; then
      rendered=0
      tui_sync_mark
    fi

    tui_read_key || continue
    if ! tui_handle_key "$_KEY"; then
      running=0
    fi
  done
}

restart_after_env_change() {
  if ! docker info >/dev/null 2>&1; then
    warn "Docker not running; restart skipped."
    return
  fi

  local mode=""
  if docker ps --format '{{.Names}}' | grep -qx 'haven-tor'; then
    mode="tor"
  elif relay_container_running; then
    mode="plain"
  else
    warn "No running containers to restart."
    return
  fi

  # Runs with errexit active inside the TUI: a refusal from restart_services
  # would end the TUI, so the one-shot check comes first and is shown here.
  local refusal=""
  if refusal="$(start_blocked 2>&1)"; then
    if [[ "$TUI_ACTIVE" == "1" ]]; then
      tui_message "Restart" ".env was saved; the restart to apply it is skipped."$'\n\n'"$refusal"
    else
      printf '%s\n' "$refusal"
      warn ".env was saved; the restart to apply it is skipped."
    fi
    return 0
  fi

  info "Restarting services ($mode) to apply .env changes..."
  # The start's preparation (missing JSON lists ask one dialog each) runs
  # BEFORE the stop: an unanswered dialog must not leave the relay down.
  prepare_start
  local START_PREPARED=1
  restart_services "$mode"
}

menu_env_editor() {
  if [[ "$TUI_ACTIVE" == "1" ]]; then
    if ! ensure_env_file; then
      tui_message ".env" ".env missing."
      return
    fi
    tui_set_view "env_list"
    return
  fi
  if [[ ! -t 0 ]]; then
    die "Env editor requires a TTY."
  fi
  if ! ensure_env_file; then
    die ".env missing."
  fi
  tui_loop "env_list"
}

menu_logs() {
  if [[ "$TUI_ACTIVE" == "1" ]]; then
    tui_set_view "logs"
    return
  fi
  if [[ -t 0 ]]; then
    tui_loop "logs"
  else
    LOG_SERVICE="all"
    local mode
    local compose_file
    mode="$(resolve_mode "logs")"
    compose_file="$(compose_file_for "$mode")"
    require_compose_file "$compose_file"
    stream_logs "$mode" "$compose_file" "$LOG_SERVICE"
  fi
}

menu_json_editor() {
  if [[ "$TUI_ACTIVE" == "1" ]]; then
    if ! detect_json_tool; then
      tui_message "JSON Editor" "jq or python3 is required for JSON editing."
      return
    fi
    tui_set_view "json_files"
    return
  fi
  if [[ ! -t 0 ]]; then
    die "JSON editor requires a TTY."
  fi
  if ! detect_json_tool; then
    die "jq or python3 is required for JSON editing."
  fi
  tui_loop "json_files"
}

tui() {
  if [[ ! -t 0 ]]; then
    die "TUI requires a TTY. Use CLI commands instead."
  fi
  tui_loop "main"
}

parse_args() {
  if [[ $# -eq 0 ]]; then
    COMMAND="tui"
    return
  fi

  while [[ $# -gt 0 ]]; do
    case "$1" in
      start|stop|restart|logs|status|tui|help|import|onion|json|env|env-upgrade|backup|restore|db-switch)
        COMMAND="$1"
        shift
        ;;
      -y|--yes)
        ASSUME_YES=1
        shift
        ;;
      --rollback)
        DB_SWITCH_ROLLBACK=1
        shift
        ;;
      --from)
        [[ $# -lt 2 ]] && die "--from requires an engine: badger or lmdb"
        [[ "$2" == "badger" || "$2" == "lmdb" ]] || die "--from takes badger or lmdb (lower case), not '$(printable_text "$2")'."
        DB_SWITCH_FROM="$2"
        shift 2
        ;;
      -t|--tor)
        MODE="tor"
        shift
        ;;
      --plain)
        MODE="plain"
        shift
        ;;
      --tail)
        [[ $# -lt 2 ]] && die "--tail requires a number"
        TAIL_COUNT="$2"
        shift 2
        ;;
      -s|--service)
        [[ $# -lt 2 ]] && die "--service requires a name"
        LOG_SERVICE="$2"
        shift 2
        ;;
      --all)
        LOG_SERVICE="all"
        shift
        ;;
      --no-follow)
        FOLLOW_LOGS=0
        shift
        ;;
      --no-build)
        BUILD_IMAGES=0
        shift
        ;;
      --build)
        BUILD_IMAGES=1
        shift
        ;;
      -h|--help)
        COMMAND="help"
        shift
        ;;
      *)
        if [[ ( "$COMMAND" == "backup" || "$COMMAND" == "restore" ) && -z "$DATA_FILE_ARG" && "$1" != -* ]]; then
          DATA_FILE_ARG="$1"
          shift
        elif [[ "$COMMAND" == "db-switch" && "$DB_SWITCH_ARG_SET" == "0" && "$1" != -* ]]; then
          DB_SWITCH_ARG="$1"
          DB_SWITCH_ARG_SET=1
          shift
        elif [[ "$COMMAND" == "db-switch" && "$1" != -* ]]; then
          die "db-switch takes one engine: badger or lmdb."
        else
          die "Unknown argument: $1"
        fi
        ;;
    esac
  done

  if [[ "$DB_SWITCH_ROLLBACK" == "1" && "$COMMAND" != "db-switch" ]]; then
    die "--rollback belongs to db-switch: $SCRIPT_NAME db-switch --rollback"
  fi
  if [[ -n "$DB_SWITCH_FROM" && "$COMMAND" != "db-switch" ]]; then
    die "--from belongs to db-switch: $SCRIPT_NAME db-switch <badger|lmdb> --from <badger|lmdb>"
  fi
  if [[ -n "$DB_SWITCH_FROM" && "$DB_SWITCH_ROLLBACK" == "1" ]]; then
    die "--from belongs to a switch, not to --rollback (the rollback reads what to put back from db/)."
  fi
  if [[ "$COMMAND" == "db-switch" ]]; then
    if [[ "$DB_SWITCH_ROLLBACK" == "1" && "$DB_SWITCH_ARG_SET" == "1" ]]; then
      die "db-switch takes either an engine or --rollback, not both."
    fi
    if [[ "$DB_SWITCH_ROLLBACK" == "0" && "$DB_SWITCH_ARG_SET" == "0" ]]; then
      die "db-switch needs an engine: $SCRIPT_NAME db-switch badger|lmdb (or --rollback)."
    fi
  fi
}

main() {
  cd "$ROOT_DIR"
  detect_compose
  parse_args "$@"

  case "$COMMAND" in
    tui)
      tui
      ;;
    start)
      ensure_docker
      start_services "$(resolve_mode "start")"
      ;;
    stop)
      ensure_docker
      stop_services "$(resolve_mode "stop")"
      ;;
    restart)
      ensure_docker
      restart_services "$(resolve_mode "restart")"
      ;;
    logs)
      if [[ -z "$LOG_SERVICE" ]]; then
        if [[ -t 0 ]]; then
          menu_logs
        else
          LOG_SERVICE="all"
        fi
      fi

      if [[ -n "$LOG_SERVICE" ]]; then
        ensure_docker
        local mode
        local compose_file
        mode="$(resolve_mode "logs")"
        compose_file="$(compose_file_for "$mode")"
        require_compose_file "$compose_file"
        stream_logs "$mode" "$compose_file" "$LOG_SERVICE"
      fi
      ;;
    status)
      ensure_docker
      show_status "$(resolve_mode "status")"
      ;;
    onion)
      show_onion_host
      ;;
    import)
      ensure_docker
      run_import_once "$(resolve_mode "import")" || exit 1
      ;;
    backup)
      ensure_docker
      backup_relay_db "$(resolve_mode "backup")" "$DATA_FILE_ARG" || exit 1
      ;;
    restore)
      ensure_docker
      restore_relay_db "$(resolve_mode "restore")" "$DATA_FILE_ARG" || exit 1
      ;;
    db-switch)
      # both check docker themselves, after the argument: a typo needs no daemon
      if [[ "$DB_SWITCH_ROLLBACK" == "1" ]]; then
        db_switch_rollback || exit 1
      else
        db_switch "$DB_SWITCH_ARG" "$DB_SWITCH_FROM" || exit 1
      fi
      ;;
    env)
      menu_env_editor
      ;;
    env-upgrade)
      if [[ ! -f "$ROOT_DIR/.env.example" ]]; then
        die ".env.example not found."
      fi
      if [[ ! -f "$ROOT_DIR/.env" ]]; then
        cp "$ROOT_DIR/.env.example" "$ROOT_DIR/.env"
        success ".env created from .env.example."
        info "Please edit your .env and then restart services."
        exit 0
      fi
      local missing_vars=""
      missing_vars="$(list_missing_env_vars)"
      local missing_count=0
      if [[ -n "$missing_vars" ]]; then
        missing_count="$(printf "%s\n" "$missing_vars" | wc -l)"
        missing_count="${missing_count// /}"
      fi
      if [[ "$missing_count" -eq 0 ]]; then
        success "No missing variables. Your .env is up to date."
        exit 0
      fi
      info "$missing_count new variable(s) found:"
      printf "%s\n" "$missing_vars"
      upgrade_env_file
      success "$missing_count variable(s) added to .env."
      [[ -z "$UPGRADE_ENV_NOTE" ]] || info "$UPGRADE_ENV_NOTE"
      info "Please review and edit your .env file, then restart services."
      ;;
    json)
      menu_json_editor
      ;;
    help|"")
      print_usage
      ;;
    *)
      die "Unknown command: $COMMAND"
      ;;
  esac
}

# Runs only when executed directly (./haven ...), not when sourced by the
# unit tests in tests/ — no environment variable that could leak into a
# user shell and silently disable main().
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
