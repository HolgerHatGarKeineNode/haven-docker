tui_update_docker_status() {
  local now
  printf -v now '%(%s)T' -1
  if [[ -z "$TUI_LAST_DOCKER_CHECK" || $((now - TUI_LAST_DOCKER_CHECK)) -ge 5 ]]; then
    local prev="$TUI_DOCKER_OK"
    local next=0
    if docker info >/dev/null 2>&1; then
      next=1
    else
      next=0
    fi
    if [[ "$next" -ne "$prev" ]]; then
      TUI_NEED_LEFT=1
      TUI_NEED_MENU=1
    fi
    TUI_DOCKER_OK="$next"
    TUI_LAST_DOCKER_CHECK="$now"
  fi
}

# tui_view_has_details [view] — true for the views whose right pane is a
# context pane (Tab: details <-> logs): the settings editor, the restore list
# and the engine switch overview.
tui_view_has_details() {
  case "${1:-$TUI_VIEW}" in
    env_list|env_item|restore_list|switch) return 0 ;;
    *) return 1 ;;
  esac
}

tui_set_view() {
  # A view with a context pane shows the details of the selected entry on the
  # right; leaving it gives the pane back the mode it had before.
  if tui_view_has_details "$1"; then
    if ! tui_view_has_details "$TUI_VIEW"; then
      TUI_RIGHT_PREV="$TUI_RIGHT_MODE"
      TUI_RIGHT_MODE="details"
    fi
  elif tui_view_has_details "$TUI_VIEW"; then
    [[ "$TUI_RIGHT_MODE" == details ]] && TUI_RIGHT_MODE="$TUI_RIGHT_PREV"
  fi
  [[ "$1" == env_list || "$1" == env_item ]] || SETTINGS_FILTER=""
  TUI_VIEW="$1"
  TUI_SEL=0
  TUI_OFFSET=0
  TUI_NEED_MENU=1
  TUI_NEED_LEFT=1
  TUI_NEED_RIGHT=1
}

# The selection marker is the only glyph in front of a menu label: the
# selected row gets "▸ ", every other row two blanks, so labels share a column.
tui_menu_icon() {
  if [[ "${1:-}" == "selected" ]]; then
    _ICON="$ICO_SELECTED"
  else
    _ICON="  "
  fi
}

# tui_state_engine — the engine word of the main view's state line: the engine
# of the data in db/ when there is exactly one; "mixed" when directories hold
# both or disagree; otherwise what DB_ENGINE in .env makes the relay run
# (upstream runs lmdb for anything but "badger", unset included).
tui_state_engine() {
  db_disk_engine
  case "$DISK_ENGINE" in
    badger|lmdb) _ENGINE_WORD="$DISK_ENGINE" ;;
    mixed|split) _ENGINE_WORD="mixed" ;;
    *)
      if [[ "$(env_engine_state)" == "badger" ]]; then
        _ENGINE_WORD="badger"
      else
        _ENGINE_WORD="lmdb"
      fi
      ;;
  esac
}

# tui_state_line — the state of the main view, written into the group names it
# belongs to: MENU_STATE is the relay's ("● Running  Tor", shown after "Relay"),
# MENU_ENGINE_NOTE the data's ("engine: badger", shown after "Data"). When the
# relay state does not fit behind its group name, whole fields are dropped from
# the right; a word is never cut.
tui_state_line() {
  tui_state_engine
  MENU_ENGINE_NOTE="engine: $_ENGINE_WORD"
  local budget=$((LEFT_CONTENT_W - ${#TUI_GROUP_GAP} - 5))   # 5 = width of "Relay"
  local -a fields=()
  if [[ "$TUI_DOCKER_OK" -ne 1 ]]; then
    fields+=("○ Docker offline")
  else
    if relay_container_running 2>/dev/null; then
      fields+=("● Running")
    else
      fields+=("○ Stopped")
    fi
    if [[ "$(resolve_mode "status" 2>/dev/null)" == "tor" ]]; then
      fields+=("Tor")
    else
      fields+=("Plain")
    fi
  fi

  local n=${#fields[@]} i line
  while (( n > 1 )); do
    line="${fields[0]}"
    for ((i = 1; i < n; i++)); do
      line+="  ${fields[$i]}"
    done
    tui_str_width "$line"
    (( _WIDTH <= budget )) && break
    n=$((n - 1))
  done
  if (( n == 1 )); then
    line="${fields[0]}"
  fi
  MENU_STATE="$line"
}

# tui_group_note <menu id> — _NOTE: the state drawn after a group name in the
# main view (relay state after "Relay", engine after "Data"), else empty.
tui_group_note() {
  case "$1" in
    group:relay) _NOTE="$MENU_STATE" ;;
    group:data) _NOTE="$MENU_ENGINE_NOTE" ;;
    *) _NOTE="" ;;
  esac
}

# tui_menu_selectable <index> — true for an entry the selection may rest on
# (group names are drawn but never selected).
tui_menu_selectable() {
  local idx="$1"
  (( idx >= 0 && idx < ${#MENU_IDS[@]} )) || return 1
  [[ "${MENU_IDS[$idx]}" != group:* ]]
}

# tui_clamp_sel — the selection inside the list and never on a group name:
# forward first, else backward (a list of group rows only keeps it in range).
tui_clamp_sel() {
  local count=${#MENU_IDS[@]}
  (( TUI_SEL < 0 )) && TUI_SEL=0
  (( count > 0 && TUI_SEL >= count )) && TUI_SEL=$((count - 1))
  if (( count > 0 )) && ! tui_menu_selectable "$TUI_SEL"; then
    tui_sel_step "$TUI_SEL" 1 || tui_sel_step "$TUI_SEL" -1 || true
  fi
  return 0
}

# tui_sel_step <from> <step> — move the selection from <from> in direction
# <step> (+1/-1) to the next selectable entry; false (selection unchanged)
# when there is none.
tui_sel_step() {
  local i=$(($1 + $2))
  local count=${#MENU_IDS[@]}
  while (( i >= 0 && i < count )); do
    if tui_menu_selectable "$i"; then
      TUI_SEL="$i"
      TUI_NEED_LEFT=1
      return 0
    fi
    i=$((i + $2))
  done
  return 1
}

# Display-only masking for values of sensitive keys in the env list.
# Not a security feature — the .env itself stays plaintext; this only keeps
# shoulder-surfers and screenshots from carrying the secret away.
mask_env_value() {
  local v="${1:-}"
  if (( ${#v} > 8 )); then
    _MASKED="…${v: -4}"
  elif [[ -n "$v" ]]; then
    _MASKED="…"
  else
    _MASKED=""
  fi
}

# env_effective_value <key> — _EFFECTIVE: the raw value of the LAST line that
# sets <key> in .env (the one Compose uses, as read_env_var reads it),
# _EFFECTIVE_LINES: how many lines set it.
env_effective_value() {
  _EFFECTIVE="$(read_env_var "$1" 2>/dev/null || true)"
  _EFFECTIVE_LINES=0
  [[ -f "$ROOT_DIR/.env" ]] && env_key_stats "$ROOT_DIR/.env" "$1" && _EFFECTIVE_LINES="$_ENV_KEY_LINES"
  return 0
}

# settings_shown_value <key> <raw value> — _SHOWN: the value as the settings
# editor shows it: without the quotes around it ("" stays for an empty quoted
# value), masked for a credential (env_key_is_sensitive).
settings_shown_value() {
  local v="$2"
  _SHOWN_MASKED=0
  if (( ${#v} > 2 )) && { [[ "$v" == \"*\" ]] || [[ "$v" == \'*\' ]]; }; then
    v="${v:1:${#v}-2}"
  fi
  if env_key_is_sensitive "$1" "$v"; then
    mask_env_value "$v"
    v="$_MASKED"
    _SHOWN_MASKED=1
  fi
  _SHOWN="$v"
}

# env_key_is_sensitive <key> [value] — true for a credential. By name: the key
# is cut into words at "_" and at camelCase humps (apiToken: api, Token), case
# ignored; it is a credential when a word ENDS in KEY, KEYS, TOKEN, SECRET,
# SECRETS, PASSWORD, PASSWORDS, PASSWD, PASS, PASSPHRASE, PW or PWD (so
# S3_SECRETKEY, APITOKEN, PRIVKEY, NGROK_AUTHTOKEN, DB_PWD), or a word IS one
# of NSEC, SK, SEED, MNEMONIC, XPRV, MACAROON, RUNE, CREDENTIAL, CREDENTIALS,
# AUTH, AUTHORIZATION, BUNKER, NWC or DSN. The word TOKENS is a count, not a
# credential (*_TOKENS_PER_INTERVAL, *_MAX_TOKENS stay visible), and a key whose
# last word is FILE, PATH or DIR holds a file path (IMPORT_SEED_RELAYS_FILE).
# By value, whatever the key: a value that starts with nsec1 or ncryptsec1, is
# exactly 64 hex characters, contains "secret=" (bunker://…, nostr+walletconnect
# …) or is a URL with a user:password@ part. OWNER_NPUB and the other *_NPUB,
# RELAY_URL, the *_ICON URLs, file paths and the limiters' numbers stay visible.
# Of .env.example's keys this masks S3_ACCESS_KEY_ID and S3_SECRET_KEY.
ENV_SECRET_ENDINGS=(KEY KEYS TOKEN SECRET SECRETS PASSWORD PASSWORDS PASSWD PASS PASSPHRASE PW PWD)
ENV_SECRET_WORDS=" NSEC SK SEED MNEMONIC XPRV MACAROON RUNE CREDENTIAL CREDENTIALS AUTH AUTHORIZATION BUNKER NWC DSN "
env_key_is_sensitive() {
  local word end k="$1" v="${2:-}" lv
  local -a words=()
  # the value, without the quotes around it
  if (( ${#v} >= 2 )) && { [[ "$v" == \"*\" ]] || [[ "$v" == \'*\' ]]; }; then
    v="${v:1:${#v}-2}"
  fi
  v="${v#[\"\']}"
  lv="${v,,}"
  [[ "$lv" == nsec1* || "$lv" == ncryptsec1* || "$lv" == *secret=* ]] && return 0
  [[ "$v" =~ ^[0-9A-Fa-f]{64}$ ]] && return 0
  [[ "$v" =~ ^[A-Za-z][A-Za-z0-9+.-]*://[^/@?#]*:[^/@?#]*@ ]] && return 0
  # camelCase humps become "_" (only keys with a lower-case letter have any)
  while [[ "$k" == *[a-z]* && "$k" =~ ^(.*[a-z0-9])([A-Z].*)$ ]]; do
    k="${BASH_REMATCH[1]}_${BASH_REMATCH[2]}"
  done
  IFS=_ read -ra words <<<"${k^^}"
  (( ${#words[@]} )) || return 1
  case "${words[${#words[@]}-1]}" in FILE|PATH|DIR) return 1 ;; esac
  for word in "${words[@]}"; do
    [[ -n "$word" && "$word" != TOKENS ]] || continue
    [[ "$ENV_SECRET_WORDS" == *" $word "* ]] && return 0
    for end in "${ENV_SECRET_ENDINGS[@]}"; do
      [[ "$word" == *"$end" ]] && return 0
    done
  done
  return 1
}

# --- settings editor: structure and descriptions from .env.example ----------
# .env.example is the one source: "## <name>" opens a section (keys above the
# first one belong to "General"), the "# " comment lines directly above a key
# are its description, a trailing "# comment" is appended to it. A bare "#" or
# a blank line ends a description that has no key yet. "# KEY=value" documents
# a key that is commented out (DOCKER_UID): it places that key, when it is in
# .env, in its section. Loaded again only when the file changed.
EX_SECTIONS=()
EX_KEYS=()               # the keys of .env.example in file order (commented ones too)
declare -A EX_SEC=()     # key -> index in EX_SECTIONS
declare -A EX_DESC=()    # key -> description
declare -A EX_EXAMPLE=() # key -> value as written (without a trailing comment)
declare -A EX_COMMENTED=() # key -> 1 when the line is commented out
EX_STAMP=""
env_example_load() {
  local f="$ROOT_DIR/.env.example" stamp kind a b c d
  stamp="$(stat -c '%Y %s' "$f" 2>/dev/null || stat -f '%m %z' "$f" 2>/dev/null || printf 'none')"
  [[ "$stamp" == "$EX_STAMP" ]] && return 0
  EX_STAMP="$stamp"
  EX_SECTIONS=() EX_KEYS=() EX_SEC=() EX_DESC=() EX_EXAMPLE=() EX_COMMENTED=()
  [[ -f "$f" ]] || return 0
  while IFS=$'\t' read -r kind a b c d; do
    case "$kind" in
      S) EX_SECTIONS+=("$a") ;;
      K)
        if (( ${#EX_SECTIONS[@]} == 0 )); then EX_SECTIONS+=("General"); fi
        [[ -n "${EX_SEC[$a]+x}" ]] && continue
        EX_KEYS+=("$a")
        EX_SEC[$a]=$(( ${#EX_SECTIONS[@]} - 1 ))
        EX_COMMENTED[$a]="$b"
        EX_EXAMPLE[$a]="$c"
        EX_DESC[$a]="$d"
        ;;
    esac
  done < <(awk '
    function value_part(v,    i, c, q, out, rest) {
      q = ""; out = ""; TRAIL = ""
      for (i = 1; i <= length(v); i++) {
        c = substr(v, i, 1)
        if (c == "\"" || c == "\047") { if (q == c) q = ""; else if (q == "") q = c }
        if (c == "#" && q == "") { TRAIL = substr(v, i + 1); break }
        out = out c
      }
      sub(/[ \t]+$/, "", out); sub(/^[ \t]+/, "", TRAIL); sub(/[ \t]+$/, "", TRAIL)
      gsub(/\t/, " ", out); gsub(/\t/, " ", TRAIL)
      return out
    }
    function key_line(line, commented,    ep, key, val, desc) {
      ep = index(line, "=")
      key = substr(line, 1, ep - 1)
      val = value_part(substr(line, ep + 1))
      desc = pending
      if (TRAIL != "") desc = (desc == "" ? TRAIL : desc " " TRAIL)
      printf "K\t%s\t%d\t%s\t%s\n", key, commented, val, desc
      pending = ""
    }
    /^## / { name = substr($0, 4); sub(/[ \t]+$/, "", name); print "S\t" name; pending = ""; next }
    /^#[ \t]*$/ { pending = ""; next }
    /^# ?[A-Za-z_][A-Za-z0-9_]*=/ { line = $0; sub(/^# ?/, "", line); key_line(line, 1); next }
    /^#/ { t = $0; sub(/^#[ \t]?/, "", t); gsub(/\t/, " ", t); pending = (pending == "" ? t : pending " " t); next }
    /^[ \t]*$/ { pending = ""; next }
    {
      line = $0; sub(/^[ \t]*/, "", line); sub(/^export[ \t]+/, "", line)
      ep = index(line, "=")
      if (ep > 0 && substr(line, 1, ep - 1) ~ /^[A-Za-z_][A-Za-z0-9_]*$/) key_line(line, 0)
      else pending = ""
    }
  ' "$f")
}

# env_values_load — ENV_ORDER (keys of .env in file order, as list_env_keys
# reads them), ENV_VALUE (key -> raw value of its LAST line, the one Compose
# uses, as read_env_var reads it) and ENV_COUNT (key -> lines that set it), in
# one pass.
ENV_ORDER=()
declare -A ENV_VALUE=()
declare -A ENV_COUNT=()
env_values_load() {
  local key value
  ENV_ORDER=() ENV_VALUE=() ENV_COUNT=()
  [[ -f "$ROOT_DIR/.env" ]] || return 0
  while IFS=$'\t' read -r key value; do
    if [[ -n "${ENV_VALUE[$key]+x}" ]]; then
      ENV_VALUE[$key]="$value"
      ENV_COUNT[$key]=$(( ${ENV_COUNT[$key]} + 1 ))
      continue
    fi
    ENV_ORDER+=("$key")
    ENV_VALUE[$key]="$value"
    ENV_COUNT[$key]=1
  done < <(awk '
    function strip_inline(v,    i, c, quote, out) {
      quote = ""; out = ""
      for (i = 1; i <= length(v); i++) {
        c = substr(v, i, 1)
        if (c == "\"" || c == "\047") { if (quote == c) quote = ""; else if (quote == "") quote = c }
        if (c == "#" && quote == "") break
        out = out c
      }
      sub(/[ \t]+$/, "", out)
      gsub(/\t/, " ", out)
      return out
    }
    /^[ \t]*#/ { next }
    /^[ \t]*$/ { next }
    /^[ \t]*export[ \t]+[A-Za-z_][A-Za-z0-9_]*=/ {
      line = $0; sub(/^[ \t]*export[ \t]+/, "", line)
      ep = index(line, "="); print substr(line, 1, ep - 1) "\t" strip_inline(substr(line, ep + 1)); next
    }
    /^[A-Za-z_][A-Za-z0-9_]*=/ {
      ep = index($0, "="); print substr($0, 1, ep - 1) "\t" strip_inline(substr($0, ep + 1))
    }
  ' "$ROOT_DIR/.env")
}

# env_section_prefix <key...> — _PREFIX: the longest prefix ending in "_" that
# all keys share and that leaves every key a word; empty for a single key.
env_section_prefix() {
  local p="$1" k
  _PREFIX=""
  (( $# > 1 )) || return 0
  for k in "${@:2}"; do
    while [[ -n "$p" && "$k" != "$p"* ]]; do p="${p%?}"; done
  done
  [[ "$p" == *_* ]] || return 0
  p="${p%_*}_"
  for k in "$@"; do
    [[ ${#k} -gt ${#p} ]] || return 0
  done
  _PREFIX="$p"
}

# env_label_base <key> <prefix> — _LABEL: the readable name of a setting in
# the list: the key without its section's prefix (and without a RELAY_ left
# behind by it: INBOX_RELAY_NAME is the inbox section's "name"), lower case,
# words apart, units as "(s)", "(m)", "(h)". The section row above names the
# relay, so the label does not repeat it. The rate limiters and a few long
# names have a short name of their own (ENV_LABEL_NAMES) that fits next to
# its value at 80 columns; the details pane always shows the full key.
declare -A ENV_LABEL_NAMES=(
  [EVENT_IP_LIMITER_TOKENS_PER_INTERVAL]="event refill"
  [EVENT_IP_LIMITER_INTERVAL]="event interval (m)"
  [EVENT_IP_LIMITER_MAX_TOKENS]="event burst"
  [CONNECTION_RATE_LIMITER_TOKENS_PER_INTERVAL]="connection refill"
  [CONNECTION_RATE_LIMITER_INTERVAL]="connection interval (m)"
  [CONNECTION_RATE_LIMITER_MAX_TOKENS]="connection burst"
  [ALLOW_EMPTY_FILTERS]="empty filters"
  [ALLOW_COMPLEX_FILTERS]="complex filters"
  [RELAY_BIND_ADDRESS]="bind address"
  [HAVEN_LOG_LEVEL]="log level"
  [OWNER_NOTES_FETCH_TIMEOUT_SECONDS]="own notes timeout (s)"
  [TAGGED_NOTES_FETCH_TIMEOUT_SECONDS]="mentions timeout (s)"
  [WHITELISTED_NPUBS_FILE]="whitelist file"
  [BLACKLISTED_NPUBS_FILE]="blacklist file"
)
env_label_base() {
  local k="${1#"$2"}"
  [[ -n "$2" && "$k" == RELAY_?* ]] && k="${k#RELAY_}"
  if [[ -n "${ENV_LABEL_NAMES[$k]:-}" ]]; then
    _LABEL="${ENV_LABEL_NAMES[$k]}"
    return 0
  fi
  case "$k" in
    *_SECONDS) k="${k%_SECONDS}_(S)" ;;
    *_HOURS) k="${k%_HOURS}_(H)" ;;
  esac
  k="${k,,}"
  _LABEL="${k//_/ }"
}

# env_labels — SET_LABEL (key -> label) for every key of .env.example and of
# .env: the base label within its section; a key only in .env keeps its
# whole name (lower case, words apart).
declare -A SET_LABEL=()
env_labels() {
  local i k
  local -a keys=()
  SET_LABEL=()
  for ((i = 0; i < ${#EX_SECTIONS[@]}; i++)); do
    keys=()
    for k in "${EX_KEYS[@]}"; do
      [[ "${EX_SEC[$k]}" == "$i" ]] && keys+=("$k")
    done
    (( ${#keys[@]} )) || continue
    env_section_prefix "${keys[@]}"
    for k in "${keys[@]}"; do
      env_label_base "$k" "$_PREFIX"
      SET_LABEL[$k]="$_LABEL"
    done
  done
  for k in "${ENV_ORDER[@]}"; do
    [[ -n "${SET_LABEL[$k]+x}" ]] && continue
    env_label_base "$k" ""
    SET_LABEL[$k]="$_LABEL"
  done
}

# tui_truncate_middle <text> <cells> <head cells> — _TRUNC: <text> cut in the
# middle to <cells>: the first <head cells>, "…", then as much of the end as
# fits, so the end of a setting name (what tells similar names apart) survives.
tui_truncate_middle() {
  local s="$1" limit="$2" head="$3" n i out_h="" out_t="" w=0 tail_budget
  n=${#s}
  tui_str_width "$s"
  if (( _WIDTH <= limit )); then
    _TRUNC="$s"
    return 0
  fi
  (( head > limit - 2 )) && head=$((limit - 2))
  (( head < 0 )) && head=0
  for ((i = 0; i < n; i++)); do
    tui_char_width "${s:i:1}"
    (( w + _CW <= head )) || break
    out_h+="${s:i:1}"
    w=$((w + _CW))
  done
  tail_budget=$((limit - w - 1))
  w=0
  for ((i = n - 1; i >= 0; i--)); do
    tui_char_width "${s:i:1}"
    (( w + _CW <= tail_budget )) || break
    out_t="${s:i:1}$out_t"
    w=$((w + _CW))
  done
  _TRUNC="${out_h}…${out_t}"
}

# settings_match <key> — true when the settings filter is empty or found,
# case-insensitive, in the key name, its label in the list or its description.
SETTINGS_FILTER=""
settings_match() {
  [[ -z "$SETTINGS_FILTER" ]] && return 0
  local f="${SETTINGS_FILTER,,}" k="${1,,}" d="${EX_DESC[$1]:-}" l="${SET_LABEL[$1]:-}"
  [[ "$k" == *"$f"* || "${d,,}" == *"$f"* || "$l" == *"$f"* ]]
}

# settings_rows — the settings list into MENU_IDS / MENU_LABELS / MENU_VALUES:
# "Add setting", then per section one group row and its keys (in the order of
# .env.example), the keys only in .env under "Other", then "Back". With a
# filter only matching keys and their section rows, or the empty-state text.
# Labels and values are fitted to the pane here (tui_fit_setting_rows).
settings_rows() {
  local i k v n=0
  local -a other=()
  env_example_load
  env_values_load
  env_labels
  if [[ -z "$SETTINGS_FILTER" ]]; then
    MENU_IDS+=(add) MENU_LABELS+=("Add setting") MENU_VALUES+=("")
  fi
  for ((i = 0; i < ${#EX_SECTIONS[@]}; i++)); do
    local -a here=()
    for k in "${EX_KEYS[@]}"; do
      [[ "${EX_SEC[$k]}" == "$i" && -n "${ENV_VALUE[$k]+x}" ]] || continue
      settings_match "$k" && here+=("$k")
    done
    (( ${#here[@]} )) || continue
    MENU_IDS+=("group:sec:$i") MENU_LABELS+=("${EX_SECTIONS[$i]}") MENU_VALUES+=("")
    for k in "${here[@]}"; do
      settings_shown_value "$k" "${ENV_VALUE[$k]}"
      v="$_SHOWN"
      (( ${ENV_COUNT[$k]:-1} > 1 )) && v="(${ENV_COUNT[$k]}×) $v"
      MENU_IDS+=("key:$k") MENU_LABELS+=("${SET_LABEL[$k]}") MENU_VALUES+=("$v")
      n=$((n + 1))
    done
  done
  for k in "${ENV_ORDER[@]}"; do
    [[ -n "${EX_SEC[$k]+x}" ]] && continue
    settings_match "$k" && other+=("$k")
  done
  if (( ${#other[@]} )); then
    MENU_IDS+=("group:sec:other") MENU_LABELS+=("Other") MENU_VALUES+=("")
    for k in "${other[@]}"; do
      settings_shown_value "$k" "${ENV_VALUE[$k]}"
      v="$_SHOWN"
      (( ${ENV_COUNT[$k]:-1} > 1 )) && v="(${ENV_COUNT[$k]}×) $v"
      MENU_IDS+=("key:$k") MENU_LABELS+=("${SET_LABEL[$k]}") MENU_VALUES+=("$v")
      n=$((n + 1))
    done
  fi
  SETTINGS_SHOWN=$n
  if [[ -n "$SETTINGS_FILTER" ]] && (( n == 0 )); then
    local line j=0
    while IFS= read -r line; do
      MENU_IDS+=("group:empty:$j") MENU_LABELS+=("$line") MENU_VALUES+=("")
      j=$((j + 1))
    done < <(printf 'No setting matches "%s". Esc clears the filter.\n' "$SETTINGS_FILTER" | tui_wrap "$LEFT_CONTENT_W")
  fi
  if [[ -z "$SETTINGS_FILTER" ]]; then
    MENU_IDS+=(back) MENU_LABELS+=("Back") MENU_VALUES+=("")
  fi
  tui_fit_setting_rows
}

# tui_fit_setting_rows — fit every key row into the pane: the label keeps its
# width, the value right-aligned gets the rest (at least a third of the row;
# what does not fit is cut at its end — the details pane shows it whole), and
# only a label that still does not fit is cut in the middle. Where two rows of
# one section would still read the same, the cut of the later one moves until
# it differs (more of the start, then less). Sections may repeat a label: the
# section row above (pinned while the list scrolls) tells them apart.
tui_fit_setting_rows() {
  local i h avail vw lw v try text vmax
  local -A seen=()
  local -a full=()
  avail=$((LEFT_CONTENT_W - 2))
  for ((i = 0; i < ${#MENU_IDS[@]}; i++)); do
    full[i]="${MENU_LABELS[$i]}"
    [[ "${MENU_IDS[$i]}" == key:* || "${MENU_IDS[$i]}" == file:* ]] || continue
    v="${MENU_VALUES[$i]}"
    if [[ -n "$v" ]]; then
      tui_str_width "${full[$i]}"
      vmax=$((avail - _WIDTH - 1))
      (( vmax < avail / 3 )) && vmax=$((avail / 3))
      tui_str_width "$v"
      vw=$_WIDTH
      if (( vw > vmax )); then
        tui_truncate "$v" "$vmax"
        v="${_TRUNC%...}…"
        tui_str_width "$v"
        vw=$_WIDTH
      fi
      MENU_VALUES[i]="$v"
      lw=$((avail - vw - 1))
    else
      lw=$avail
    fi
    MENU_LABEL_W[i]=$lw
  done
  for ((i = 0; i < ${#MENU_IDS[@]}; i++)); do
    if [[ "${MENU_IDS[$i]}" != key:* && "${MENU_IDS[$i]}" != file:* ]]; then
      [[ "${MENU_IDS[$i]}" == group:sec:* ]] && seen=()
      seen["${MENU_LABELS[$i]}"]=1
      continue
    fi
    lw=${MENU_LABEL_W[$i]}
    h=$(( (lw - 1) / 3 ))
    text=""
    for try in "$h" $(seq $((h + 1)) $((lw - 2))) $(seq $((h - 1)) -1 0); do
      tui_truncate_middle "${full[$i]}" "$lw" "$try"
      text="$_TRUNC|${MENU_VALUES[$i]}"
      [[ -z "${seen[$text]+x}" ]] && break
    done
    seen["$text"]=1
    MENU_LABELS[i]="$_TRUNC"
  done
}

tui_build_menu() {
  MENU_IDS=()
  MENU_LABELS=()
  MENU_KEYS=()
  MENU_VALUES=()
  MENU_LABEL_W=()
  MENU_TITLE=""
  MENU_SUBTITLE=""
  MENU_STATE=""

  case "$TUI_VIEW" in
    main)
      TUI_LEFT_TITLE="Haven"
      tui_state_line
      # The state lives in the group names (tui_group_note); the blank row
      # (group:gap, never selected) sets Help / About / Quit apart from
      # Configure. 19 rows: all of it fits the 19 content rows at 80x24.
      MENU_IDS=(group:relay start_plain start_tor stop restart
        group:data backup restore db_switch import
        group:configure env json env_upgrade onion
        group:gap help about quit)
      MENU_LABELS=("Relay" "Start" "Start with Tor" "Stop" "Restart"
        "Data" "Back up now" "Restore a backup" "Switch engine" "Import notes"
        "Configure" "Settings (.env)" "Access lists (JSON)" "Add missing settings" "Onion address"
        "" "Help" "About" "Quit")
      MENU_KEYS=("" s t x r
        "" b e d i
        "" c l u o
        "" "?" a q)
      # an interrupted engine switch: its undo leads the Data group
      if [[ -e "$DB_SWITCH_MARKER" || -L "$DB_SWITCH_MARKER" ]]; then
        MENU_IDS=("${MENU_IDS[@]:0:6}" switch_rollback "${MENU_IDS[@]:6}")
        MENU_LABELS=("${MENU_LABELS[@]:0:6}" "Undo interrupted switch" "${MENU_LABELS[@]:6}")
        MENU_KEYS=("${MENU_KEYS[@]:0:6}" n "${MENU_KEYS[@]:6}")
      fi
      ;;
    restore_list)
      TUI_LEFT_TITLE="Haven / Restore a backup"
      MENU_TITLE="Restore a backup"
      MENU_SUBTITLE="backups/, newest first"
      # a row is the name without the "haven-" every backup of this script
      # starts with and without ".zip", and its age: at 80 columns that keeps
      # the whole date and time readable; name and size are in the details
      local fname lab
      for fname in "${FLOW_FILES[@]+"${FLOW_FILES[@]}"}"; do
        tui_flow_age "${FLOW_FILE_TIME[$fname]:-0}" short
        lab="${fname%.zip}"
        lab="${lab#haven-}"
        MENU_IDS+=("file:$fname") MENU_LABELS+=("$lab") MENU_VALUES+=("$_AGE")
      done
      MENU_IDS+=(back) MENU_LABELS+=("Back") MENU_VALUES+=("")
      tui_fit_setting_rows
      ;;
    switch)
      TUI_LEFT_TITLE="Haven / Switch engine"
      MENU_TITLE="Switch engine"
      MENU_SUBTITLE="The old files are kept"
      MENU_IDS=(group:i1 group:i2 group:i3 group:i4 group:i5 group:i6)
      MENU_LABELS=("On disk: $FLOW_FOUND" "Target: $FLOW_TARGET" "Size of db/: $FLOW_DB_SIZE"
        "Free space: $FLOW_FREE" "Last backup: $FLOW_BACKUP_AGE" "")
      if [[ "$FLOW_MIXED" == "1" ]]; then
        MENU_IDS+=(from:badger from:lmdb)
        MENU_LABELS+=("From the badger side" "From the lmdb side")
      else
        MENU_IDS+=(switch)
        MENU_LABELS+=("Switch to $FLOW_TARGET")
      fi
      MENU_IDS+=(back)
      MENU_LABELS+=("Back")
      ;;
    logs)
      TUI_LEFT_TITLE="Haven / Logs"
      MENU_TITLE="Log settings"
      MENU_SUBTITLE="Service: ${LOG_SERVICE:-all} │ Tail: ${TAIL_COUNT} │ Follow: $([[ "$FOLLOW_LOGS" == "1" ]] && echo on || echo off)"
      MENU_IDS=(service tail follow back)
      MENU_LABELS=("Select service" "Tail lines" "Toggle follow" "Back")
      ;;
    logs_service)
      TUI_LEFT_TITLE="Haven / Logs / Service"
      MENU_TITLE="Log services"
      MENU_SUBTITLE="Choose which service to stream."
      MENU_IDS=(all)
      MENU_LABELS=("All services")
      local svc
      while IFS= read -r svc; do
        [[ -n "$svc" ]] || continue
        MENU_IDS+=("$svc")
        MENU_LABELS+=("$svc")
      done < <(list_services "$(compose_file_for "$(resolve_mode "logs")")")
      if [[ "${#MENU_IDS[@]}" -eq 1 ]]; then
        MENU_IDS+=(relay tor)
        MENU_LABELS+=("relay" "tor")
      fi
      MENU_IDS+=(back)
      MENU_LABELS+=("Back")
      ;;
    env_list)
      TUI_LEFT_TITLE="Haven / Settings"
      MENU_TITLE="Settings (.env)"
      settings_rows
      if [[ -n "$SETTINGS_FILTER" ]]; then
        # a filter longer than the row is cut in its middle, inside the
        # quotes: the count at the end of the row always stays readable
        local fterm="$SETTINGS_FILTER" fpre="Filter " fbudget
        tui_str_width "$fpre\"\": $SETTINGS_SHOWN found"
        fbudget=$((LEFT_CONTENT_W - _WIDTH))
        if (( fbudget < 6 )); then fpre=""; fbudget=$((fbudget + 7)); fi
        tui_truncate_middle "$fterm" "$fbudget" $(( (fbudget - 1) / 2 ))
        MENU_SUBTITLE="$fpre\"$_TRUNC\": $SETTINGS_SHOWN found"
      else
        MENU_SUBTITLE="Select a setting"
      fi
      ;;
    env_item)
      TUI_LEFT_TITLE="Haven / Settings / $CURRENT_ENV_KEY"
      MENU_TITLE="$CURRENT_ENV_KEY"
      MENU_SUBTITLE="Edit, reveal or remove."
      MENU_IDS=(edit reveal remove back)
      MENU_LABELS=("Edit value" "Reveal value" "Remove setting" "Back")
      ;;
    json_files)
      TUI_LEFT_TITLE="Haven / Access lists"
      MENU_TITLE="Access lists (JSON)"
      MENU_SUBTITLE="Select a list"
      local count=${#JSON_FILES[@]}
      local file label
      for ((i=0; i<count; i++)); do
        file="${JSON_FILES[$i]}"
        label="${JSON_LABELS[$i]}"
        MENU_IDS+=("$file")
        MENU_LABELS+=("$label")
      done
      MENU_IDS+=(back)
      MENU_LABELS+=("Back")
      ;;
    json_items)
      TUI_LEFT_TITLE="Haven / Access lists / $(json_label_for "$CURRENT_JSON_FILE")"
      MENU_TITLE="$CURRENT_JSON_FILE"
      MENU_SUBTITLE="Edit list items"
      MENU_IDS=(add clear)
      MENU_LABELS=("Add item" "Clear list")
      local path="$ROOT_DIR/$CURRENT_JSON_FILE"
      local output=""
      if ! output="$(json_list_items "$path" 2>/dev/null)"; then
        MENU_IDS=(back)
        MENU_LABELS=("Not valid JSON: back")
      else
        local idx=0
        local item
        while IFS= read -r item; do
          MENU_IDS+=("item:$idx")
          if json_item_is_valid "$CURRENT_JSON_FILE" "$item"; then
            MENU_LABELS+=("$item")
          else
            MENU_LABELS+=("$item (invalid)")
          fi
          idx=$((idx + 1))
        done <<<"$output"
        MENU_IDS+=(back)
        MENU_LABELS+=("Back")
      fi
      ;;
  esac
}

tui_render_left_menu() {
  local row="$LEFT_CONTENT_ROW"
  local visible_rows="$LEFT_CONTENT_HEIGHT"

  # Only rebuild menu data when needed (not on simple navigation)
  if [[ "$TUI_NEED_MENU" -eq 1 ]]; then
    tui_build_menu
    TUI_NEED_MENU=0
  fi

  # Row 1 names the current view (the path); it changes with the view, and
  # so do the key hints of the bottom row.
  tui_draw_title_row
  tui_refresh_status_bar

  # Bold accent title
  if [[ -n "$MENU_TITLE" ]]; then
    tui_truncate "$MENU_TITLE" "$LEFT_CONTENT_W"
    tui_print_left_styled "$row" "${TUI_BOLD}${TUI_FG_ACCENT}" "$_TRUNC"
    row=$((row + 1))
    visible_rows=$((visible_rows - 1))
  fi

  # Dim subtitle
  if [[ -n "$MENU_SUBTITLE" ]]; then
    tui_truncate "$MENU_SUBTITLE" "$LEFT_CONTENT_W"
    tui_print_left_styled "$row" "${TUI_DIM}${TUI_FG_SUBTITLE}" "$_TRUNC"
    row=$((row + 1))
    visible_rows=$((visible_rows - 1))
  fi

  # Thin separator under a titled view (the main view's groups need the row)
  if [[ -n "$MENU_TITLE" ]]; then
    tui_print_left_styled "$row" "$TUI_FG_SEPARATOR" "$_HLINE_SEP"
    row=$((row + 1))
    visible_rows=$((visible_rows - 1))
  fi

  local count=${#MENU_LABELS[@]}
  if [[ "$count" -le 0 ]]; then
    tui_print_left_styled "$row" "$TUI_DIM" "(empty)"
    return
  fi

  tui_clamp_sel

  if [[ "$TUI_SEL" -lt "$TUI_OFFSET" ]]; then
    TUI_OFFSET="$TUI_SEL"
    # scrolling up onto the first entry of a group shows the group name too
    if (( TUI_OFFSET > 0 )) && [[ "${MENU_IDS[$((TUI_OFFSET - 1))]}" == group:* ]]; then
      TUI_OFFSET=$((TUI_OFFSET - 1))
    fi
  fi
  if [[ "$TUI_SEL" -ge $((TUI_OFFSET + visible_rows)) ]]; then
    TUI_OFFSET=$((TUI_SEL - visible_rows + 1))
  fi
  # Settings list: when the window starts inside a section, that section's
  # row stays pinned in the first row (the labels do not repeat the relay
  # they belong to); the window below it is one row shorter.
  local j
  TUI_PIN=-1
  while [[ "$TUI_VIEW" == env_list ]]; do
    TUI_PIN=-1
    if (( TUI_OFFSET > 0 )) && [[ "${MENU_IDS[$TUI_OFFSET]}" != group:* ]]; then
      for ((j = TUI_OFFSET - 1; j >= 0; j--)); do
        [[ "${MENU_IDS[$j]}" == group:sec:* ]] && { TUI_PIN=$j; break; }
      done
    fi
    (( TUI_PIN >= 0 && TUI_SEL >= TUI_OFFSET + visible_rows - 1 )) || break
    TUI_OFFSET=$((TUI_OFFSET + 1))
  done

  local i idx label menu_id key key_w label_w
  for ((i=0; i<visible_rows; i++)); do
    idx=$((TUI_OFFSET + i))
    if (( TUI_PIN >= 0 )); then
      idx=$((TUI_OFFSET + i - 1))
      (( i == 0 )) && idx=$TUI_PIN
    fi
    label=""
    menu_id=""
    key=""
    if [[ "$idx" -lt "$count" ]]; then
      label="${MENU_LABELS[$idx]}"
      menu_id="${MENU_IDS[$idx]}"
      key="${MENU_KEYS[$idx]:-}"
    fi
    key_w=0
    [[ -n "$key" ]] && key_w=2
    label_w=$((LEFT_CONTENT_W - 2 - key_w))
    tui_truncate "$label" "$label_w"

    printf '\033[%d;%dH' "$((row + i + 1))" "$((LEFT_X + 1))"
    if [[ -z "$label" ]]; then
      printf "%-*s" "$LEFT_CONTENT_W" ""
    elif [[ "$menu_id" == group:* ]]; then
      # group name: dim, in the marker column, never selected; the state it
      # carries (tui_group_note) follows in bold — the state is a word
      tui_group_note "$menu_id"
      if [[ -n "$_NOTE" ]]; then
        tui_str_width "${label}${TUI_GROUP_GAP}"
        tui_pad_to "$_NOTE" $((LEFT_CONTENT_W - _WIDTH))
        printf "%b%s%b%s%b%s%b" "$TUI_FG_MENU_DIM" "$label" "$CLR_RESET" \
          "$TUI_GROUP_GAP" "$TUI_BOLD" "$_PADDED" "$CLR_RESET"
      else
        # a group row starts in the marker column: it has the whole width
        tui_truncate "$label" "$LEFT_CONTENT_W"
        tui_pad_to "$_TRUNC" "$LEFT_CONTENT_W"
        printf "%b%s%b" "$TUI_FG_MENU_DIM" "$_PADDED" "$CLR_RESET"
      fi
    elif [[ -n "${MENU_VALUES[$idx]:-}" ]]; then
      # settings row: label (fitted by tui_fit_setting_rows), value right-aligned
      local value="${MENU_VALUES[$idx]}" gap
      tui_str_width "$label"
      gap=$_WIDTH
      tui_str_width "$value"
      gap=$((LEFT_CONTENT_W - 2 - gap - _WIDTH))
      (( gap < 1 )) && gap=1
      if [[ "$idx" -eq "$TUI_SEL" ]]; then
        tui_menu_icon selected
        tui_pad_to "${_ICON}${label}$(printf '%*s' "$gap" '')${value}" "$LEFT_CONTENT_W"
        printf "%b%s%b" "${TUI_BOLD}${TUI_FG_SELECTED}${TUI_BG_SELECTED}" "$_PADDED" "$CLR_RESET"
      else
        tui_menu_icon
        printf "%s%b%s%b%*s%b%s%b" "$_ICON" "$TUI_FG_MENU" "$label" "$CLR_RESET" "$gap" "" \
          "${TUI_DIM}${TUI_FG_MENU_DIM}" "$value" "$CLR_RESET"
      fi
    elif [[ "$idx" -eq "$TUI_SEL" ]]; then
      tui_menu_icon selected
      if [[ -n "$key" ]]; then
        tui_pad_to "${_ICON}${key} ${_TRUNC}" "$LEFT_CONTENT_W"
      else
        tui_pad_to "${_ICON}${_TRUNC}" "$LEFT_CONTENT_W"
      fi
      printf "%b%s%b" \
        "${TUI_BOLD}${TUI_FG_SELECTED}${TUI_BG_SELECTED}" \
        "$_PADDED" "$CLR_RESET"
    else
      local style="$TUI_FG_MENU"
      if [[ "$menu_id" == "back" || "$menu_id" == "quit" ]]; then
        style="$TUI_FG_MENU_DIM"
      fi
      tui_menu_icon
      tui_pad_to "$_TRUNC" "$label_w"
      if [[ -n "$key" ]]; then
        printf "%s%b%s%b%b %s%b" "$_ICON" \
          "$TUI_SHORTCUT_KEY" "$key" "$CLR_RESET" \
          "$style" "$_PADDED" "$CLR_RESET"
      else
        printf "%s%b%s%b" "$_ICON" "$style" "$_PADDED" "$CLR_RESET"
      fi
    fi
  done
}

tui_handle_back() {
  case "$TUI_VIEW" in
    main) return 0 ;;   # Esc and ← in the main view do nothing: q quits
    logs) tui_set_view "main" ;;
    logs_service) tui_set_view "logs" ;;
    env_list)
      if [[ -n "$SETTINGS_FILTER" ]]; then
        # Esc clears an active filter before it leaves the view
        settings_set_filter ""
      else
        tui_set_view "main"
      fi
      ;;
    env_item) tui_set_view "env_list" ;;
    json_files) tui_set_view "main" ;;
    json_items) tui_set_view "json_files" ;;
    restore_list|switch) tui_set_view "main" ;;
    *) tui_set_view "main" ;;
  esac
  return 0
}

tui_run_action() {
  local title="$1"
  shift
  if [[ "$TUI_ACTIVE" == "1" && "$FOLLOW_LOGS" == "1" ]]; then
    stop_log_stream
  fi
  run_capture "$@"
  if [[ "$RUN_STATUS" -ne 0 ]]; then
    # the output as text (a die's ERROR line included), its colours dropped
    local text="Failed (exit $RUN_STATUS)." line sep=$'\n\n'
    while IFS= read -r line; do
      strip_terminal_controls "$line"
      [[ -z "$_STRIPPED" ]] || { text+="$sep${_STRIPPED//"$ROOT_DIR/"/}"; sep=$'\n'; }
    done <<<"$RUN_OUTPUT"
    tui_message "$title" "$text"
  elif [[ "$RUN_OUTPUT" == *"$MIXED_START_WARNING"* ]]; then
    # a start that went ahead on mixed directories: its warning would scroll by
    # unseen in the captured output
    tui_message "$title" "$(printf '%s\n' "$RUN_OUTPUT" | grep -F -- "$MIXED_START_WARNING")"
  fi
  if [[ "$TUI_ACTIVE" == "1" ]]; then
    TUI_NEED_FRAME=1
    TUI_NEED_MENU=1
    TUI_NEED_LEFT=1
    TUI_NEED_RIGHT=1
    tui_refresh_logs_view
  fi
}

# --- guided data flows --------------------------------------------------------
# Back up, restore and engine switch in the TUI are thin layers over the CLI
# verbs: the TUI picks what to run, asks, then runs `./haven <verb> ...` as a
# child process and shows its output; every check, the docker calls and the
# relay handling stay in the verb. Everything from here to tui_flow_end has
# no docker or compose call of its own (tests/haven-flows.bats greps for one).
TASK_PID=""
TASK_FD=""
TASK_DIR=""
TASK_KIND=""
TASK_TITLE=""           # the flow's name, for the title row of its result box
TASK_HEAD=""            # first line of the task pane ("Backing up")
TASK_T0=0
TASK_RC=0
TASK_INT=0
TASK_RESULT=""          # from "::result <ok|rolled-back|failed>"
TASK_STEP=0             # from "::step <n>/<total> <name>"
TASK_STEP_TOTAL=0
TASK_STEPS=()           # step names as the verb printed them, by number
TASK_LINES=()           # the verb's output, protocol lines included
TASK_CARRY=""           # a line the verb has not finished yet
TASK_RELAY_TEXT=""      # running state: what happens to the relay
TASK_KEYS_TEXT=""       # running state: what the keys do
TASK_CTRLC_HINT=""      # the bottom row's word for Ctrl-C
TUI_TASK_ACTIVE=0
FLOW_SAVED_INT=""        # the INT trap before tui_flow_run, put back by tui_flow_finish
FLOW_RELAY="unknown"    # running | stopped | unknown: the relay when the flow began

# tui_flow_relay_now — FLOW_RELAY from the state the main view last showed
# (MENU_STATE, read from Docker by tui_state_line): the flows ask nothing of
# their own, and the verb's output stays the last word on the relay.
tui_flow_relay_now() {
  case "$MENU_STATE" in
    "● Running"*) FLOW_RELAY="running" ;;
    "○ Stopped"*) FLOW_RELAY="stopped" ;;
    *) FLOW_RELAY="unknown" ;;
  esac
}

# tui_flow_relay_sentence — _SENTENCE: what a backup, restore or undo does to
# the relay, for its confirmation (the verbs stop a running relay and start
# it again; a stopped one stays stopped).
tui_flow_relay_sentence() {
  case "$FLOW_RELAY" in
    running) _SENTENCE="The relay stops while it runs and starts again afterwards." ;;
    stopped) _SENTENCE="The relay is not running and stays stopped." ;;
    *) _SENTENCE="A running relay stops while it runs and starts again afterwards." ;;
  esac
}

# tui_flow_task_texts <kind> — the running state's words: TASK_RELAY_TEXT,
# TASK_KEYS_TEXT, TASK_CTRLC_HINT, true to what the verb does on Ctrl-C (its
# signal guard stops the one-shot, a switch puts the old layout back, a relay
# that ran is started again).
tui_flow_task_texts() {
  local what="$1" back=""
  case "$1" in
    switch) what="switch"; back=" and puts everything back as it was" ;;
    rollback) what="undo" ;;
  esac
  case "$FLOW_RELAY" in
    running) TASK_RELAY_TEXT="The relay is offline until the $what ends; then it starts again." ;;
    stopped) TASK_RELAY_TEXT="The relay is not running and stays stopped." ;;
    *) TASK_RELAY_TEXT="A running relay is offline until the $what ends; then it starts again." ;;
  esac
  TASK_CTRLC_HINT="Stop the $what"
  TASK_KEYS_TEXT="Other keys wait. Ctrl-C stops the $what$back."
  [[ "$1" == switch ]] && TASK_CTRLC_HINT="Stop and put back"
  if [[ "$1" == rollback ]]; then
    TASK_CTRLC_HINT="Stop"
    TASK_KEYS_TEXT="Other keys wait until it ends."
  fi
  return 0
}

# tui_flow_elapsed — _ELAPSED: "<m>m <ss>s" since the task started
tui_flow_elapsed() {
  local now e
  printf -v now '%(%s)T' -1
  e=$((now - TASK_T0))
  (( e < 0 )) && e=0
  printf -v _ELAPSED '%dm %02ds' $((e / 60)) $((e % 60))
}

# tui_flow_take <line> — one line of the verb's output into TASK_LINES, the
# protocol lines into the step list and the result.
tui_flow_take() {
  local line="$1" n
  strip_terminal_controls "$line"
  line="$_STRIPPED"
  TASK_LINES+=("$line")
  # a protocol line is one the verb printed as such: "::" as its first bytes,
  # not a line that only starts with "::" once its escapes are gone
  [[ "$1" == ::* ]] || return 0
  if [[ "$line" =~ ^::step\ ([0-9]+)/([0-9]+)\ (.+)$ ]]; then
    n="${BASH_REMATCH[1]}"
    TASK_STEP="$n"
    TASK_STEP_TOTAL="${BASH_REMATCH[2]}"
    TASK_STEPS[n]="${BASH_REMATCH[3]}"
  elif [[ "$line" =~ ^::result\ (.+)$ ]]; then
    TASK_RESULT="${BASH_REMATCH[1]}"
  fi
}

# tui_flow_drain — read what the verb wrote since the last call (a line it has
# not finished stays in TASK_CARRY); 0 when something arrived.
tui_flow_drain() {
  local line got=1
  [[ -n "$TASK_FD" ]] || return 1
  while :; do
    line=""
    if IFS= read -r line <&"$TASK_FD"; then
      tui_flow_take "$TASK_CARRY$line"
      TASK_CARRY=""
      got=0
    else
      # end of what is written so far; a partial line waits for its rest
      TASK_CARRY+="$line"
      break
    fi
  done
  return "$got"
}

tui_render_left_task() {
  local row="$LEFT_CONTENT_ROW" i end line
  local -a lines=() styles=()
  tui_flow_elapsed
  lines+=("$TASK_HEAD") styles+=("${TUI_BOLD}${TUI_FG_ACCENT}")
  if [[ "$TASK_KIND" == switch || "$TASK_KIND" == rollback ]]; then
    if (( TASK_STEP_TOTAL > 0 )); then
      lines+=("Step $TASK_STEP of $TASK_STEP_TOTAL, $_ELAPSED") styles+=("$TUI_FG_SUBTITLE")
    else
      lines+=("$_ELAPSED") styles+=("$TUI_FG_SUBTITLE")
    fi
    lines+=("$_HLINE_SEP") styles+=("$TUI_FG_SEPARATOR")
    for ((i = 1; i <= TASK_STEP_TOTAL; i++)); do
      [[ -n "${TASK_STEPS[$i]:-}" ]] || continue
      if (( i < TASK_STEP )); then
        lines+=("✓ ${TASK_STEPS[$i]}") styles+=("")
      else
        lines+=("▸ ${TASK_STEPS[$i]}") styles+=("$TUI_BOLD")
      fi
    done
    end=$((TASK_STEP_TOTAL - TASK_STEP))
    if (( end > 0 )); then
      line="$end steps to go"
      (( end == 1 )) && line="1 step to go"
      lines+=("  $line") styles+=("${TUI_DIM}${TUI_FG_MENU_DIM}")
    fi
  else
    lines+=("Elapsed $_ELAPSED") styles+=("$TUI_FG_SUBTITLE")
    lines+=("$_HLINE_SEP") styles+=("$TUI_FG_SEPARATOR")
  fi
  lines+=("") styles+=("")
  # what is happening to the relay, then what the keys do: bold, then dim
  while IFS= read -r line; do
    lines+=("$line") styles+=("$TUI_BOLD")
  done < <(printf '%s\n' "$TASK_RELAY_TEXT" | tui_wrap "$LEFT_CONTENT_W")
  lines+=("") styles+=("")
  while IFS= read -r line; do
    lines+=("$line") styles+=("${TUI_DIM}${TUI_FG_MENU_DIM}")
  done < <(printf '%s\n' "$TASK_KEYS_TEXT" | tui_wrap "$LEFT_CONTENT_W")
  for ((i = 0; i < LEFT_CONTENT_HEIGHT; i++)); do
    line="" ; local st=""
    if (( i < ${#lines[@]} )); then line="${lines[$i]}"; st="${styles[$i]}"; fi
    tui_truncate "$line" "$LEFT_CONTENT_W"
    tui_print_left_styled $((row + i)) "$st" "$_TRUNC"
  done
}

tui_render_right_task() {
  tui_flow_elapsed
  if [[ "$TUI_TASK_ACTIVE" == "1" ]]; then
    TUI_RIGHT_TITLE="Relay offline $_ELAPSED │ Output"
  else
    TUI_RIGHT_TITLE="Output"
  fi
  tui_draw_title_row
  local -a out_rows=()
  local line row
  for line in "${TASK_LINES[@]+"${TASK_LINES[@]}"}"; do
    [[ "$line" == ::* ]] && continue
    while IFS= read -r row; do out_rows+=("$row"); done < <(printf '%s\n' "$line" | tui_wrap "$RIGHT_CONTENT_W")
  done
  local start=$(( ${#out_rows[@]} > RIGHT_CONTENT_HEIGHT ? ${#out_rows[@]} - RIGHT_CONTENT_HEIGHT : 0 ))
  for ((row = 0; row < RIGHT_CONTENT_HEIGHT; row++)); do
    line=""
    (( start + row < ${#out_rows[@]} )) && line="${out_rows[$((start + row))]}"
    tui_truncate "$line" "$RIGHT_CONTENT_W"
    tui_pad_to "$_TRUNC" "$RIGHT_CONTENT_W"
    printf '\033[%d;%dH%s' "$((RIGHT_CONTENT_ROW + row + 1))" "$((RIGHT_X + 1))" "$_PADDED"
  done
}

# tui_flow_run <kind> <title> <head> <verb args...> — run `./haven <verb args>`
# as a child and show it until it ends: the left pane the task state (for an
# engine switch the steps from its ::step lines), the title row how long the
# relay has been offline, the right pane the verb's output. Every key waits
# (Esc and q too); Ctrl-C is passed to the child, whose signal guard stops the
# one-shot and starts the relay again. The TUI's own log stream pauses for
# the duration. Sets TASK_RC, TASK_RESULT, TASK_STEPS, TASK_LINES.
tui_flow_run() {
  local kind="$1" title="$2" head="$3" saved_left="$TUI_LEFT_TITLE" redraw=1 now last=0
  shift 3
  local -a cmd=("$ROOT_DIR/$SCRIPT_NAME")
  [[ "$MODE" == tor ]] && cmd+=(--tor)
  [[ "$MODE" == plain ]] && cmd+=(--plain)
  cmd+=("$@")
  TASK_KIND="$kind" TASK_HEAD="$head" TASK_TITLE="$title"
  tui_flow_task_texts "$kind"
  TASK_LINES=() TASK_STEPS=() TASK_STEP=0 TASK_STEP_TOTAL=0 TASK_RESULT="" TASK_RC=0 TASK_INT=0 TASK_CARRY=""
  if [[ "$FOLLOW_LOGS" == "1" ]]; then stop_log_stream; fi
  TASK_DIR="$(mktemp -d "${TMPDIR:-/tmp}/haven-task.XXXXXX")"
  : > "$TASK_DIR/out"
  printf -v TASK_T0 '%(%s)T' -1
  # Ctrl-C goes to the child while it runs and is ignored once it ended, until
  # tui_flow_finish closed the result box and puts the TUI's own trap back
  # (FLOW_SAVED_INT): a Ctrl-C in between must not quit the TUI. While the child
  # runs this is a handler, which no subshell inherits; from the moment the
  # child is gone it is `trap '' INT`, which every subshell does inherit (see
  # below).
  FLOW_SAVED_INT="$(trap -p INT)"
  trap 'TASK_INT=1; if [[ -n "$TASK_PID" ]]; then kill -INT "$TASK_PID" 2>/dev/null || true; fi' INT
  # A background job of a shell without job control ignores SIGINT and
  # cannot trap it; with -m the child keeps the default, gets its own process
  # group (the terminal's Ctrl-C reaches the TUI, which passes it on) and its
  # guard can run.
  set -m
  "${cmd[@]}" >"$TASK_DIR/out" 2>&1 </dev/null &
  TASK_PID=$!
  set +m
  exec {TASK_FD}<"$TASK_DIR/out"
  TUI_TASK_ACTIVE=1
  TUI_RIGHT_PREV_TASK="$TUI_RIGHT_MODE"
  TUI_RIGHT_MODE="task"
  TUI_LEFT_TITLE="Haven / $title"
  TUI_FOOTER="task"
  while :; do
    if [[ "${TUI_NEED_RESIZE:-0}" -eq 1 ]]; then
      TUI_NEED_RESIZE=0
      tui_update_layout
      redraw=1
    fi
    tui_flow_drain && redraw=2
    if ! kill -0 "$TASK_PID" 2>/dev/null; then
      # the child is gone: ignore INT, inherited by every subshell from here
      # to the dismissed box. A Ctrl-C reaches the whole foreground process
      # group, and a handler is not inherited: the subshell of
      # TUI_COLS="$(tput cols)" in the box's layout died of it, the size came
      # out empty and the next frame ended the TUI under errexit.
      trap '' INT
      tui_flow_drain || true
      [[ -z "$TASK_CARRY" ]] || { tui_flow_take "$TASK_CARRY"; TASK_CARRY=""; }
      break
    fi
    printf -v now '%(%s)T' -1
    if (( redraw == 1 )); then
      tui_draw_frame 1
      redraw=2
    fi
    if (( redraw == 2 || now != last )); then
      tui_render_left_task
      tui_render_right_panel
      tui_sync_mark
      redraw=0
      last=$now
    fi
    tui_read_key || true   # every key waits while the verb runs
  done
  TASK_RC=0
  wait "$TASK_PID" 2>/dev/null || TASK_RC=$?
  TASK_PID=""
  exec {TASK_FD}<&-
  TASK_FD=""
  rm -rf -- "$TASK_DIR"
  TASK_DIR=""
  TUI_TASK_ACTIVE=0
  TUI_FOOTER=""
  TUI_LEFT_TITLE="$saved_left"
}

# tui_flow_finish <box title> <first line> — the result box, then back to the
# main view with the log stream resumed. The box is written to be read at
# 80x24 without scrolling: what happened, the relay's state, where the data
# is, the one next step (tui_flow_box); the verb's whole output stays in the
# right pane beside it.
tui_flow_finish() {
  local title="$1" first="$2" text
  tui_flow_box
  text="$_SUMMARY"
  [[ -z "$first" ]] || text="$first"$'\n\n'"$text"
  TUI_LEFT_TITLE="Haven / ${TASK_TITLE:-$title}"
  tui_message "$title" "$text"
  # the box is closed: Ctrl-C quits the TUI again (tui_flow_run)
  if [[ -n "$FLOW_SAVED_INT" ]]; then eval "$FLOW_SAVED_INT"; else trap - INT; fi
  FLOW_SAVED_INT=""
  TUI_RIGHT_MODE="${TUI_RIGHT_PREV_TASK:-logs}"
  [[ "$TUI_RIGHT_MODE" == task || "$TUI_RIGHT_MODE" == details ]] && TUI_RIGHT_MODE="logs"
  tui_set_view main
  TUI_NEED_FRAME=1
  tui_refresh_logs_view
}

# tui_flow_summary — _SUMMARY: the verb's closing lines: those after its last
# ::step line and after its last progress line (one that ends in "..."),
# protocol lines left out, the INFO and OK words dropped, paths inside this
# directory written relative to it (backups/…, db/…).
tui_flow_summary() {
  local i from=0 line
  _SUMMARY=""
  for ((i = 0; i < ${#TASK_LINES[@]}; i++)); do
    line="${TASK_LINES[$i]}"
    [[ "$line" == "::step "* || "$line" == *... ]] && from=$((i + 1))
  done
  for ((i = from; i < ${#TASK_LINES[@]}; i++)); do
    line="${TASK_LINES[$i]}"
    [[ "$line" == ::* || -z "$line" ]] && continue
    line="${line#INFO }"
    line="${line#OK }"
    line="${line//"$ROOT_DIR/"/}"
    _SUMMARY+="${_SUMMARY:+$'\n'}$line"
  done
  [[ -n "$_SUMMARY" ]] || _SUMMARY="The command printed nothing more (exit status $TASK_RC); its output is on the right."
}

# tui_flow_find <ERE> — _FOUND: the first output line of the verb that
# matches (every caller anchors its ERE at the start of the line: a sentence
# inside a foreign name or path in the middle of a line never counts) (INFO/OK/WARN word dropped, paths relative), BASH_REMATCH set by
# the match against it; false when there is none.
tui_flow_find() {
  local line
  _FOUND=""
  for line in "${TASK_LINES[@]+"${TASK_LINES[@]}"}"; do
    [[ "$line" == ::* ]] && continue
    line="${line#INFO }"; line="${line#OK }"; line="${line#WARN }"
    line="${line//"$ROOT_DIR/"/}"
    if [[ "$line" =~ $1 ]]; then
      _FOUND="$line"
      return 0
    fi
  done
  return 1
}

# tui_flow_relay_note — _RELAY_NOTE: the relay's state after the run, in the
# verb's own terms (its last word on the relay wins: a relay that did not come
# back is said first). Empty when the verb said nothing about it.
tui_flow_relay_note() {
  _RELAY_NOTE=""
  if tui_flow_find '^The relay is NOT running|^The relay did not start|^The relay was not started'; then
    if [[ -e "$DB_SWITCH_MARKER" || -L "$DB_SWITCH_MARKER" ]]; then
      # an unfinished switch blocks every start until it is undone
      _RELAY_NOTE="The relay is NOT running; it can start once the switch is undone."
    else
      _RELAY_NOTE="The relay is NOT running: start it with s in the main view."
    fi
  elif tui_flow_find '^The relay is running on ([a-z]+)\.|^The relay is running \(([a-z]+)\)'; then
    _RELAY_NOTE="The relay is running on ${BASH_REMATCH[1]:-${BASH_REMATCH[2]}}."
  elif tui_flow_find '^The relay is running\.$|^Starting the relay again'; then
    _RELAY_NOTE="The relay is running again."
  elif tui_flow_find '^The relay was not running'; then
    _RELAY_NOTE="The relay was not running and stays stopped."
  elif ! tui_flow_find '^Stopping the relay'; then
    _RELAY_NOTE="The relay was not touched."
  fi
}

# tui_flow_box — _SUMMARY: the body of the result box. For the outcomes whose
# lines are known (backup and restore finished, switch done, switch rolled
# back or stopped half-way) a short text built from the verb's own lines;
# for any other outcome, or when a line is not where it is expected, the
# verb's closing lines (tui_flow_summary). The relay's state is always said.
tui_flow_box() {
  local nl=$'\n' box="" path size
  tui_flow_relay_note
  case "$TASK_KIND:$TASK_RC:$TASK_RESULT" in
    backup:0:*)
      if tui_flow_find '^Backup written: ([^ ]+) \(([^,]+),'; then
        path="${BASH_REMATCH[1]}" size="${BASH_REMATCH[2]}"
        box="Written and verified:${nl}$path ($size).${nl}${nl}$_RELAY_NOTE${nl}${nl}Not in the backup: the media in blossom/, .env and the JSON lists. Copy those separately."
      fi
      ;;
    restore:0:*)
      if tui_flow_find '^Restore finished: the events from ([^ ]+) that were missing'; then
        box="Added the events of ${BASH_REMATCH[1]} that were missing; nothing was deleted, and notes that were already there were skipped (on lmdb, a media index entry that was already there is now listed once more).${nl}${nl}$_RELAY_NOTE${nl}${nl}Media files are not in a backup: copy blossom/ back if some are missing."
      fi
      ;;
    switch:*:ok)
      if tui_flow_find '^Switched the relay database from ([a-z]+) to ([a-z]+)\.'; then
        local from="${BASH_REMATCH[1]}" to="${BASH_REMATCH[2]}"
        box="The relay database moved from $from to $to.${nl}$_RELAY_NOTE"
        if tui_flow_find '^The old [a-z]+ directories are kept in (db/[^ ]+)'; then
          box+="${nl}${nl}The old $from data is kept in ${BASH_REMATCH[1]%.}"
        fi
        if tui_flow_find '^Backup of the old [a-z]+ database: ([^ ]+)'; then
          box+="${nl}Backup from before: ${BASH_REMATCH[1]}"
        fi
        box+="${nl}${nl}Next: check that the relay serves your notes. To go back: ./$SCRIPT_NAME db-switch --rollback"
      fi
      ;;
    switch:*:rolled-back|switch:*:failed)
      if (( TASK_STEP > 1 )); then
        tui_flow_find '^The engine switch failed: (.+)$' && box="Cause: ${BASH_REMATCH[1]}${nl}"
        box+="$_RELAY_NOTE"
        if tui_flow_find '^What the failed run produced is kept in (db/[^ ]+)'; then
          box+="${nl}${nl}What the failed run made is kept in ${BASH_REMATCH[1]%.}"
        fi
        [[ "$TASK_RESULT" == rolled-back ]] && box+="${nl}${nl}Next: fix the cause, then switch again."
      fi
      ;;
  esac
  if [[ -z "$box" ]]; then
    tui_flow_summary
    box="$_SUMMARY"
    [[ -z "$_RELAY_NOTE" || "$box" == *"relay is"* || "$box" == *"relay was"* ]] || box+="${nl}${nl}$_RELAY_NOTE"
  fi
  _SUMMARY="$box"
}

# tui_flow_outcome <noun> — _TITLE for a backup or restore box from the exit status
tui_flow_outcome() {
  if (( TASK_RC == 0 )); then
    _TITLE="$1 finished"
  elif (( TASK_INT )) || (( TASK_RC == 130 )); then
    _TITLE="$1 interrupted"
  else
    _TITLE="$1 failed"
  fi
}

tui_flow_backup() {
  tui_flow_relay_now
  tui_flow_relay_sentence
  tui_confirm "Back up now? A verified copy of the relay database goes to backups/ in this directory. $_SENTENCE" "y" || return 0
  tui_flow_run backup "Back up now" "Backing up" backup
  tui_flow_outcome "Backup"
  tui_flow_finish "$_TITLE" ""
}

# tui_flow_backups_list — FLOW_FILES (newest first), FLOW_FILE_SIZE and
# FLOW_FILE_TIME (by name) for the .zip files in backups/ that the restore verb
# accepts: regular files, no symlinks, and names that pass its own rule
# (backup_normalize_name: letters, digits, . _ + -, not starting with "-"), so
# a crafted name never reaches the screen or the verb; FLOW_LIST_ERR when the
# directory cannot be read.
FLOW_FILES=()
declare -A FLOW_FILE_SIZE=()
declare -A FLOW_FILE_TIME=()
FLOW_LIST_ERR=""
tui_flow_backups_list() {
  local f name t sz
  FLOW_FILES=() FLOW_FILE_SIZE=() FLOW_FILE_TIME=() FLOW_LIST_ERR=""
  [[ -d "$BACKUP_DIR" ]] || return 0
  if [[ ! -r "$BACKUP_DIR" || ! -x "$BACKUP_DIR" ]]; then
    FLOW_LIST_ERR="backups/ cannot be read by $(id -un 2>/dev/null || id -u): its permissions do not allow listing it."
    return 0
  fi
  while IFS=$'\t' read -r t sz name; do
    [[ -n "$name" ]] || continue
    FLOW_FILES+=("$name")
    FLOW_FILE_SIZE[$name]="$sz"
    FLOW_FILE_TIME[$name]="$t"
  done < <(
    for f in "$BACKUP_DIR"/*.zip; do
      [[ -f "$f" && ! -L "$f" ]] || continue
      backup_normalize_name "${f##*/}" >/dev/null 2>&1 || continue
      [[ "$BACKUP_NAME" == "${f##*/}" ]] || continue
      t="$(stat -c %Y "$f" 2>/dev/null || stat -f %m "$f" 2>/dev/null || echo 0)"
      sz="$(stat -c %s "$f" 2>/dev/null || stat -f %z "$f" 2>/dev/null || echo 0)"
      printf '%s\t%s\t%s\n' "$t" "$sz" "$BACKUP_NAME"
    done | LC_ALL=C sort -t $'\t' -k1,1nr -k3,3
  )
}

# tui_flow_age <epoch> [short] — _AGE: "5 min ago", "3 h ago", "2 days ago";
# with "short": "now", "5m", "3h", "2d"
tui_flow_age() {
  local now d
  printf -v now '%(%s)T' -1
  d=$((now - $1))
  (( d < 0 )) && d=0
  if [[ "${2:-}" == short ]]; then
    if (( d < 60 )); then _AGE="now"
    elif (( d < 3600 )); then _AGE="$((d / 60))m"
    elif (( d < 172800 )); then _AGE="$((d / 3600))h"
    else _AGE="$((d / 86400))d"
    fi
    return 0
  fi
  if (( d < 60 )); then _AGE="just now"
  elif (( d < 3600 )); then _AGE="$((d / 60)) min ago"
  elif (( d < 172800 )); then _AGE="$((d / 3600)) h ago"
  else _AGE="$((d / 86400)) days ago"
  fi
}

# tui_flow_short_size <bytes> — _SHORT: 512B, 12K, 3.4M, 1.2G
tui_flow_short_size() {
  _SHORT="$(awk -v b="$1" 'BEGIN { split("B K M G T", u, " "); i = 1
    while (b >= 1024 && i < 5) { b /= 1024; i++ }
    if (i == 1 || b >= 10) printf "%d%s", b, u[i]; else printf "%.1f%s", b, u[i] }')"
}

tui_flow_restore() {
  tui_flow_relay_now
  tui_flow_backups_list
  if [[ -n "$FLOW_LIST_ERR" ]]; then
    tui_message "Restore a backup" "$FLOW_LIST_ERR"
    return 0
  fi
  if (( ${#FLOW_FILES[@]} == 0 )); then
    tui_message "Restore a backup" "There is no backup in backups/ yet. Make one with Back up now, or with ./$SCRIPT_NAME backup in a terminal."
    return 0
  fi
  tui_set_view restore_list
}

tui_flow_restore_pick() {
  local name="$1" what="It adds the events of this backup that are missing and deletes nothing."
  tui_flow_relay_sentence
  # into a database that holds data: what is measured to happen to what is
  # already there (see restore_relay_db); db_has_data reads db/ only
  if db_has_data; then
    what="It adds the events of this backup that are missing and deletes nothing; events that exist only in the database stay. The database already holds data: notes that are already there are skipped, but on lmdb a media index entry that is already there is listed once more."
  fi
  tui_confirm "Restore $name? $what $_SENTENCE" "n" || return 0
  tui_flow_run restore "Restore a backup" "Restoring" restore "$name" --yes
  tui_flow_outcome "Restore"
  tui_flow_finish "$_TITLE" ""
}

# tui_flow_switch_facts — FLOW_FOUND (what db/ holds, from db_disk_engine),
# FLOW_TARGET, FLOW_MIXED (1: the two --from choices), FLOW_DB_SIZE, FLOW_FREE,
# FLOW_BACKUP_AGE for the overview of the engine switch.
tui_flow_switch_facts() {
  local eff
  db_disk_engine
  eff="lmdb"
  [[ "$(env_engine_state)" == badger ]] && eff="badger"
  FLOW_MIXED=0
  case "$DISK_ENGINE" in
    badger) FLOW_FOUND="badger"; FLOW_TARGET="lmdb" ;;
    lmdb) FLOW_FOUND="lmdb"; FLOW_TARGET="badger" ;;
    mixed|split|unknown) FLOW_FOUND="both engines"; FLOW_TARGET="$eff"; FLOW_MIXED=1 ;;
    *) FLOW_FOUND="no data"; FLOW_TARGET="badger"; [[ "$eff" == badger ]] && FLOW_TARGET="lmdb" ;;
  esac
  FLOW_DB_SIZE="$(du -sh "$ROOT_DIR/db" 2>/dev/null | awk '{print $1}')"
  [[ -n "$FLOW_DB_SIZE" ]] || FLOW_DB_SIZE="unknown"
  FLOW_FREE="$(df -Pk "$ROOT_DIR/db" 2>/dev/null | awk 'NR == 2 {print $4}')"
  if [[ "$FLOW_FREE" =~ ^[0-9]+$ ]]; then
    tui_flow_short_size $((FLOW_FREE * 1024))
    FLOW_FREE="$_SHORT"
  else
    FLOW_FREE="unknown"
  fi
  tui_flow_backups_list
  if [[ -n "$FLOW_LIST_ERR" ]]; then
    FLOW_BACKUP_AGE="backups/ unreadable"
  elif (( ${#FLOW_FILES[@]} )); then
    tui_flow_age "${FLOW_FILE_TIME[${FLOW_FILES[0]}]}"
    FLOW_BACKUP_AGE="$_AGE"
  else
    FLOW_BACKUP_AGE="never"
  fi
}

tui_flow_switch() {
  tui_flow_relay_now
  tui_flow_switch_facts
  tui_set_view switch
}

# tui_flow_switch_go [<from>] — the typed confirmation, then the switch.
tui_flow_switch_go() {
  local from="${1:-}" typed
  typed="$(tui_prompt "Type $FLOW_TARGET:" "")"
  if [[ "$typed" != "$FLOW_TARGET" ]]; then
    if [[ -z "$typed" ]]; then
      tui_message "Switch engine" "Cancelled; nothing was changed."
    else
      tui_message "Switch engine" "Cancelled: you typed '$(printable_text "$typed")', not '$FLOW_TARGET'. Nothing was changed."
    fi
    return 0
  fi
  local -a args=(db-switch "$FLOW_TARGET")
  [[ -z "$from" ]] || args+=(--from "$from")
  args+=(--yes)
  local source="$FLOW_FOUND"
  [[ -z "$from" ]] || source="$from"
  tui_flow_run switch "Switch engine" "Switching to $FLOW_TARGET" "${args[@]}"
  local failed_step="${TASK_STEPS[$TASK_STEP]:-}"
  case "$TASK_RESULT" in
    ok) tui_flow_finish "Engine switched" "" ;;
    rolled-back)
      tui_flow_finish "Switch rolled back" "Step '$failed_step' failed; the switch was rolled back: db/ and DB_ENGINE are back on $source." ;;
    *)
      if (( TASK_STEP <= 1 )) && [[ "$TASK_RESULT" == failed ]]; then
        tui_flow_finish "Switch not started" ""
      elif [[ -e "$DB_SWITCH_MARKER" || -L "$DB_SWITCH_MARKER" ]]; then
        tui_flow_finish "Switch failed" "Step '$failed_step' failed and the switch is not finished. Next step: ./$SCRIPT_NAME db-switch --rollback (Undo interrupted switch in the Data group)."
      else
        tui_flow_finish "Switch failed" "Step '$failed_step' failed."
      fi
      ;;
  esac
}

tui_flow_rollback() {
  tui_flow_relay_now
  tui_flow_relay_sentence
  tui_confirm "Undo the interrupted switch? It puts the previous engine and its data back as the switch recorded them; nothing in db/ is deleted. $_SENTENCE" "n" || return 0
  tui_flow_run rollback "Undo interrupted switch" "Undoing the switch" db-switch --rollback
  case "$TASK_RESULT" in
    rolled-back) tui_flow_finish "Switch undone" "" ;;
    *) tui_flow_finish "Undo failed" "" ;;
  esac
}

# tui_flow_details — DETAIL_LINES for the restore list and the switch overview
tui_flow_details() {
  local id="" v="" t
  DETAIL_LINES=() DETAIL_BOLD=0 DETAIL_STYLE=()
  (( ${#MENU_IDS[@]} > 0 && TUI_SEL < ${#MENU_IDS[@]} )) && id="${MENU_IDS[$TUI_SEL]}"
  case "$id" in
    file:*)
      t="${id#file:}"
      while IFS= read -r v; do DETAIL_LINES+=("$v"); done < <(printf '%s\n' "$t" | tui_wrap "$RIGHT_CONTENT_W")
      DETAIL_BOLD=${#DETAIL_LINES[@]}
      tui_flow_age "${FLOW_FILE_TIME[$t]:-0}"
      DETAIL_LINES+=("")
      detail_field "Written" "$(date -d "@${FLOW_FILE_TIME[$t]:-0}" '+%Y-%m-%d %H:%M' 2>/dev/null || date -r "${FLOW_FILE_TIME[$t]:-0}" '+%Y-%m-%d %H:%M' 2>/dev/null) ($_AGE)"
      detail_field "Size" "$(human_size "${FLOW_FILE_SIZE[$t]:-0}")"
      DETAIL_LINES+=("")
      v="A restore adds the events of this backup that are missing and deletes nothing. Into a database that holds data, notes that are already there are skipped, while on lmdb a media index entry that is already there is listed once more. Enter asks before anything runs."
      ;;
    switch|from:*)
      # the verb's steps in order (stop, backup, move, restore, start), in
      # words, with what happens to the relay: said before the typed name
      local src="$FLOW_FOUND" aside="db/.pre-switch-$FLOW_FOUND-<time>/" o="" r1 r2
      if [[ "$id" == from:* ]]; then
        src="${id#from:}" aside="db/.pre-switch-mixed-<time>/" o=badger
        [[ "$src" == badger ]] && o=lmdb
      fi
      case "$FLOW_RELAY" in
        running) r1="The relay stops (it is running now)."; r2="The relay starts again on $FLOW_TARGET." ;;
        stopped) r1="The relay is not running and stays stopped."; r2="" ;;
        *) r1="A running relay stops."; r2="A relay that ran starts again on $FLOW_TARGET." ;;
      esac
      v="What happens:"$'\n'"1. $r1"$'\n'"2. A verified backup of the $src data goes to backups/."$'\n'
      if [[ -n "$o" ]]; then
        v+="3. All database directories move to $aside and are kept."$'\n'"4. DB_ENGINE becomes $FLOW_TARGET and the $src side is restored into a clean $FLOW_TARGET database; the $o side stays set aside, not merged."$'\n'
      else
        v+="3. The $src directories move to $aside and are kept."$'\n'"4. DB_ENGINE becomes $FLOW_TARGET and the data is restored into a new $FLOW_TARGET database."$'\n'
      fi
      [[ -z "$r2" ]] || v+="5. $r2"$'\n'
      v+=$'\n'"If a step fails, the switch rolls back to the old data (where it cannot finish, Undo interrupted switch appears in the Data group). To go back later: ./$SCRIPT_NAME db-switch --rollback."$'\n\n'"Enter asks you to type $FLOW_TARGET." ;;
    back) v="Back to the main menu." ;;
  esac
  while IFS= read -r t; do DETAIL_LINES+=("$t"); done < <(printf '%s\n' "$v" | tui_wrap "$RIGHT_CONTENT_W")
}
# tui_flow_end — end of the flow code (see the comment at its start)

# About screen: the distributed version (image tag from the compose file)
# plus the running relay image digest, best effort without the daemon.
tui_about() {
  local version="-"
  local compose_file="$ROOT_DIR/docker-compose.yml"
  if [[ -f "$compose_file" ]]; then
    version="$(grep -m1 'image:.*haven-docker' "$compose_file" | sed -E 's/.*haven-docker:([^[:space:]]+).*/\1/')"
    [[ -n "$version" ]] || version="-"
  fi
  local digest="-"
  if docker info >/dev/null 2>&1; then
    digest="$(docker inspect --format '{{.Image}}' "$RELAY_CONTAINER" 2>/dev/null || true)"
    if [[ "$digest" == sha256:* ]]; then
      digest="${digest:0:22}…"
    else
      digest="-"
    fi
  fi
  tui_message "About" "haven-docker CLI version: $version
Relay image digest: $digest
Upstream: Haven, a High Availability Vault for Events on Nostr.
Settings history: every edit of .env or a list keeps the previous file as <name>.bak.<time> (the 10 most recent)."
}

tui_handle_enter() {
