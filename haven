          fi
          tui_set_view "env_list"
          ;;
        json)
          if ! detect_json_tool; then
            tui_message "Access lists" "Editing the lists needs jq or python3."
            return
          fi
          tui_set_view "json_files"
          ;;
        onion)
          local onion_text=""
          local onion_host_file="$ROOT_DIR/tor/data/haven/hostname"
          local onion_torrc="$ROOT_DIR/tor/torrc"
          if [[ -f "$onion_host_file" ]]; then
            onion_text="$(cat "$onion_host_file")"
          else
            onion_text="No onion address yet. Start the relay with Tor; the address appears once Tor is up."
          fi
          if [[ -f "$onion_torrc" ]]; then
            onion_text="$onion_text

torrc:
$(cat "$onion_torrc")"
          fi
          tui_message "Onion address" "$onion_text"
          ;;
        import)
          tui_require_docker || return 0
          if tui_confirm "Import notes now? The relay stops while it runs." "y"; then
            # The import streams for minutes; suspend the TUI so it is visible.
            tui_cleanup
            printf "\n"
            run_import_once "$(resolve_mode "import")" || true
            printf "\nPress Enter to return to the TUI... "
            read -r _ || true
            tui_init
            TUI_NEED_FRAME=1
            TUI_NEED_MENU=1
            TUI_NEED_LEFT=1
            TUI_NEED_RIGHT=1
          fi
          ;;
        backup) tui_flow_backup ;;
        restore) tui_flow_restore ;;
        db_switch) tui_flow_switch ;;
        switch_rollback) tui_flow_rollback ;;
        env_upgrade)
          if [[ ! -f "$ROOT_DIR/.env.example" ]]; then
            tui_message "Add missing settings" ".env.example not found."
            return
          fi
          if [[ ! -f "$ROOT_DIR/.env" ]]; then
            if tui_confirm "No .env yet. Create it from .env.example?" "y"; then
              cp "$ROOT_DIR/.env.example" "$ROOT_DIR/.env"
              tui_message "Add missing settings" ".env created from .env.example. Edit your settings, then restart the relay."
            fi
            return
          fi
          local upgrade_missing=""
          upgrade_missing="$(list_missing_env_vars)"
          local upgrade_count=0
          if [[ -n "$upgrade_missing" ]]; then
            upgrade_count="$(printf "%s\n" "$upgrade_missing" | wc -l)"
            upgrade_count="${upgrade_count// /}"
          fi
          if [[ "$upgrade_count" -eq 0 ]]; then
            tui_message "Add missing settings" "Nothing to add: .env has every setting of .env.example."
            return
          fi
          local upgrade_preview=""
          upgrade_preview="$(printf "%s\n" "$upgrade_missing" | head -n 10)"
          if [[ "$upgrade_count" -gt 10 ]]; then
            upgrade_preview="$upgrade_preview\n... and $((upgrade_count - 10)) more"
          fi
          local upgrade_what="$upgrade_count settings are"
          [[ "$upgrade_count" -eq 1 ]] && upgrade_what="1 setting is"
          tui_message "Add missing settings" "$upgrade_what missing from .env:\n\n$upgrade_preview"
          if tui_confirm "Add them to .env?" "y"; then
            upgrade_env_file
            local upgrade_note=""
            [[ -z "$UPGRADE_ENV_NOTE" ]] || upgrade_note="\n\n$UPGRADE_ENV_NOTE"
            local upgrade_done="$upgrade_count settings added."
            [[ "$upgrade_count" -eq 1 ]] && upgrade_done="1 setting added."
            tui_message "Add missing settings" "$upgrade_done Review them in Settings, then restart the relay.$upgrade_note"
          fi
          ;;
        help)
          show_help_screen
          ;;
        about)
          tui_about
          ;;
        quit)
          return 1
          ;;
      esac
      ;;
    logs)
      case "$id" in
        service)
          tui_set_view "logs_service"
          ;;
        tail)
          local new_tail
          new_tail="$(tui_prompt "Tail lines:" "$TAIL_COUNT")"
          if [[ "$new_tail" =~ ^[0-9]+$ ]]; then
            TAIL_COUNT="$new_tail"
            if [[ "$FOLLOW_LOGS" == "1" ]]; then
              start_log_stream
            else
              refresh_log_snapshot
            fi
            TUI_NEED_RIGHT=1
          else
            tui_message "Logs" "Tail lines must be a number."
          fi
          ;;
        follow)
          if [[ "$FOLLOW_LOGS" == "1" ]]; then
            FOLLOW_LOGS=0
            stop_log_stream
            refresh_log_snapshot
          else
            FOLLOW_LOGS=1
            start_log_stream
          fi
          TUI_NEED_RIGHT=1
          ;;
        back)
          tui_set_view "main"
          ;;
      esac
      ;;
    logs_service)
      if [[ "$id" == "back" ]]; then
        tui_set_view "logs"
      else
        LOG_SERVICE="$id"
        if [[ "$FOLLOW_LOGS" == "1" ]]; then
          start_log_stream
        else
          refresh_log_snapshot
        fi
        TUI_NEED_RIGHT=1
        tui_set_view "logs"
      fi
      ;;
    env_list)
      case "$id" in
        add)
          local new_key
          local new_value
          new_key="$(tui_prompt "New key:" "" _validate_prompt_new_key)"
          if [[ -z "$new_key" ]]; then
            return
          fi
          PROMPT_ENV_KEY="$new_key"
          new_value="$(tui_prompt "New value:" "" _validate_prompt_env_value)"
          if [[ -z "$new_value" ]]; then
            return
          fi
          tui_engine_unknown_note "$new_key"
          tui_env_save "$new_key" "$new_value"
          ;;
        back)
          tui_set_view "main"
          ;;
        *)
          if [[ "$id" == key:* ]]; then
            CURRENT_ENV_KEY="${id#key:}"
            tui_set_view "env_item"
          fi
          ;;
      esac
      ;;
    env_item)
      case "$id" in
        edit)
          local current=""
          local new_value=""
          env_effective_value "$CURRENT_ENV_KEY"
          current="$_EFFECTIVE"
          PROMPT_ENV_KEY="$CURRENT_ENV_KEY"
          # the current value is never handed to the prompt: it may be a
          # credential, and a prompt draws what it holds (a refused value was
          # redrawn in clear). Esc, Ctrl-C and an empty Enter mean no change:
          # nothing is validated or written, the relay is not restarted.
          new_value="$(tui_prompt "New value:" "" _validate_prompt_env_value)"
          if [[ -z "$new_value" || "$new_value" == "$current" ]]; then
            return 0
          fi
          tui_engine_unknown_note "$CURRENT_ENV_KEY"
          tui_env_save "$CURRENT_ENV_KEY" "$new_value"
          ;;
        reveal)
          # Explicit reveal: the list view only ever shows masked values.
          local shown=""
          env_effective_value "$CURRENT_ENV_KEY"
          shown="$_EFFECTIVE"
          if [[ -z "$shown" ]]; then
            shown="(empty)"
          fi
          tui_message "$CURRENT_ENV_KEY" "$shown"
          ;;
        remove)
          # without the line the relay runs lmdb (upstream's default): the same
          # flip as an edit, refused the same way
          if [[ "$CURRENT_ENV_KEY" == "DB_ENGINE" ]] && ! engine_change_allowed lmdb; then
            tui_message "$CURRENT_ENV_KEY" "Not removed: without DB_ENGINE the relay runs lmdb. $ENGINE_CHANGE_ERR"
            return
          fi
          if tui_confirm "Remove $CURRENT_ENV_KEY?" "n"; then
            tui_engine_unknown_note "$CURRENT_ENV_KEY"
            tui_env_save "$CURRENT_ENV_KEY" --remove
          fi
          ;;
        back)
          tui_set_view "env_list"
          ;;
      esac
      ;;
    restore_list)
      case "$id" in
        back) tui_set_view "main" ;;
        file:*) tui_flow_restore_pick "${id#file:}" ;;
      esac
      ;;
    switch)
      case "$id" in
        back) tui_set_view "main" ;;
        switch) tui_flow_switch_go ;;
        from:*) tui_flow_switch_go "${id#from:}" ;;
      esac
      ;;
    json_files)
      if [[ "$id" == "back" ]]; then
        tui_set_view "main"
      else
        CURRENT_JSON_FILE="$id"
        if ! ensure_json_array_file "$CURRENT_JSON_FILE"; then
          tui_message "Access lists" "$CURRENT_JSON_FILE is missing or not valid JSON."
          return
        fi
        tui_set_view "json_items"
      fi
      ;;
    json_items)
      case "$id" in
        add)
          local new_item
          new_item="$(tui_prompt "Add item:" "")"
          # empty: cancelled (Esc) or nothing typed — nothing to add, nothing to say
          [[ -n "$new_item" ]] || return 0
          if ! validate_json_item "$CURRENT_JSON_FILE" "$new_item"; then
            tui_message "Access lists" "$VALIDATION_ERROR"
            return
          fi
          local item_to_add="$VALIDATION_VALUE"
          local path="$ROOT_DIR/$CURRENT_JSON_FILE"
          run_capture json_list_items "$path"
          local duplicate=0
          local existing
          while IFS= read -r existing; do
            if [[ "$existing" == "$item_to_add" ]]; then
              duplicate=1
              break
            fi
          done <<<"$RUN_OUTPUT"
          if [[ "$duplicate" == "1" ]]; then
            tui_message "Access lists" "Already on the list."
            return
          fi
          json_add_item "$path" "$item_to_add"
          ;;
        clear)
          if tui_confirm "Remove every item from the list?" "n"; then
            json_clear "$ROOT_DIR/$CURRENT_JSON_FILE"
          fi
          ;;
        back)
          tui_set_view "json_files"
          ;;
        item:*)
          local index="${id#item:}"
          local path="$ROOT_DIR/$CURRENT_JSON_FILE"
          local output=""
          output="$(json_list_items "$path" 2>/dev/null || true)"
          local current_item=""
          current_item="$(printf "%s" "$output" | sed -n "$((index + 1))p")"
          if [[ -n "$current_item" ]]; then
            if tui_confirm "Remove item?\n\n$current_item" "n"; then
              json_remove_index "$path" "$index"
            fi
          fi
          ;;
      esac
      ;;
  esac
  TUI_NEED_MENU=1
  TUI_NEED_LEFT=1
  TUI_NEED_RIGHT=1
  return 0
}

tui_handle_key() {
  local key="$1"
  local count=${#MENU_IDS[@]}

  # Main view: an entry's shortcut letter runs exactly what Enter runs on it.
  if [[ "$TUI_VIEW" == "main" && ${#key} -eq 1 ]]; then
    local k
    for ((k = 0; k < count; k++)); do
      if [[ -n "${MENU_KEYS[$k]:-}" && "${MENU_KEYS[$k]}" == "$key" ]]; then
        TUI_SEL="$k"
        TUI_NEED_LEFT=1
        tui_handle_enter || return 1
        TUI_NEED_LEFT=1
        return 0
      fi
    done
  fi

  # Navigation skips group names (tui_menu_selectable).
  case "$key" in
    up|k)
      tui_sel_step "$TUI_SEL" -1 || true
      ;;
    down|j)
      tui_sel_step "$TUI_SEL" 1 || true
      ;;
    home|g)
      tui_sel_step -1 1 || true
      TUI_NEED_LEFT=1
      ;;
    end|G)
      tui_sel_step "$count" -1 || true
      TUI_NEED_LEFT=1
      ;;
    pgup|pgdn)
      # Since P5 the page keys belong to the log panel's scrollback (the
      # plan's P5 DoD assigns them there); menus page via g/G, Home/End,
      # j/k and the digit shortcuts.
      if [[ "$TUI_RIGHT_MODE" == "logs" ]]; then
        local page=$((RIGHT_CONTENT_HEIGHT > 1 ? RIGHT_CONTENT_HEIGHT - 1 : 1))
        if [[ "$key" == "pgup" ]]; then
          # Clamp against what the panel shows: with a filter, the matching
          # lines in the window under the hit-count row (one row shorter).
          local height=$RIGHT_CONTENT_HEIGHT
          local total=${#LOG_LINES[@]}
          if [[ -n "$LOG_FILTER" ]]; then
            height=$((RIGHT_CONTENT_HEIGHT - 1))
            tui_log_view_lines "$height"
            total=$_VIEW_MATCHES
          fi
          local max_scroll=$((total > height ? total - height : 0))
          LOG_SCROLL=$((LOG_SCROLL + page))
          (( LOG_SCROLL > max_scroll )) && LOG_SCROLL=$max_scroll
        else
          LOG_SCROLL=$((LOG_SCROLL - page))
          (( LOG_SCROLL < 0 )) && LOG_SCROLL=0
        fi
        TUI_NEED_RIGHT=1
      fi
      ;;
    /)
      # In the settings list: filter the settings (name and description).
      if [[ "$TUI_VIEW" == env_list ]]; then
        local new_settings_filter
        new_settings_filter="$(tui_prompt "Filter settings:" "")"
        settings_set_filter "$new_settings_filter"
        TUI_NEED_LEFT=1
        return 0
      fi
      # Live substring filter for the log panel. No default on purpose:
      # an empty Enter must clear the filter instead of re-applying it.
      if [[ "$TUI_RIGHT_MODE" == "logs" ]] && ! tui_view_has_details; then
        local new_filter
        new_filter="$(tui_prompt "Filter logs:" "")"
        LOG_FILTER="$new_filter"
        LOG_SCROLL=0
        TUI_NEED_RIGHT=1
        # the prompt cleared its rows, which belong to the menu
        TUI_NEED_LEFT=1
      fi
      ;;
    tab)
      # settings editor: details <-> logs; elsewhere: logs <-> status
      if tui_view_has_details; then
        if [[ "$TUI_RIGHT_MODE" == "details" ]]; then TUI_RIGHT_MODE="logs"; else TUI_RIGHT_MODE="details"; fi
      elif [[ "$TUI_RIGHT_MODE" == "logs" ]]; then
        TUI_RIGHT_MODE="status"
      else
        TUI_RIGHT_MODE="logs"
      fi
      TUI_NEED_RIGHT=1
      ;;
    [1-9])
      # the nth selectable entry (group names do not count)
      local n=0 d
      for ((d = 0; d < count; d++)); do
        tui_menu_selectable "$d" || continue
        n=$((n + 1))
        if (( n == key )); then
          TUI_SEL="$d"
          TUI_NEED_LEFT=1
          break
        fi
      done
      ;;
    enter)
      tui_handle_enter || return 1
      # a prompt the entry opened cleared its rows, which belong to the menu
      TUI_NEED_LEFT=1
      ;;
    left|esc)
      tui_handle_back || return 1
      ;;
    quit)
      if [[ "$TUI_VIEW" == "main" ]]; then
        return 1
      fi
      tui_handle_back
      ;;
    del|f1|f2|unknown|paste)
      # Recognized escape sequences not bound to a menu action; they must
      # never fall through to esc/back.
      ;;
  esac
  # the details pane follows the selection
  [[ "$TUI_RIGHT_MODE" == "details" ]] && TUI_NEED_RIGHT=1
  return 0
}

# settings_set_filter <text> — apply (or with "" clear) the settings filter; the
# selection stays on the same setting when it is still listed, else it is
# clamped by the next render. The filter never writes .env.
settings_set_filter() {
  local keep=""
  if (( ${#MENU_IDS[@]} > 0 && TUI_SEL < ${#MENU_IDS[@]} )); then keep="${MENU_IDS[$TUI_SEL]}"; fi
  SETTINGS_FILTER="$1"
  tui_build_menu
  TUI_NEED_MENU=0
  local i
  for ((i = 0; i < ${#MENU_IDS[@]}; i++)); do
    if [[ "${MENU_IDS[$i]}" == "$keep" ]]; then TUI_SEL=$i; break; fi
  done
  (( i < ${#MENU_IDS[@]} )) || TUI_SEL=0
  TUI_OFFSET=0
  TUI_NEED_LEFT=1
  TUI_NEED_RIGHT=1
}

# Test seam (see HAVEN_TUI_SYNC_FILE at the top): publish "a render pass has
# completed" as an incrementing number. Written via a temp file and rename so a
# reader never sees a half-written value.
tui_sync_mark() {
  [[ -n "${HAVEN_TUI_SYNC_FILE:-}" ]] || return 0
  TUI_SYNC_COUNT=$((TUI_SYNC_COUNT + 1))
  { printf '%s\n' "$TUI_SYNC_COUNT" > "$HAVEN_TUI_SYNC_FILE.tmp" \
      && mv -f "$HAVEN_TUI_SYNC_FILE.tmp" "$HAVEN_TUI_SYNC_FILE"; } 2>/dev/null || true
}

tui_loop() {
  local start_view="$1"
  local running=1
  local rendered=0

  # A full-screen TUI cannot draw on a terminal without cursor addressing.
  if [[ "${TERM:-}" == "dumb" || -z "${TERM:-}" ]]; then
    printf '%s: the TUI needs a terminal that can position the cursor (TERM is "%s"); use the commands instead, e.g. ./%s status, ./%s start, ./%s backup — ./%s help lists them all.\n' \
      "$SCRIPT_NAME" "${TERM:-}" "$SCRIPT_NAME" "$SCRIPT_NAME" "$SCRIPT_NAME" "$SCRIPT_NAME" >&2
    exit 1
  fi

  # Size check BEFORE tui_init touches stty/the alternate screen, so a
  # too-small terminal leaves the shell state untouched.
  tui_update_layout
  if [[ "$TUI_TOO_SMALL" == "1" ]]; then
    printf 'Terminal too small: %s needs at least %d columns x %d lines (current: %d x %d).\n' \
      "$SCRIPT_NAME" "$TUI_MIN_COLS" "$TUI_MIN_LINES" "$TUI_COLS" "$TUI_LINES" >&2
    exit 1
  fi

  tui_init
  trap 'TUI_NEED_RESIZE=1' SIGWINCH

  if [[ -n "$start_view" ]]; then
    TUI_VIEW="$start_view"
  else
    TUI_VIEW="main"
  fi
  [[ "$TUI_VIEW" == env_list ]] && TUI_RIGHT_MODE="details"
  TUI_SEL=0
  TUI_OFFSET=0
  TUI_NEED_FRAME=1
  TUI_NEED_LEFT=1
  TUI_NEED_RIGHT=1

  if [[ -z "$LOG_SERVICE" ]]; then
    LOG_SERVICE="relay"
  fi
  TUI_RIGHT_TITLE="Logs: ${LOG_SERVICE:-all}"
  _SPINNER_TICK=0

  tui_update_docker_status
  if [[ "$FOLLOW_LOGS" == "1" ]]; then
    start_log_stream
  else
    refresh_log_snapshot
  fi

  while [[ "$running" -eq 1 ]]; do
    if [[ "$TUI_NEED_RESIZE" -eq 1 ]]; then
      TUI_NEED_RESIZE=0
      tui_update_layout
      if [[ "$TUI_TOO_SMALL" == "1" ]]; then
        # Below the renderable minimum: show a message instead of a garbled
        # frame; normal operation resumes once the terminal grows again.
        tui_clear
        printf '\033[1;1H%s' "${CLR_RESET}"
        printf 'Terminal too small: need at least %d cols x %d lines (current: %d x %d). Enlarge to continue.' \
          "$TUI_MIN_COLS" "$TUI_MIN_LINES" "$TUI_COLS" "$TUI_LINES"
        TUI_NEED_FRAME=0
        TUI_NEED_MENU=0
        TUI_NEED_LEFT=0
        TUI_NEED_RIGHT=0
        rendered=1
      else
        TUI_NEED_FRAME=1
        TUI_NEED_MENU=1
        TUI_NEED_LEFT=1
        TUI_NEED_RIGHT=1
      fi
    fi

    _SPINNER_TICK=$((_SPINNER_TICK + 1))
    if (( _SPINNER_TICK % 4 == 0 && FOLLOW_LOGS == 1 )); then
      # With the 150 ms poll this fires every ~600 ms; draining pulls all
      # buffered lines per tick, so follow-logs stay visibly flowing.
      TUI_NEED_RIGHT=1
    fi

    tui_update_docker_status
    tui_ensure_log_stream
    drain_log_stream

    if [[ "$TUI_NEED_FRAME" -eq 1 ]]; then
      tui_draw_frame 1
      TUI_NEED_FRAME=0
      TUI_NEED_LEFT=1
      TUI_NEED_RIGHT=1
      rendered=1
    fi

    if [[ "$TUI_NEED_RIGHT" -eq 1 ]]; then
      tui_render_right_panel
      TUI_NEED_RIGHT=0
      rendered=1
    fi

    if [[ "$TUI_NEED_LEFT" -eq 1 ]]; then
      tui_render_left_menu
      TUI_NEED_LEFT=0
      rendered=1
    fi

    if [[ "$rendered" -eq 1 ]]; then
      rendered=0
      tui_sync_mark
    fi

    tui_read_key || continue
    if ! tui_handle_key "$_KEY"; then
      running=0
    fi
  done
}

# tui_env_save <key> <value>|--remove — the settings editor's write:
# set_env_var or remove_env_var, captured (their warnings never land on the
# frame). A refused or failed write is shown in a box and nothing restarts —
# the writer's status is checked before anything else. A write that went
# through restarts a running relay (restart_after_env_change), whose box says
# what happened; a value with a $ outside single quotes adds env_dollar_note.
tui_env_save() {
  local key="$1" line text
  if [[ "$2" == --remove ]]; then
    run_capture remove_env_var "$key"
  else
    run_capture set_env_var "$key" "$2"
  fi
  if [[ "$RUN_STATUS" -ne 0 ]]; then
    text=".env was not changed, and the relay was not restarted."
    while IFS= read -r line; do
      strip_terminal_controls "$line"
      line="${_STRIPPED#WARN }"
      [[ -z "$line" ]] || text+=$'\n'"${line//"$ROOT_DIR/"/}"
    done <<<"$RUN_OUTPUT"
    tui_message "$key" "$text"
    TUI_NEED_FRAME=1 TUI_NEED_MENU=1 TUI_NEED_LEFT=1 TUI_NEED_RIGHT=1
    return 0   # shown; a non-zero status here would end the TUI (tui_handle_key)
  fi
  _DOLLAR_NOTE=""
  [[ "$2" == --remove ]] || env_dollar_note "$2"
  restart_after_env_change "$_DOLLAR_NOTE"
}

# tui_relay_state_sentence — _RELAY_STATE: the relay's state as Docker reports
# it NOW, for a box written after an action (never what the action intended).
tui_relay_state_sentence() {
  if relay_container_running 2>/dev/null; then
    _RELAY_STATE="The relay is running."
  else
    _RELAY_STATE="The relay is NOT running: start it with s in the main view."
  fi
}

# restart_after_env_change [<note>] — after a saved setting: restart a running
# relay to apply it. In the TUI every outcome ends in a box (<note> appended);
# outside it, messages.
restart_after_env_change() {
  local note="${1:-}" text=""
  if ! docker info >/dev/null 2>&1; then
    if [[ "$TUI_ACTIVE" == "1" ]]; then
      text=".env was saved. Docker is not reachable, so nothing was restarted; the change applies at the next start."
      [[ -z "$note" ]] || text+=$'\n\n'"$note"
      tui_message "Restart" "$text"
      TUI_NEED_FRAME=1 TUI_NEED_MENU=1 TUI_NEED_LEFT=1 TUI_NEED_RIGHT=1
    else
      warn "Docker not running; restart skipped."
    fi
    return 0
  fi

  local mode=""
  if docker ps --format '{{.Names}}' | grep -qx 'haven-tor'; then
    mode="tor"
  elif relay_container_running; then
    mode="plain"
  else
    if [[ "$TUI_ACTIVE" == "1" ]]; then
      text=".env was saved. The relay is not running, so nothing was restarted; the change applies when it starts (s in the main view)."
      [[ -z "$note" ]] || text+=$'\n\n'"$note"
      tui_message "Restart" "$text"
      TUI_NEED_FRAME=1 TUI_NEED_MENU=1 TUI_NEED_LEFT=1 TUI_NEED_RIGHT=1
    else
      warn "No running containers to restart."
    fi
    return 0
  fi

  # Runs with errexit active inside the TUI: a refusal from restart_services
  # would end the TUI, so the one-shot check comes first and is shown here.
  local refusal=""
  if refusal="$(start_blocked 2>&1)"; then
    if [[ "$TUI_ACTIVE" == "1" ]]; then
      text=".env was saved; the restart to apply it is skipped."$'\n\n'"$refusal"
      [[ -z "$note" ]] || text+=$'\n\n'"$note"
      tui_message "Restart" "$text"
    else
      printf '%s\n' "$refusal"
      warn ".env was saved; the restart to apply it is skipped."
    fi
    return 0
  fi

  # The start's preparation (missing JSON lists ask one dialog each) runs
  # BEFORE the stop: an unanswered dialog must not leave the relay down.
  if [[ "$TUI_ACTIVE" == "1" ]]; then
    tui_restart_captured "$mode" "$note"
    return 0
  fi
  info "Restarting services ($mode) to apply .env changes..."
  prepare_start
  local START_PREPARED=1
  restart_services "$mode"
}

# tui_restart_captured <mode> [<note>] — the restart after a saved setting, as
# the main menu's Start and Restart run (tui_run_action): the output is
# captured, never written over the frame, and the result is shown in a box —
# the warnings in it, or the whole output when something failed — with the
# relay's state as Docker reports it after the restart (a failed `up` leaves it
# stopped, and the box says so). The start's preparation runs first and
# captured too, except the one step that asks (a missing JSON list, one dialog
# each), which needs the terminal; a refusal there leaves the relay running.
tui_restart_captured() {
  local mode="$1" note="${2:-}" text="" line warns="" out streaming=0
  if [[ "$FOLLOW_LOGS" == "1" ]]; then
    stop_log_stream
    streaming=1
  fi
  run_capture tui_prepare_start_quiet
  out="$RUN_OUTPUT"
  if [[ "$RUN_STATUS" -ne 0 ]]; then
    text=".env was saved; the restart to apply it was not run: the start's checks failed (exit $RUN_STATUS)."
  else
    ensure_example_jsons
    local START_PREPARED=1
    run_capture restart_services "$mode"
    out+="${out:+$'\n'}$RUN_OUTPUT"
  fi
  tui_relay_state_sentence
  if [[ -n "$text" ]]; then
    text+=" $_RELAY_STATE"
  elif [[ "$RUN_STATUS" -ne 0 ]]; then
    text=".env was saved; the restart to apply it failed (exit $RUN_STATUS). $_RELAY_STATE"
  elif [[ "$_RELAY_STATE" == "The relay is running." ]]; then
    text=".env was saved and the relay restarted (${mode^}) to apply it."
  else
    text=".env was saved; the restart reported no error, but ${_RELAY_STATE,}"
  fi
  while IFS= read -r line; do
    strip_terminal_controls "$line"
    line="$_STRIPPED"
    if [[ -n "$line" && ( "$RUN_STATUS" -ne 0 || "$line" == "WARN "* || "$line" == "ERROR "* ) ]]; then
      warns+=$'\n'"${line//"$ROOT_DIR/"/}"
    fi
  done <<<"$out"
  [[ -z "$warns" ]] || text+=$'\n'"$warns"
  [[ -z "$note" ]] || text+=$'\n\n'"$note"
  tui_message "Restart" "$text"
  TUI_NEED_FRAME=1
  TUI_NEED_MENU=1
  TUI_NEED_LEFT=1
  TUI_NEED_RIGHT=1
  # the stream stopped above starts again; a paused log view stays as it was
  (( streaming == 0 )) || start_log_stream
}

# tui_prepare_start_quiet — prepare_start without its dialog step
# (ensure_example_jsons), for a captured run inside the TUI (run_capture, a
# subshell with TUI_ACTIVE=0, so a die in it only ends the subshell).
tui_prepare_start_quiet() {
  warn_missing_critical_env
  ensure_docker_uid
  ensure_data_dirs
  warn_import_flag
}

menu_env_editor() {
  if [[ "$TUI_ACTIVE" == "1" ]]; then
    if ! ensure_env_file; then
      tui_message ".env" ".env missing."
      return
    fi
    tui_set_view "env_list"
    return
  fi
  if [[ ! -t 0 ]]; then
    die "Env editor requires a TTY."
  fi
  if ! ensure_env_file; then
    die ".env missing."
  fi
  tui_loop "env_list"
}

menu_logs() {
  if [[ "$TUI_ACTIVE" == "1" ]]; then
    tui_set_view "logs"
    return
  fi
  if [[ -t 0 ]]; then
    tui_loop "logs"
  else
    LOG_SERVICE="all"
    local mode
    local compose_file
    mode="$(resolve_mode "logs")"
    compose_file="$(compose_file_for "$mode")"
    require_compose_file "$compose_file"
    stream_logs "$mode" "$compose_file" "$LOG_SERVICE"
  fi
}

menu_json_editor() {
  if [[ "$TUI_ACTIVE" == "1" ]]; then
    if ! detect_json_tool; then
      tui_message "Access lists" "Editing the lists needs jq or python3."
      return
    fi
    tui_set_view "json_files"
    return
  fi
  if [[ ! -t 0 ]]; then
    die "JSON editor requires a TTY."
  fi
  if ! detect_json_tool; then
    die "jq or python3 is required for JSON editing."
  fi
  tui_loop "json_files"
}

tui() {
  if [[ ! -t 0 ]]; then
    die "TUI requires a TTY. Use CLI commands instead."
  fi
  tui_loop "main"
}

parse_args() {
  if [[ $# -eq 0 ]]; then
    COMMAND="tui"
    return
  fi

  while [[ $# -gt 0 ]]; do
    case "$1" in
      start|stop|restart|logs|status|tui|help|import|onion|json|env|env-upgrade|backup|restore|db-switch)
        COMMAND="$1"
        shift
        ;;
      -y|--yes)
        ASSUME_YES=1
        shift
        ;;
      --rollback)
        DB_SWITCH_ROLLBACK=1
        shift
        ;;
      --from)
        [[ $# -lt 2 ]] && die "--from requires an engine: badger or lmdb"
        [[ "$2" == "badger" || "$2" == "lmdb" ]] || die "--from takes badger or lmdb (lower case), not '$(printable_text "$2")'."
        DB_SWITCH_FROM="$2"
        shift 2
        ;;
      -t|--tor)
        MODE="tor"
        shift
        ;;
      --plain)
        MODE="plain"
        shift
        ;;
      --tail)
        [[ $# -lt 2 ]] && die "--tail requires a number"
        TAIL_COUNT="$2"
        shift 2
        ;;
      -s|--service)
        [[ $# -lt 2 ]] && die "--service requires a name"
        LOG_SERVICE="$2"
        shift 2
        ;;
      --all)
        LOG_SERVICE="all"
        shift
        ;;
      --no-follow)
        FOLLOW_LOGS=0
        shift
        ;;
      --no-build)
        BUILD_IMAGES=0
        shift
        ;;
      --build)
        BUILD_IMAGES=1
        shift
        ;;
      -h|--help)
        COMMAND="help"
        shift
        ;;
      *)
        if [[ ( "$COMMAND" == "backup" || "$COMMAND" == "restore" ) && -z "$DATA_FILE_ARG" && "$1" != -* ]]; then
          DATA_FILE_ARG="$1"
          shift
        elif [[ "$COMMAND" == "db-switch" && "$DB_SWITCH_ARG_SET" == "0" && "$1" != -* ]]; then
          DB_SWITCH_ARG="$1"
          DB_SWITCH_ARG_SET=1
          shift
        elif [[ "$COMMAND" == "db-switch" && "$1" != -* ]]; then
          die "db-switch takes one engine: badger or lmdb."
        else
          die "Unknown argument: $1"
        fi
        ;;
    esac
  done

  if [[ "$DB_SWITCH_ROLLBACK" == "1" && "$COMMAND" != "db-switch" ]]; then
    die "--rollback belongs to db-switch: $SCRIPT_NAME db-switch --rollback"
  fi
  if [[ -n "$DB_SWITCH_FROM" && "$COMMAND" != "db-switch" ]]; then
    die "--from belongs to db-switch: $SCRIPT_NAME db-switch <badger|lmdb> --from <badger|lmdb>"
  fi
  if [[ -n "$DB_SWITCH_FROM" && "$DB_SWITCH_ROLLBACK" == "1" ]]; then
    die "--from belongs to a switch, not to --rollback (the rollback reads what to put back from db/)."
  fi
  if [[ "$COMMAND" == "db-switch" ]]; then
    if [[ "$DB_SWITCH_ROLLBACK" == "1" && "$DB_SWITCH_ARG_SET" == "1" ]]; then
      die "db-switch takes either an engine or --rollback, not both."
    fi
    if [[ "$DB_SWITCH_ROLLBACK" == "0" && "$DB_SWITCH_ARG_SET" == "0" ]]; then
      die "db-switch needs an engine: $SCRIPT_NAME db-switch badger|lmdb (or --rollback)."
    fi
  fi
}

main() {
  cd "$ROOT_DIR"
  detect_compose
  parse_args "$@"

  case "$COMMAND" in
    tui)
      tui
      ;;
    start)
      ensure_docker
      start_services "$(resolve_mode "start")"
      ;;
    stop)
      ensure_docker
      stop_services "$(resolve_mode "stop")"
      ;;
    restart)
      ensure_docker
      restart_services "$(resolve_mode "restart")"
      ;;
    logs)
      if [[ -z "$LOG_SERVICE" ]]; then
        if [[ -t 0 ]]; then
          menu_logs
        else
          LOG_SERVICE="all"
        fi
      fi

      if [[ -n "$LOG_SERVICE" ]]; then
        ensure_docker
        local mode
        local compose_file
        mode="$(resolve_mode "logs")"
        compose_file="$(compose_file_for "$mode")"
        require_compose_file "$compose_file"
        stream_logs "$mode" "$compose_file" "$LOG_SERVICE"
      fi
      ;;
    status)
      ensure_docker
      show_status "$(resolve_mode "status")"
      ;;
    onion)
      show_onion_host
      ;;
    import)
      ensure_docker
      run_import_once "$(resolve_mode "import")" || exit 1
      ;;
    backup)
      ensure_docker
      backup_relay_db "$(resolve_mode "backup")" "$DATA_FILE_ARG" || exit 1
      ;;
    restore)
      ensure_docker
      restore_relay_db "$(resolve_mode "restore")" "$DATA_FILE_ARG" || exit 1
      ;;
    db-switch)
      # both check docker themselves, after the argument: a typo needs no daemon
      if [[ "$DB_SWITCH_ROLLBACK" == "1" ]]; then
        db_switch_rollback || exit 1
      else
        db_switch "$DB_SWITCH_ARG" "$DB_SWITCH_FROM" || exit 1
      fi
      ;;
    env)
      menu_env_editor
      ;;
    env-upgrade)
      if [[ ! -f "$ROOT_DIR/.env.example" ]]; then
        die ".env.example not found."
      fi
      if [[ ! -f "$ROOT_DIR/.env" ]]; then
        cp "$ROOT_DIR/.env.example" "$ROOT_DIR/.env"
        success ".env created from .env.example."
        info "Please edit your .env and then restart services."
        exit 0
      fi
      local missing_vars=""
      missing_vars="$(list_missing_env_vars)"
      local missing_count=0
      if [[ -n "$missing_vars" ]]; then
        missing_count="$(printf "%s\n" "$missing_vars" | wc -l)"
        missing_count="${missing_count// /}"
      fi
      if [[ "$missing_count" -eq 0 ]]; then
        success "No missing variables. Your .env is up to date."
        exit 0
      fi
      info "$missing_count new variable(s) found:"
      printf "%s\n" "$missing_vars"
      upgrade_env_file
      success "$missing_count variable(s) added to .env."
      [[ -z "$UPGRADE_ENV_NOTE" ]] || info "$UPGRADE_ENV_NOTE"
      info "Please review and edit your .env file, then restart services."
      ;;
    json)
      menu_json_editor
      ;;
    help|"")
      print_usage
      ;;
    *)
      die "Unknown command: $COMMAND"
      ;;
  esac
}

# Runs only when executed directly (./haven ...), not when sourced by the
# unit tests in tests/ — no environment variable that could leak into a
# user shell and silently disable main().
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
